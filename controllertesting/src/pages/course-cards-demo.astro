---

<BaseLayout 
  title="Course Design Cards Demo" 
  description="Previewing the premium Native Astro course design cards."
  noindex={true}

  localized={true}>
  <main class="min-h-screen pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <header class="mb-12 text-center md:text-left">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-primary mb-4">Course Design Cards</h1>
      <p class="text-secondary text-lg max-w-2xl">A premium, zero-JS Astro translation of the requested React component. Fully compatible with our existing Tailwind v4 gradient token system.</p>
    </header>

    {/* The grid layout ensures it works beautifully on all screen sizes */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {cardData.map((card) => (
        <CourseDesignCard data={card} />
      ))}
    </section>

  </main>
</BaseLayout>
