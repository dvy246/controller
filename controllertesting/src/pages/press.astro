---
/**
 * /press — Press kit for journalists & reviewers.
 * Data-backed angles only: no invented stats. Everything here is traceable
 * to reliabilityData.json (modeled reference baselines), the methodology
 * page, or the gamepad-lib repo. Community sample counts are live and start
 * at 0 until real, consenting testers contribute.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Press Kit' },
];

const facts = [
  { k: 'Modeled reference baselines', v: '5 models' },
  { k: 'Free browser diagnostics', v: '39' },
  { k: 'Repair guides', v: '12' },
  { k: 'Per-game settings guides', v: '30' },
  { k: 'Controller comparisons', v: '9' },
  { k: 'Locales', v: '1 (English — additional locales planned)' },
];
---

<BaseLayout
  title="Press Kit: Gamepad Testing Data & Media | ControllerTesting"
  description="Press kit for ControllerTesting.com: free controller testing platform with modeled reference baselines, open-source math, and a zero-invented-figures policy."
  breadcrumbs={breadcrumbs}

  localized={false}>
  <Header />

  <main id="main-content">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mb-12">
        <span class="badge-tag mb-3">Press &amp; Media</span>
        <h1 class="text-h1 mb-3">Press Kit</h1>
        <p class="text-secondary text-lg max-w-3xl leading-relaxed">
          ControllerTesting.com is the free, browser-based controller testing platform that explains
          <em>why</em> your controller behaves the way it does, beyond the raw axis numbers. Our reliability
          figures are explicitly labeled <em>modeled reference baselines</em>, and community sample counts are
          live figures that start at 0 and grow with consenting testers. We do not invent figures.
        </p>
      </header>

      <section class="card-base p-6 mb-8">
        <h2 class="section-title mb-4">Key facts</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          {facts.map((f) => (
            <div class="p-4 rounded-xl bg-surface-1 border border-border-subtle">
              <div class="text-2xl font-bold text-accent">{f.v}</div>
              <div class="text-tertiary text-sm mt-1">{f.k}</div>
            </div>
          ))}
        </div>
      </section>

      <section class="card-base p-6 mb-8">
        <h2 class="section-title mb-4">Story angles</h2>
        <ul class="space-y-3 text-secondary leading-relaxed">
          <li>
            <strong class="text-primary">The Hall-effect vs potentiometer gap, modeled.</strong> Our reference
            baseline model shows Hall-effect sticks averaging <strong class="text-primary">0.1%</strong> drift
            after 12 months vs <strong class="text-primary">3.1–5.2%</strong> for potentiometer sticks, and a
            <strong class="text-primary">36-month</strong> average lifespan before drift onset vs
            <strong class="text-primary">9–14 months</strong>. A 30–50× modeled difference behind a hardware
            trend that's reshaping the controller market (see also Valve's 2026 TMR-stick Steam Controller).
          </li>
          <li>
            <strong class="text-primary">A testing site that admits its limits.</strong> Published methodology
            page, per-tool "how this test works &amp; its limits" block, "no data yet" labels instead of invented
            numbers, and a recommendation to an open-source alternative (dualshock-tools) where our own tool is
            narrower. We are building trust with repair-minded users who distrust single-tool readings.
          </li>
          <li>
            <strong class="text-primary">Measurement math open-sourced.</strong> The core drift/circularity
            library (<code class="inline-code">gamepad-analyzer</code>, MIT) is the exact code running our tools —
            auditable, forkable, verifiable.
          </li>
          <li>
            <strong class="text-primary">Repair-first content.</strong> 12 step-by-step stick-drift repair
            guides, 30 per-game deadzone/sensitivity settings guides, 9 controller comparisons — all linked back
            to re-testing tools, closing the diagnose→fix→verify loop.
          </li>
        </ul>
      </section>

      <section class="card-base p-6 mb-8">
        <h2 class="section-title mb-4">The one-line pitch</h2>
        <p class="text-primary text-lg leading-relaxed">
          "The controller tester that shows its work: modeled reference baselines, open-source measurement
          math, published methodology — and repair guides for what you find."
        </p>
      </section>

      <section class="card-base p-6 mb-8">
        <h2 class="section-title mb-4">Why journalists trust us (and should)</h2>
        <ul class="space-y-3 text-secondary leading-relaxed">
          <li><strong class="text-primary">No ad network, no trackers, no sign-ups.</strong> The tools run
            locally in your browser; telemetry is opt-in consent, and only anonymized model + measurement
            values sync to public community baselines.</li>
          <li><strong class="text-primary">No lab-certification claims.</strong> We state precisely what browser
            testing can and cannot measure.</li>
          <li><strong class="text-primary">Figures are labeled and dated.</strong> Baselines are explicitly
            modeled references; the reliability dataset page displays its snapshot date and the monthly report
            archives changes.</li>
        </ul>
      </section>

      <section class="card-base p-6">
        <h2 class="section-title mb-4">Media resources</h2>
        <ul class="space-y-3 text-secondary leading-relaxed">
          <li><a href="/reliability/report" class="text-accent hover:underline">Monthly reliability dataset report</a> — the numbers behind the Hall-effect angle.</li>
          <li><a href="/test/methodology" class="text-accent hover:underline">Testing methodology</a> — what browser tests can and cannot measure.</li>
          <li><a href="/reliability" class="text-accent hover:underline">Reliability hub</a> — per-model baselines.</li>
          <li><a href="/games" class="text-accent hover:underline">Browser gamepad arcade</a> — playable demonstration of input precision.</li>
          <li><a href="/embeds" class="text-accent hover:underline">Embeds &amp; widgets</a> — iframe widgets with attribution backlinks.</li>
        </ul>
        <p class="text-tertiary text-sm mt-6">
          For interviews, data access, or review codes: <a href="mailto:press@controllertesting.com" class="text-accent hover:underline">press@controllertesting.com</a>.
          We answer data questions with data.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .inline-code { font-family: var(--font-mono); font-size: 0.875rem; background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: 4px; padding: 0.1em 0.35em; }
</style>
