  if (url.includes('/latency')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-lat" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#EF4444"/></linearGradient></defs><circle cx="12" cy="13" r="8" stroke="url(#g-lat)" stroke-width="2"/><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" fill="url(#g-lat)" fill-opacity="0.3" stroke="#F59E0B" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
  if (url.includes('/multi')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-multi" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6366F1"/><stop offset="100%" stop-color="#A855F7"/></linearGradient></defs><rect x="2" y="3" width="9" height="8" rx="2" fill="url(#g-multi)" fill-opacity="0.2" stroke="url(#g-multi)" stroke-width="2"/><rect x="13" y="3" width="9" height="8" rx="2" fill="url(#g-multi)" fill-opacity="0.2" stroke="url(#g-multi)" stroke-width="2"/><rect x="2" y="13" width="9" height="8" rx="2" fill="url(#g-multi)" fill-opacity="0.2" stroke="url(#g-multi)" stroke-width="2"/><rect x="13" y="13" width="9" height="8" rx="2" fill="url(#g-multi)" fill-opacity="0.2" stroke="url(#g-multi)" stroke-width="2"/></svg>`;
  if (url.includes('/timeline')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-tl" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#10B981"/><stop offset="100%" stop-color="#3B82F6"/></linearGradient></defs><path d="M3 3v18h18" stroke="url(#g-tl)" stroke-width="2" stroke-linecap="round"/><path d="M7 16l4-4 4 2 5-7" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="16" r="2" fill="#10B981"/><circle cx="11" cy="12" r="2" fill="#10B981"/><circle cx="15" cy="14" r="2" fill="#3B82F6"/><circle cx="20" cy="7" r="2" fill="#3B82F6"/></svg>`;
  if (url.includes('/gyroscope')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-gyro" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#38BDF8"/><stop offset="100%" stop-color="#C084FC"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#g-gyro)" stroke-width="2"/><ellipse cx="12" cy="12" rx="9" ry="3" stroke="#38BDF8" stroke-width="1.5" transform="rotate(45 12 12)"/><circle cx="12" cy="12" r="3" fill="#C084FC"/></svg>`;
  if (url.includes('/touchpad')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-touch" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#2563EB"/><stop offset="100%" stop-color="#38BDF8"/></linearGradient></defs><rect x="3" y="5" width="18" height="14" rx="3" fill="url(#g-touch)" fill-opacity="0.2" stroke="url(#g-touch)" stroke-width="2"/><circle cx="9" cy="12" r="2" fill="#38BDF8"/><circle cx="15" cy="12" r="2" fill="#60A5FA"/></svg>`;
  if (url.includes('/microphone')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-mic" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#EC4899"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient></defs><rect x="9" y="3" width="6" height="11" rx="3" fill="url(#g-mic)" fill-opacity="0.2" stroke="url(#g-mic)" stroke-width="2"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8" stroke="#EC4899" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (url.includes('/competitive-readiness')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-esports" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#FBBF24"/></linearGradient></defs><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34M18 4H6v7a6 6 0 0 0 12 0V4z" fill="url(#g-esports)" fill-opacity="0.2" stroke="url(#g-esports)" stroke-width="2" stroke-linejoin="round"/></svg>`;
  return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-def" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#60A5FA"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="6" fill="url(#g-def)" fill-opacity="0.2" stroke="url(#g-def)" stroke-width="2"/></svg>`;
}
---
<BaseLayout 
  title="Testing Toolkit | 32+ Diagnostic Tools for Controller & Mouse"
  description="The world's most comprehensive hardware testing toolkit. Diagnose stick drift, polling rate, circularity, and latency. Used by 142,850+ players."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(toolsSchema)} />

  <Header />
  
  <main class="toolkit-page relative min-h-screen overflow-hidden bg-[var(--color-bg-base)]">
    {/* Abstract Premium Background Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.12),transparent_70%)] pointer-events-none"></div>
    <div class="absolute top-[20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-accent/10 blur-[120px] pointer-events-none mix-blend-screen"></div>
    <div class="absolute top-[40%] right-[-10%] w-[600px] h-[600px] rounded-full bg-accent/10 blur-[150px] pointer-events-none mix-blend-screen"></div>

    <div class="container-site toolkit-container relative z-10">
      <div class="toolkit-breadcrumbs">
        <Breadcrumbs items={breadcrumbs} />
      </div>
      
      <header class="toolkit-hero max-w-3xl">
        <div class="telemetry-badge inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border-default)] shadow-sm mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent)]"></span>
          </span>
          <span class="text-xs font-bold tracking-widest uppercase text-[var(--color-text-secondary)]">142,850+ Controllers Tested Globally</span>
        </div>
        
        <h1 class="text-hero mb-6">
          Diagnostic<br/><span class="text-gradient">Testing Toolkit</span>
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl font-medium">
          The most comprehensive, privacy-first diagnostic suite available in the browser. 
          No downloads required. Hardware telemetry powers our empirical reliability database.
        </p>
      </header>

      <div class="toolkit-sections-wrapper">
        {/* Controller Suite */}
        <section class="toolkit-section">
          <div class="section-header border-b border-[var(--color-border-subtle)] pb-6 mb-8">
            <h2 class="text-h2 mb-2">Controller & Peripheral Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-base font-medium">The definitive suite for gamepads, flight sticks, racing wheels, and MIDI.</p>
          </div>
          <div class="grid-tools">
            {controllerTools.map(tool => (
              <a href={tool.url} class={`tool-hub-card card-hover ${tool.badge === 'Flagship' ? 'card-gradient' : 'card-base'}`}>
                <div class="card-top-bar">
                  <div class="card-icon" set:html={getToolIconSvg(tool.url)} />
                  {tool.badge && <span class="badge-tag">{tool.badge}</span>}
                </div>
                <h3 class="text-h3">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <span class="btn-icon-wrap w-6 h-6"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
                </span>
              </a>
            ))}
          </div>
        </section>

        {/* Mouse Suite */}
        <section class="toolkit-section">
          <div class="section-header border-b border-[var(--color-border-subtle)] pb-6">
            <h2 class="text-h2 mb-3">Mouse & Keyboard Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-lg font-medium">High-precision polling rate and latency checkers for competitive peripherals.</p>
          </div>
          <div class="grid-tools">
            {mouseTools.map(tool => (
              <a href={tool.url} class="tool-hub-card card-hover card-base">
                <div class="card-top-bar">
                  <div class="card-icon" set:html={getToolIconSvg(tool.url)} />
                </div>
                <h3 class="text-h3">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <span class="btn-icon-wrap w-6 h-6"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
                </span>
              </a>
            ))}
          </div>
        </section>

        {/* Specialized Suite */}
        <section class="toolkit-section">
          <div class="section-header border-b border-[var(--color-border-subtle)] pb-6">
            <h2 class="text-h2 mb-3">High-SEA Programmatic Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-lg font-medium">Advanced physics, spatial audio, and aim-training sandbox engines.</p>
          </div>
          <div class="grid-tools">
            {specializedTools.map(tool => (
              <a href={tool.url} class="tool-hub-card card-hover card-base">
                <div class="card-top-bar">
                  <div class="card-icon" set:html={getToolIconSvg(tool.url)} />
                </div>
                <h3 class="text-h3">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <span class="btn-icon-wrap w-6 h-6"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <section class="toolkit-footer border-t border-[var(--color-border-subtle)]">
        <div class="toolkit-footer-card bg-[var(--color-surface-1)] border border-[var(--color-border-default)] group shadow-sm">
            <h3 class="text-h3 relative z-10 mb-4">Embed these tools</h3>
          <p class="text-[var(--color-text-secondary)] relative z-10 text-lg font-medium mb-8">Get free gamepad testing widgets for your website. Easy to integrate, fully responsive, and zero dependencies.</p>
          <a href="/embeds" class="btn-primary relative z-10 shadow-md">
            Explore Widgets
            <span class="btn-icon-wrap w-6 h-6"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </a>
        </div>
        
        <div class="toolkit-footer-card bg-[var(--color-surface-2)] border border-[var(--color-border-default)] group shadow-sm">
          <h3 class="text-h3 relative z-10 mb-4">Need a New Tool?</h3>
          <p class="text-[var(--color-text-secondary)] relative z-10 text-lg font-medium mb-8">We're constantly expanding our dataset and toolkit. If you need a specific tool, let us know.</p>
          <a href="/contact" class="btn-secondary relative z-10">
            Submit Feedback
            <span class="btn-icon-wrap w-6 h-6"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .toolkit-page {
    padding-top: 120px;
    padding-bottom: 80px;
  }
  .toolkit-container {
    padding-top: 2rem;
    padding-bottom: 6rem;
  }
  .toolkit-hero {
    margin-bottom: 5rem;
  }
  .toolkit-breadcrumbs {
    margin-bottom: 3rem;
  }
  .toolkit-sections-wrapper {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }
  .section-header {
    margin-bottom: 3rem;
  }
  .toolkit-footer {
    margin-top: 8rem;
    padding-top: 4rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .toolkit-footer-card {
    position: relative;
    border-radius: 2rem;
    padding: 2.5rem;
    overflow: hidden;
  }
  /* Local styling rules in case some CSS global classes were missing. We strictly use container-site. */
  .grid-tools {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    width: 100%;
  }

  .tool-hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-lg, 1.25rem);
    transition: transform var(--duration-fast) var(--ease-smooth), box-shadow var(--duration-fast) var(--ease-smooth), border-color var(--duration-fast) var(--ease-smooth);
  }

  .tool-hub-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    transition: transform 0.3s ease;
  }
  
  .tool-hub-card:hover .card-icon {
    transform: scale(1.1) rotate(5deg);
    color: var(--color-accent);
  }

  .badge-tag {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: rgba(37, 99, 235, 0.15);
    color: var(--color-accent);
    padding: 0.2em 0.55em;
    border-radius: 3px;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }


  .card-tool-desc {
    font-size: var(--text-small, 0.875rem);
    color: var(--color-text-secondary);
    line-height: 1.5;
    flex-grow: 1;
  }

  .card-action-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small, 0.875rem);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 0.25rem;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  
  .tool-hub-card:hover .card-action-link {
    opacity: 1;
  }
</style>
