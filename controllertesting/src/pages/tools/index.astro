---
/**
 * src/pages/tools/index.astro
 * Master Testing Toolkit Hub
 * SEO optimized and aligned with Data Authority pivot.
 * UPGRADED: Multi-Million Dollar Premium UI
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Diagnostic Toolkit' }
];

const toolsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Diagnostic Testing Toolkit',
  'description': 'The complete suite of diagnostic tools for controllers, mice, and specialized peripherals.',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'url': 'https://controllertesting.com/test/controller/full-diagnostic', 'name': 'Full Diagnostic Wizard' },
    { '@type': 'ListItem', 'position': 2, 'url': 'https://controllertesting.com/test/controller/drift', 'name': 'Stick Drift Detector' },
    { '@type': 'ListItem', 'position': 3, 'url': 'https://controllertesting.com/test/controller/polling-rate', 'name': 'Polling Rate Checker' },
    { '@type': 'ListItem', 'position': 4, 'url': 'https://controllertesting.com/test/controller/circularity', 'name': 'Circularity Test' },
    { '@type': 'ListItem', 'position': 5, 'url': 'https://controllertesting.com/test/controller/ps-calibration', 'name': 'PS Controller WebHID Calibration' }
  ]
};

const controllerTools = [
  { name: 'Full Diagnostic Wizard', url: '/test/controller/full-diagnostic', desc: '5-step hardware checkup wizard.', icon: '⚡' },
  { name: 'Stick Drift Detector', url: '/test/controller/drift', desc: '0.1% stick drift canvas visualizer.', icon: '🎯' },
  { name: 'Controller Health Score™', url: '/test/controller/health-score', desc: '0-100 grade & printable PDF report card.', icon: '📈' },
  { name: 'Nintendo Switch Tester & Repair', url: '/test/controller/nintendo-switch', desc: 'Joy-Con drift tester and Hall-effect replacement guide.', icon: '🔴' },
  { name: 'PS Controller WebHID Calibration', url: '/test/controller/ps-calibration', desc: 'Low-level WebHID zero-point sampling & firmware save.', icon: '🔧' },
  { name: 'Steering Wheel & Pedals', url: '/test/controller/steering-wheel', desc: '900°/1080° rotation disc & Throttle/Brake/Clutch linearity.', icon: '🏎️' },
  { name: 'Fight Stick & Hitbox', url: '/test/controller/fight-stick', desc: 'Vewlix 8-button layout & Capcom SOCD cleaner rule check.', icon: '🕹️' },
  { name: 'Flight Stick & HOTAS', url: '/test/controller/flight-stick', desc: 'Pitch/roll/yaw, 128+ buttons & throttle quadrant.', icon: '✈️' },
  { name: 'MIDI Keyboard & Controller', url: '/test/midi', desc: 'Web MIDI API note events, velocity (0-127) & CC messages.', icon: '🎹' },
  { name: 'Button Tester', url: '/test/controller/buttons', desc: 'Interactive face button matrix & ghosting detector.', icon: '⏺️' },
  { name: 'Trigger Pressure Tester', url: '/test/controller/triggers', desc: 'Analog L2/R2 pressure curve analyzer.', icon: '🕹️' },
  { name: 'Vibration Tester', url: '/test/controller/vibration', desc: 'Dual haptic rumble motor pulse tester.', icon: '📳' },
  { name: 'Circularity Test', url: '/test/controller/circularity', desc: '360-degree stick range of motion & error.', icon: '⭕' },
  { name: 'Deadzone Visualizer', url: '/test/controller/deadzone', desc: 'Inner & outer deadzone threshold tuning.', icon: '⚫' },
  { name: 'Polling Rate Checker', url: '/test/controller/polling-rate', desc: 'Real-time Hz input report frequency.', icon: '⏱️' },
  { name: '8-Way D-Pad Tester', url: '/test/controller/dpad', desc: 'Directional pad diagonal precision.', icon: '➕' },
  { name: 'Latency Estimator', url: '/test/controller/latency', desc: 'Input delay & reaction speed timer.', icon: '⚡' },
  { name: 'Multi-Controller Tester', url: '/test/controller/multi', desc: '4 gamepads simultaneous diagnostic.', icon: '👥' },
  { name: 'Drift Timeline Tracker', url: '/test/controller/timeline', desc: 'LocalStorage hardware degradation tracker.', icon: '📊' },
  { name: 'Gyroscope Tester', url: '/test/controller/gyroscope', desc: '3-axis motion sensor calibration.', icon: '🧭' },
  { name: 'Touchpad Tester', url: '/test/controller/touchpad', desc: 'PS5 DualSense multi-touch trackpad.', icon: '👆' },
  { name: 'Microphone Tester', url: '/test/controller/microphone', desc: 'Built-in mic & 3.5mm headset audio meter.', icon: '🎤' },
  { name: 'Competitive Readiness', url: '/test/controller/competitive-readiness', desc: 'Esports tournament benchmark assessor.', icon: '🏆' },
];

const mouseTools = [
  { name: 'CPS Test', url: '/test/mouse/cps', desc: 'Clicks per second speed tester.', icon: '🖱️' },
  { name: 'Mouse Polling Rate (Hz)', url: '/test/mouse/polling-rate', desc: 'Up to 8000Hz (8KHz) report rate checker.', icon: '⚡' },
  { name: 'DPI Analyzer', url: '/test/mouse/dpi', desc: 'True hardware DPI sensitivity calculator.', icon: '🎯' },
  { name: 'Click Latency Test', url: '/test/mouse/click-latency', desc: 'Click delay timer in ms.', icon: '⏱️' },
  { name: 'Mouse Button Matrix', url: '/test/mouse/buttons', desc: 'MB1, MB2, MB3, MB4, MB5 side buttons.', icon: '⏺️' },
  { name: 'Scroll Wheel Tester', url: '/test/mouse/scroll', desc: 'Scroll direction & encoder jumping faults.', icon: '↕️' },
  { name: 'Double-Click Fault Test', url: '/test/mouse/double-click', desc: 'Switch bounce & chatter detector.', icon: '⚠️' },
  { name: 'Mouse Hub Index', url: '/test/mouse/', desc: 'Master dashboard for mouse diagnostics.', icon: '📋' },
];

const specializedTools = [
  { name: 'Pro-Aim Sandbox', url: '/aim-trainer', desc: 'Canvas 2D stick drift & aim tracking benchmark.', icon: '🎯' },
  { name: 'Sens Converter Engine', url: '/sensitivity-converter', desc: '1:1 360-degree motor memory math engine.', icon: '🔄' },
  { name: 'Phantom Hz & Ghosting', url: '/hz-test', desc: 'Motion blur persistence & frame pacing analyzer.', icon: '👻' },
  { name: 'Sonic-Space Audio', url: '/audio-test', desc: 'Web Audio API 3D binaural radar & Bluetooth latency.', icon: '🔊' },
  { name: 'Mech-Matrix Keyboard', url: '/keyboard-tester', desc: '3D isometric keyboard visualizer with NKRO.', icon: '⌨️' },
];
---
<BaseLayout 
  title="Testing Toolkit | 32+ Diagnostic Tools for Controller & Mouse"
  description="The world's most comprehensive hardware testing toolkit. Diagnose stick drift, polling rate, circularity, and latency. Used by 142,850+ players."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(toolsSchema)} />

  <Header />
  
  <main class="toolkit-page relative bg-[#05050A] min-h-screen text-stone-200 overflow-hidden">
    {/* Abstract Premium Background Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-[radial-gradient(ellipse_at_top,rgba(59,130,246,0.15),transparent_70%)] pointer-events-none"></div>
    <div class="absolute top-[20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-600/10 blur-[120px] pointer-events-none mix-blend-screen"></div>
    <div class="absolute top-[40%] right-[-10%] w-[600px] h-[600px] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none mix-blend-screen"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-32 pb-24">
      <div class="mb-12">
        <Breadcrumbs items={breadcrumbs} />
      </div>
      
      <header class="toolkit-hero mb-24 max-w-3xl">
        <div class="telemetry-badge inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 mb-8 backdrop-blur-md">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-blue-500"></span>
          </span>
          <span class="text-xs font-bold tracking-widest uppercase text-blue-400">142,850+ Controllers Tested Globally</span>
        </div>
        
        <h1 class="text-5xl lg:text-7xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white via-stone-200 to-stone-500 mb-6 drop-shadow-sm">
          Diagnostic<br/>Testing Toolkit
        </h1>
        <p class="text-lg lg:text-xl text-stone-400 leading-relaxed max-w-2xl font-medium">
          The most comprehensive, privacy-first diagnostic suite available in the browser. 
          No downloads required. Hardware telemetry powers our empirical reliability database.
        </p>
      </header>

      <div class="space-y-32">
        {/* Controller Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-12">
            <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Controller & Peripheral Suite</h2>
            <p class="text-stone-400 text-lg">The definitive 22-tool suite for gamepads, flight sticks, racing wheels, and MIDI.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {controllerTools.map(tool => (
              <a href={tool.url} class="group relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:border-blue-500/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.2)] overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-500/0 via-transparent to-purple-500/0 group-hover:from-blue-500/10 group-hover:to-purple-500/10 transition-colors duration-500"></div>
                <div class="relative z-10 flex flex-col h-full">
                  <div class="w-12 h-12 rounded-2xl bg-black/40 border border-white/10 flex items-center justify-center text-2xl mb-6 shadow-inner group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500">
                    {tool.icon}
                  </div>
                  <h3 class="text-lg font-bold text-white mb-2 tracking-tight group-hover:text-blue-400 transition-colors">{tool.name}</h3>
                  <p class="text-sm text-stone-400 leading-relaxed font-medium">{tool.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        {/* Mouse Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-12">
            <h2 class="text-3xl font-bold tracking-tight text-white mb-3">Mouse & Keyboard Suite</h2>
            <p class="text-stone-400 text-lg">High-precision polling rate and latency checkers for competitive peripherals.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {mouseTools.map(tool => (
              <a href={tool.url} class="group relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:border-emerald-500/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.2)] overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/0 via-transparent to-cyan-500/0 group-hover:from-emerald-500/10 group-hover:to-cyan-500/10 transition-colors duration-500"></div>
                <div class="relative z-10 flex flex-col h-full">
                  <div class="w-12 h-12 rounded-2xl bg-black/40 border border-white/10 flex items-center justify-center text-2xl mb-6 shadow-inner group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500">
                    {tool.icon}
                  </div>
                  <h3 class="text-lg font-bold text-white mb-2 tracking-tight group-hover:text-emerald-400 transition-colors">{tool.name}</h3>
                  <p class="text-sm text-stone-400 leading-relaxed font-medium">{tool.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        {/* Specialized Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-12">
            <h2 class="text-3xl font-bold tracking-tight text-white mb-3">High-SEA Programmatic Suite</h2>
            <p class="text-stone-400 text-lg">Advanced physics, spatial audio, and aim-training sandbox engines.</p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {specializedTools.map(tool => (
              <a href={tool.url} class="group relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-6 transition-all duration-500 hover:-translate-y-2 hover:bg-white/10 hover:border-fuchsia-500/30 hover:shadow-[0_20px_40px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.2)] overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-fuchsia-500/0 via-transparent to-purple-500/0 group-hover:from-fuchsia-500/10 group-hover:to-purple-500/10 transition-colors duration-500"></div>
                <div class="relative z-10 flex flex-col h-full">
                  <div class="w-12 h-12 rounded-2xl bg-black/40 border border-white/10 flex items-center justify-center text-2xl mb-6 shadow-inner group-hover:scale-110 group-hover:rotate-3 transition-transform duration-500">
                    {tool.icon}
                  </div>
                  <h3 class="text-lg font-bold text-white mb-2 tracking-tight group-hover:text-fuchsia-400 transition-colors">{tool.name}</h3>
                  <p class="text-sm text-stone-400 leading-relaxed font-medium">{tool.desc}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>

      <section class="mt-32 pt-16 border-t border-white/10 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="relative bg-gradient-to-br from-blue-900/20 to-transparent border border-blue-500/20 rounded-[2rem] p-10 overflow-hidden group">
          <div class="absolute inset-0 bg-[url('/noise.png')] opacity-20 mix-blend-overlay"></div>
          <h3 class="text-2xl font-bold text-white mb-4 relative z-10">Embed these tools</h3>
          <p class="text-blue-200/70 mb-8 relative z-10 text-lg">Get free gamepad testing widgets for your website. Easy to integrate, fully responsive, and zero dependencies.</p>
          <a href="/embeds" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-blue-500 text-white font-bold hover:bg-blue-400 transition-colors relative z-10 shadow-[0_0_20px_rgba(59,130,246,0.4)]">Explore Widgets</a>
        </div>
        
        <div class="relative bg-gradient-to-br from-stone-800/40 to-transparent border border-white/10 rounded-[2rem] p-10 overflow-hidden group">
          <h3 class="text-2xl font-bold text-white mb-4 relative z-10">Need a New Tool?</h3>
          <p class="text-stone-400 mb-8 relative z-10 text-lg">We're constantly expanding our dataset and toolkit. If you need a specific tool, let us know.</p>
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-white/10 text-white font-bold hover:bg-white/20 border border-white/10 transition-colors relative z-10">Submit Feedback</a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
