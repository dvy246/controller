---
/**
 * src/pages/tools/index.astro
 * Master Testing Toolkit Hub
 * SEO optimized and aligned with Data Authority pivot.
 * UPGRADED: Multi-Million Dollar Premium UI
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Diagnostic Toolkit' }
];

const toolsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Diagnostic Testing Toolkit',
  'description': 'The complete suite of diagnostic tools for controllers, mice, and specialized peripherals.',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'url': 'https://controllertesting.com/test/controller/full-diagnostic', 'name': 'Full Diagnostic Wizard' },
    { '@type': 'ListItem', 'position': 2, 'url': 'https://controllertesting.com/test/controller/drift', 'name': 'Stick Drift Detector' },
    { '@type': 'ListItem', 'position': 3, 'url': 'https://controllertesting.com/test/controller/polling-rate', 'name': 'Polling Rate Checker' },
    { '@type': 'ListItem', 'position': 4, 'url': 'https://controllertesting.com/test/controller/circularity', 'name': 'Circularity Test' },
    { '@type': 'ListItem', 'position': 5, 'url': 'https://controllertesting.com/test/controller/ps-calibration', 'name': 'PS Controller WebHID Calibration' }
  ]
};

const controllerTools = [
  { name: 'Full Diagnostic Wizard', url: '/test/controller/full-diagnostic', desc: '5-step hardware checkup wizard.', icon: '⚡', badge: 'Flagship' },
  { name: 'Stick Drift Detector', url: '/test/controller/drift', desc: '0.1% stick drift canvas visualizer.', icon: '🎯', badge: 'High Priority' },
  { name: 'Controller Health Score™', url: '/test/controller/health-score', desc: '0-100 grade & printable PDF report card.', icon: '📈', badge: 'Flagship' },
  { name: 'Nintendo Switch Tester & Repair', url: '/test/controller/nintendo-switch', desc: 'Joy-Con drift tester and Hall-effect replacement guide.', icon: '🔴' },
  { name: 'PS Controller WebHID Calibration', url: '/test/controller/ps-calibration', desc: 'Low-level WebHID zero-point sampling & firmware save.', icon: '🔧', badge: 'Flagship' },
  { name: 'Steering Wheel & Pedals', url: '/test/controller/steering-wheel', desc: '900°/1080° rotation disc & Throttle/Brake/Clutch linearity.', icon: '🏎️' },
  { name: 'Fight Stick & Hitbox', url: '/test/controller/fight-stick', desc: 'Vewlix 8-button layout & Capcom SOCD cleaner rule check.', icon: '🕹️' },
  { name: 'Flight Stick & HOTAS', url: '/test/controller/flight-stick', desc: 'Pitch/roll/yaw, 128+ buttons & throttle quadrant.', icon: '✈️' },
  { name: 'MIDI Keyboard & Controller', url: '/test/midi', desc: 'Web MIDI API note events, velocity (0-127) & CC messages.', icon: '🎹' },
  { name: 'Button Tester', url: '/test/controller/buttons', desc: 'Interactive face button matrix & ghosting detector.', icon: '⏺️' },
  { name: 'Trigger Pressure Tester', url: '/test/controller/triggers', desc: 'Analog L2/R2 pressure curve analyzer.', icon: '🕹️' },
  { name: 'Vibration Tester', url: '/test/controller/vibration', desc: 'Dual haptic rumble motor pulse tester.', icon: '📳' },
  { name: 'Circularity Test', url: '/test/controller/circularity', desc: '360-degree stick range of motion & error.', icon: '⭕' },
  { name: 'Deadzone Visualizer', url: '/test/controller/deadzone', desc: 'Inner & outer deadzone threshold tuning.', icon: '⚫' },
  { name: 'Polling Rate Checker', url: '/test/controller/polling-rate', desc: 'Real-time Hz input report frequency.', icon: '⏱️' },
  { name: '8-Way D-Pad Tester', url: '/test/controller/dpad', desc: 'Directional pad diagonal precision.', icon: '➕' },
  { name: 'Latency Estimator', url: '/test/controller/latency', desc: 'Input delay & reaction speed timer.', icon: '⚡' },
  { name: 'Multi-Controller Tester', url: '/test/controller/multi', desc: '4 gamepads simultaneous diagnostic.', icon: '👥' },
  { name: 'Drift Timeline Tracker', url: '/test/controller/timeline', desc: 'LocalStorage hardware degradation tracker.', icon: '📊' },
  { name: 'Gyroscope Tester', url: '/test/controller/gyroscope', desc: '3-axis motion sensor calibration.', icon: '🧭' },
  { name: 'Touchpad Tester', url: '/test/controller/touchpad', desc: 'PS5 DualSense multi-touch trackpad.', icon: '👆' },
  { name: 'Microphone Tester', url: '/test/controller/microphone', desc: 'Built-in mic & 3.5mm headset audio meter.', icon: '🎤' },
  { name: 'Competitive Readiness', url: '/test/controller/competitive-readiness', desc: 'Esports tournament benchmark assessor.', icon: '🏆' },
];

const mouseTools = [
  { name: 'CPS Test', url: '/test/mouse/cps', desc: 'Clicks per second speed tester.', icon: '🖱️' },
  { name: 'Mouse Polling Rate (Hz)', url: '/test/mouse/polling-rate', desc: 'Up to 8000Hz (8KHz) report rate checker.', icon: '⚡' },
  { name: 'DPI Analyzer', url: '/test/mouse/dpi', desc: 'True hardware DPI sensitivity calculator.', icon: '🎯' },
  { name: 'Click Latency Test', url: '/test/mouse/click-latency', desc: 'Click delay timer in ms.', icon: '⏱️' },
  { name: 'Mouse Button Matrix', url: '/test/mouse/buttons', desc: 'MB1, MB2, MB3, MB4, MB5 side buttons.', icon: '⏺️' },
  { name: 'Scroll Wheel Tester', url: '/test/mouse/scroll', desc: 'Scroll direction & encoder jumping faults.', icon: '↕️' },
  { name: 'Double-Click Fault Test', url: '/test/mouse/double-click', desc: 'Switch bounce & chatter detector.', icon: '⚠️' },
  { name: 'Mouse Hub Index', url: '/test/mouse/', desc: 'Master dashboard for mouse diagnostics.', icon: '📋' },
];

const specializedTools = [
  { name: 'Pro-Aim Sandbox', url: '/aim-trainer', desc: 'Canvas 2D stick drift & aim tracking benchmark.', icon: '🎯' },
  { name: 'Sens Converter Engine', url: '/sensitivity-converter', desc: '1:1 360-degree motor memory math engine.', icon: '🔄' },
  { name: 'Phantom Hz & Ghosting', url: '/hz-test', desc: 'Motion blur persistence & frame pacing analyzer.', icon: '👻' },
  { name: 'Sonic-Space Audio', url: '/audio-test', desc: 'Web Audio API 3D binaural radar & Bluetooth latency.', icon: '🔊' },
  { name: 'Mech-Matrix Keyboard', url: '/keyboard-tester', desc: '3D isometric keyboard visualizer with NKRO.', icon: '⌨️' },
];
---
<BaseLayout 
  title="Testing Toolkit | 32+ Diagnostic Tools for Controller & Mouse"
  description="The world's most comprehensive hardware testing toolkit. Diagnose stick drift, polling rate, circularity, and latency. Used by 142,850+ players."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(toolsSchema)} />

  <Header />
  
  <main class="toolkit-page relative min-h-screen overflow-hidden bg-[var(--color-bg-base)]">
    {/* Abstract Premium Background Glows */}
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-[radial-gradient(ellipse_at_top,rgba(37,99,235,0.12),transparent_70%)] pointer-events-none"></div>
    <div class="absolute top-[20%] left-[-10%] w-[500px] h-[500px] rounded-full bg-purple-600/10 blur-[120px] pointer-events-none mix-blend-screen"></div>
    <div class="absolute top-[40%] right-[-10%] w-[600px] h-[600px] rounded-full bg-blue-600/10 blur-[150px] pointer-events-none mix-blend-screen"></div>

    <div class="container-site relative z-10 pt-32 pb-24">
      <div class="mb-12">
        <Breadcrumbs items={breadcrumbs} />
      </div>
      
      <header class="toolkit-hero mb-20 max-w-3xl">
        <div class="telemetry-badge inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-[var(--color-surface-2)] border border-[var(--color-border-default)] mb-8 shadow-sm">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent)] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent)]"></span>
          </span>
          <span class="text-xs font-bold tracking-widest uppercase text-[var(--color-text-secondary)]">142,850+ Controllers Tested Globally</span>
        </div>
        
        <h1 class="text-5xl lg:text-7xl font-black tracking-tighter text-[var(--color-text-primary)] mb-6 drop-shadow-sm">
          Diagnostic<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[#60A5FA]">Testing Toolkit</span>
        </h1>
        <p class="text-lg lg:text-xl text-[var(--color-text-secondary)] leading-relaxed max-w-2xl font-medium">
          The most comprehensive, privacy-first diagnostic suite available in the browser. 
          No downloads required. Hardware telemetry powers our empirical reliability database.
        </p>
      </header>

      <div class="space-y-32">
        {/* Controller Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-10 border-b border-[var(--color-border-subtle)] pb-6">
            <h2 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] mb-3">Controller & Peripheral Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-lg font-medium">The definitive 22-tool suite for gamepads, flight sticks, racing wheels, and MIDI.</p>
          </div>
          <div class="grid-tools">
            {controllerTools.map(tool => (
              <a href={tool.url} class={`tool-hub-card card-hover ${tool.badge === 'Flagship' ? 'card-gradient' : 'card-base'}`}>
                <div class="card-top-bar">
                  <div class="card-icon">
                    <span class="text-xl" aria-hidden="true">{tool.icon}</span>
                  </div>
                  {tool.badge && <span class="badge-tag">{tool.badge}</span>}
                </div>
                <h3 class="card-tool-name">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            ))}
          </div>
        </section>

        {/* Mouse Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-10 border-b border-[var(--color-border-subtle)] pb-6">
            <h2 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] mb-3">Mouse & Keyboard Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-lg font-medium">High-precision polling rate and latency checkers for competitive peripherals.</p>
          </div>
          <div class="grid-tools">
            {mouseTools.map(tool => (
              <a href={tool.url} class="tool-hub-card card-hover card-base">
                <div class="card-top-bar">
                  <div class="card-icon">
                    <span class="text-xl" aria-hidden="true">{tool.icon}</span>
                  </div>
                </div>
                <h3 class="card-tool-name">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            ))}
          </div>
        </section>

        {/* Specialized Suite */}
        <section class="toolkit-section">
          <div class="section-header mb-10 border-b border-[var(--color-border-subtle)] pb-6">
            <h2 class="text-3xl font-bold tracking-tight text-[var(--color-text-primary)] mb-3">High-SEA Programmatic Suite</h2>
            <p class="text-[var(--color-text-secondary)] text-lg font-medium">Advanced physics, spatial audio, and aim-training sandbox engines.</p>
          </div>
          <div class="grid-tools">
            {specializedTools.map(tool => (
              <a href={tool.url} class="tool-hub-card card-hover card-base">
                <div class="card-top-bar">
                  <div class="card-icon">
                    <span class="text-xl" aria-hidden="true">{tool.icon}</span>
                  </div>
                </div>
                <h3 class="card-tool-name">{tool.name}</h3>
                <p class="card-tool-desc">{tool.desc}</p>
                <span class="card-action-link">
                  Run test
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            ))}
          </div>
        </section>
      </div>

      <section class="mt-32 pt-16 border-t border-[var(--color-border-subtle)] grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="relative bg-[var(--color-surface-1)] border border-[var(--color-border-default)] rounded-[2rem] p-10 overflow-hidden group shadow-sm">
          <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay"></div>
          <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-4 relative z-10">Embed these tools</h3>
          <p class="text-[var(--color-text-secondary)] mb-8 relative z-10 text-lg font-medium">Get free gamepad testing widgets for your website. Easy to integrate, fully responsive, and zero dependencies.</p>
          <a href="/embeds" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[var(--color-accent)] text-white font-bold hover:bg-[var(--color-accent-hover)] transition-colors relative z-10 shadow-md">Explore Widgets</a>
        </div>
        
        <div class="relative bg-[var(--color-surface-2)] border border-[var(--color-border-default)] rounded-[2rem] p-10 overflow-hidden group shadow-sm">
          <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-4 relative z-10">Need a New Tool?</h3>
          <p class="text-[var(--color-text-secondary)] mb-8 relative z-10 text-lg font-medium">We're constantly expanding our dataset and toolkit. If you need a specific tool, let us know.</p>
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[var(--color-surface-3)] text-[var(--color-text-primary)] font-bold hover:bg-[var(--color-surface-4)] border border-[var(--color-border-default)] transition-colors relative z-10">Submit Feedback</a>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Local styling rules in case some CSS global classes were missing. We strictly use container-site. */
  .grid-tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    width: 100%;
  }

  .tool-hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    text-decoration: none;
    cursor: pointer;
    border-radius: var(--radius-lg, 1.25rem);
    transition: all 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .tool-hub-card:hover {
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    transition: transform 0.3s ease;
  }
  
  .tool-hub-card:hover .card-icon {
    transform: scale(1.1) rotate(5deg);
    color: var(--color-accent);
  }

  .badge-tag {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: rgba(37, 99, 235, 0.15);
    color: var(--color-accent);
    padding: 0.2em 0.55em;
    border-radius: 3px;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .card-tool-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .card-tool-desc {
    font-size: var(--text-small, 0.875rem);
    color: var(--color-text-secondary);
    line-height: 1.5;
    flex-grow: 1;
  }

  .card-action-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small, 0.875rem);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 0.25rem;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  
  .tool-hub-card:hover .card-action-link {
    opacity: 1;
  }
</style>
