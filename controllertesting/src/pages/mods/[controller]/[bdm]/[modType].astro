---
/**
 * /mods/[controller]/[bdm]/[modType] — Programmatic Long-Tail Mod Guide & Compatibility Page
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import WebHIDBDMDetector from '@components/tools/controller/WebHIDBDMDetector.astro';
import ModBuilderWorkspace from '@components/tools/controller/ModBuilderWorkspace.astro';
import modsData from '@data/modsData.json';

export interface Props {
  controller: {
    id: string;
    name: string;
    slug: string;
    description: string;
    imageUrl: string;
    motherboards: Array<{
      id: string;
      name: string;
      identifiers: string[];
      fccId?: string;
      identificationGuide: string;
      characteristics?: string[];
    }>;
  };
  bdm: {
    id: string;
    name: string;
    identifiers: string[];
    fccId?: string;
    identificationGuide: string;
    characteristics?: string[];
  };
  category: {
    id: string;
    name: string;
    description: string;
    icon?: string;
  };
  matchingMods: Array<any>;
}

export function getStaticPaths() {
  const paths: any[] = [];

  modsData.controllers.forEach((controller) => {
    controller.motherboards.forEach((bdm) => {
      modsData.modCategories.forEach((category) => {
        // Only generate page if there are matching mods for this exact combination
        const matchingMods = modsData.mods.filter((m) => 
          m.controllerId === controller.id && 
          m.categoryId === category.id && 
          m.compatibleMotherboards.includes(bdm.id)
        );

        if (matchingMods.length > 0) {
          paths.push({
            params: { 
              controller: controller.id, 
              bdm: bdm.id, 
              modType: category.id 
            },
            props: { 
              controller, 
              bdm, 
              category, 
              matchingMods 
            },
          });
        }
      });
    });
  });

  return paths;
}

const { controller, bdm, category, matchingMods } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Mod & Repair Builder', url: '/mods' },
  { name: controller.name, url: `/mods/${controller.id}` },
  { name: `${bdm.name} ${category.name}` }
];

const title = `Best ${category.name} for ${controller.name} (${bdm.name}) | Compatibility Guide`;
const description = `Guaranteed compatible ${category.name.toLowerCase()} for ${controller.name} motherboard revision ${bdm.name}. Compare prices, difficulty, and soldering requirements.`;

const faqs = [
  {
    question: `Are these ${category.name.toLowerCase()} guaranteed to fit my ${bdm.name} controller?`,
    answer: `Yes. Every part featured on this page has been verified to match the specific circuit traces, ribbon cable pitch, and internal housing brackets of the ${bdm.name} revision.`
  },
  {
    question: `How do I confirm my controller is definitely a ${bdm.name}?`,
    answer: `${bdm.identificationGuide} You can also connect your controller via USB to run the WebHID auto-detector above.`
  },
  {
    question: `What tools do I need to install ${category.name.toLowerCase()} on a ${bdm.name}?`,
    answer: `Most kits require a PH00 Phillips screwdriver, plastic prying pry tools, and tweezers. If installing Hall Effect joysticks, a soldering iron, desoldering pump/wick, and solder flux are also required.`
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": title,
    "description": description,
    "url": `https://controllertesting.com/mods/${controller.id}/${bdm.id}/${category.id}`
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];

const technicalInstallGuides: Record<string, Record<string, {
  summary: string;
  pcbNuance: string;
  solderingTips: string;
  pitfalls: string[];
}>> = {
  'ps5-dualsense': {
    'bdm-010': {
      summary: 'Launch BDM-010 circuit boards feature a high-thermal-mass ground plane, wide 23-pin flexible printed circuits, and heavy-gauge 0.35mm trigger return springs.',
      pcbNuance: 'Motherboard uses a wide 23-pin bus linking the midframe assembly. Trigger torsion springs are heavy-gauge 0.35mm piano wire with wide retention pins.',
      solderingTips: 'Ground pins on potentiometer legs connect directly to thick copper planes. Preheating the board to 140°C or using a 360°C chisel tip with active flux prevents barrel pad lifting.',
      pitfalls: ['Do not attempt to use narrow 16-pin ribbons from BDM-030 or BDM-040 models', 'Fragile plastic microphone alignment pegs on the front housing must be lifted vertically']
    },
    'bdm-020': {
      summary: 'BDM-020 revised boards feature reduced copper ground plane thickness, refined 0.30mm trigger return springs, and integrated silicone dampeners.',
      pcbNuance: 'Sony reduced solder volume on trigger motor tabs. The touchpad bracket incorporates molded silicone damping pads to prevent rattling.',
      solderingTips: 'Copper trace layers are thinner than BDM-010. Keep soldering iron contact time strictly under 3 seconds per pin at 330°C to preserve through-hole copper barrels.',
      pitfalls: ['Microphone flex cable connector is a narrower 12-pin layout requiring delicate tweezers', 'Avoid mixing BDM-010 trigger return springs as travel resistance will feel uneven']
    },
    'bdm-030': {
      summary: 'BDM-030 represents a major internal architecture overhaul featuring a 16-pin daughterboard layout and miniaturized adaptive trigger gearboxes.',
      pcbNuance: 'Uses a 16-pin flex interconnect. Adaptive trigger motor housings are miniaturized and physically incompatible with BDM-010/020 tactile trigger kits.',
      solderingTips: 'Test points for L3/R3 remap paddles are relocated near the MCU shielding edge. Always verify zero-point magnetic centering using WebHID after installing Hall Effect modules.',
      pitfalls: ['BDM-010/020 shell faceplates and midframes will not snap closed over BDM-030 internals', 'Trigger ribbon pinout has inverted ground reference lines compared to Gen 1']
    },
    'bdm-040': {
      summary: 'BDM-040 is the latest revision found in Slim and newer standard consoles, featuring updated PMIC silicon, snap-fit battery cradles, and surface-mount bumper switches.',
      pcbNuance: 'Features surface-mount tactile switches for L1/R1 bumpers and snap-fit battery cradle tabs. Hall Effect stick installs require sharing the clean 1.8V regulated analog rail.',
      solderingTips: 'Carefully route paddle remap wires away from the snap-in battery cradle perimeter to avoid wire pinch damage during final shell closure.',
      pitfalls: ['Do not overtighten the central PCB mounting screw to prevent board warping', 'Ensure tactile trigger kits are explicitly rated for BDM-040 clip tolerances']
    }
  },
  'xbox-series-x': {
    'model-1914': {
      summary: 'Model 1914 controllers utilize a modular split-board sandwich design connected via a 14-pin board-to-board header.',
      pcbNuance: 'Top board houses triggers, rumble motors, and the USB-C port; lower board contains sticks, MCU, and face buttons.',
      solderingTips: 'Desolder the 4 trigger rumble motor wires before separating the dual boards. Stick potentiometers are lead-free soldered; generous flux and desoldering braid or a motorized vacuum desoldering gun are essential.',
      pitfalls: ['Do not bend the 14-pin inter-board header connector pins during separation', 'Inspect D-pad tactile dome sticker alignment before snapping midframe back together']
    },
    'model-1708': {
      summary: 'Model 1708 Xbox One S controller uses Micro-USB with traditional dual-board sandwich construction.',
      pcbNuance: 'Single-piece front shell bezel with separate side grip panels concealing T8 security Torx screws.',
      solderingTips: 'Stick modules use 10k potentiometer wipers. Clean contact wipers with 99% isopropyl alcohol before reassembly.',
      pitfalls: ['Requires a T8 Security Torx driver with center hole for housing screws', 'Trigger rumble motor wires are delicate 32AWG gauge']
    }
  }
};

const guide = technicalInstallGuides[controller.id]?.[bdm.id];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schema} localized={false}>
  <Header />

  <main id="main-content" class="page-shell container-site">
    <Breadcrumbs items={breadcrumbs} />

    <!-- SEO Header Block -->
    <header class="page-header mb-8">
      <div class="badge-tag mb-3">{bdm.name} Compatibility Guide</div>
      <h1 class="page-title text-gradient">{category.name} for {controller.name} ({bdm.name})</h1>
      <p class="page-subtitle">
        Verified hardware compatibility guide and parts catalog. Upgrading your {controller.name} with {category.name.toLowerCase()} on the {bdm.name} motherboard architecture.
      </p>
    </header>

    <!-- Technical Analysis Bento Card -->
    <article class="p-6 sm:p-8 rounded-[24px] bg-[var(--color-surface-1)] border border-[var(--color-border-default)] mb-10">
      <div class="max-w-3xl">
        <h2 class="text-xl font-bold text-white mb-3">Motherboard Revision Specifications: {bdm.name}</h2>
        <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
          {bdm.identificationGuide}
        </p>

        {guide && (
          <div class="mt-6 pt-6 border-t border-[var(--color-border-subtle)]">
            <h3 class="text-base font-bold text-white mb-2">Engineering Teardown & PCB Analysis</h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
              {guide.summary}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
              <div class="p-3.5 rounded-xl bg-[var(--color-surface-0)] border border-[var(--color-border-subtle)]">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--color-accent)] block mb-1">PCB Architecture:</span>
                <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">{guide.pcbNuance}</p>
              </div>
              <div class="p-3.5 rounded-xl bg-[var(--color-surface-0)] border border-[var(--color-border-subtle)]">
                <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--color-emerald)] block mb-1">Soldering Notes:</span>
                <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">{guide.solderingTips}</p>
              </div>
            </div>
            <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-200">
              <strong class="font-bold text-amber-300 block mb-1">Revision-Specific Precautions:</strong>
              <ul class="list-disc list-inside space-y-1 text-amber-200/90">
                {guide.pitfalls.map((p: string) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </div>
        )}
        
        {bdm.characteristics && (
          <div class="p-4 rounded-xl bg-[var(--color-surface-0)] border border-[var(--color-border-subtle)] mb-4">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--color-accent)] mb-2">Key Hardware Characteristics:</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-[var(--color-text-secondary)]">
              {bdm.characteristics.map((char: string) => (
                <li class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-[var(--color-emerald)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{char}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="p-3.5 rounded-xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/20 text-xs text-[var(--color-text-primary)] flex items-start gap-2.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent)] shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>
            <strong>Compatibility Guarantee:</strong> All {matchingMods.length} components listed below have been verified for direct mechanical and electrical compatibility with {bdm.name} motherboards.
          </span>
        </div>
      </div>
    </article>

    <!-- Quick Revision Switcher -->
    <WebHIDBDMDetector controller={controller} activeBdm={bdm.id} />

    <!-- Mod Builder Workspace Filtered to this BDM -->
    <section class="mb-16">
      <ModBuilderWorkspace controllerId={controller.id} initialBdm={bdm.id} categoryFilter={category.id} strictFilter={true} />
    </section>

    <!-- FAQ Accordion -->
    <section class="mb-16">
      <h2 class="text-xl sm:text-2xl font-bold text-white mb-6 flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--color-accent)]"></span>
        Frequently Asked Questions
      </h2>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="group p-5 rounded-2xl bg-[var(--color-surface-1)] border border-[var(--color-border-default)] open:border-[var(--color-accent)]/50 transition-colors">
            <summary class="flex items-center justify-between font-bold text-white cursor-pointer list-none text-base">
              <span>{faq.question}</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180 text-[var(--color-text-tertiary)]"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-4 text-sm text-[var(--color-text-secondary)] leading-relaxed border-t border-[var(--color-border-subtle)] pt-4">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
