---
/**
 * /contact — Contact Us
 * SEO Title: Contact Us — ControllerTesting.com
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Contact Us' },
];

const contactChannels = [
  {
    title: 'General Support & Feedback',
    desc: 'Found a bug, have a question about controller compatibility, or need help with a diagnostic test?',
    email: 'support@controllertesting.com',
    response: '24–48 business hours',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="3" fill="#3B82F6" fill-opacity="0.2" stroke="#3B82F6" stroke-width="2"/><path d="M3 7l9 6 9-6" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Business & Widget Licensing',
    desc: 'Interested in embedding our diagnostic widgets, licensing WebHID calibration tools, or partnerships?',
    email: 'partnerships@controllertesting.com',
    response: '1–2 business days',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" fill="#10B981" fill-opacity="0.2" stroke="#10B981" stroke-width="2"/></svg>`,
  },
  {
    title: 'Press & Media Inquiries',
    desc: 'Journalists, hardware reviewers, and content creators looking for empirical wear telemetry data.',
    email: 'press@controllertesting.com',
    response: 'Same-day priority',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="#8B5CF6" stroke-width="2"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" fill="#8B5CF6" fill-opacity="0.2" stroke="#A855F7" stroke-width="2"/></svg>`,
  },
];
---

<BaseLayout
  title="Contact Us — ControllerTesting.com"
  description="Contact the ControllerTesting.com team for support, business inquiries, or to report an issue with our diagnostic tools."
  breadcrumbs={breadcrumbs}
  localized={false}
>
  <Header />

  <main id="main-content" class="pt-24 pb-20 bg-surface-0 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumbs -->
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <!-- Page Header -->
      <header class="mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono mb-4 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Direct Communication
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight mb-3">
          Contact Engineering & Support
        </h1>
        <p class="text-base sm:text-lg text-text-secondary max-w-2xl leading-relaxed">
          We're here to help with questions about controller diagnostics, hardware compatibility, bug reports, or partnership opportunities.
        </p>
      </header>

      <!-- 2-Column Split: Channels + Contact Form -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Direct Channels (Col 5) -->
        <div class="lg:col-span-5 space-y-4">
          {contactChannels.map((channel) => (
            <div class="rounded-xl bg-surface-1 border border-surface-2 p-6 hover:border-surface-3 transition-colors">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-9 h-9 rounded-lg bg-surface-2 border border-surface-3 flex items-center justify-center">
                  <Fragment set:html={channel.icon} />
                </div>
                <h2 class="text-base font-bold text-text-primary">
                  {channel.title}
                </h2>
              </div>
              <p class="text-xs text-text-secondary leading-relaxed mb-4">
                {channel.desc}
              </p>
              <div class="flex items-center justify-between text-xs border-t border-surface-2 pt-3">
                <a href={`mailto:${channel.email}`} class="font-mono text-blue-400 hover:underline">
                  {channel.email}
                </a>
                <span class="text-text-tertiary font-mono">
                  {channel.response}
                </span>
              </div>
            </div>
          ))}
        </div>

        <!-- Right: Interactive Form (Col 7) -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl bg-surface-1 border border-surface-2 p-6 sm:p-8">
            <h2 class="text-xl font-bold text-text-primary mb-2">Send Us a Direct Message</h2>
            <p class="text-xs text-text-secondary mb-6">Fill out the form below and our technical team will review your message.</p>

            <form class="space-y-5" action="mailto:support@controllertesting.com" method="post" enctype="text/plain">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-mono text-text-secondary uppercase mb-2">Your Name</label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="e.g. Alex Mercer"
                    class="w-full bg-surface-2 border border-surface-3 rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-blue-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-mono text-text-secondary uppercase mb-2">Email Address</label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="alex@example.com"
                    class="w-full bg-surface-2 border border-surface-3 rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-blue-500 transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="contact-subject" class="block text-xs font-mono text-text-secondary uppercase mb-2">Inquiry Type</label>
                <select
                  id="contact-subject"
                  name="subject"
                  class="w-full bg-surface-2 border border-surface-3 rounded-lg px-4 py-2.5 text-sm text-text-primary focus:outline-none focus:border-blue-500 transition-colors"
                >
                  <option value="bug">Report a Diagnostic Bug / Issue</option>
                  <option value="compatibility">Controller Hardware Compatibility Question</option>
                  <option value="licensing">Widget Embedding & Business Licensing</option>
                  <option value="press">Press & Data Telemetry Citation</option>
                  <option value="other">Other Inquiry</option>
                </select>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-mono text-text-secondary uppercase mb-2">Message</label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Describe your issue or inquiry in detail..."
                  class="w-full bg-surface-2 border border-surface-3 rounded-lg px-4 py-2.5 text-sm text-text-primary placeholder:text-text-tertiary focus:outline-none focus:border-blue-500 transition-colors resize-y"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full sm:w-auto btn-primary px-6 py-3 rounded-lg text-sm font-medium inline-flex items-center justify-center gap-2 cursor-pointer"
              >
                Send Message
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
