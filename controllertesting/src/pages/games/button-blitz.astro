---
/**
 * /games/button-blitz — Button Blitz Reaction Game
 * SEO Title: Button Blitz — Controller Button Reaction & Speed Game
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import ArcadeRewardsLine from '@components/games/ArcadeRewardsLine.astro';
import GameHowToPlay from '@components/games/GameHowToPlay.astro';
import InterlinkStrip from '@components/global/InterlinkStrip.astro';
import { resolveToolsForGame } from '@data/arcadeInterlinks';

const breadcrumbs = [
  { name: 'Games Arcade', url: '/games' },
  { name: 'Button Blitz' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Button Blitz Reaction Game',
  description: 'Fast-paced button reaction game for PS5, Xbox, and Switch gamepads.',
  gamePlatform: 'Web Browser',
};

const relatedTools = resolveToolsForGame('button-blitz');
---

<BaseLayout
  title="Button Blitz — Controller Button Reaction Game | ControllerTesting.com"
  description="Test your button reaction speed in Button Blitz. Press on-screen button prompts on your PS5, Xbox, or Switch controller."
  schema={schema}
  breadcrumbs={breadcrumbs}

  localized={true}>
  <Header />

  <main id="main-content" class="game-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="game-header">
        <span class="badge-tag">Reflex Challenge</span>
        <h1 class="game-title">Button Blitz Reaction Speed</h1>
        <p class="game-subtitle">
          Press the matching button the moment it appears on screen. That's your reaction speed.
        </p>
      </header>

      <div class="blitz-card card-base">
        <div class="blitz-prompt-box" id="blitz-prompt">
          <span class="prompt-text text-gradient" id="prompt-btn-name">PRESS START</span>
        </div>

        <div class="blitz-stats-bar">
          <div class="b-stat"><span class="b-label">SCORE</span><span class="b-val text-gradient" id="blitz-score">0</span></div>
          <div class="b-stat"><span class="b-label">STREAK</span><span class="b-val mono" id="blitz-streak">0</span></div>
          <button type="button" class="btn-primary" id="btn-start-blitz">Start Game</button>
        </div>
        <p class="blitz-hint">Gamepad: A / B / X / Y face buttons · Keyboard: J / K / L / ;</p>
      </div>

      <div class="game-over-panel glass-panel" id="blitz-over" role="status" hidden>
        <span class="over-eyebrow">Round Complete</span>
        <div class="over-score mono text-gradient" id="blitz-over-score">0</div>
        <p class="over-sub">Final score</p>
        <ArcadeRewardsLine baseId="blitz" xp={50} />
        <div class="over-actions">
          <button type="button" class="btn-primary" id="btn-blitz-again">Play Again</button>
          <a href="/games" class="btn-secondary">Back to Arcade</a>
        </div>
      </div>

      <GameHowToPlay
        xp={50}
        goal="Press the on-screen face button as fast as possible before the 20-second round ends. Each correct press scores 100 + 10 × current streak."
        controls={[
          { action: 'A / Cross', label: 'Press when prompted' },
          { action: 'B / Circle', label: 'Press when prompted' },
          { action: 'X / Square', label: 'Press when prompted' },
          { action: 'Y / Triangle', label: 'Press when prompted' },
          { action: 'J / K / L / ;', label: 'Face buttons (keyboard)' },
        ]}
        steps={[
          'Press Start Game to begin the round.',
          'Watch the prompt box — it shows which face button to press.',
          'Hit the matching button the moment it appears. The faster and streakier you are, the more points you earn.',
          'Pressing the wrong button resets your streak. The round ends after 20 seconds.',
        ]}
        tips={[
          'Keep your thumb resting over all four face buttons so you can pivot to the prompt quickly.',
          'A correct answer grows the streak multiplier — chain them for high scores.',
          'Wrong presses are free in terms of score loss, but they wipe your streak, so accuracy beats speed.',
        ]}
      />
      <InterlinkStrip
        type="tools"
        title="Verify with a diagnostic tool"
        subtitle="Practice is one thing — confirmation is another. Run the matching hardware test to turn your score into a measurable verdict."
        links={relatedTools}
      />
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { parseGamepadState } from '@lib/gamepad';
  import {
    claimArcadeXp,
    getArcadeRewardEls,
    renderArcadeRewards,
  } from '@lib/arcadeRewards';

  document.addEventListener('DOMContentLoaded', () => {
    let isPlaying = false;
    let score = 0;
    let streak = 0;
    let roundTimerId: number | null = null;
    let currentTargetBtn = 0; // 0=A/Cross, 1=B/Circle, 2=X/Square, 3=Y/Triangle

    const btnNames = ['A / CROSS (B0)', 'B / CIRCLE (B1)', 'X / SQUARE (B2)', 'Y / TRIANGLE (B3)'];
    const keyMap = ['KeyJ', 'KeyK', 'KeyL', 'Semicolon'];

    const promptEl = document.getElementById('prompt-btn-name');
    const scoreEl = document.getElementById('blitz-score');
    const streakEl = document.getElementById('blitz-streak');
    const overPanel = document.getElementById('blitz-over') as HTMLElement | null;
    const overScoreEl = document.getElementById('blitz-over-score') as HTMLElement | null;

    const keys = new Set<string>();
    window.addEventListener('keydown', (e: KeyboardEvent) => keys.add(e.code));
    window.addEventListener('keyup', (e: KeyboardEvent) => keys.delete(e.code));

    function nextPrompt() {
      currentTargetBtn = Math.floor(Math.random() * 4);
      if (promptEl) promptEl.textContent = btnNames[currentTargetBtn];
    }

    function endGame() {
      isPlaying = false;
      if (roundTimerId) clearTimeout(roundTimerId);
      roundTimerId = null;
      if (promptEl) promptEl.textContent = 'GAME OVER!';
      const result = claimArcadeXp('blitz', 50);
      renderArcadeRewards(
        getArcadeRewardEls('blitz'),
        result
          ? { kind: 'award', result, amount: 50 }
          : { kind: 'claimed', amount: 50 },
      );
      if (overScoreEl) overScoreEl.textContent = String(score);
      if (overPanel) overPanel.hidden = false;
    }

    function startGame() {
      if (isPlaying) return;
      if (roundTimerId) clearTimeout(roundTimerId);
      isPlaying = true;
      score = 0;
      streak = 0;
      if (scoreEl) scoreEl.textContent = '0';
      if (streakEl) streakEl.textContent = '0';
      if (overPanel) overPanel.hidden = true;
      nextPrompt();

      roundTimerId = window.setTimeout(() => endGame(), 20000);
    }

    let prevButtons: boolean[] = [];

    function pollBlitz() {
      if (isPlaying) {
        let buttonsDown: boolean[] = [false, false, false, false];

        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        let activeGp: Gamepad | null = null;
        for (let i = 0; i < gamepads.length; i++) {
          if (gamepads[i] && gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
        }

        if (activeGp) {
          const state = parseGamepadState(activeGp);
          [0, 1, 2, 3].forEach((btnIdx) => {
            if (state.buttons[btnIdx]?.pressed) buttonsDown[btnIdx] = true;
          });
        } else {
          [0, 1, 2, 3].forEach((btnIdx) => {
            if (keys.has(keyMap[btnIdx])) buttonsDown[btnIdx] = true;
          });
        }

        [0, 1, 2, 3].forEach((btnIdx) => {
          const isPressed = buttonsDown[btnIdx];
          if (isPressed && !prevButtons[btnIdx]) {
            if (btnIdx === currentTargetBtn) {
              score += 100 + (streak * 10);
              streak++;
              nextPrompt();
            } else {
              streak = 0;
            }
            if (scoreEl) scoreEl.textContent = String(score);
            if (streakEl) streakEl.textContent = String(streak);
          }
          prevButtons[btnIdx] = isPressed;
        });
      }

      requestAnimationFrame(pollBlitz);
    }

    pollBlitz();

    document.getElementById('btn-start-blitz')?.addEventListener('click', startGame);
    document.getElementById('btn-blitz-again')?.addEventListener('click', startGame);
  });
</script>

<style>
  .game-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .game-header { margin-bottom: 2rem; }
  .game-title { font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .game-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .blitz-card { padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; align-items: center; }
  .blitz-prompt-box { width: 100%; max-width: 600px; height: 220px; background: var(--color-surface-1); border: 2px dashed var(--color-accent); border-radius: var(--radius-card); display: flex; align-items: center; justify-content: center; text-align: center; touch-action: manipulation; user-select: none; }
  .prompt-text { font-family: var(--font-mono); font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; }
  .blitz-stats-bar { width: 100%; max-width: 600px; display: flex; align-items: center; justify-content: space-between; }
  .blitz-stats-bar .btn-primary { touch-action: manipulation; }
  .b-stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .b-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); }
  .b-val { font-size: 1.5rem; font-weight: 700; }
  .blitz-hint { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--color-text-tertiary); text-align: center; margin: 0; }
  .game-over-panel { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; max-width: 480px; margin-inline: auto; padding: 2rem; text-align: center; }
  .game-over-panel[hidden] { display: none; }
  .over-eyebrow { font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-tertiary); }
  .over-score { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 800; line-height: 1; }
  .over-sub { margin: 0; font-size: var(--text-small); color: var(--color-text-secondary); }
  .over-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .over-actions .btn-primary,
  .over-actions .btn-secondary { touch-action: manipulation; }
</style>
