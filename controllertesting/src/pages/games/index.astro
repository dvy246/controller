---
/**
 * /games/index.astro — Controller Games Arcade Hub
 * SEO Title: Controller Arcade — 5 Free Browser Games for Gamepads
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Games Arcade' },
];

const games = [
  { id: 'stick-sniper', name: 'Stick Sniper', type: 'Precision', desc: 'Acquire targets with the right stick and hold your aim', href: '/games/stick-sniper', pts: 50 },
  { id: 'button-blitz', name: 'Button Blitz', type: 'Reflex', desc: 'Press the on-screen face button as fast as you can', href: '/games/button-blitz', pts: 50 },
  { id: 'stick-maze', name: 'Stick Maze Runner', type: 'Precision', desc: 'Steer through tight corridors with the analog stick', href: '/games/stick-maze', pts: 100 },
  { id: 'trigger-racer', name: 'Trigger Speed Racer', type: 'Precision', desc: 'Hold R2 in the green zone to match the speed target', href: '/games/trigger-racer', pts: 150 },
  { id: 'quick-draw', name: 'Quick Draw Reaction', type: 'Reflex', desc: 'Press any button the instant the signal turns green', href: '/games/quick-draw', pts: 75 },
  { id: 'nova-blaster', name: 'Nova Blaster', type: 'Shooter', desc: 'Twin-stick arena shooter — move, aim, and survive waves', href: '/games/nova-blaster', pts: 100 },
  { id: 'beat-drop', name: 'Beat Drop', type: 'Rhythm', desc: 'Tap face buttons in time as notes cross the hit line', href: '/games/beat-drop', pts: 75 },
  { id: 'memory-pulse', name: 'Memory Pulse', type: 'Memory', desc: 'Repeat the growing face-button sequence from memory', href: '/games/memory-pulse', pts: 125 },
  { id: 'asteroid-dash', name: 'Asteroid Dash', type: 'Survival', desc: 'Dodge asteroids and collect orbs with R2 boost', href: '/games/asteroid-dash', pts: 125 },
  { id: 'combo-rush', name: 'Combo Rush', type: 'Challenge', desc: 'Chain every input — sticks, triggers, buttons, dpad', href: '/games/combo-rush', pts: 150 },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Controller Arcade Games',
  numberOfItems: games.length,
  itemListElement: games.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.name,
    url: `https://controllertesting.com${g.href}`,
  })),
};
function getGameIcon(id: string) {
  if (id.includes('sniper')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
  if (id.includes('blitz')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`;
  if (id.includes('racer')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>`;
  if (id.includes('maze')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
  if (id.includes('draw')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>`;
  if (id.includes('nova')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-4z"/><path d="M12 8v8M8 12h8"/></svg>`;
  if (id.includes('beat')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"/><path d="M12 7v5l3 2"/></svg>`;
  if (id.includes('memory')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>`;
  if (id.includes('asteroid')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2-1 3.7-2.4 4.8A7 7 0 0 1 5 9a7 7 0 0 1 7-7z"/><circle cx="9" cy="7" r="1.5"/><path d="M12 22c3-1 5-3.4 5-6"/></svg>`;
  if (id.includes('combo')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3v7a6 6 0 0 0 12 0V3"/><path d="M4 21h16M12 17v4"/></svg>`;
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="6"/></svg>`;
}
---

<BaseLayout
  title="Controller Arcade — 5 Free Browser Games for Gamepads | ControllerTesting.com"
  description="Play 5 free browser games using your PS5, Xbox, or Switch controller. Precision aim trainers, reflex challenges, and rewards Arcade."
  schema={schema}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="arcade-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="arcade-hero">
        <span class="badge-tag">Gamepad Arcade &amp; Benchmarks</span>
        <h1 class="arcade-title text-h1">Controller Arcade &amp; Aim Trainer</h1>
        <p class="arcade-subtitle">
          Put your controller to the test in browser arcade games built specifically for gamepads. Earn XP points, level up, and build a daily streak.
        </p>
      </header>

      <div class="arcade-rewards-banner card-base">
        <div class="rewards-info">
          <h2 class="rewards-heading">Your Arcade Progression</h2>
          <p class="rewards-sub">Earn +50 XP per diagnostic test and up to +150 XP per game session. Test every day to build your streak.</p>
        </div>
        <div class="rewards-stats">
          <div class="rewards-stat-box">
            <svg class="r-icon r-icon-pass" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span class="r-label">CURRENT XP POINTS</span>
            <span class="r-val r-val-pass" id="user-xp-val">0 XP</span>
          </div>
          <div class="rewards-stat-box">
            <svg class="r-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            <span class="r-label">LEVEL</span>
            <span class="r-val" id="user-level-val">1</span>
          </div>
          <div class="rewards-stat-box">
            <svg class="r-icon r-icon-streak" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <span class="r-label">DAILY STREAK</span>
            <span class="r-val r-val-streak" id="user-streak-val">0-day streak</span>
          </div>
        </div>
      </div>

      <div class="grid-games">
        {games.map((g) => (
          <a href={g.href} class="game-card card-base card-hover">
            <div class="game-card-top">
              <div class="game-card-icon-wrap">
                <span class="game-card-icon" set:html={getGameIcon(g.id)} aria-hidden="true" />
                <span class="badge-tag">{g.type}</span>
              </div>
              <span class="game-pts-tag">+{g.pts} XP</span>
            </div>
            <h2 class="game-card-name">{g.name}</h2>
            <p class="game-card-desc">{g.desc}</p>
            <span class="game-card-xp-bar">
              <span class="gc-xp-track" role="progressbar" aria-label={`Progress to next level in ${g.name}`} aria-valuemin="0" aria-valuemax="200" aria-valuenow="0" data-xp-bar><span class="gc-xp-fill" data-xp-fill></span></span>
              <span class="gc-xp-meta mono" data-xp-meta>Level 1 · 0/200 XP</span>
            </span>
            <span class="game-play-btn">
              Play Game
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { getUserProgress } from '../../lib/rewards';

  document.addEventListener('DOMContentLoaded', () => {
    const prog = getUserProgress();
    const pts = prog.pts || 0;
    const level = prog.level || 1;
    const streak = prog.streak || 0;
    const into = pts % 200;
    const pct = Math.round((into / 200) * 100);

    const xpEl = document.getElementById('user-xp-val');
    if (xpEl) xpEl.textContent = `${pts} XP`;
    const levelEl = document.getElementById('user-level-val');
    if (levelEl) levelEl.textContent = String(level);
    const streakEl = document.getElementById('user-streak-val');
    if (streakEl) streakEl.textContent = `${streak}-day streak`;

    document.querySelectorAll<HTMLElement>('[data-xp-fill]').forEach((fill) => {
      fill.style.width = `${pct}%`;
    });
    document.querySelectorAll<HTMLElement>('[data-xp-meta]').forEach((meta) => {
      meta.textContent = `Level ${level} · ${into}/200 XP`;
    });
    document.querySelectorAll<HTMLElement>('[data-xp-bar]').forEach((bar) => {
      bar.setAttribute('aria-valuenow', String(into));
    });
  });
</script>

<style>
  .arcade-page { padding-top: 96px; padding-bottom: var(--spacing-section); }
  .arcade-hero { margin-bottom: 2rem; }
  .arcade-hero .badge-tag { margin-bottom: 0.75rem; }
  .arcade-title { font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .arcade-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .arcade-rewards-banner { display: flex; align-items: center; justify-content: space-between; padding: 1.75rem 2rem; margin-bottom: 2.25rem; flex-wrap: wrap; gap: 1.5rem; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); }
  .rewards-heading { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem; }
  .rewards-sub { font-size: var(--text-small); color: var(--color-text-secondary); max-width: 44ch; }
  .rewards-stats { display: grid; grid-template-columns: repeat(3, minmax(132px, 1fr)); gap: 0.875rem; }
  .rewards-stat-box { display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; padding: 1rem 1.125rem; background: var(--color-surface-3); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); }
  .r-icon { color: var(--color-neutral); margin-bottom: 0.25rem; }
  .r-icon-pass { color: var(--color-pass); }
  .r-icon-streak { color: var(--color-warning); }
  .r-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .r-val { font-family: var(--font-mono); font-size: 1.75rem; font-weight: 800; line-height: 1.1; }
  .r-val-pass { color: var(--color-pass); }
  .r-val-streak { color: var(--color-warning); }
  .grid-games { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.5rem; width: 100%; }
  .game-card { display: flex; flex-direction: column; gap: 0.875rem; text-decoration: none; cursor: pointer; padding: 1.75rem; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); transition: background var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast); }
  .game-card:hover { background: var(--color-surface-3); border-color: var(--color-accent); transform: translateY(-3px); text-decoration: none; }
  .game-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .game-card-top { display: flex; justify-content: space-between; align-items: center; }
  .game-card-icon-wrap { display: flex; align-items: center; gap: 0.75rem; }
  .game-card-icon { width: 38px; height: 38px; border-radius: var(--radius-sm); background: var(--color-surface-3); border: 1px solid var(--color-border-subtle); display: flex; align-items: center; justify-content: center; color: var(--color-accent); }
  .game-pts-tag { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; color: var(--color-pass); background: var(--color-pass-bg); padding: 0.2em 0.6em; border-radius: var(--radius-pill); border: 1px solid var(--color-pass); }
  .game-card-name { font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); letter-spacing: -0.01em; }
  .game-card-desc { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6; flex-grow: 1; }
  .game-card-xp-bar { display: flex; align-items: center; gap: 0.625rem; width: 100%; }
  .gc-xp-track { flex: 1; height: 6px; background: var(--color-surface-3); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-pill); overflow: hidden; }
  .gc-xp-fill { display: block; width: 0%; height: 100%; background: var(--color-accent); border-radius: var(--radius-pill); transition: width var(--duration-fast) cubic-bezier(0.16, 1, 0.3, 1); }
  .gc-xp-meta { font-size: 0.7rem; font-weight: 700; color: var(--color-text-tertiary); white-space: nowrap; }
  .game-play-btn { display: flex; align-items: center; gap: 0.375rem; font-size: var(--text-small); font-weight: 600; color: var(--color-accent); margin-top: 0.25rem; }
  @media (max-width: 768px) { .rewards-stats { grid-template-columns: 1fr; width: 100%; } }
</style>
