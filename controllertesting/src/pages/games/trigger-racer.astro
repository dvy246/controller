---
/**
 * /games/trigger-racer — Trigger Racer Precision Throttle Game
 * Precision analog trigger control arcade game.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import ArcadeRewardsLine from '@components/games/ArcadeRewardsLine.astro';
import GameHowToPlay from '@components/games/GameHowToPlay.astro';
import InterlinkStrip from '@components/global/InterlinkStrip.astro';
import { resolveToolsForGame } from '@data/arcadeInterlinks';

const breadcrumbs = [
  { name: 'Games Arcade', url: '/games' },
  { name: 'Trigger Racer' },
];

const relatedTools = resolveToolsForGame('trigger-racer');
---

<BaseLayout
  title="Trigger Racer — Precision Throttle Game | ControllerTesting.com"
  description="Test your analog trigger control linearity in Trigger Racer. Modulate R2/L2 pressure to stay inside target speed zones."
  breadcrumbs={breadcrumbs}

  localized={true}>
  <Header />
  <div class="game-container">
    <div class="hero-card card-base">
      <Breadcrumbs items={breadcrumbs} />
      <span class="hero-badge">THROTTLE CONTROL GAME</span>
      <h1 class="hero-title text-gradient">Trigger Racer</h1>
      <p class="hero-desc">
        Squeeze R2 / RT to hold the throttle in the green zone. Overshoot into red and you lose the gear.
      </p>
    </div>

    <div class="canvas-card card-base">
      <div class="game-score-bar">
        <span>RPM ZONE: <strong class="mono text-gradient" id="trig-zone">50%</strong></span>
        <span>SCORE: <strong class="mono" id="trig-score">0</strong></span>
        <span>STATUS: <strong class="mono pass" id="trig-status">READY</strong></span>
      </div>

      <canvas id="trig-canvas" width="700" height="300"></canvas>

      <p class="racer-hint">Gamepad: squeeze R2 / RT to match the green zone · Keyboard: hold ↑ / W to rev, ↓ / S to release</p>

      <div class="game-controls">
        <button type="button" class="btn-primary" id="btn-start-trig">Start Race</button>
      </div>

      <div class="game-over-panel glass-panel" id="trig-over" role="status" hidden>
        <span class="over-eyebrow">Race Complete</span>
        <div class="over-score mono text-gradient" id="trig-over-score">0</div>
        <p class="over-sub">Final score</p>
        <ArcadeRewardsLine baseId="trig" xp={150} />
        <div class="over-actions">
          <button type="button" class="btn-primary" id="btn-trig-again">Play Again</button>
          <a href="/games" class="btn-secondary">Back to Arcade</a>
        </div>
      </div>
    </div>

    <GameHowToPlay
      xp={150}
      goal="Squeeze R2 / RT to rev the engine until your tachometer bar sits inside the glowing green zone. Hold it there — every frame in the zone scores +10. Reach 1000 points to finish the race."
      controls={[
        { action: 'R2 / RT', label: 'Rev the throttle up' },
        { action: 'Release R2', label: 'Ease the throttle down' },
        { action: '↑ / W', label: 'Rev (keyboard)' },
        { action: '↓ / S', label: 'Release (keyboard)' },
      ]}
      steps={[
        'Press Start Race — a random green target zone appears on the tachometer.',
        'Squeeze R2/RT (or hold ↑/W) to raise your throttle bar toward the green zone.',
        'Feather the trigger to keep the bar inside the zone; drifting out stops the scoring.',
        'Keep the bar in-zone until the score hits 1000 to cross the finish line.',
      ]}
      tips={[
        'The zone is ~8% wide — a full pull overshoots it, so ramp up slowly and settle.',
        'Micro-adjustments near the threshold score far more than big trigger sweeps.',
        'A steady, controlled trigger hand beats jittery taps: consistency is what racks up points.',
      ]}
    />

      <InterlinkStrip
        type="tools"
        title="Verify with a diagnostic tool"
        subtitle="Practice is one thing — confirmation is another. Run the matching hardware test to turn your score into a measurable verdict."
        links={relatedTools}
      />
  </div>
  <Footer />
</BaseLayout>

<script>
  import {
    claimArcadeXp,
    getArcadeRewardEls,
    renderArcadeRewards,
  } from '@lib/arcadeRewards';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('trig-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
      if (!ctx) return;
    if (!ctx) return;

    const overPanel = document.getElementById('trig-over') as HTMLElement | null;
    const overScoreEl = document.getElementById('trig-over-score') as HTMLElement | null;

    let isPlaying = false;
    let score = 0;
    let targetPct = 50;
    let keyboardVal = 0;

    const keys = new Set<string>();
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['ArrowUp', 'ArrowDown'].includes(e.code)) e.preventDefault();
      keys.add(e.code);
    });
    window.addEventListener('keyup', (e: KeyboardEvent) => keys.delete(e.code));

    function readTriggerPct(): number {
      if (keys.has('ArrowUp') || keys.has('KeyW')) keyboardVal = Math.min(100, keyboardVal + 3);
      if (keys.has('ArrowDown') || keys.has('KeyS')) keyboardVal = Math.max(0, keyboardVal - 3);
      if (keys.has('ArrowUp') || keys.has('KeyW') || keys.has('ArrowDown') || keys.has('KeyS')) {
        return keyboardVal;
      }
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      const gp = gamepads[0];
      if (gp && gp.buttons[7]) {
        return gp.buttons[7].value * 100;
      }
      return 0;
    }

    function endGame() {
      isPlaying = false;
      const result = claimArcadeXp('trig', 150);
      renderArcadeRewards(
        getArcadeRewardEls('trig'),
        result
          ? { kind: 'award', result, amount: 150 }
          : { kind: 'claimed', amount: 150 },
      );
      const st = document.getElementById('trig-status');
      if (st) st.textContent = 'RACE COMPLETED!';
      if (overScoreEl) overScoreEl.textContent = String(score);
      if (overPanel) overPanel.hidden = false;
    }

    function startRace() {
      if (isPlaying) return;
      score = 0;
      isPlaying = true;
      keyboardVal = 0;
      targetPct = Math.floor(Math.random() * 60) + 20;
      const zEl = document.getElementById('trig-zone');
      if (zEl) zEl.textContent = `${targetPct}%`;
      const st = document.getElementById('trig-status');
      if (st) st.textContent = 'RACING';
      const scEl = document.getElementById('trig-score');
      if (scEl) scEl.textContent = '0';
      if (overPanel) overPanel.hidden = true;
    }

    function loop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Track
      ctx.fillStyle = '#0c0c14';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Target Zone (Green box)
      const zoneY = canvas.height - (targetPct / 100) * canvas.height;
      ctx.fillStyle = 'rgba(16, 185, 129, 0.2)';
      ctx.fillRect(0, zoneY - 20, canvas.width, 40);
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2;
      ctx.strokeRect(0, zoneY - 20, canvas.width, 40);

      // Read trigger input
      const currentVal = readTriggerPct();

      // Player Tachometer bar
      const playerY = canvas.height - (currentVal / 100) * canvas.height;
      ctx.fillStyle = '#2563eb';
      ctx.fillRect(100, playerY - 10, canvas.width - 200, 20);

      if (isPlaying) {
        if (Math.abs(currentVal - targetPct) < 8) {
          score += 10;
          const scEl = document.getElementById('trig-score');
          if (scEl) scEl.textContent = String(score);
        }

        if (score >= 1000) {
          endGame();
          return;
        }
      }

      requestAnimationFrame(loop);
    }

    document.getElementById('btn-start-trig')?.addEventListener('click', startRace);
    document.getElementById('btn-trig-again')?.addEventListener('click', startRace);

    loop();
  });
</script>

<style>
  .game-container { max-width: 900px; padding-top: calc(var(--header-height, 64px) + 2rem); margin: 0 auto 2rem; padding-left: 1.5rem; padding-right: 1.5rem; display: flex; flex-direction: column; gap: 2rem; }
  .hero-card { padding: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .hero-badge { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--color-accent); letter-spacing: 0.08em; }
  .hero-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.15; }
  .hero-desc { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; }
  .canvas-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; align-items: center; }
  .game-score-bar { width: 100%; display: flex; justify-content: space-between; font-size: 1rem; font-weight: 600; }
  #trig-canvas { width: 100%; max-width: 700px; aspect-ratio: 7 / 3; height: auto; display: block; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); background: var(--color-surface-1); touch-action: manipulation; user-select: none; }
  .racer-hint { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--color-text-tertiary); text-align: center; margin: 0; }
  .game-controls { display: flex; justify-content: center; width: 100%; margin-top: 0.5rem; }
  .game-controls .btn-primary { touch-action: manipulation; }
  .game-over-panel { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; width: 100%; max-width: 480px; margin-inline: auto; padding: 2rem; text-align: center; }
  .game-over-panel[hidden] { display: none; }
  .over-eyebrow { font-family: var(--font-mono); font-size: var(--text-micro); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-tertiary); }
  .over-score { font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 800; line-height: 1; }
  .over-sub { margin: 0; font-size: var(--text-small); color: var(--color-text-secondary); }
  .over-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .over-actions .btn-primary,
  .over-actions .btn-secondary { touch-action: manipulation; }
  @media (max-width: 768px) { .game-score-bar { flex-direction: column; gap: 0.375rem; } }
</style>
