---
/**
 * b2b-api.astro — Controller Diagnostic API for Sellers
 * Document hub for refurbishers (eBay, BackMarket) to get iframe embed code for the report/[uuid] page.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

const title = "Controller Diagnostic API for Sellers | B2B Refurbisher Tools";
const description = "Embed verifiable controller diagnostic reports into your eBay, BackMarket, or custom storefront. Boost buyer trust with our Controller Diagnostic API for sellers.";

const breadcrumbs = [
  { name: 'Home', url: 'https://controllertesting.com/' },
  { name: 'B2B API for Sellers', url: 'https://controllertesting.com/b2b-api' },
];

const faqs = [
  {
    question: "How do I embed a diagnostic report on my eBay listing?",
    answer: "Generate a report using our Full Diagnostic tool, copy the provided iframe code, and paste it into the HTML description of your eBay listing."
  },
  {
    question: "Is the Controller Diagnostic API free for sellers?",
    answer: "Yes, our diagnostic tools and the report embedding functionality are currently free for both casual users and high-volume refurbishers."
  },
  {
    question: "Do buyers need to create an account to view the report?",
    answer: "No. Reports are hosted securely and accessible via a unique UUID link or embedded iframe without any login required."
  }
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: description,
    url: 'https://controllertesting.com/b2b-api',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Controller Diagnostic API',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description: 'B2B tool for controller refurbishers to embed diagnostic reports into ecommerce listings.'
  }
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  schema={schema}
>
  <Header />

  <main id="main-content" class="container-site">
    <section class="hero b2b-hero py-20">
      <div class="hero-inner text-center max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">
          Controller Diagnostic API for Sellers
        </h1>
        <p class="text-lg text-stone-300 mb-8">
          Increase buyer trust and reduce returns on eBay, BackMarket, and custom storefronts by embedding verifiable diagnostic reports directly into your listings.
        </p>
        <div class="flex justify-center gap-4">
          <a href="/test/controller/full-diagnostic" class="btn-primary">Generate a Report</a>
          <a href="#documentation" class="btn-secondary">Read Documentation</a>
        </div>
      </div>
    </section>

    <section id="documentation" class="py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center border-b border-stone-800 pb-4">Integration Documentation</h2>
        
        <div class="card-base mb-8">
          <h3 class="text-xl font-semibold mb-4 text-emerald-400">Step 1: Generate a Report</h3>
          <p class="mb-4 text-stone-300">
            Connect the refurbished controller and run the <strong>Full Diagnostic</strong> test. Once completed, a unique <code>UUID</code> will be generated for the hardware evidence report.
          </p>
        </div>

        <div class="card-base mb-8">
          <h3 class="text-xl font-semibold mb-4 text-blue-400">Step 2: Copy the iframe Embed Code</h3>
          <p class="mb-4 text-stone-300">
            Use the generated <code>UUID</code> to create an iframe embed. Replace <code>YOUR_UUID_HERE</code> with the actual report ID.
          </p>
          <pre class="bg-stone-900 p-4 rounded-md border border-stone-800 overflow-x-auto text-sm text-stone-300 font-mono">
&lt;iframe 
  src="https://controllertesting.com/report/YOUR_UUID_HERE?embed=true" 
  width="100%" 
  height="600" 
  frameborder="0" 
  title="Controller Diagnostic Report"&gt;
&lt;/iframe&gt;
          </pre>
        </div>

        <div class="card-base mb-8">
          <h3 class="text-xl font-semibold mb-4 text-amber-400">Step 3: Paste into Your Listing</h3>
          <p class="mb-4 text-stone-300">
            Switch your ecommerce listing editor (e.g., eBay description editor) to HTML mode and paste the iframe snippet. The live report card will now display directly to your buyers.
          </p>
        </div>
      </div>
    </section>
    
    <section class="faq-section py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Frequently Asked Questions</h2>
        <div class="faq-list space-y-4">
          {faqs.map((faq) => (
            <details class="faq-item group card-base cursor-pointer">
              <summary class="font-semibold text-lg flex justify-between items-center outline-none">
                {faq.question}
                <span class="transition-transform group-open:rotate-45 text-emerald-400">+</span>
              </summary>
              <p class="mt-4 text-stone-400 leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .b2b-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: radial-gradient(circle at center, rgba(37,99,235,0.1) 0%, transparent 70%);
  }
</style>
