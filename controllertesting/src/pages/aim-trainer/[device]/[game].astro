---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AimTrainerCanvas from '../../../components/features/AimTrainerCanvas.astro';

export function getStaticPaths() {
  const devices = ['controller', 'mouse'];
  const games = ['apex-legends', 'valorant', 'fortnite', 'warzone', 'counter-strike-2'];

  const paths = [];
  for (const device of devices) {
    for (const game of games) {
      paths.push({ params: { device, game } });
    }
  }
  return paths;
}

const { device, game } = Astro.params;

const formattedGame = game.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const formattedDevice = device.charAt(0).toUpperCase() + device.slice(1);

const title = `Pro Aim Trainer & Input Precision - ${formattedDevice} (${formattedGame})`;
const description = `Test and improve your ${formattedDevice} aim precision, target tracking speed, and stick drift impact specifically tuned for ${formattedGame}. Free client-side benchmark tool.`;
const canonical = `https://controllertesting.com/aim-trainer/${device}/${game}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="text-xs text-slate-400 mb-6 flex items-center gap-2">
      <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
      <span>/</span>
      <a href="/games" class="hover:text-blue-400 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-slate-200 capitalize">Aim Trainer ({device})</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {formattedDevice} Aim Trainer & Precision Benchmark
      </h1>
      <p class="mt-2 text-base text-slate-300 max-w-3xl">
        Calibrated for <span class="text-blue-400 font-semibold">{formattedGame}</span> mechanics. Benchmark your target acquisition velocity, micro-adjustment accuracy, and hardware response delay directly in your browser.
      </p>
    </div>

    <!-- Interactive Component -->
    <AimTrainerCanvas device={device} game={game} />

    <!-- AEO/GEO FAQ Section -->
    <section class="mt-16 bg-surface-1 p-6 sm:p-8 rounded-2xl border border-surface-3">
      <h2 class="text-2xl font-bold text-white mb-6">Frequently Asked Questions & Benchmark Guide</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-300">
        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold text-white text-base mb-2">How does controller stick drift impact aim accuracy?</h3>
          <p>
            Stick drift causes subtle, unwanted motion inputs when your analog stick is at rest. In fast-paced shooters like {formattedGame}, stick drift pulls your crosshair away from targets during micro-adjustments, reducing your effective hit rate by up to 15%.
          </p>
        </div>

        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold text-white text-base mb-2">How do I calibrate my deadzones for {formattedGame}?</h3>
          <p>
            First, run our <a href="/test/controller/drift" class="text-blue-400 hover:underline font-semibold">Stick Drift Tester</a> to measure your hardware error rate. Set your in-game inner deadzone slightly above your hardware error percentage to eliminate drift without losing fine control.
          </p>
        </div>

        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold text-white text-base mb-2">Is this aim trainer completely free and web-based?</h3>
          <p>
            Yes! It runs entirely client-side using browser HTML5 Canvas and the Gamepad API. No software downloads, accounts, or database tracking required.
          </p>
        </div>

        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold text-white text-base mb-2">What is a good accuracy score for {formattedDevice}?</h3>
          <p>
            A competitive score for {formattedDevice} users on {formattedGame} settings is <strong>85%+ accuracy</strong> with over 25 targets hit in 30 seconds.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
