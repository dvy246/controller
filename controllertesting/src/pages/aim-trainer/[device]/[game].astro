---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';
import AimTrainerCanvas from '../../../components/features/AimTrainerCanvas.astro';

export function getStaticPaths() {
  const devices = ['controller', 'mouse'];
  const games = ['apex-legends', 'valorant', 'fortnite', 'warzone', 'counter-strike-2'];

  const paths = [];
  for (const device of devices) {
    for (const game of games) {
      paths.push({ params: { device, game } });
    }
  }
  return paths;
}

const { device, game } = Astro.params;

const formattedGame = game.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const formattedDevice = device.charAt(0).toUpperCase() + device.slice(1);

const title = `Pro Aim Trainer & Input Precision - ${formattedDevice} (${formattedGame})`;
const description = `Test and improve your ${formattedDevice} aim precision, target tracking speed, and stick drift impact specifically tuned for ${formattedGame}. Free client-side benchmark tool.`;
const canonical = `https://controllertesting.com/aim-trainer/${device}/${game}`;

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: `Aim Trainer (${formattedDevice})` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header />
  <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Page Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-h1">
        {formattedDevice} Aim Trainer & Precision Benchmark
      </h1>
      <p class="mt-2 text-secondary max-w-3xl">
        Calibrated for <span class="text-accent font-semibold">{formattedGame}</span> mechanics. Benchmark your target acquisition velocity, micro-adjustment accuracy, and hardware response delay directly in your browser.
      </p>
    </div>

    <!-- Interactive Component -->
    <AimTrainerCanvas device={device} game={game} />

    <!-- AEO/GEO FAQ Section -->
    <section class="mt-16 bg-[var(--color-surface-1)] p-6 sm:p-8 rounded-2xl border border-[var(--color-border-default)]">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-6">Frequently Asked Questions & Benchmark Guide</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">How does controller stick drift impact aim accuracy?</h3>
          <p class="leading-relaxed">
            Stick drift causes subtle, unwanted motion inputs when your analog stick is at rest. In fast-paced shooters like {formattedGame}, stick drift pulls your crosshair away from targets during micro-adjustments, reducing your effective hit rate by up to 15%.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">How do I calibrate my deadzones for {formattedGame}?</h3>
          <p class="leading-relaxed">
            First, run our <a href="/test/controller/drift" class="text-[var(--color-accent)] hover:underline font-semibold">Stick Drift Tester</a> to measure your hardware error rate. Set your in-game inner deadzone slightly above your hardware error percentage to eliminate drift without losing fine control.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">Is this aim trainer completely free and web-based?</h3>
          <p class="leading-relaxed">
            Yes! It runs entirely client-side using browser HTML5 Canvas and the Gamepad API. No software downloads, accounts, or database tracking required.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="font-semibold mb-2">What is a good accuracy score for {formattedDevice}?</h3>
          <p>
            A competitive score for {formattedDevice} users on {formattedGame} settings is <strong>85%+ accuracy</strong> with over 25 targets hit in 30 seconds.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
