---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import AimTrainerCanvas from '@components/features/AimTrainerCanvas.astro';

export function getStaticPaths() {
  const devices = ['controller', 'mouse'];

  // Per-game aim context. Public competitive knowledge; no invented figures.
  const gameContext: Record<string, { playstyle: string; focus: string; practice: string }> = {
    'apex-legends': {
      playstyle: 'tracking and mid-range recoil control — targets move constantly and fights are sustained.',
      focus: 'smooth, continuous target tracking rather than single flicks.',
      practice: 'train long slow-tracking passes with a second mouse/stick, then add strafe-jitter on the target.',
    },
    'valorant': {
      playstyle: 'crosshair placement and short, precise flicks — one well-placed shot wins an angle.',
      focus: 'first-shot accuracy and micro-adjustments onto heads at medium range.',
      practice: 'practice small-offset re-flicks onto a static dot, then add strafing to force corrections.',
    },
    'fortnite': {
      playstyle: 'building pressure splits attention between builds and gunfights, so aim must survive high APM.',
      focus: 'fast acquisition after a build edit, then controlled shots while the opponent edits back.',
      practice: 'alternate between editing drills and short target-acquisition bursts to simulate build-to-gun transitions.',
    },
    'warzone': {
      playstyle: 'long-range recoil control on automatic weapons plus close-quarters tracking in tight spaces.',
      focus: 'sustained beam tracking at distance while the target strafes.',
      practice: 'practice long-range tracking with controlled horizontal pulls, then drill quick close-range turn-and-aim.',
    },
    'counter-strike-2': {
      playstyle: 'spray control and pre-aiming common angles — precision beats speed.',
      focus: 'controlled bursts and keeping the crosshair on a single point through spray.',
      practice: 'repeat short-burst drills on a fixed head-height dot, then re-aim drills after each kill window.',
    },
  };

  // Per-device context. No invented measurement claims.
  const deviceContext: Record<string, { input: string; tuning: string; practice: string }> = {
    'controller': {
      input: 'an analog stick: aim speed is set by stick deflection and your right-stick micro-adjustments.',
      tuning: 'deadzone and response curve govern how a small deflection translates to screen movement — a drift offset makes micro-aim near-impossible.',
      practice: 'on a stick, prioritize small, deliberate correction flicks and ignore any aim assist you rely on in the real game.',
    },
    'mouse': {
      input: 'a mouse: aim speed is set by your DPI and in-game sensitivity, driven by wrist or arm movement.',
      tuning: 'your cm/360° distance is what muscle memory stores — changing DPI or sens mid-training invalidates your benchmark.',
      practice: 'on mouse, keep your grip relaxed and practice large arm sweeps plus fine fingertip flicks separately.',
    },
  };

  const games = ['apex-legends', 'valorant', 'fortnite', 'warzone', 'counter-strike-2'];

  const paths = [];
  for (const device of devices) {
    for (const game of games) {
      paths.push({ params: { device, game }, props: { gc: gameContext[game], dc: deviceContext[device] } });
    }
  }
  return paths;
}

const { device, game } = Astro.params;
const { gc, dc } = Astro.props;

const formattedGame = game.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
const formattedDevice = device.charAt(0).toUpperCase() + device.slice(1);

const title = `${formattedDevice} Aim Trainer (${formattedGame}) | CT`;
const description = `Test and improve your ${formattedDevice} aim precision, target tracking, and stick-drift handling tuned for ${formattedGame}. Free in-browser benchmark, no install.`;
const canonical = `https://controllertesting.com/aim-trainer/${device}/${game}`;

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: `Aim Trainer (${formattedDevice})` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}
  localized={false}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header />
  <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Page Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-h1">
        {formattedDevice} Aim Trainer & Precision Benchmark
      </h1>
      <p class="mt-2 text-secondary max-w-3xl">
        Calibrated for <span class="text-accent font-semibold">{formattedGame}</span> mechanics. Benchmark your target acquisition velocity, micro-adjustment accuracy, and hardware response delay directly in your browser.
      </p>
    </div>

    <!-- Interactive Component -->
    <AimTrainerCanvas device={device} game={game} />

    <!-- AEO/GEO FAQ Section -->
    <section class="mt-16 bg-[var(--color-surface-1)] p-6 sm:p-8 rounded-2xl border border-[var(--color-border-default)]">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-6">Frequently Asked Questions & Benchmark Guide</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">How does controller stick drift impact aim accuracy?</h3>
          <p class="leading-relaxed">
            Stick drift causes subtle, unwanted motion inputs when your analog stick is at rest. In fast-paced shooters like {formattedGame}, drift pulls your crosshair off target during micro-adjustments and inflates your score variance on this benchmark — clean the stick or raise the deadzone before you measure.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">What makes {formattedGame} aim different on {formattedDevice}?</h3>
          <p class="leading-relaxed">
            {formattedGame} is {gc.playstyle} With {dc.input} the training priority is {gc.focus} On this benchmark, {dc.tuning}
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">How do I calibrate my deadzones for {formattedGame}?</h3>
          <p class="leading-relaxed">
            First, run our <a href="/test/controller/drift" class="text-[var(--color-accent)] hover:underline font-semibold">Stick Drift Tester</a> to measure your hardware error rate. Set your in-game inner deadzone slightly above your hardware error percentage to eliminate drift without losing fine control.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">What should I practice for {formattedGame}?</h3>
          <p class="leading-relaxed">
            {gc.practice} {dc.practice} Track three consecutive runs and look at trend, not a single lucky score.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">Is this aim trainer completely free and web-based?</h3>
          <p class="leading-relaxed">
            Yes! It runs entirely client-side using browser HTML5 Canvas and the Gamepad API. No software downloads, accounts, or database tracking required.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
