---
/**
 * /best-controller-for/[slug] — static fit guides computed from the dataset.
 * slug: small | large | limited-grip-strength
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import { picksForHandKey, HAND_REFERENCES, getFitModels, type HandKey } from '@lib/fit';
import fitData from '@data/controllerFitData.json';

type GuideKey = 'small' | 'large' | 'limited-grip-strength';

export function getStaticPaths() {
  const urlKeys: Record<string, GuideKey> = {
    'small-hands': 'small',
    'large-hands': 'large',
    'limited-grip-strength': 'limited-grip-strength',
  };
  return Object.entries(urlKeys).map(([urlKey]) => ({ params: { slug: urlKey } }));
}

const { slug: urlKey } = Astro.params;
const urlKeys: Record<string, GuideKey> = {
  'small-hands': 'small',
  'large-hands': 'large',
  'limited-grip-strength': 'limited-grip-strength',
};
const handKey = urlKeys[urlKey] ?? 'medium' as GuideKey;
const refKey: HandKey = handKey === 'limited-grip-strength' ? 'medium' : handKey;

const content = {
  small: {
    title: 'Best Controllers for Small Hands',
    intro: `Controllers that fit smaller hands: light, compact, easy to wrap around. Ranked from our fit dataset at ${HAND_REFERENCES.small.spanMm} mm span — we never guess unmeasured models.`,
    focus: 'span',
    editorial: `Smaller hands are about reach, not just width: the test that matters is whether your thumbs can reach both sticks without shifting your grip, and whether your index fingers comfortably reach the shoulder buttons without overextending. The models ranked here score best on body width at the ${HAND_REFERENCES.small.spanMm} mm reference span, which is why a compact pad usually beats a larger, feature-packed one for this group — features you cannot reach comfortably are features you will not use in a close match. Two practical checks before you buy: hold the pad and see if your thumb arcs to the far stick without your palm lifting, and make sure the grip shells do not force your fingers to claw rather than rest. A controller that feels "almost right" in a store shelf demo will feel wrong in hour three of a ranked session, because small-hand fatigue is a reach problem, not a weight problem.`,
  },
  large: {
    title: 'Best Controllers for Large Hands',
    intro: `Controllers for large hands: deep grips, no awkward palm stretch. Ranked from our fit dataset at ${HAND_REFERENCES.large.spanMm} mm span — we never guess unmeasured models.`,
    focus: 'span',
    editorial: `Large hands are the classic "grip in the air" case: when a controller body is too narrow, your palms hover and your thumbs have to angle inward, which shows up as fatigue in long sessions rather than as an obvious sizing problem. The models ranked here give your palms a solid purchase and keep your thumbs over the sticks at the ${HAND_REFERENCES.large.spanMm} mm reference span, so the ranking favors deeper grips and fuller bodies over featherweight designs that read as cramped. Before you commit, check that your ring and pinky fingers have somewhere to wrap — a pad with short handle depth will leave those fingers dangling and drag your aim over time. And remember the palm test: with a comfortable pad, the base of your palm rests on the shell and your thumb sits over the stick arc without you thinking about it; with the wrong size, your brain is constantly micro-adjusting the grip while you play.`,
  },
  'limited-grip-strength': {
    title: 'Best Controllers for Limited Grip Strength',
    intro: `Weight matters more than width when grip strength is limited. Lightweight picks (≤ 250 g) ranked from our fit dataset — we never guess unmeasured models.`,
    focus: 'weight',
    editorial: `With limited grip strength, holding a controller for a long session is its own workout, so weight is the primary filter here and width is a secondary check. A heavier pad puts constant static load on the same small hand muscles you need for inputs, which is why the ranking sorts strictly by published weight and only breaks ties by fit verdict. Keep your elbows supported where possible — the controller that feels light in a store feels twice as heavy after an hour of ranked play. Also look at how the weight sits: a pad that is heavy in the handles pulls your wrists down, while a pad that is heavy toward the face loads the fingers that do the fine work. If hand stamina is your constraint, favor a lightweight shell with the buttons clustered close together so your inputs happen in a small, relaxed zone rather than across long travel.`,
  },
}[handKey];

const ranked = picksForHandKey(refKey);
const models = getFitModels();

// Weight-first ordering for limited-grip-strength, span-first otherwise.
const ordered = [...ranked.results].sort((a, b) => {
  if (handKey === 'limited-grip-strength') {
    const wa = a.weightG ?? Infinity;
    const wb = b.weightG ?? Infinity;
    if (wa !== wb) return wa - wb;
  }
  return ranked.results.indexOf(a) - ranked.results.indexOf(b);
});

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Controller Fit', url: '/fit' },
  { name: content.title },
];

const canonicalUrl = `https://controllertesting.com/best-controller-for/${urlKey}`;

const faqs = [
  {
    q: `What is the best controller for ${handKey === 'small' ? 'small hands' : handKey === 'large' ? 'large hands' : 'limited grip strength'}?`,
    a: content.intro,
  },
  {
    q: 'Why are some controllers excluded from this ranking?',
    a: `Controllers whose body width or weight has not been measured are marked pending in the dataset. Excluding them keeps every recommendation traceable to a published measurement (snapshot ${fitData.updatedAt}).`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const tierLabel: Record<string, string> = {
  recommended: 'Recommended fit',
  'try-first': 'Try before you buy',
  'not-ideal': 'Not ideal at reference span',
  pending: 'Verdict pending (unmeasured)',
};
---

<BaseLayout
  title={`Best Controller for ${content.title.replace(/^Best Controllers for /, '')} | CT`}
  description={content.intro}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbs}
  schema={faqSchema}

  localized={false}>
  <Header />

  <main id="main-content" class="bcf-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="bcf-hero">
        <span class="badge-tag mb-3">Computed from measured dimensions</span>
        <h1 class="text-h1 mb-3">{content.title}</h1>
        <p class="bcf-intro">{content.intro}</p>
        <div class="bcf-meta">
          <span class="bcf-meta-chip mono">{HAND_REFERENCES[refKey].note}</span>
          <span class="bcf-meta-chip mono">dataset snapshot {fitData.updatedAt}</span>
        </div>
      </header>

      <section class="bcf-editorial" aria-label="Guide detail">
        <p class="bcf-intro">{content.editorial}</p>
      </section>

      <!-- Ranked list -->
      <section class="bcf-list" aria-label="Ranked controller picks">
        {ordered.map((r) => {
          const model = models[r.slug];
          return (
            <article class={`bcf-card tier-${r.verdict}`}>
              <div class="bcf-rank">
                <span class="bcf-rank-num">{String(ordered.indexOf(r) + 1).padStart(2, '0')}</span>
              </div>
              <div class="bcf-body">
                <div class="bcf-head">
                  <h2 class="bcf-name">{r.name}</h2>
                  <span class="bcf-tier">{tierLabel[r.verdict]}</span>
                </div>
                <p class="bcf-reason">{r.reason}</p>
                <div class="bcf-specs">
                  <span class="bcf-spec mono">{r.widthMm !== null ? `${r.widthMm} mm wide` : 'width pending'}</span>
                  <span class="bcf-spec mono">{r.weightG !== null ? `${r.weightG} g` : 'weight pending'}</span>
                  <span class="bcf-spec mono">{r.stickLayout} sticks</span>
                  {model.priceUsd !== null && <span class="bcf-spec mono">${model.priceUsd}</span>}
                </div>
                <ul class="bcf-notes">
                  {model.fitNotes.slice(0, 2).map((note) => (
                    <li class="bcf-note">{note}</li>
                  ))}
                </ul>
                <a href={`/fit/${r.slug}`} class="bcf-link">Full fit profile &rarr;</a>
              </div>
            </article>
          );
        })}
      </section>

      <!-- How this is computed -->
      <section class="bcf-method card-base">
        <h2 class="section-title mb-3">How this list is computed</h2>
        <p class="bcf-method-text">
          The same engine that powers the <a href="/fit" class="hub-link">interactive fit analyzer</a> produces
          these ranks. For width verdicts, a model is recommended when its published body width sits between
          75% and 95% of the reference hand span with a matching stick layout. For limited grip strength, the
          list is re-ordered by published weight — lighter first — and the width verdict is shown for context.
          Every figure is traceable to <span class="mono">src/data/controllerFitData.json</span>; anything not
          yet measured is labeled pending rather than estimated.
        </p>
        <a href="/test/methodology" class="hub-link">Read the testing methodology &rarr;</a>
      </section>

      <!-- FAQ -->
      <section class="bcf-faq" aria-labelledby="bcf-faq-title">
        <h2 id="bcf-faq-title" class="section-title mb-3">Common questions</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <div class="faq-item">
              <h3 class="faq-q">{f.q}</h3>
              <p class="faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .bcf-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .container-site {
    width: 100%; max-width: 1000px; margin-inline: auto; padding-inline: 1.5rem;
    display: flex; flex-direction: column; gap: 2.5rem;
  }
  .badge-tag {
    margin-bottom: 0.75rem;
  }
  .bcf-hero { max-width: 80ch; }
  .bcf-intro { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.7; }
  .bcf-editorial { margin-top: 0.75rem; }
  .bcf-meta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .bcf-meta-chip {
    font-size: 0.6875rem; color: var(--color-text-tertiary); background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle); border-radius: var(--radius-pill); padding: 0.35em 0.9em;
  }

  .bcf-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .bcf-card {
    display: grid; grid-template-columns: 56px 1fr; gap: 1.25rem;
    background: var(--color-surface-2); border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card); padding: 1.5rem; border-left: 3px solid var(--color-border-subtle);
  }
  .bcf-card.tier-recommended { border-left-color: var(--color-pass); }
  .bcf-card.tier-try-first { border-left-color: var(--color-accent); }
  .bcf-card.tier-not-ideal { border-left-color: var(--color-warning); }
  .bcf-card.tier-pending { border-left-color: var(--color-text-tertiary); opacity: 0.85; }
  .bcf-rank-num { font-family: var(--font-mono); font-size: 1.375rem; font-weight: 800; color: var(--color-text-tertiary); }
  .bcf-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .bcf-name { font-size: 1.25rem; font-weight: 800; color: var(--color-text-primary); }
  .bcf-tier {
    font-family: var(--font-mono); font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--color-pass); white-space: nowrap;
  }
  .tier-try-first .bcf-tier { color: var(--color-accent); }
  .tier-not-ideal .bcf-tier { color: var(--color-warning); }
  .tier-pending .bcf-tier { color: var(--color-text-tertiary); }
  .bcf-reason { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.6; margin-top: 0.375rem; }
  .bcf-specs { display: flex; gap: 0.625rem; flex-wrap: wrap; margin-top: 0.625rem; }
  .bcf-spec {
    font-size: 0.6875rem; color: var(--color-text-secondary); background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle); border-radius: var(--radius-pill); padding: 0.25em 0.7em;
  }
  .bcf-notes { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .bcf-note {
    font-size: var(--text-small); color: var(--color-text-tertiary); line-height: 1.55;
    padding-left: 1rem; position: relative;
  }
  .bcf-note::before { content: '—'; position: absolute; left: 0; color: var(--color-accent); }
  .bcf-link { font-size: 0.8125rem; font-weight: 600; color: var(--color-accent); margin-top: 0.75rem; display: inline-block; }

  .section-title { margin-bottom: 0.75rem; }
  .bcf-method { padding: 1.75rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .bcf-method-text { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.7; max-width: 72ch; }

  .bcf-faq { display: flex; flex-direction: column; gap: 1rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0; }
  .faq-item { border-bottom: 1px solid var(--color-border-subtle); padding: 1.25rem 0; }
  .faq-item:last-child { border-bottom: none; padding-bottom: 0; }
  .faq-q { font-size: 0.9375rem; font-weight: 700; color: var(--color-text-primary); margin-bottom: 0.375rem; }
  .faq-a { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.65; }
  .hub-link { color: var(--color-accent); }

  @media (max-width: 640px) {
    .bcf-card { grid-template-columns: 1fr; gap: 0.75rem; padding: 1.25rem; }
  }
</style>
