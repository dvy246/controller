---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import reliabilityData from '../../data/reliabilityData.json';

const reliabilityModels = reliabilityData.models as Record<string, any>;

export function getStaticPaths() {
  const controllers = [
    {
      slug: 'xbox-elite-series-2',
      name: 'Xbox Elite Series 2',
      brand: 'Microsoft',
      type: 'Pro Gamepad',
      knownIssues: [
        'Tactile switch bumper (LB/RB) double-clicking or chatter',
        'Tension-adjustable stick module center offset',
        'Back paddle microswitch responsiveness'
      ],
      description: 'Complete diagnostic suite for Xbox Elite Series 2. Test 4x rear paddles, adjustable stick tension torque, and trigger stop calibration.',
      reliabilitySlug: null,
    },
    {
      slug: 'dualsense-edge',
      name: 'PlayStation DualSense Edge',
      brand: 'Sony',
      type: 'Pro Gamepad',
      knownIssues: [
        'Replaceable stick module zero-point misalignment',
        'Fn lever button mapping indices',
        'Adaptive trigger mechanical stop travel'
      ],
      description: 'Professional hardware tester for PS5 DualSense Edge. Verify swappable stick module drift %, back lever switches, and trigger travel profiles.',
      reliabilitySlug: 'dualsense-edge',
    },
    {
      slug: 'scuf-instinct-pro',
      name: 'SCUF Instinct Pro',
      brand: 'Corsair / SCUF',
      type: 'Esports Gamepad',
      knownIssues: [
        'Instant trigger mouse-click switch bounce',
        'Ergonomic rear paddle contact degradation'
      ],
      description: 'Hardware diagnostic wizard for SCUF Instinct Pro. Test ultra-fast instant triggers and ergonomic 4-paddle layout.',
      reliabilitySlug: null,
    },
    {
      slug: '8bitdo-ultimate',
      name: '8BitDo Ultimate Hall Effect',
      brand: '8BitDo',
      type: 'Hall Effect Gamepad',
      knownIssues: [
        'Magnetic center bounce under rapid snap-back',
        '2.4G wireless adapter report rate jitter'
      ],
      description: 'Hall Effect stick drift & circularity tester for 8BitDo Ultimate. Verify 0.01% drift stability and magnetic sensor precision.',
      reliabilitySlug: 'hall-effect-generic',
    },
    {
      slug: 'razer-wolverine-v2',
      name: 'Razer Wolverine V2 Pro',
      brand: 'Razer',
      type: 'Esports Gamepad',
      knownIssues: [
        'Mecha-tactile action button actuation point',
        'Multi-function top bumper (M1/M2) index mapping'
      ],
      description: 'Diagnostic tool for Razer Wolverine V2 Pro. Check mecha-tactile switch actuation speeds and multi-function remapped buttons.',
      reliabilitySlug: null,
    },
    {
      slug: 'switch-pro',
      name: 'Nintendo Switch Pro Controller',
      brand: 'Nintendo',
      type: 'Gamepad',
      knownIssues: [
        'D-Pad diagonal misinputs',
        'Minor stick powder buildup in housing'
      ],
      description: 'Hardware diagnostic suite for Nintendo Switch Pro Controller. Verify stick centering, D-pad diagonal accuracy, and button latency.',
      reliabilitySlug: 'switch-pro',
    },
    {
      slug: 'logitech-f310',
      name: 'Logitech F310 / F710',
      brand: 'Logitech',
      type: 'Classic Gamepad',
      knownIssues: [
        'DirectInput (D) vs XInput (X) toggle mode mismatch',
        'Floating D-Pad diagonal sensitivity'
      ],
      description: 'Online test tool for Logitech F310 & F710 wireless controllers. Verify XInput/DirectInput modes and floating D-pad diagonal accuracy.',
      reliabilitySlug: null,
    }
  ];

  return controllers.map((c) => ({
    params: { slug: c.slug },
    props: { controller: c }
  }));
}

const { slug } = Astro.params;
const { controller } = Astro.props;

const canonicalUrl = `https://controllertesting.com/controller/${slug}`;
const reliability =
  controller.reliabilitySlug && reliabilityModels[controller.reliabilitySlug]
    ? reliabilityModels[controller.reliabilitySlug]
    : null;

const breadcrumbs = [
  { name: 'Controller Profiles', url: '/controller' },
  { name: controller.name }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": controller.name,
  "description": controller.description,
  "brand": {
    "@type": "Brand",
    "name": controller.brand
  }
};
---

<BaseLayout
  title={`${controller.name} Hardware Test & Diagnostic Tool`}
  description={controller.description}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <Header />
  <section class="max-w-4xl mx-auto px-4 pt-24 pb-16">
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="text-center mb-12">
      <span class="badge-tag mb-3">{controller.brand} • {controller.type}</span>
      <h1 class="text-h1 mb-4">{controller.name} Diagnostic Suite</h1>
      <p class="text-secondary text-lg max-w-2xl mx-auto">
        {controller.description}
      </p>
    </div>

    <!-- Quick Action Links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <a href="/test/controller/drift" class="card-base p-4 rounded-xl text-center hover:border-accent-hover transition-colors group">
        <div class="text-accent font-bold mb-1 group-hover:underline">Test Stick Drift</div>
        <div class="text-xs text-secondary">Precision 0.1% Axis Check</div>
      </a>
      <a href={controller.reliabilitySlug ? `/reliability/${controller.reliabilitySlug}` : '/reliability'} class="card-base p-4 rounded-xl text-center hover:border-pass transition-colors group">
        <div class="text-pass font-bold mb-1 group-hover:underline">Reliability Benchmark</div>
        <div class="text-xs text-secondary">{controller.reliabilitySlug ? 'View Baseline Lifespan Data' : 'No Dataset Yet — View Hub'}</div>
      </a>
      <a href="/passport" class="card-base p-4 rounded-xl text-center hover:border-accent-hover transition-colors group">
        <div class="text-accent font-bold mb-1 group-hover:underline">Controller Passport™</div>
        <div class="text-xs text-secondary">Create Resale Certificate</div>
      </a>
    </div>

    <!-- Measured Reliability Baselines (from reliabilityData.json) -->
    {reliability && (
      <div class="card-base p-8 mb-12">
        <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
          <h2 class="section-title flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-pass" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Measured Reliability Baselines
          </h2>
          <a href={`/reliability/${controller.reliabilitySlug}`} class="text-pass text-sm font-medium hover:underline">
            Full reliability report →
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-surface-1 border border-border-subtle rounded-xl p-4">
            <div class="text-secondary text-xs font-medium mb-1">Avg 12-Month Drift</div>
            <div class="text-2xl font-bold text-warning font-mono tabular-nums">{reliability.avgDriftAfter12MonthsPercent}%</div>
          </div>
          <div class="bg-surface-1 border border-border-subtle rounded-xl p-4">
            <div class="text-secondary text-xs font-medium mb-1">Circularity Error</div>
            <div class="text-2xl font-bold text-accent font-mono tabular-nums">{reliability.avgCircularityErrorPercent}%</div>
          </div>
          <div class="bg-surface-1 border border-border-subtle rounded-xl p-4">
            <div class="text-secondary text-xs font-medium mb-1">Drift-Free Lifespan</div>
            <div class="text-2xl font-bold text-pass font-mono tabular-nums">{reliability.avgLifespanMonthsBeforeDrift} mo</div>
          </div>
          <div class="bg-surface-1 border border-border-subtle rounded-xl p-4">
            <div class="text-secondary text-xs font-medium mb-1">Dataset Samples</div>
            <div class="text-2xl font-bold text-primary font-mono tabular-nums">{reliability.samples.toLocaleString()}</div>
          </div>
        </div>
        <p class="text-xs text-tertiary mt-4">
          Baseline reference figures from {reliability.samples.toLocaleString()} documented test results (snapshot {reliabilityData.updatedAt}). Baselines, not a guarantee for any individual unit.
        </p>
      </div>
    )}

    <!-- Hardware Specific Known Issues -->
    <div class="card-base p-8 mb-12">
      <h2 class="section-title mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        Model-Specific Diagnostic Guidance: {controller.name}
      </h2>
      <ul class="space-y-3 text-secondary">
        {controller.knownIssues.map((issue) => (
          <li class="flex items-start gap-3">
            <span class="text-warning font-bold">•</span>
            <span>{issue}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Footer />
</BaseLayout>
