    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .stat-featured-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Orbit spin — transform-only, compositor friendly */
  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .stats-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    max-width: 1280px;
    margin-inline: auto;
  }

  .stat-block {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.5rem 2rem;
    border-right: 1px solid var(--color-border-subtle);
    text-align: center;
  }
  .stat-block:last-child { border-right: none; }

  .stat-number {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* ════════════════════════════════════════════════
     SECTION 3: TOOLS BENTO
     ════════════════════════════════════════════════ */
  .tools-section {
    padding: var(--spacing-section) 0;
  }

  .section-header-stack {
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }

  .section-heading {
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .section-heading.centered { text-align: center; }

  /* ── Bento ── */
  .tools-bento {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .bento-featured {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    padding: 2.25rem;
    text-decoration: none;
    overflow: hidden;
    transition: border-color var(--duration-normal), box-shadow var(--duration-normal), transform var(--duration-normal) var(--ease-spring);
    cursor: pointer;
  }

  .bento-featured:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 32px rgba(37, 99, 235, 0.12);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .bento-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent);
    color: white;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    margin-bottom: 0.875rem;
  }

  .bento-featured-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .bento-featured-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .bento-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-accent);
  }

  .bento-featured-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .health-score-mini-card {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .gauge-ring-wrap {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .gauge-svg { width: 100%; height: 100%; }

  .gauge-score-text {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .score-num {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .score-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    color: var(--color-pass);
    letter-spacing: 0.08em;
    margin-top: 0.15rem;
  }

  .gauge-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
  }

  .metric-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .metric-row:last-child { border-bottom: none; padding-bottom: 0; }

  .m-lbl { color: var(--color-text-tertiary); font-weight: 700; letter-spacing: 0.05em; }
  .m-val { font-weight: 700; }

  /* Tool grid — Spacious multi-column responsive grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.75rem;
    text-decoration: none;
    padding: 1.35rem;
    cursor: pointer;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    transition: background var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
  }

  .tool-card:hover {
    text-decoration: none;
    background: var(--color-surface-3);
    border-color: var(--color-border-default);
    transform: translateY(-2px);
  }

  .tool-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .tool-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }

  .tool-badge {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    background: rgba(37, 99, 235, 0.12);
    color: var(--color-accent);
    padding: 0.2em 0.5em;
    border-radius: 3px;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }


  .tool-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .tools-see-all {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  /* ── Whole-setup band (mouse + keyboard as first-class citizens) ── */
  .setup-band {
    margin-top: 2rem;
    padding: 1.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .setup-band-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 46ch;
  }

  .setup-band-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .setup-band-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .setup-band-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* ════════════════════════════════════════════════
     SECTION 4: JOURNEY
     ════════════════════════════════════════════════ */
  .journey-section {
    padding: var(--spacing-section) 0;
    background: var(--color-surface-1);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* ── Journey ── */
  .journey-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: start;
  }

  .journey-left { position: sticky; top: 100px; max-width: 480px; }

  .journey-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 38ch;
  }

  .journey-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .journey-step {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    text-decoration: none;
    transition: background var(--duration-fast);
    border-radius: var(--radius-sm);
    padding-inline: 0.75rem;
    cursor: pointer;
  }

  .journey-step:hover { background: var(--color-surface-3); text-decoration: none; }
  .journey-step:hover .step-arrow { color: var(--color-accent); transform: translateX(4px); }

  .step-num {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }

  .step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 0.25rem;
  }

  .step-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .step-arrow {
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    transition: color var(--duration-fast), transform var(--duration-fast);
  }

  /* ════════════════════════════════════════════════
     SECTION 5: GAMES
     ════════════════════════════════════════════════ */
  .games-section {
    padding: var(--spacing-section) 0;
  }

  .games-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .games-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .games-types {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .games-type {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .games-type-count {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .games-type-label {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  /* Game preview cards */
  /* ── Scroll-driven parallax wrapper ──
     Pure CSS `animation-timeline: view()`: transforms only, compositor thread.
     Guarded with @supports + prefers-reduced-motion so unsupported/reduced
     setups render the tree at rest (no CLS, no invisible content). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .games-cards-parallax {
        animation-name: games-cards-drift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 5% cover 95%;
        animation-duration: 1ms; /* Firefox requires non-zero duration */
        will-change: transform;
      }
    }
  }

  @keyframes games-cards-drift {
    from { transform: translate3d(0, -3%, 0); }
    to   { transform: translate3d(0, 3%, 0); }
  }

  .games-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 0.75rem;
  }

  .game-preview-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    grid-column: 1;
    grid-row: 1;
  }

  .game-preview-card.game-preview-sm {
    grid-column: 2;
    grid-row: 1;
  }

  .game-preview-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.875rem;
  }

  .game-preview-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.08em;
  }

  .game-preview-type {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(37, 99, 235, 0.1);
    color: var(--color-accent);
    padding: 0.15em 0.5em;
    border-radius: 3px;
  }
  .game-preview-type.sm { font-size: 0.55rem; }

  .game-preview-screen {
    position: relative;
    height: 80px;
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: 0.75rem;
    overflow: hidden;
  }

  .game-target {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px rgba(37, 99, 235, 0.6);
    transform: translate(-50%, -50%);
  }

  .game-crosshair {
    position: absolute;
    top: 50%;
    left: 45%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 16px;
    border: 2px solid var(--color-pass);
    border-radius: 50%;
  }

  .game-preview-stats {
    display: flex;
    gap: 0.75rem;
  }

  .gstat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  .gstat strong {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  /* Button grid in 2-player mini card */
  .button-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .btn-indicator {
    height: 32px;
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-tertiary);
  }

  .btn-indicator.active {
    background: var(--color-pass-bg);
    border-color: var(--color-pass);
    color: var(--color-pass);
  }

  /* Rewards card */
  .rewards-card {
    grid-column: 1 / -1;
    grid-row: 2;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem;
  }

  .rewards-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.875rem;
  }

  .rewards-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reward-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .reward-item svg { color: var(--color-accent); flex-shrink: 0; }

  /* ════════════════════════════════════════════════
     SECTION 6: MOAT COMPARISON
     ════════════════════════════════════════════════ */
  .moat-section {
    padding: var(--spacing-section) 0;
    background: var(--color-surface-1);
    border-top: 1px solid var(--color-border-subtle);
  }

  .moat-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .moat-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 56ch;
    margin: 1rem auto 0;
  }

  .moat-comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: start;
    max-width: 800px;
    margin-inline: auto;
  }

  .compare-col {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: 1.5rem;
  }

  .compare-col.compare-us {
    border-color: var(--color-accent);
    background: rgba(37, 99, 235, 0.04);
  }

  .compare-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1.125rem;
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .compare-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .compare-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: var(--text-small);
    line-height: 1.4;
  }

  .compare-item.good { color: var(--color-text-primary); }
  .compare-item.bad  { color: var(--color-text-tertiary); text-decoration: line-through; text-decoration-color: var(--color-fail); }

  .compare-item.good svg { color: var(--color-pass); flex-shrink: 0; margin-top: 1px; }
  .compare-item.bad svg  { color: var(--color-fail); flex-shrink: 0; margin-top: 1px; }

  /* ════════════════════════════════════════════════
     SECTION 7: FAQ — readable, scannable, and keyboard friendly
     ════════════════════════════════════════════════ */
  .faq-section {
    padding: var(--spacing-section) 0;
    background: var(--color-surface-0);
    border-top: 1px solid var(--color-border-subtle);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .faq-intro {
    position: sticky;
    top: 6rem;
  }

  .faq-intro p {
    max-width: 38ch;
    margin-top: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .compare-vs {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-tertiary);
    padding-top: 2rem;
    text-align: center;
    letter-spacing: 0.08em;
  }

  /* ════════════════════════════════════════════════
     SECTION 7: FINAL CTA
     ════════════════════════════════════════════════ */
  .cta-section {
    padding: var(--spacing-section) 0;
  }

  .cta-inner {
    text-align: center;
    border: 1px solid var(--color-border-default);
    background: var(--color-surface-2);
    border-radius: var(--radius-xl);
    padding: 4rem 3rem;
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 800px;
    margin-inline: auto;
  }

  /* Subtle ambient glow */
  .cta-inner::before {
    content: '';
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 200%;
    background: radial-gradient(ellipse, rgba(37, 99, 235, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-eyebrow {
    position: relative;
    z-index: 1;
  }

  .cta-heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text-primary);
    margin: 0.75rem 0 1rem;
    max-width: 20ch;
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .cta-desc {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 42ch;
    margin: 0 auto 2rem;
    position: relative;
    z-index: 1;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .cta-btn {
    font-size: 1.0625rem;
    padding: 0.875rem 2rem;
  }

  .cta-features {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: var(--text-small);
    color: var(--color-text-tertiary);
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  /* ════════════════════════════════════════════════
     RESPONSIVE
     ════════════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-visual { order: 0; max-width: 520px; margin-inline: auto; }
    .hero-content { max-width: 100%; }

    .tools-bento { grid-template-columns: 1fr; }
    .bento-featured { grid-template-columns: 1fr; }
    .bento-featured-visual { display: none; }

    .journey-layout { grid-template-columns: 1fr; }
    .journey-left { position: static; }

    .games-layout { grid-template-columns: 1fr; }

    .moat-comparison { grid-template-columns: 1fr; }
    .compare-vs { display: none; }

    .faq-layout { grid-template-columns: 1fr; gap: 2rem; }
    .faq-intro { position: static; }

