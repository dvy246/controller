---
/**
 * index.astro — ControllerTesting.com Homepage
 *
 * Design Read: Gaming tools hub landing for competitive + casual gamers.
 * Dark Tech language. Precision-engineering-dashboard meets premium hardware.
 * Dials: DESIGN_VARIANCE: 8 / MOTION_INTENSITY: 7 / VISUAL_DENSITY: 5
 *
 * Skills applied:
 *   - design-taste-frontend: asymmetric hero, no 3-equal-cards, anti-slop checks,
 *     max 1 eyebrow per 3 sections, Section-Layout-Repetition ban, spring physics
 *   - ui-ux-pro-max: 44px touch targets, WCAG AA contrast, cursor-pointer, focus states
 *   - minimalist-ui: macro-whitespace, Geist, 1px borders, typographic hierarchy
 *   - DESIGN.md: 5-layer surfaces, single cobalt accent, Geist Mono for data
 *
 * Hero: Left-aligned split (NOT centered — design-taste rule)
 * Sections: Hero → Stats → Bento Tools → Journey → Games → Moat → CTA → Footer
 * 8 sections, 4+ different layout families ✓
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import ControllerHero from '../../components/global/ControllerHero.astro';
import { useTranslations } from '../../i18n/utils';
const t = useTranslations('ja');

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ControllerTesting.com',
  url: 'https://controllertesting.com',
  description: 'Free controller test online for PS5, PS4, Xbox, Switch, and PC. Use a gamepad tester to check drift, buttons, triggers, polling rate, and rumble in your browser.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://controllertesting.com/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ControllerTesting.com',
  url: 'https://controllertesting.com',
  logo: 'https://controllertesting.com/favicon.svg',
};

const faqs = [
  {
    question: 'How do I run a controller test online?',
    answer: 'Open a test, connect your gamepad, and move the sticks or press the buttons when prompted. The browser reads supported controller input and shows the result without a download or account.',
  },
  {
    question: 'Can I run a PS4 controller test here?',
    answer: 'Yes. Connect a PS4 controller by USB or Bluetooth, then choose the relevant test. Results depend on the browser exposing the controller through the Gamepad API.',
  },
  {
    question: 'What does the gamepad tester check?',
    answer: 'The test suite can check analog stick drift, buttons, triggers, polling rate, vibration, circularity, latency, and other controller signals. Start with one focused test or use the full diagnostic.',
  },
  {
    question: 'Is ControllerTesting.com free to use?',
    answer: 'Yes. The browser-based controller tests are free to use, do not require an account, and keep the measurement session on your device.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const tools = [
  { name: 'Stick Drift Test', href: '/test/controller/drift', desc: 'Detect analog stick drift to 0.1% precision', badge: 'Most used', icon: 'drift' },
  { name: 'Full Diagnostic', href: '/test/controller/full-diagnostic', desc: 'Complete 2-minute controller health checkup', badge: 'フラッグシップ', icon: 'diagnostic' },
  { name: 'Button Tester', href: '/test/controller/buttons', desc: 'Test every button for ghosting and response', icon: 'buttons' },
  { name: 'Trigger Pressure', href: '/test/controller/triggers', desc: 'Measure analog trigger linearity and range', icon: 'triggers' },
  { name: 'Health Score', href: '/test/controller/health-score', desc: 'Get your controller\'s 0-100 score + grade', badge: 'Unique', icon: 'score' },
  { name: 'Deadzone Visualizer', href: '/test/controller/deadzone', desc: 'Find the perfect deadzone for your game', icon: 'deadzone' },
  { name: 'Polling Rate', href: '/test/controller/polling-rate', desc: 'Measure input frequency in Hz', icon: 'polling' },
  { name: 'Circularity Test', href: '/test/controller/circularity', desc: 'Check stick movement roundness and range', icon: 'circularity' },
];

const stats = [
  { value: '32', label: 'Hardware tools', mono: true },
  { value: '142k+', label: 'Controllers tested', mono: true },
  { value: '100%', label: 'Privacy preserving', mono: true },
  { value: '0', label: 'Installs required', mono: true },
];

const journeySteps = [
  { num: '01', title: 'Test', desc: 'Run the Full Diagnostic — takes 2 minutes. Get your Health Score.', href: '/test/controller/full-diagnostic' },
  { num: '02', title: 'Diagnose', desc: 'See exactly what\'s wrong. Drift percentage, trigger wear, button response.', href: '/test/controller/health-score' },
  { num: '03', title: 'Decide', desc: 'Fix vs Replace Calculator weighs repair cost against replacement price.', href: '/fix-or-replace' },
  { num: '04', title: 'Fix', desc: 'Step-by-step repair guide with embedded re-test to verify it worked.', href: '/warranty' },
  { num: '05', title: 'Optimize', desc: 'Get game-specific deadzone and sensitivity settings based on your test.', href: '/test/controller/competitive-readiness' },
];

function getToolIcon(icon: string) {
  switch (icon) {
    case 'drift':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-drift-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#06B6D4"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#g-drift-ja)" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="url(#g-drift-ja)" fill-opacity="0.3" stroke="#06B6D4" stroke-width="1.5"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/></svg>`;
    case 'diagnostic':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-diag-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#8B5CF6"/><stop offset="100%" stop-color="#EC4899"/></linearGradient></defs><rect x="3" y="4" width="18" height="16" rx="4" fill="url(#g-diag-ja)" fill-opacity="0.15" stroke="url(#g-diag-ja)" stroke-width="2"/><path d="M7 12h2.5l1.5-4 2.5 8 2-4h3.5" stroke="#EC4899" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    case 'buttons':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-btn-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="6" fill="url(#g-btn-ja)" fill-opacity="0.15" stroke="url(#g-btn-ja)" stroke-width="2"/><circle cx="16" cy="8.5" r="1.5" fill="#EF4444"/><circle cx="13.5" cy="12" r="1.5" fill="#3B82F6"/><circle cx="18.5" cy="12" r="1.5" fill="#10B981"/><circle cx="16" cy="15.5" r="1.5" fill="#F59E0B"/></svg>`;
    case 'triggers':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-trig-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#10B981"/><stop offset="100%" stop-color="#06B6D4"/></linearGradient></defs><rect x="4" y="3" width="6" height="18" rx="3" fill="url(#g-trig-ja)" fill-opacity="0.2" stroke="url(#g-trig-ja)" stroke-width="2"/><rect x="14" y="3" width="6" height="18" rx="3" fill="url(#g-trig-ja)" fill-opacity="0.2" stroke="url(#g-trig-ja)" stroke-width="2"/><rect x="4" y="10" width="6" height="11" rx="2" fill="#10B981"/><rect x="14" y="6" width="6" height="15" rx="2" fill="#06B6D4"/></svg>`;
    case 'score':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-score-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#g-score-ja)" fill-opacity="0.25" stroke="url(#g-score-ja)" stroke-width="2" stroke-linejoin="round"/></svg>`;
    case 'deadzone':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-dz-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#EF4444"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#g-dz-ja)" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="url(#g-dz-ja)" fill-opacity="0.25" stroke="#EF4444" stroke-width="1.5"/><path d="M12 7v10M7 12h10" stroke="#F59E0B" stroke-width="1.5"/></svg>`;
    case 'polling':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-hz-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#00F2FE"/><stop offset="100%" stop-color="#4FACFE"/></linearGradient></defs><path d="M2 13h4l3-8 4 14 3-10 2 4h4" stroke="url(#g-hz-ja)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    case 'circularity':
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-circ-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#2563EB"/><stop offset="100%" stop-color="#38BDF8"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#g-circ-ja)" stroke-width="2" stroke-dasharray="4 2"/><circle cx="12" cy="12" r="3" fill="#38BDF8"/><path d="M12 3v18M3 12h18" stroke="url(#g-circ-ja)" stroke-width="1.5" stroke-opacity="0.5"/></svg>`;
    default:
      return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="g-def-ja" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#60A5FA"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="6" fill="url(#g-def-ja)" fill-opacity="0.2" stroke="url(#g-def-ja)" stroke-width="2"/></svg>`;
  }
}
---

<BaseLayout
  title="コントローラーテスト オンライン | 無料ゲームパッドチェッカー"
  description="PS5、PS4、Xbox、Switch、PC用の無料コントローラーテストを実行。ドリフト、ボタン、トリガー、ポーリングレート、振動を確認します。"
  ogImage="https://controllertesting.com/images/controller-hero.jpg"
  ogImageAlt="White DualSense controller ready for an online controller test"
  ogImageWidth={736}
  ogImageHeight={1308}
  schema={[websiteSchema, orgSchema, faqSchema]}
  localized
>
  <Header />

  <main id="main-content">

    {/* ═══════════════════════════════════════════════════════
        SECTION 1: HERO — Asymmetric split (design-taste rule)
        ═══════════════════════════════════════════════════════ */}
    <section class="hero" aria-labelledby="hero-headline">
      {/* Aurora ambient background — CSS-only, transform-composited (see global.css) */}
      <div class="hero-aurora" aria-hidden="true"></div>
      <div class="hero-inner">

        {/* Left: Content */}
        <div class="hero-content">
          <div class="hero-kicker">
            <span class="hero-kicker-signal" aria-hidden="true"></span>
            <span>コントローラーテスト / 精密診断</span>
            <span class="hero-kicker-meta">ブラウザ / 準備完了</span>
          </div>
          <h1 id="hero-headline" class="text-hero mb-6">
            スティックドリフトを診断 <span class="text-accent">負ける前に。</span>
          </h1>
          <p class="hero-subtext">
            コントローラー、マウス、キーボードを瞬時にテスト。保証期間が切れる前にドリフト、レイテンシ、ボタンの故障を発見。これまで体験したことのない感覚を。
          </p>
          <div class="hero-ctas">
            <a href="/test/controller/full-diagnostic" class="btn-primary hero-cta-primary">
              コントローラーをテスト
              <span class="btn-icon-wrap"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </a>
            <a href="/test/controller/drift" class="btn-secondary hero-cta-secondary">
              ドリフトをチェック
            </a>
          </div>

          {/* Clean Telemetry Proof Pill (No fake avatar initials) */}
          <div class="hero-proof">
            <div class="rounded-full bg-surface-1 border border-surface-2 text-xs font-mono text-secondary flex items-center px-3 gap-2">
              <span class="text-pass font-bold">✓ 142,850+</span> 件のハードウェアテレメトリ測定
            </div>
          </div>
        </div>

        {/* Right: Hero visual */}
        {/* Right: Hero visual — Interactive SVG + Parallax Telemetry Engine */}
        <div class="hero-visual">
          <ControllerHero />
        </div>
      </div>

      {/* ── Compatibility strip — UNDER hero, not inside (design-taste rule) ── */}
      <div class="compat-strip">
        <span class="compat-label">対応デバイス</span>
        <div class="compat-icons" aria-label="Supported controllers: PS5, Xbox, Nintendo Switch, PC, Android, iOS">
          <span class="compat-item">PS5</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">PS4</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">Xbox</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">Nintendo Switch</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">PC</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">Android</span>
          <span class="compat-divider" aria-hidden="true"></span>
          <span class="compat-item">iOS</span>
        </div>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════
        SECTION 2: STATS — Full-width number display (different layout family)
        No eyebrow here (section 1 had none, will use one at section 4)
        ═══════════════════════════════════════════════════════ */}
    <section class="stats-section" aria-label="Platform statistics">
      {/* Telemetry stat card — CSS orbit dot + rAF count-up (progressive, no CLS) */}
      <div class="stat-featured" data-reveal>
        <div class="stat-featured-orbit" aria-hidden="true">
          <span class="stat-featured-orbit-dot"></span>
        </div>
        <div class="stat-featured-content">
          <span class="stat-featured-label">ライブハードウェアテレメトリ</span>
          <div class="stat-featured-value">
            <span class="stat-count-value" id="telemetry-count" data-count="142850">142k+</span>
            <span class="stat-featured-unit">サンプル</span>
          </div>
          <span class="stat-featured-desc">実際のコントローラーテストからのドリフト・円形度測定</span>
        </div>
      </div>

      <div class="stats-inner">
        {stats.map((stat) => (
          <div class="stat-block" data-reveal>
            <span class="stat-number" class:list={[{ mono: stat.mono }]}>{stat.value}</span>
            <span class="stat-desc">{stat.label}</span>
          </div>
        ))}
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════
        SECTION 3: TOOLS BENTO GRID — Asymmetric grid (different layout family)
        Eyebrow 1 of max-3 for 8 sections (ceil(8/3)=3)
        Bento: real visual variety — featured large cell + grid cells
        ═══════════════════════════════════════════════════════ */}
    <section class="tools-section" aria-labelledby="tools-heading">
      <div class="container-site">
        <div class="section-header-stack" data-reveal>
          <h2 id="tools-heading" class="section-heading">
            29のツール。1つのコントローラー。
            <br />必要なすべてのテスト。
          </h2>
        </div>

        {/* Bento: featured + grid (not 3-equal-cards!) */}
        <div class="tools-bento">

          {/* Featured large cell — real visual, not text-only */}
          <a href="/test/controller/health-score" class="bento-featured" data-reveal>
            <div class="bento-featured-content">
              <span class="bento-badge">フラッグシップ</span>
              <h3 class="bento-featured-title">コントローラーヘルススコア</h3>
              <p class="bento-featured-desc">
                ドリフト、ボタン、トリガー、ポーリングレート、
                円形度を1回の診断で測定する唯一の0-100スコア。評価を確認（A+〜F）。
              </p>
              <span class="bento-link">
                スコアを取得
                <span class="btn-icon-wrap"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </span>
            </div>
            <div class="bento-featured-visual" aria-hidden="true">
              <div class="health-score-mini-card">
                <div class="gauge-ring-wrap">
                  <svg width="120" height="120" viewBox="0 0 120 120" class="gauge-svg">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="var(--color-border-default)" stroke-width="10" />
                    <circle cx="60" cy="60" r="50" fill="none" stroke="var(--color-pass)" stroke-width="10" stroke-dasharray="314" stroke-dashoffset="62" stroke-linecap="round" transform="rotate(-90 60 60)" />
                  </svg>
                  <div class="gauge-score-text">
                    <span class="score-num">94</span>
                    <span class="score-label">GRADE A+</span>
                  </div>
                </div>
                <div class="gauge-metrics font-mono">
                  <div class="metric-row"><span class="m-lbl">DRIFT:</span><span class="m-val text-pass">0.04% PASSED</span></div>
                  <div class="metric-row"><span class="m-lbl">POLLING:</span><span class="m-val text-accent">1000 Hz</span></div>
                  <div class="metric-row"><span class="m-lbl">CIRCULARITY:</span><span class="m-val text-pass">0.08% PERFECT</span></div>
                </div>
              </div>
            </div>
          </a>

          {/* Tool grid cells */}
          <div class="tools-grid">
            {tools.slice(0, 7).map((tool) => (
              <a href={tool.href} class="tool-card card-base card-hover" data-reveal>
                <div class="tool-card-top">
                  <span class="tool-icon" aria-hidden="true" set:html={getToolIcon(tool.icon)} />
                  {tool.badge && (
                    <span class="tool-badge">{tool.badge}</span>
                  )}
                </div>
                <h3 class="text-h3">{tool.name}</h3>
                <p class="tool-desc">{tool.desc}</p>
              </a>
            ))}
          </div>
        </div>

        <div class="tools-see-all" data-reveal>
          <a href="/test/controller" class="btn-secondary">
            全29のコントローラーテストを見る
            <span class="btn-icon-wrap"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
          </a>
          <a href="/test/mouse" class="btn-ghost">マウステスト</a>
          <a href="/test/keyboard" class="btn-ghost">キーボードテスト</a>
        </div>

        {/* ── Whole-setup band: mouse + keyboard as first-class, not footnotes ── */}
        <div class="setup-band card-base" data-reveal>
          <div class="setup-band-head">
            <span class="badge-tag">フルセットアップテスト</span>
            <h3 class="setup-band-title">マウスとキーボードにも同じ待遇を。</h3>
            <p class="setup-band-desc">
              CPS速度、真のDPI、8Kポーリング、クリックレイテンシ、ダブルクリックの不具合、ホイールの状態—
              7つのマウスツール。さらにNKROマトリックス検証を備えたメカニカルキーボードサンドボックス。
            </p>
          </div>
          <div class="setup-band-links">
            <a href="/test/mouse/cps" class="btn-secondary">CPS Test</a>
            <a href="/test/mouse/dpi" class="btn-secondary">DPI Analyzer</a>
            <a href="/test/mouse/polling-rate" class="btn-secondary">8K Polling Rate</a>
            <a href="/test/mouse/double-click" class="btn-secondary">Double-Click Fault</a>
            <a href="/keyboard-tester/full" class="btn-ghost">キーボードサンドボックス</a>
          </div>
        </div>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════
        SECTION 4: JOURNEY — Numbered vertical timeline (different layout family)
        Eyebrow 2 of 3 (at section 4, with sections 5,6 having none)
        ═══════════════════════════════════════════════════════ */}
    <section class="journey-section" aria-labelledby="journey-heading">
      <div class="container-site">
        <div class="journey-layout">
          <div class="journey-left" data-reveal>
            <h2 id="journey-heading" class="section-heading">
              1つのプラットフォーム。
              <br />すべての答え。
            </h2>
            <p class="journey-desc">
              コントローラーの調子が悪いとき、現在は5〜8つのサイトを訪れて
              1つの問題を解決します。私たちは1つの場所ですべてを網羅しています。
            </p>
            <a href="/test/controller/full-diagnostic" class="btn-primary">
              旅を始める
            </a>
          </div>

          <div class="journey-steps">
            {journeySteps.map((step, i) => (
              <a href={step.href} class="journey-step" data-reveal style={`--delay: ${i * 80}ms`}>
                <span class="step-num" aria-hidden="true">{step.num}</span>
                <div class="step-content">
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-desc">{step.desc}</p>
                </div>
                <svg class="step-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ═══════════════════════════════════════════════════════
        SECTION 5: GAMES — Full-bleed dark with accent (different layout)
        No eyebrow (section 4 had one)
        ═══════════════════════════════════════════════════════ */}
    <section class="games-section" aria-labelledby="games-heading">
      <div class="container-site">
        <div class="games-layout">
          <div class="games-content" data-reveal>
            <h2 id="games-heading" class="section-heading">
              コントローラーをテスト.
              <br />そしてそれで遊ぶ。
            </h2>
            <p class="games-desc">
              あなたの入力に基づいて作られた5つのブラウザゲーム。XPを獲得し、
