---
/**
 * /reliability — Hardware Reliability Baselines Hub (flagship vertical)
 * All numbers trace directly to src/data/reliabilityData.json and are
 * explicitly modeled reference baselines — nothing invented.
 * No competitor has this content type (verified).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import reliabilityData from '@data/reliabilityData.json';

const models = Object.entries(reliabilityData.models as Record<string, any>);

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Reliability Data' }];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Controller Reliability Data — Stick Drift Baselines by Model',
    description: `Modeled reference baselines for stick drift and sensor reliability across 5 controller models (snapshot ${reliabilityData.updatedAt}).`,
    url: 'https://controllertesting.com/reliability/'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: models.map(([slug, m], index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: m.name,
      url: `https://controllertesting.com/reliability/${slug}`
    }))
  }
];
---

<BaseLayout
  title="Controller Reliability Data Hub | ControllerTesting"
  description={`Modeled reference baselines for stick drift and sensor reliability across 5 controller models (snapshot ${reliabilityData.updatedAt}).`}
  breadcrumbs={breadcrumbs}
  schema={schemaData}

  localized={false}>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-hero">
        <span class="badge-tag">Modeled Reference Baselines</span>
        <h1 class="text-h1 mb-2">Controller Reliability Data</h1>
        <p class="hub-subtitle">
          Modeled reference baselines for stick drift and sensor wear by model — engineering estimates,
          snapshot {reliabilityData.updatedAt}, not measured results. Baselines, not promises about any individual unit.
        </p>
      </header>

      <div class="model-grid">
        {models.map(([slug, m]) => (
          <a href={`/reliability/${slug}`} class="model-card card-base card-hover">
            <h2 class="model-name">{m.name}</h2>
            <div class="model-stats">
              <div class="stat">
                <span class="stat-label">12-mo drift</span>
                <span class="stat-value">{m.avgDriftAfter12MonthsPercent}%</span>
              </div>
              <div class="stat">
                <span class="stat-label">Circularity err</span>
                <span class="stat-value">{m.avgCircularityErrorPercent}%</span>
              </div>
              <div class="stat">
                <span class="stat-label">Drift-free lifespan</span>
                <span class="stat-value">{m.avgLifespanMonthsBeforeDrift} mo</span>
              </div>
            </div>
            <span class="model-samples">modeled reference baseline</span>
          </a>
        ))}
      </div>

      <section class="hub-note card-base">
        <h2 class="section-title">How to read this data</h2>
        <p class="hub-text">
          Higher 12-month drift % = more degradation in the reference model. Lower circularity error % = better range
          accuracy. Hall-effect controllers ({models.find(([, m]) => m.name.includes('Hall'))?.[1].avgDriftAfter12MonthsPercent}%
          at 12 months) show a large modeled gap over potentiometer sticks — that gap is the whole Hall-effect argument.
          These are modeled estimates, not a measured dataset: community telemetry starts at 0 and every consenting test
          makes the baselines sharper. See our <a href="/test/methodology" class="hub-link">methodology</a> for what browser
          testing can and cannot tell you.
        </p>
        <p class="hub-text mt-3">
          <a href="/reliability/dashboard" class="hub-link">Open the aggregate reliability dashboard &rarr;</a>
          &nbsp;&middot;&nbsp;
          <a href="/reliability/report" class="hub-link">Read the monthly baselines report &rarr;</a>
        </p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .hub-hero { margin-bottom: 2.5rem; }
  .hub-hero .badge-tag { margin-bottom: 0.75rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 70ch; }
  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
  .model-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; cursor: pointer; }
  .model-card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .model-name { font-size: 1.125rem; font-weight: 800; }
  .model-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: 0.75rem; }
  .stat-label { font-family: var(--font-mono); font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-tertiary); }
  .stat-value { font-family: var(--font-mono); font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); }
  .model-samples { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-text-tertiary); }
  .hub-note { padding: 2rem; }
  .hub-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; }
  .hub-link { color: var(--color-accent); }
</style>
