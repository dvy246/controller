---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import AuthorByline from '@components/global/AuthorByline.astro';
import Footer from '@components/global/Footer.astro';
import Header from '@components/global/Header.astro';
import reliabilityData from '@data/reliabilityData.json';

export function getStaticPaths() {
  const models = Object.keys(reliabilityData.models);
  return models.map((slug) => ({
    params: { slug },
    props: { modelData: (reliabilityData.models as Record<string, any>)[slug], slug }
  }));
}

const { slug } = Astro.params;
const { modelData } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Reliability Data', url: '/reliability' },
  { name: modelData.name },
];

const canonicalUrl = `https://controllertesting.com/reliability/${slug}`;

const modelEditorial: Record<string, string> = {
  'ps5-dualsense': "The DualSense is a potentiometer-based controller wrapped in modern firmware, which matters for how its drift actually presents: the carbon-film wear lives almost entirely on the left stick Y-axis because that is the axis your character walks on, and the controller's aggressive circular deadzone correction tends to hide early degradation from the raw readings. Community teardown reports consistently point at the left stick module as the first failure point, typically appearing as a springy re-centering stick rather than hard drift. The good news is that the module is a standard size and replacement sticks for the DualSense are widely available, so a diagnosed drift does not end the controller's life — plan for a module swap rather than a full replacement.",
  'xbox-series-x': "The Xbox Series controller's known failure points are unusual in that stick drift is not always the first complaint — bumpers (LB/RB) are the most frequently reported failing switch, showing up as intermittent clicks or double-registration before the sticks ever degrade. When the sticks do drift, it typically surfaces under high tension input, meaning sustained forward or diagonal pressure rather than at rest, which is the opposite presentation from a Sony pad. Because the Series controller uses standard ALPS modules, stick replacement is straightforward, but the bumper switch is a surface-mount component that requires soldering — check the bumpers first with the button matrix test before you assume the problem is the stick.",
  'switch-pro': "The Switch Pro Controller is best known in the community for two specific quirks rather than general stick wear: D-pad diagonal misinputs, where a single direction press occasionally registers two diagonals at once, and a powdery residue that builds up inside the stick housing from the pad's materials rubbing together. Neither is true sensor failure — the D-pad issue is a membrane contact geometry problem, and the powder is cosmetic wear that a cleaning pass usually fixes. Actual stick drift on the Pro Controller is comparatively rare, but when it does happen it is typically the left stick after heavy use in games that hold forward on a virtual thumbstick. Because the Pro Controller's sticks are soldered to the board, repair is more involved than on a module-swap pad, so treat early cleaning as preventive maintenance.",
  'dualsense-edge': 'The DualSense Edge is designed around repairability: its stick modules are swappable without any soldering, which fundamentally changes the drift math — a diagnosed module can be replaced in minutes at the cost of a new stick assembly rather than a new controller. The known wear characteristics on the Edge are therefore more about the removable parts: the swappable stick module itself wears exactly like a standard potentiometer module, and the back paddles are the other frequent report, showing microswitch looseness as a rattle or an occasional missed press. Because the Edge carries a premium price, the practical advice is to test the swappable modules against each other when you see drift — swapping the left and right sticks tells you instantly whether the fault follows the module (replace it) or stays on the board (a deeper issue).',
  'hall-effect-generic': 'A Hall effect controller replaces the carbon wiper with a magnetic field sensor, so its drift profile is fundamentally different: instead of track wear there is electronic centering, and the failure mode is a software-tunable center offset rather than a physically worn path. The two known quirks are a magnetic center bounce — a small wobble around neutral that firmware deadzone tuning absorbs — and an occasional factory centering offset that the first calibration pass removes. Because there is no physical contact in the sensing element, a Hall stick that drifts heavily is almost always a firmware, magnet-mount, or controller firmware issue rather than mechanical wear, so recalibrate before you consider replacing the module, and expect these sensors to outlast a standard carbon potentiometer by a wide margin in pure wear terms.',
};
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": `${modelData.name} Hardware Stick Drift & Sensor Reliability Baseline`,
  "description": `Modeled reference figures for stick drift degradation, circularity error %, and sensor lifespan for ${modelData.name} (snapshot ${reliabilityData.updatedAt}). Reference estimates — not a guarantee for any individual unit.`,
  "url": canonicalUrl,
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "creator": {
    "@type": "Organization",
    "name": "ControllerTesting.com"
  }
};
---

<BaseLayout
  title={`${modelData.name.replace('Nintendo Switch Pro Controller','Switch Pro')} Reliability | CT`}
  description={`Modeled reference figures for stick drift magnitude, circularity error %, and sensor wear for ${modelData.name} (snapshot ${reliabilityData.updatedAt}).`}
  canonical={canonicalUrl}
  breadcrumbs={breadcrumbs}
  schema={schemaData}

  localized={false}>
  <Header />

  <main class="reliability-report-page container-site page-layout">
    <Breadcrumbs items={breadcrumbs} />
    
    <header class="report-hero card-base card-gradient text-center">
      <div class="badge-tag live-badge mb-4 items-center gap-2">
        <span class="live-dot"></span>
        Modeled Reference Baseline • Snapshot {reliabilityData.updatedAt}
      </div>
      <h1 class="text-h1 mb-4">{modelData.name} Reliability Report</h1>
      <p class="text-lead text-secondary max-w-prose mx-auto">
        Modeled reference figures for stick drift degradation, circularity error, and sensor wear — engineering
        estimates, not measured results. Every unit is different — measure yours directly with our free diagnostics.
      </p>
      <div class="mt-8">
        <AuthorByline
          datePublished="2026-08-02"
          dateModified="2026-08-10"
          readingTime="4 min read"
        />
      </div>
      <div class="mt-8">
        <a href="/test/controller/drift" class="btn-primary">Test Your Controller</a>
      </div>
    </header>

    <div class="metrics-grid">
      <div class="metric-card card-base">
        <div class="metric-label text-tertiary">Avg 12-Month Drift</div>
        <div class="metric-value mono text-warning">{modelData.avgDriftAfter12MonthsPercent}%</div>
        <p class="metric-desc text-secondary">Modeled static offset at rest</p>
      </div>

      <div class="metric-card card-base">
        <div class="metric-label text-tertiary">Avg Circularity Error</div>
        <div class="metric-value mono text-accent">{modelData.avgCircularityErrorPercent}%</div>
        <p class="metric-desc text-secondary">Deviation from 100% outer circle</p>
      </div>

      <div class="metric-card card-base">
        <div class="metric-label text-tertiary">Avg Drift-Free Lifespan</div>
        <div class="metric-value mono text-pass">{modelData.avgLifespanMonthsBeforeDrift} Mo</div>
        <p class="metric-desc text-secondary">Before >2.5% deadzone tuning required</p>
      </div>
    </div>

    <section class="percentile-section card-base mb-12 p-6 sm:p-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-6">Drift Magnitude Percentiles</h2>
      <div class="table-container" aria-label="Drift magnitude percentile thresholds for {modelData.name}">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Tier</th>
              <th scope="col">Drift Threshold (%)</th>
              <th scope="col">Percentile Standing</th>
              <th scope="col">Recommended Action</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-semibold text-pass">Excellent</td>
              <td class="mono">≤ {modelData.percentileThresholds.excellent}%</td>
              <td>Top 10% cleanest sensors</td>
              <td>No action needed (0% deadzone)</td>
            </tr>
            <tr>
              <td class="font-semibold text-accent">Good</td>
              <td class="mono">≤ {modelData.percentileThresholds.good}%</td>
              <td>Top 30% normal wear</td>
              <td>Default game deadzone (2-3%)</td>
            </tr>
            <tr>
              <td class="font-semibold text-warning">Average</td>
              <td class="mono">≤ {modelData.percentileThresholds.average}%</td>
              <td>50th percentile baseline</td>
              <td>Set 5% deadzone in settings</td>
            </tr>
            <tr>
              <td class="font-semibold text-fail">Poor / Degraded</td>
              <td class="mono">> {modelData.percentileThresholds.average}%</td>
              <td>Bottom 20% high drift</td>
              <td>Clean potentiometers or replace module</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="issues-section card-base mb-12 p-6 sm:p-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-6">Known Wear Characteristics</h2>
      <ul class="issues-list">
        {modelData.commonIssues.map((issue: string) => (
          <li>{issue}</li>
        ))}
      </ul>
      {modelEditorial[slug] && (
        <div class="card-base mb-12 p-6 sm:p-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-4">Model Analysis & Repair Notes</h2>
          <p class="text-secondary leading-relaxed">{modelEditorial[slug]}</p>
        </div>
      )}
      <div class="data-notice mt-8 pt-6 border-t border-border-subtle text-small text-tertiary">
        <p>
          <strong>About this data:</strong> this is a static baseline snapshot (compiled {reliabilityData.updatedAt}), not live telemetry.
          Figures are aggregated reference values; your individual controller may perform better or worse.
          For a measurement of your own hardware, run the <a href="/test/controller/drift" class="text-accent underline hover:text-[var(--color-accent-hover)] transition-colors">Stick Drift Detector</a> or the <a href="/test/controller/circularity" class="text-accent underline hover:text-[var(--color-accent-hover)] transition-colors">Circularity Test</a>.
        </p>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .reliability-report-page {
    padding-top: 80px;
    padding-bottom: var(--spacing-section);
  }

  .report-hero {
    margin-bottom: 3rem;
    padding: 4rem 2rem;
  }

  .live-badge {
    color: var(--color-pass);
    background: color-mix(in srgb, var(--color-pass) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-pass) 22%, transparent);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-pass);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-pass) 70%, transparent); }
    70% { opacity: 0.4; box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-pass) 0%, transparent); }
    100% { opacity: 1; box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-pass) 0%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .metric-card {
    padding: 2rem;
    text-align: center;
    transition: transform 0.2s var(--ease-spring);
  }

  .metric-card:hover {
    transform: translateY(-4px);
  }

  .metric-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .metric-value {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .metric-desc {
    font-size: var(--text-small);
  }

  .table-container {
    overflow-x: auto;
  }

  .data-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    text-align: left;
  }

  .data-table th {
    background: var(--color-surface-2);
    padding: 1rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .data-table th:first-child { border-top-left-radius: var(--radius-sm); }
  .data-table th:last-child { border-top-right-radius: var(--radius-sm); }

  .data-table td {
    padding: 1.25rem 1.5rem;
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
  }

  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background: rgba(255, 255, 255, 0.02); }

  .data-table .mono { font-variant-numeric: tabular-nums; }

  .issues-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .issues-list li {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .issues-list li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--color-warning);
    font-weight: bold;
    font-size: 1.25rem;
    line-height: 1;
  }

  @media (max-width: 768px) {
    .metrics-grid { grid-template-columns: 1fr; }
  }
</style>
