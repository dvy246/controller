---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import OverclockValidator from '../../../components/tools/controller/OverclockValidator.astro';

export function getStaticPaths() {
  const controllers = [
    { slug: 'ps5', name: 'DualSense' },
    { slug: 'ps4', name: 'DualShock 4' }
  ];
  
  const connections = [
    { slug: 'usb-c', name: 'Wired (USB-C)' },
    { slug: 'bluetooth', name: 'Bluetooth' }
  ];
  
  return controllers.flatMap(controller => 
    connections.map(connection => ({
      params: { 
        controller: controller.slug,
        connection: connection.slug
      },
      props: { 
        controllerName: controller.name,
        connectionName: connection.name
      }
    }))
  );
}

const { controller, connection } = Astro.params;
const { controllerName, connectionName } = Astro.props;

const title = `${controllerName} ${connectionName} Overclock Validator | ControllerTesting.com`;
const description = `Test and validate the true hardware polling rate (Hz) and input jitter of your ${controllerName} via ${connectionName}. Verify your hidusbf overclock settings in real-time.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Overclock Validator' }
];

// Schema markup for SEO
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "High-Frequency Overclock Validator",
  "applicationCategory": "DiagnosticTool",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Can I overclock a ${controllerName}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, using utilities like LordOfMice's hidusbf on PC, you can increase the USB polling rate of the ${controllerName} to 1000Hz (1ms) to reduce input lag. Note that Bluetooth polling rates are handled differently by your Bluetooth adapter.`
      }
    },
    {
      "@type": "Question",
      "name": "What does a high jitter mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High jitter (standard deviation) means the time between inputs is inconsistent. Even if average Hz is high, erratic frame pacing can make aim feel floaty. A stable 500Hz is often better than an unstable 1000Hz."
      }
    }
  ]
};
---

<ToolLayout 
  title={title}
  description={description}
  category="Diagnostic Tools"
  toolName="Overclock Validator"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight mb-4 font-geist">
        {controllerName} <span class="text-blue-500">Overclock Validator</span>
      </h1>
      <p class="text-lg text-surface-content-muted max-w-2xl mx-auto">
        Testing connection type: <strong class="text-white bg-surface-2 px-2 py-1 rounded-md">{connectionName}</strong>. 
        Move your analog sticks continuously to generate real-time polling data and verify your hidusbf target.
      </p>
    </div>

    <div class="mb-16">
      <OverclockValidator />
    </div>
    
    <div class="prose prose-invert prose-blue max-w-3xl mx-auto mt-16">
      <h2 class="font-geist text-2xl font-bold mb-4">About Controller Overclocking</h2>
      
      <div class="bg-surface-1 border border-surface-2 rounded-xl p-6 mb-8">
        <h3 class="text-xl font-bold mb-2">How to use this validator</h3>
        <ol class="list-decimal pl-5 space-y-2 text-surface-content">
          <li>Ensure your {controllerName} is connected via {connectionName}.</li>
          <li>Press any button to wake the Gamepad API.</li>
          <li>Move the analog sticks in rapid, continuous circles.</li>
          <li>Watch the telemetry graph stabilize to see your true hardware polling rate.</li>
        </ol>
      </div>

      <div class="space-y-6">
        <div>
          <h3 class="text-lg font-bold text-white mb-2">Is 1000Hz (1ms) always better?</h3>
          <p class="text-surface-content">
            Not necessarily. While 1000Hz reduces average input latency by a few milliseconds compared to 250Hz, it demands more CPU cycles. The key metric is <strong>stability (Jitter)</strong>. An overclock that results in severe frame pacing spikes can feel worse than a rock-solid lower polling rate.
          </p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-white mb-2">Does hidusbf work on Bluetooth?</h3>
          <p class="text-surface-content">
            No, the popular LordOfMice hidusbf utility only overrides USB device descriptor limits. Overclocking Bluetooth requires changing the polling interval in your OS Bluetooth stack or using custom dongles.
          </p>
        </div>
      </div>
    </div>
  </div>
</ToolLayout>
