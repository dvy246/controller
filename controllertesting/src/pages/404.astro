---
/**
 * 404.astro — Custom 404 Page Not Found Page
 * SEO Title: Page Not Found (404) | ControllerTesting.com
 */

import BaseLayout from '../layouts/BaseLayout.astro';

const popularTools = [
  { name: 'Stick Drift Detector', href: '/test/controller/drift', desc: 'Test analog stick drift to 0.1% accuracy' },
  { name: 'Full Diagnostic Wizard', href: '/test/controller/full-diagnostic', desc: '5-step guided hardware checkup' },
  { name: 'Controller Health Score™', href: '/test/controller/health-score', desc: 'Calculate 0-100 hardware health grade' },
  { name: 'Mouse Polling Rate', href: '/test/mouse/polling-rate', desc: 'Measure mouse report frequency in Hz' },
];
---

<BaseLayout
  title="404 — Page Not Found | ControllerTesting.com"
  description="The requested page could not be found. Return to ControllerTesting.com diagnostic tools."
  noindex={true}
>
  <div class="error-container">
    <div class="error-badge">ERROR 404</div>
    <h1 class="error-title text-gradient">Input Signal Lost</h1>
    <p class="error-desc">
      The requested URL was not found on our server. The diagnostic route may have moved or been updated.
    </p>

    <div class="cta-row">
      <a href="/" class="btn-primary">Return Home</a>
      <a href="/test/controller" class="btn-secondary">View All Controller Tools</a>
    </div>

    <div class="popular-section">
      <h2 class="section-subtitle">Popular Diagnostic Tools</h2>
      <div class="popular-grid">
        {popularTools.map((tool) => (
          <a href={tool.href} class="popular-card card-base card-hover">
            <h3 class="tool-name">{tool.name}</h3>
            <p class="tool-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    max-width: 800px;
    margin: 4rem auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .error-badge {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-fail);
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.05em;
  }
  .error-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
  }
  .error-desc {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 540px;
    line-height: 1.6;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: var(--color-surface-2);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-secondary:hover {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
  }
  .popular-section {
    width: 100%;
    margin-top: 3rem;
    text-align: left;
  }
  .section-subtitle {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    text-align: center;
  }
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    text-decoration: none;
  }
  .tool-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .tool-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  @media (max-width: 640px) {
    .popular-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
