---
/**
 * 404.astro — Custom 404 Page Not Found Page
 * SEO Title: Page Not Found (404) | ControllerTesting.com
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Page Not Found' }
];

const popularTools = [
  { name: 'Stick Drift Detector', href: '/test/controller/drift', desc: 'Test analog stick drift to 0.1% accuracy' },
  { name: 'Full Diagnostic Wizard', href: '/test/controller/full-diagnostic', desc: '5-step guided hardware checkup' },
  { name: 'Controller Health Score™', href: '/test/controller/health-score', desc: 'Calculate 0-100 hardware health grade' },
  { name: 'Mouse Polling Rate', href: '/test/mouse/polling-rate', desc: 'Measure mouse report frequency in Hz' },
];
---

<BaseLayout
  title="404 — Page Not Found | ControllerTesting"
  description="The requested page could not be found. Return to ControllerTesting.com diagnostic tools."
  noindex={true}
  breadcrumbs={breadcrumbs}

  localized={false}>
  <Header />
  <div class="error-container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="error-badge">ERROR 404</div>
    <h1 class="text-h1 text-gradient">Input Signal Lost</h1>
    <p class="error-desc">
      The requested URL was not found on our server. The diagnostic route may have moved or been updated.
    </p>

    <div class="cta-row">
      <a href="/" class="btn-primary">Return Home</a>
      <a href="/test/controller" class="btn-secondary">View All Controller Tools</a>
    </div>

    <div class="popular-section">
      <h2 class="section-title mb-3">Popular Diagnostic Tools</h2>
      <div class="popular-grid">
        {popularTools.map((tool) => (
          <a href={tool.href} class="popular-card card-base card-hover">
            <h3 class="text-h3">{tool.name}</h3>
            <p class="tool-desc">{tool.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  .error-container {
    max-width: 800px;
    padding-top: calc(var(--header-height, 64px) + 2rem);
    margin: 0 auto 4rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .error-badge {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-fail);
    background: color-mix(in srgb, var(--color-fail) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-fail) 20%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.05em;
  }
  .error-desc {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 540px;
    line-height: 1.6;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .popular-section {
    width: 100%;
    margin-top: 3rem;
    text-align: left;
  }
  .popular-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .popular-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    text-decoration: none;
  }
  .tool-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }
  @media (max-width: 640px) {
    .popular-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
