---
/**
 * /test/controller/quick-health — Express 60-Second Controller Health Check Page
 * SEO Title: 60-Second Quick Controller Health Check — Express Diagnostic Tool
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import QuickHealth from '../../../components/tools/controller/QuickHealth.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Quick Health Check' },
];

const faqs = [
  {
    question: 'What is the 60-Second Quick Health Check?',
    answer: 'The Quick Health Check is an express 60-second guided diagnostic that tests stick drift, button matrix actuation, and trigger linearity in continuous guided phases.',
  },
  {
    question: 'How is the Quick Health Score calculated?',
    answer: 'The score (0-100) combines resting thumbstick zero-point drift %, face button matrix coverage, and L2/R2 analog trigger pressure travel.',
  },
  {
    question: 'Can I save my Quick Health results to my Passport?',
    answer: 'Yes! Upon completing the 60-second check, your results are automatically saved to your local Controller Passport history and award 50 XP.',
  },
];
---

<ToolLayout
  title="60-Second Quick Controller Health Check — Express Hardware Diagnostic | ControllerTesting.com"
  description="Run an express 60-second guided controller checkup. Test stick drift, face button matrix, and trigger pressure in under a minute. Save results to your Controller Passport."
  toolName="Quick Health Check (60s)"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <QuickHealth />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <div class="flex items-center gap-3 mb-6">
        <span class="w-3 h-3 rounded-full bg-accent animate-pulse"></span>
        <h2 class="text-2xl font-bold tracking-tight text-primary">Understanding Express Health Verdicts</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-gradient p-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/5 hover:border-emerald-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="badge-pass font-mono text-xs px-2.5 py-1 rounded-md font-bold inline-block mb-3">Grade A+ (90–100)</span>
          <h3 class="text-lg font-bold text-primary mb-2">Esports Ready</h3>
          <p class="text-sm text-secondary leading-relaxed">Zero measurable drift, 100% button actuation, and perfect analog trigger linearity.</p>
        </div>

        <div class="card-gradient p-6 rounded-2xl border border-amber-500/30 bg-amber-500/5 hover:border-amber-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <span class="badge-warning font-mono text-xs px-2.5 py-1 rounded-md font-bold inline-block mb-3">Grade B (70–89)</span>
          <h3 class="text-lg font-bold text-primary mb-2">Minor Wear</h3>
          <p class="text-sm text-secondary leading-relaxed">Minor stick drift (2-5%) or button wear. Deadzone adjustment recommended.</p>
        </div>

        <div class="card-gradient p-6 rounded-2xl border border-red-500/30 bg-red-500/5 hover:border-red-500/50 transition-all">
          <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center mb-4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <span class="badge-fail font-mono text-xs px-2.5 py-1 rounded-md font-bold inline-block mb-3">Grade C (&lt;70)</span>
          <h3 class="text-lg font-bold text-primary mb-2">Module Fault</h3>
          <p class="text-sm text-secondary leading-relaxed">Significant drift (&gt;5%) or sticky buttons. Module cleaning or replacement required.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner flex items-center justify-between gap-4 flex-wrap p-6 rounded-2xl bg-surface-2 border border-surface-3">
      <div>
        <h3 class="export-title text-lg font-bold">Need a full 5-step deep dive?</h3>
        <p class="export-desc text-xs text-secondary">Run our 2-minute Flagship Full Diagnostic Wizard for detailed rumble and circularity testing.</p>
      </div>
      <div class="export-buttons flex gap-3">
        <a href="/test/controller/full-diagnostic" class="btn-primary">Full Diagnostic Wizard</a>
        <a href="/passport" class="btn-secondary">View Resale Passport</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/full-diagnostic" class="tool-card card-base card-hover p-4 rounded-xl">
      <span class="tool-badge text-xs text-accent font-mono font-bold">Flagship</span>
      <h3 class="tool-name font-bold text-primary text-base mt-1">Full Diagnostic Wizard</h3>
      <p class="tool-desc text-xs text-secondary">Test drift, buttons, triggers, and rumble in 2 minutes.</p>
    </a>
    <a href="/test/controller/drift" class="tool-card card-base card-hover p-4 rounded-xl">
      <h3 class="tool-name font-bold text-primary text-base">Stick Drift Detector</h3>
      <p class="tool-desc text-xs text-secondary">Precision 0.1% axis drift canvas visualizer.</p>
    </a>
    <a href="/test/controller/health-score" class="tool-card card-base card-hover p-4 rounded-xl">
      <h3 class="tool-name font-bold text-primary text-base">Health Score™</h3>
      <p class="tool-desc text-xs text-secondary">Calculate 0-100 hardware health grade & report card.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover p-4 rounded-xl">
      <h3 class="tool-name font-bold text-primary text-base">Polling Rate Checker</h3>
      <p class="tool-desc text-xs text-secondary">Test controller report frequency in Hz.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2 class="text-xl font-bold text-primary mb-3">Why Use the 60-Second Quick Controller Health Check?</h2>
    <p class="text-sm text-secondary leading-relaxed mb-4">
      When buying a used controller, prepping for a tournament match, or troubleshooting sudden aim issues, you don't always have time for extensive manual testing. Our 60-Second Quick Health Check automates stick drift sampling, button responsiveness, and trigger pressure verification into four 15-second guided phases.
    </p>

    <h3 class="text-lg font-bold text-primary mb-2">What Does the 60-Second Test Cover?</h3>
    <ul class="list-disc ml-5 text-sm text-secondary leading-relaxed space-y-1 mb-4">
      <li><strong>Phase 1: Stick Drift & Zero-Point Error:</strong> Measures resting thumbstick drift percentage and axis center offset.</li>
      <li><strong>Phase 2: Button Response Matrix:</strong> Confirms face action button (A/B/X/Y or Cross/Circle/Square/Triangle), D-pad, and shoulder bumper actuations.</li>
      <li><strong>Phase 3: Trigger Linearity:</strong> Evaluates L2/R2 analog trigger pressure from 0% resting to 100% full travel.</li>
      <li><strong>Phase 4: Express Score & Passport Record:</strong> Calculates an overall hardware score, awards 50 XP, and logs your test snapshot into your Controller Passport.</li>
    </ul>
  </Fragment>
</ToolLayout>

<style>
  .text-emerald { color: #10B981; }
  .text-warning { color: #F59E0B; }
  .text-fail { color: #EF4444; }
  .bg-emerald\/10 { background: rgba(16, 185, 129, 0.1); }
  .bg-warning\/10 { background: rgba(245, 158, 11, 0.1); }
  .bg-fail\/10 { background: rgba(239, 68, 68, 0.1); }
  .border-emerald\/30 { border-color: rgba(16, 185, 129, 0.3); }
  .border-warning\/30 { border-color: rgba(245, 158, 11, 0.3); }
  .border-fail\/30 { border-color: rgba(239, 68, 68, 0.3); }
</style>
