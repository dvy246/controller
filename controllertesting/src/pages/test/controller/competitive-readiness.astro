---
/**
 * /test/controller/competitive-readiness — Competitive Readiness Assessor
 * Master SEO & Technical Content Optimization
 * Primary keyword: competitive controller test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import CompetitiveReadiness from '@components/tools/controller/CompetitiveReadiness.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Competitive Readiness' },
];

const faqs = [
  {
    question: 'What is the Controller Competitive Readiness Benchmark?',
    answer: 'The Competitive Readiness Benchmark checks resting stick drift (under 2.0%), circularity error (under 8.5%) and whether both triggers reach full travel, using live input from your controller. The thresholds are this site\'s own benchmarks for low-deadzone play, not league rules.',
  },
  {
    question: 'Why is low stick drift critical for rotational aim assist in FPS games?',
    answer: 'In Apex Legends, Call of Duty: Warzone, and Fortnite, rotational aim assist engages automatically when player velocity crosses zero. A drifting stick forces you to raise the deadzone, which swallows small aim corrections.',
  },
  {
    question: 'What does the Competitive Ready result require?',
    answer: 'Competitive Ready means resting drift under 2.0% on both sticks, average circularity error under 8.5%, and both triggers reaching full travel during the 10-second test. These thresholds are ControllerTesting.com benchmarks for low-deadzone play; ALGS, CDL and other leagues do not publish controller hardware specs.',
  },
  {
    question: 'Should competitive controller players overclock to 1000Hz?',
    answer: 'It can help on PC. A wired DualSense or DualShock 4 can be polled faster with community USB tools, shortening the gap between reports from about 4ms to 1ms. The gain is small next to game and display latency, and it does not apply on consoles.',
  },
  {
    question: 'Are Hall-effect controllers legal in official esports tournaments?',
    answer: 'Hall-effect controllers are widely used in competitive play, but legality is set per event: check the current rulebook for your league or tournament, and disable turbo or macro functions, which are commonly banned.',
  }
];
---

<ToolLayout
  title="Competitive Controller Readiness Test | CT"
  description="Check whether your controller is clean enough for low-deadzone competitive play: live stick drift, circularity and trigger travel, with clear pass thresholds."
  keywords="competitive controller test, controller readiness check, stick drift competitive, low deadzone controller test"
  toolName="Competitive Controller Readiness Test"
  category="Flagship Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <CompetitiveReadiness />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Readiness thresholds</h2>
      <p class="results-text">
        Live measurements compared against this site's competitive benchmarks (these are our thresholds, not official league rules):
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Competitive Ready</strong>
          <p class="legend-text">Drift &lt; 2.0% | Circularity &lt; 8.5% | Triggers reach full range. Clean enough for 0–3% in-game deadzones.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Playable (Tuning Needed)</strong>
          <p class="legend-text">Drift 2.1%–5.0% | Circularity 8.6%–12.5%. Minor stick wear; expect to run a deadzone of about 5%.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Needs Repair</strong>
          <p class="legend-text">Drift &gt; 5.0%. The deadzone needed to hide it will noticeably blunt fine aim; clean or replace the stick.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Save your results as a report</h3>
        <p class="export-desc">Create a 0–100 Controller Health Score report you can keep or share. It is a self-test, not a tournament certification.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/health-score" class="btn-primary">Generate Health Report</a>
        <a href="/test/controller/full-diagnostic" class="btn-secondary">Run Full Wizard</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/deadzone" class="tool-card card-base card-hover">
      <h3 class="tool-name">Deadzone Visualizer</h3>
      <p class="tool-desc">Calculate minimum in-game deadzones.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Measure input update frequency in Hz.</p>
    </a>
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Isolated 0.1% stick centering detector.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>What "competitive ready" means here</h2>
    <p>
      Competitive leagues such as ALGS or the Call of Duty League publish rules about controller features (turbo,
      macros, approved hardware), not drift or circularity limits. This test answers a narrower question: is your
      stick clean enough to run a very low in-game deadzone without the crosshair wandering?
    </p>

    <h3>The three checks</h3>
    <ol>
      <li>
        <strong>Resting stick drift (under 2.0%):</strong> low enough that a 0–3% in-game deadzone hides it, so small
        aim corrections still register.
      </li>
      <li>
        <strong>Circularity error (under 8.5%):</strong> the stick reaches roughly the same speed in every direction,
        so diagonal flicks behave like straight ones.
      </li>
      <li>
        <strong>Trigger travel:</strong> both triggers reach full 1.0 during the test; a trigger that stops short can
        miss shots in games that need a full pull.
      </li>
    </ol>
    <p>
      If a check fails, the <a href="/test/controller/drift" class="content-link">Stick Drift test</a> and the
      <a href="/fix/stick-drift" class="content-link">repair guides</a> show what to do next.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .results-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .content-link { color: var(--color-accent); text-decoration: underline; }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
</style>
