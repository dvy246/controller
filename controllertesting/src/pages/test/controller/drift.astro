---
/**
 * /test/controller/drift — Stick Drift Test Page
 * SEO Title: Controller Stick Drift Test — Free Online Analog Stick Tester
 * Target keyword: controller stick drift test, ps5 stick drift test, xbox stick drift test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import DriftTester from '@components/tools/controller/DriftTester.astro';
import DecisionStrip from '@components/features/DecisionStrip.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Stick Drift Test' },
];

const faqs = [
  {
    question: 'How do I know if my controller has stick drift?',
    answer: 'Connect your controller above and leave both analog sticks untouched. If the drift percentage is above 2.0% or the cursor moves away from the absolute center, your controller has stick drift.',
  },
  {
    question: 'What causes controller stick drift?',
    answer: 'Stick drift is caused by worn potentiometer wipers, accumulated dust inside the thumbstick module, or degraded spring tension. Hall-effect thumbsticks prevent drift by using magnetic sensors instead of physical contacts.',
  },
  {
    question: 'Can I fix stick drift without opening my controller?',
    answer: 'Minor drift caused by dust can often be fixed by spraying 99% isopropyl alcohol around the stick base or increasing your in-game deadzone setting to 5-10%. Severe drift requires module replacement.',
  },
  {
    question: 'Does this test work with PS5 DualSense and Xbox controllers?',
    answer: 'Yes! This test supports PS5 DualSense, PS4 DualShock, Xbox Series X/S, Xbox One, Nintendo Switch Pro Controller, Joy-Cons, and any standard USB or Bluetooth gamepad.',
  },
  {
    question: 'Is a 5% stick drift bad?',
    answer: 'A 5% resting drift is considered minor to moderate wear. You can usually mask it by increasing your in-game inner deadzone to 6-8%, but it indicates the carbon potentiometer tracks are actively degrading.',
  },
  {
    question: 'How to fix stick drift permanently?',
    answer: 'The only permanent fix for stick drift is replacing the analog stick module. Upgrading to a Hall-effect joystick module entirely eliminates future drift because it uses magnets instead of physical contacts.',
  }
];
---

<ToolLayout
  title="Stick Drift Test — Free Online Gamepad Drift Detector | ControllerTesting.com"
  description="Test your PS5, Xbox, or Switch controller for stick drift instantly online. Free online gamepad tester measures drift to 0.1% accuracy — no download required."
  keywords="stick drift test, controller drift test, ps5 stick drift test, xbox controller drift, joy-con drift test, gamepad drift detector, how to test controller drift"
  toolName="Stick Drift Test"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  telemetryEnabled
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <DriftTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Understanding Your Test Results</h2>
      <p class="text-sm text-secondary mb-4">
        Our interpretation engine compares your drift reading against modeled reference baselines derived from potentiometer wear-curve engineering data. The exact threshold ranges depend on your controller model, but generally follow this calibration curve:
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Normal Variance (Healthy)</strong>
          <p class="legend-text">Drift under ~2.0% (varies by model). No in-game phantom movement will occur, even at 0% deadzone.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Minor Wear (Watch)</strong>
          <p class="legend-text">Drift from 2.0% to ~10%. Typical potentiometer aging. Increase deadzone to compensate.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Severe Wear (Action Needed)</strong>
          <p class="legend-text">Drift above 10%. Significant hardware degradation. Consider warranty claim or module replacement.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Decision Strip Slot ── */}
  <Fragment slot="decision-strip">
    <DecisionStrip />
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Save your drift test snapshot</h3>
        <p class="export-desc">Export your results as a verified PDF diagnostic report or track drift over time.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/health-score" class="btn-primary">Generate Health Report</a>
        <a href="/test/controller/timeline" class="btn-secondary">Save to Timeline</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/full-diagnostic" class="tool-card card-base card-hover">
      <span class="tool-badge">Flagship</span>
      <h3 class="tool-name">Full Diagnostic Wizard</h3>
      <p class="tool-desc">Test drift, buttons, triggers, and rumble in 2 minutes.</p>
    </a>
    <a href="/test/controller/circularity" class="tool-card card-base card-hover">
      <h3 class="tool-name">Circularity Test</h3>
      <p class="tool-desc">Measure stick range of motion and outer error boundary.</p>
    </a>
    <a href="/test/controller/deadzone" class="tool-card card-base card-hover">
      <h3 class="tool-name">Deadzone Visualizer</h3>
      <p class="tool-desc">Find the ideal deadzone setting for competitive FPS games.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Test controller response latency and polling rate in Hz.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>What Is Controller Stick Drift?</h2>
    <p>
      Controller stick drift is an analog thumbstick hardware defect where a controller registers phantom movement inputs despite both thumbsticks resting untouched at absolute center. It occurs when mechanical friction degrades potentiometer wiper contacts or dust accumulates inside the thumbstick module, triggering camera jitter or unintended character movement in competitive games.
    </p>

    <h3>Why Potentiometers Suffer from Drift</h3>
    <p>
      Most standard gamepads — including the PlayStation 5 DualSense, Xbox Wireless Controller, and Nintendo Switch Joy-Cons — use resistive potentiometer thumbsticks.
      Inside each potentiometer, a metallic wiper glides over a resistive graphite track to measure movement. Over time, friction wears down the graphite layer,
      creating microscopic debris that disrupts electrical resistance readings.
    </p>

    <h3>How to Fix Stick Drift: 3 Proven Steps</h3>
    <ol>
      <li>
        <strong>Clean with Isopropyl Alcohol:</strong> Turn off your controller, apply 2-3 drops of 99% isopropyl alcohol around the thumbstick ball joint,
        rotate the stick 30 times, and let it dry for 15 minutes.
      </li>
      <li>
        <strong>Adjust In-Game Deadzone:</strong> Open your game settings (e.g., Controller Settings → Deadzone) and increase the inner deadzone slider
        until camera movement stops.
      </li>
      <li>
        <strong>Upgrade to Hall-Effect Sticks:</strong> Replace your traditional potentiometers with Hall-effect magnetic stick modules, which eliminate friction
        and never suffer from drift.
      </li>
    </ol>

    <h2>What this test cannot prove</h2>
    <p>
      This browser-based test measures the output of your operating system's controller driver, not the raw hardware sensors directly.
      Therefore, it cannot distinguish between permanent mechanical wear and temporary environmental factors like dust or temperature.
      It also cannot bypass driver-level deadzones enforced by Windows or macOS. For highest confidence, run this test multiple times over several days via a wired USB connection to rule out Bluetooth transport jitter.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .results-summary {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .results-legend-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .legend-card {
    padding: 1rem;
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .legend-pass {
    background: var(--color-pass-bg);
    border: 1px solid var(--color-pass);
  }
  .legend-pass .legend-title { color: var(--color-pass); }

  .legend-warning {
    background: var(--color-warning-bg);
    border: 1px solid var(--color-warning);
  }
  .legend-warning .legend-title { color: var(--color-warning); }

  .legend-fail {
    background: var(--color-fail-bg);
    border: 1px solid var(--color-fail);
  }
  .legend-fail .legend-title { color: var(--color-fail); }

  .legend-title {
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .legend-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .export-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .export-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .export-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .export-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .prose {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .prose h2, .prose h3 {
    color: var(--color-text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ol {
    margin-left: 1.25rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .results-legend-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
