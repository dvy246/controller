---
/**
 * /test/controller/ps5 — PS5 DualSense Controller Tester & Stick Drift Check
 * Target keyword: ps5 controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'PS5 DualSense Tester' },
];

const faqs = [
  {
    "question": "Does the PS5 DualSense get stick drift?",
    "answer": "Yes, like all controllers using potentiometer joysticks, the PS5 DualSense can develop stick drift due to wear on internal carbon tracks over time."
  },
  {
    "question": "How to reset a PS5 controller?",
    "answer": "Locate the small reset button on the back of the controller next to the Sony logo. Use a paperclip to press and hold the button for 5 seconds."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "PS5 DualSense Controller Tester & Stick Drift Check",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Check your PS5 DualSense controller for stick drift, button responsiveness, and trigger issues with our advanced online diagnostic tool."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "PS5 DualSense Tester",
          "item": "https://controllertesting.com/test/controller/ps5"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does the PS5 DualSense get stick drift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, like all controllers using potentiometer joysticks, the PS5 DualSense can develop stick drift due to wear on internal carbon tracks over time."
          }
        },
        {
          "@type": "Question",
          "name": "How to reset a PS5 controller?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Locate the small reset button on the back of the controller next to the Sony logo. Use a paperclip to press and hold the button for 5 seconds."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="PS5 DualSense Controller Tester & Stick Drift Check"
  description="Check your PS5 DualSense controller for stick drift, button responsiveness, and trigger issues with our advanced online diagnostic tool."
  toolName="PS5 DualSense Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell ps5-brand-shell group relative" data-model="playstation">
      <!-- PlayStation Blue Ambient Glow -->
      
      <!-- Floating PS Geometry (CSS only for vibe) -->
      <div class="ps-geometry-bg" aria-hidden="true">
         <span class="ps-shape ps-cross">×</span>
         <span class="ps-shape ps-circle">○</span>
         <span class="ps-shape ps-square">□</span>
         <span class="ps-shape ps-triangle">△</span>
      </div>

      <div class="doppelrand-core flex flex-col relative z-10" style="min-height: 500px; padding: 0;">
        <Interactive3DVisualizer isRigid={true} />
      </div>
    </div>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you test and fix PS5 DualSense stick drift?">
      <p>To test for PS5 DualSense stick drift, use a web-based controller tester to measure analog stick centering precision. If drift exceeds five percent, try resetting the controller using the back pinhole. If the issue persists, the internal potentiometer requires replacement or a warranty claim.</p>
      
      <h3 style="color: var(--color-accent); margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: bold;">Recommended Actions</h3>
      <p>Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto px-4">
      <PremiumFaqAccordion faqs={faqs} title="PS5 DualSense FAQs" subtitle="Common issues and questions about Sony's DualSense controller." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>

<style>
  .ps5-brand-shell {
    --ambient-glow: #2563EB;
    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.25) 0%, transparent 60%),
                repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(37, 99, 235, 0.05) 10px, rgba(37, 99, 235, 0.05) 20px);
    box-shadow: inset 0 0 40px rgba(37, 99, 235, 0.1), 0 0 60px rgba(37, 99, 235, 0.2);
    border: 1px solid rgba(37, 99, 235, 0.3);
    border-radius: 12px;
    padding: 1rem;
  }
  .ps-geometry-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 0.1;
  }
  .ps-shape {
    position: absolute;
    font-size: 8rem;
    font-weight: 300;
    color: #fff;
    filter: blur(2px);
    animation: floatShape 20s infinite linear;
  }
  .ps-cross { top: 10%; left: 10%; animation-delay: 0s; }
  .ps-circle { top: 20%; right: 15%; animation-delay: -5s; }
  .ps-square { bottom: 15%; left: 20%; animation-delay: -10s; }
  .ps-triangle { bottom: 10%; right: 10%; animation-delay: -15s; }

  @keyframes floatShape {
    0% { transform: translateY(0) rotate(0deg); opacity: 0.1; }
    50% { transform: translateY(-40px) rotate(180deg); opacity: 0.3; }
    100% { transform: translateY(0) rotate(360deg); opacity: 0.1; }
  }
</style>
