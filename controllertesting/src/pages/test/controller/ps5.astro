---
/**
 * /test/controller/ps5 — Playstation Controller Test & Stick Drift Check
 * Target keyword: playstation controller test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import Interactive2DVisualizer from '@components/tools/controller/Interactive2DVisualizer.astro';
import DiagnosticResultsBento from '@components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '@components/seo/PremiumGuideCard.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Playstation Controller Test' },
];

const faqs = [
  {
    "question": "Does the PS5 DualSense get stick drift?",
    "answer": "Yes, like all controllers using potentiometer joysticks, the PS5 DualSense can develop stick drift due to wear on internal carbon tracks over time."
  },
  {
    "question": "Does this tester work with PS4 DualShock 4 controllers?",
    "answer": "Yes! You can connect your PS4 DualShock 4 controller via Bluetooth or USB. Our tester will detect all inputs, including face buttons, triggers, and the analog sticks for drift."
  },
  {
    "question": "Can I test my PS3 controller online?",
    "answer": "Yes, the PS3 DualShock 3 controller is supported. You may need specific drivers (like DsHidMini) on Windows to ensure it is recognized by your browser, but once connected, all inputs can be tested."
  },
  {
    "question": "How to reset a PS5 or PS4 controller?",
    "answer": "Both the PS5 DualSense and PS4 DualShock 4 have a small reset hole on the back. Use a paperclip to press and hold the hidden button for 3 to 5 seconds to hard reset the controller."
  },
  {
    "question": "How do I check my PlayStation controller buttons online?",
    "answer": "Connect your PlayStation controller to your PC or Mac via USB or Bluetooth. Press any button to activate the connection, and our tester will display all face buttons and D-Pad inputs."
  },
  {
    "question": "Why is my PS5 or PS4 controller drifting?",
    "answer": "PlayStation controller drift happens when the ALPS potentiometer sensors degrade from use or gather dust, causing the stick to register false inputs without you touching it."
  },
  {
    "question": "Why does my PS4 controller have a blinking white light?",
    "answer": "A blinking white light usually means the controller lost connection or its battery is dying. Try resetting the controller with a paperclip and reconnecting it with a known-good data USB cable."
  }
];

---

<ToolLayout
  title="PlayStation Controller Test | PS5 DualSense Tester"
  description="Test your PlayStation controller online free. Check PS5 DualSense stick drift, buttons, adaptive triggers, touchpad, and gyroscope instantly — no download."
  toolName="PS5 DualSense Controller Test"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <Interactive2DVisualizer mode="playstation" isRigid={true} />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── Semantic SEO Content Slot ── */}
  <Fragment slot="content">
    <h2 class="text-h2 mb-6">Deep Diagnostics for Playstation Controllers</h2>
    <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
      The DualSense is a precision instrument, but its thumbsticks wear like any other. Each stick uses an ALPS potentiometer with a carbon track, and as that track degrades you get <strong class="text-[var(--color-text-primary)]">stick drift</strong>: movement registered while your thumb is off the stick. Connect your DualSense and this tool reads the raw Gamepad API axes at 0.1% precision, so you know exactly how much drift you are dealing with before choosing a fix.
    </p>

    <h3 class="text-h3 mb-4 mt-10">Testing Adaptive Triggers and Polling Rates</h3>
    <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
      Beyond drift, check the L2 and R2 adaptive triggers for a linear pull, confirm the standard 250Hz Bluetooth polling rate (or up to 1000Hz overclocked over USB), and verify that both sticks hold circular geometry and every face button registers without double-clicks or ghosting.
    </p>

    <h3 class="text-h3 mb-4 mt-10">Hall Effect Joystick Upgrades</h3>
    <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
      If you have soldered Hall-effect sensors into your DualSense motherboard to cure drift permanently, use the <a href="/calibrate/dualsense/hall-effect" class="font-semibold">WebHID Calibrator</a> to write the new zero-point calibration directly to the controller firmware, so the sticks recenter cleanly.
    </p>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you test and fix PS5 DualSense stick drift?">
      <p class="text-lg leading-relaxed">To test for PS5 DualSense stick drift, use a web-based controller tester to measure analog stick centering precision. If drift exceeds five percent, try resetting the controller using the back pinhole. If the issue persists, the internal potentiometer requires replacement or a warranty claim.</p>
      
      <h3 class="text-h3 text-accent mt-8 mb-4">Recommended Actions</h3>
      <p class="text-lg leading-relaxed">Start with the <a href="/test/controller/drift" class="font-semibold">Stick Drift Test</a>. A resting offset above 2% means the potentiometer is wearing; use that number to decide between an RMA claim, a deadzone workaround, or a Hall-effect module swap before you open the shell.</p>
    </PremiumGuideCard>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/touchpad" class="tool-hub-card card-hover card-base focus-visible:ring-2 focus-visible:ring-accent outline-none">
      <div class="card-icon" aria-hidden="true">👆</div>
      <h3 class="card-tool-name text-h3">PS5 Touchpad Tester</h3>
      <p class="card-tool-desc">Test DualSense multi-touch tracking and click gestures.</p>
    </a>
    <a href="/test/controller/gyroscope" class="tool-hub-card card-hover card-base focus-visible:ring-2 focus-visible:ring-accent outline-none">
      <div class="card-icon" aria-hidden="true">🧭</div>
      <h3 class="card-tool-name text-h3">Gyroscope & Motion</h3>
      <p class="card-tool-desc">Verify 6-axis motion sensors and tilt calibration.</p>
    </a>
    <a href="/test/controller/microphone" class="tool-hub-card card-hover card-base focus-visible:ring-2 focus-visible:ring-accent outline-none">
      <div class="card-icon" aria-hidden="true">🎤</div>
      <h3 class="card-tool-name text-h3">DualSense Mic Test</h3>
      <p class="card-tool-desc">Check the built-in controller microphone array input.</p>
    </a>
  </Fragment>
</ToolLayout>

<style>
  .ps5-brand-shell {
    --ambient-glow: transparent;
  }
</style>
