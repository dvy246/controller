---
/**
 * /test/controller/ps5 — PS5 DualSense Controller Tester & Stick Drift Check
 * Target keyword: ps5 controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive2DVisualizer from '../../../components/tools/controller/Interactive2DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'PS5 DualSense Tester' },
];

const faqs = [
  {
    "question": "Does the PS5 DualSense get stick drift?",
    "answer": "Yes, like all controllers using potentiometer joysticks, the PS5 DualSense can develop stick drift due to wear on internal carbon tracks over time."
  },
  {
    "question": "How to reset a PS5 controller?",
    "answer": "Locate the small reset button on the back of the controller next to the Sony logo. Use a paperclip to press and hold the button for 5 seconds."
  }
];

---

<ToolLayout
  title="PS5 DualSense Controller Tester & Stick Drift Check"
  description="Check your PS5 DualSense controller for stick drift, button responsiveness, and trigger issues with our advanced online diagnostic tool."
  toolName="PS5 DualSense Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell ps5-brand-shell group relative" data-model="playstation">
      <!-- PlayStation Blue Ambient Glow -->
      
      <!-- Floating PS Geometry (CSS only for vibe) -->
      <div class="ps-geometry-bg" aria-hidden="true">
         <span class="ps-shape ps-cross">×</span>
         <span class="ps-shape ps-circle">○</span>
         <span class="ps-shape ps-square">□</span>
         <span class="ps-shape ps-triangle">△</span>
      </div>

      <div class="doppelrand-core flex flex-col relative z-10" style="min-height: 500px; padding: 0;">
        <Interactive2DVisualizer isRigid={true} />
      </div>
    </div>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── Semantic SEO Content Slot ── */}
  <Fragment slot="content">
    <section class="max-w-4xl mx-auto mt-16 px-6">
      <h2 class="text-[var(--text-h2)] font-extrabold tracking-tight mb-6">Deep Diagnostics for the PS5 DualSense</h2>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        The PlayStation 5 DualSense controller represents a massive leap in haptic feedback and adaptive trigger technology. However, like its predecessors, it relies on ALPS Alpine potentiometer joysticks which are susceptible to mechanical wear and carbon track degradation—commonly known as <strong>stick drift</strong>. Our hardware diagnostic engine connects directly via the Gamepad API to measure raw axis data from your DualSense, allowing you to quantify exactly how much drift is occurring down to the 0.01% threshold.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Testing Adaptive Triggers and Polling Rates</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        Beyond stick drift, competitive players often need to verify the linearity of their L2 and R2 adaptive triggers and ensure they are hitting the standard 250Hz Bluetooth polling rate (or up to 1000Hz when overclocked). Using this interface, you can verify that both the left and right analog modules are reaching their perfect circular geometry and that every face button registers immediately without double-clicking or input ghosting.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Hall Effect Joystick Upgrades</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
        If you have recently soldered third-party Hall-effect electromagnetic sensors into your DualSense motherboard to permanently cure stick drift, you can use our <a href="/calibrate/dualsense/hall-effect" class="text-[var(--color-accent)] underline">WebHID Calibrator</a> tool to write the new zero-point hardware calibration directly to the controller's firmware, ensuring perfect recentering.
      </p>
    </section>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you test and fix PS5 DualSense stick drift?">
      <p class="text-lg">To test for PS5 DualSense stick drift, use a web-based controller tester to measure analog stick centering precision. If drift exceeds five percent, try resetting the controller using the back pinhole. If the issue persists, the internal potentiometer requires replacement or a warranty claim.</p>
      
      <h3 class="text-blue-400 mt-12 mb-4 text-2xl font-extrabold tracking-tight">Recommended Actions</h3>
      <p class="text-lg">Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto mt-32 mb-20 px-6">
      <PremiumFaqAccordion faqs={faqs} title="PS5 DualSense FAQs" subtitle="Common issues and questions about Sony's DualSense controller." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/touchpad" class="tool-hub-card card-hover card-base">
      <div class="card-icon">👆</div>
      <h3 class="card-tool-name">PS5 Touchpad Tester</h3>
      <p class="card-tool-desc">Test DualSense multi-touch tracking and click gestures.</p>
    </a>
    <a href="/test/controller/gyroscope" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🧭</div>
      <h3 class="card-tool-name">Gyroscope & Motion</h3>
      <p class="card-tool-desc">Verify 6-axis motion sensors and tilt calibration.</p>
    </a>
    <a href="/test/controller/microphone" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🎤</div>
      <h3 class="card-tool-name">DualSense Mic Test</h3>
      <p class="card-tool-desc">Check the built-in controller microphone array input.</p>
    </a>
  </Fragment>
</ToolLayout>

<style>
  .ps5-brand-shell {
    --ambient-glow: #2563EB;
    box-shadow: 0 0 60px rgba(37, 99, 235, 0.15);
    border-color: rgba(37, 99, 235, 0.3);
  }
  .ps-geometry-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
    opacity: 0.1;
  }
  .ps-shape {
    position: absolute;
    font-size: 8rem;
    font-weight: 300;
    color: #fff;
    filter: blur(2px);
    animation: floatShape 20s infinite linear;
  }
  .ps-cross { top: 10%; left: 10%; animation-delay: 0s; }
  .ps-circle { top: 20%; right: 15%; animation-delay: -5s; }
  .ps-square { bottom: 15%; left: 20%; animation-delay: -10s; }
  .ps-triangle { bottom: 10%; right: 10%; animation-delay: -15s; }

  @keyframes floatShape {
    0% { transform: translateY(0) rotate(0deg); opacity: 0.1; }
    50% { transform: translateY(-40px) rotate(180deg); opacity: 0.3; }
    100% { transform: translateY(0) rotate(360deg); opacity: 0.1; }
  }
</style>
