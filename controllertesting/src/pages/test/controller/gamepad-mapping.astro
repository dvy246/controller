---
/**
 * /test/controller/gamepad-mapping — Gamepad Mapping & Button Rebind Tester
 * Target keyword: gamepad-mapping controller tester
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import ButtonTester from '@components/tools/controller/ButtonTester.astro';
import PremiumGuideCard from '@components/seo/PremiumGuideCard.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Gamepad Mapping Tester' },
];

const faqs = [
  {
    "question": "Can I remap controller buttons in the browser?",
    "answer": "The browser Gamepad API reads inputs directly. To remap buttons globally, you must use software like Steam Input, DS4Windows, or system-level accessibility settings."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Gamepad Mapping & Button Rebind Tester",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Verify your custom controller layouts and button mappings. Ensure your rebinds work perfectly before launching a game."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Gamepad Mapping Tester",
          "item": "https://controllertesting.com/test/controller/gamepad-mapping"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I remap controller buttons in the browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The browser Gamepad API reads inputs directly. To remap buttons globally, you must use software like Steam Input, DS4Windows, or system-level accessibility settings."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="Gamepad Mapping & Button Rebind Test | ControllerTesting"
  description="Verify your custom controller layouts and button mappings. Ensure your rebinds work perfectly before launching a game."
  toolName="Gamepad Mapping Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
  telemetryEnabled
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <ButtonTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Diagnostics Results</h2>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">0.0% – 2.0% (Healthy)</strong>
          <p class="legend-text">Normal variance. Your controller is operating flawlessly.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">2.1% – 10.0% (Minor Drift)</strong>
          <p class="legend-text">Slight potentiometer wear detected.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">> 10.0% (Severe Drift)</strong>
          <p class="legend-text">Severe drift detected. Repair is highly recommended.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you verify custom gamepad button mappings?">
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        <strong>Verify custom gamepad button mappings by using an online controller mapping tool. Press each remapped button on your controller and check if the on-screen display registers the intended virtual output. This ensures software-level rebinds are functioning correctly before you launch a game.</strong>
      </p>
      
      <h3 class="text-lg font-bold text-[var(--color-text-primary)] mt-8 mb-3">Recommended Actions</h3>
      <p class="text-[var(--color-text-secondary)] leading-relaxed">
        Before you chase a rebind problem, rule out the hardware: run the <a href="/test/controller/drift">Stick Drift Test</a>. A stick that reports movement while idle will corrupt any mapping test and look like a broken rebind.
      </p>
    </PremiumGuideCard>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>
