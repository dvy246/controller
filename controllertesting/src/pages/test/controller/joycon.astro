---
/**
 * /test/controller/joycon — Joy-Con Tester: Check Switch Controllers for Drift
 * Target keyword: joycon controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Joy-Con Tester' },
];

const faqs = [
  {
    "question": "Will Nintendo fix my drifting Joy-Cons for free?",
    "answer": "Yes, in many regions including North America and Europe, Nintendo offers free repair programs for Joy-Con drift regardless of warranty status."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Joy-Con Tester: Check Switch Controllers for Drift",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Specifically designed testing tool for Nintendo Switch Joy-Cons. Verify input accuracy and diagnose the dreaded Joy-Con drift instantly."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Joy-Con Tester",
          "item": "https://controllertesting.com/test/controller/joycon"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Will Nintendo fix my drifting Joy-Cons for free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, in many regions including North America and Europe, Nintendo offers free repair programs for Joy-Con drift regardless of warranty status."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="Joy-Con Tester: Check Switch Controllers for Drift"
  description="Specifically designed testing tool for Nintendo Switch Joy-Cons. Verify input accuracy and diagnose the dreaded Joy-Con drift instantly."
  toolName="Joy-Con Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell nintendo-brand-shell" data-model="switch">
      <Interactive3DVisualizer />
    </div>
    <style>
      .nintendo-brand-shell {
        background: linear-gradient(135deg, rgba(255, 0, 50, 0.15) 0%, transparent 50%, rgba(0, 195, 227, 0.15) 100%);
        border: 2px solid transparent;
        background-clip: padding-box;
        position: relative;
        border-radius: 12px;
        padding: 1rem;
      }
      .nintendo-brand-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        margin: -2px;
        border-radius: inherit;
        background: linear-gradient(135deg, #ff0032 0%, #00c3e3 100%);
        opacity: 0.5;
      }
    </style>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you accurately test a Joy-Con for drift?">
      <p>To accurately test a Joy-Con for drift, pair it via Bluetooth to a computer and launch an online gamepad diagnostic tool. Leave the thumbstick untouched. If the crosshair moves or shows an input value greater than two percent, your Joy-Con has a physical drift issue.</p>
      
      <h3 style="color: var(--color-accent); margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: bold;">Recommended Actions</h3>
      <p>Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto px-4">
      <PremiumFaqAccordion faqs={faqs} title="Nintendo Joy-Con FAQs" subtitle="Common issues and questions about Nintendo's Joy-Con controllers." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>
