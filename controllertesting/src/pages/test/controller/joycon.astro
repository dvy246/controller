---
/**
 * /test/controller/joycon — Joy-Con Tester: Check Switch Controllers for Drift
 * Target keyword: joycon controller tester
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import Interactive2DVisualizer from '@components/tools/controller/Interactive2DVisualizer.astro';
import DiagnosticResultsBento from '@components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '@components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '@components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Joy-Con Tester' },
];

const faqs = [
  {
    "question": "Will Nintendo fix my drifting Joy-Cons for free?",
    "answer": "Yes, in many regions including North America and Europe, Nintendo offers free repair programs for Joy-Con drift regardless of warranty status."
  }
];

---

<ToolLayout
  title="Joy-Con Drift Test: Switch Joy-Cons | ControllerTesting"
  description="Test your Nintendo Switch Joy-Cons for drift instantly online free. Verify input accuracy and diagnose Joy-Con drift in your browser."
  toolName="Joy-Con Drift Test"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>


  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <Interactive2DVisualizer mode="joycon" isRigid={true} />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── Semantic SEO Content Slot ── */}
  <Fragment slot="content">
    <section class="max-w-4xl mx-auto mt-16 px-6">
      <h2 class="text-h2 mb-6">Joy-Con Drift & Hardware Diagnostics</h2>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        "Joy-Con Drift" is the most documented controller failure in gaming. Nintendo's compact stick modules use ultra-thin graphite pads instead of full-size ALPS potentiometers, and those pads wear faster. Pair a Joy-Con to a PC, Mac, or Android device, and this tool measures the drift severity in minutes — the number you want before you file a free Nintendo RMA.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Testing the SL/SR Rail Buttons</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        The second common failure is the SL and SR rail buttons. Sliding a Joy-Con on and off the console repeatedly can crimp or sever the ribbon cable behind those buttons, taking out the pairing LEDs with them. Test the rail buttons in the button matrix to confirm whether the ribbon is compromised.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Motion Controls and HD Rumble</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
        Small as they are, Joy-Cons pack a linear resonant actuator (LRA) for HD Rumble, a 6-axis gyroscope, and an IR motion camera in the right unit. Use the motion tools to confirm the IMU calibration holds for swing and tilt games like Switch Sports or Mario Kart 8 Deluxe.
      </p>
    </section>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How do you accurately test a Joy-Con for drift?">
      <p class="text-lg">To accurately test a Joy-Con for drift, pair it via Bluetooth to a computer and launch an online gamepad diagnostic tool. Leave the thumbstick untouched. If the crosshair moves or shows an input value greater than two percent, your Joy-Con has a physical drift issue.</p>
      
      <h3 class="text-h3 text-accent mt-8 mb-4">Recommended Actions</h3>
      <p class="text-lg">      Start with the <a href="/test/controller/drift">Stick Drift Test</a> to get a numeric reading. If a stick rests above 2%, skip the cleaning cycle and file a free Nintendo repair — Joy-Con graphite pads rarely recover, and Nintendo fixes them at no cost in the US and EU.</p>
    </PremiumGuideCard>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/gyroscope" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🧭</div>
      <h3 class="card-tool-name">Joy-Con Gyro Tester</h3>
      <p class="card-tool-desc">Test the 6-axis motion controls and tilt calibration.</p>
    </a>
    <a href="/test/controller/vibration" class="tool-hub-card card-hover card-base">
      <div class="card-icon">📳</div>
      <h3 class="card-tool-name">HD Rumble Check</h3>
      <p class="card-tool-desc">Verify the linear resonant actuators (LRA) in each Joy-Con.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🔘</div>
      <h3 class="card-tool-name">Rail Button Tester</h3>
      <p class="card-tool-desc">Check the hidden SL/SR rail buttons for ribbon cable damage.</p>
    </a>
  </Fragment>
</ToolLayout>
