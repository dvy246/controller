---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Diagnostics', url: '/test/controller' },
  { name: 'Passport' },
];

const title = "Controller Passport | Hardware Diagnostic History";
const description = "View your longitudinal controller diagnostic history, track stick drift degradation over time, and compare before/after repair metrics.";

---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <Header />

  <main class="passport-page container-site page-layout">
    <Breadcrumbs items={breadcrumbs} />

    <header class="passport-hero card-base">
      <div class="hero-content">
        <h1 class="text-h1">Controller Passport</h1>
        <p class="text-base text-secondary">
          Your private, local-first diagnostic history. Track stick drift degradation, validate repairs with before/after comparisons, and monitor hardware lifespans. 
          All data remains strictly on your device.
        </p>
      </div>
      <div class="hero-actions">
        <a href="/test/controller/full-diagnostic" class="btn-primary">Run New Diagnostic</a>
      </div>
    </header>

    <div id="passport-dashboard" class="passport-dashboard">
      <div id="loading-state" class="dashboard-state">
        <div class="spinner"></div>
        <p class="mono text-small text-accent">Loading local history...</p>
      </div>

      <div id="empty-state" class="dashboard-state sr-only">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon text-tertiary">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
        <h2 class="text-h3">No Devices Found</h2>
        <p class="text-secondary mt-2">You haven't saved any diagnostic reports to your passport yet.</p>
        <a href="/test/controller/health-score" class="btn-secondary mt-4">Take your first test</a>
      </div>

      <div id="device-list" class="device-grid sr-only">
        <!-- Rendered via JS -->
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<script>
  import { getPassportHistory, compareReports } from '../../../lib/passport';
  import { buildShareUrl } from '../../../lib/share';
  import type { PassportRecord } from '../../../lib/passport';
  import type { EvidenceReport } from '../../../lib/report';

  document.addEventListener('DOMContentLoaded', () => {
    initDashboard();
  });

  function initDashboard() {
    const loadingState = document.getElementById('loading-state');
    const emptyState = document.getElementById('empty-state');
    const deviceList = document.getElementById('device-list');
    
    if (!loadingState || !emptyState || !deviceList) return;

    // Simulate slight delay for premium feeling (smooth intro)
    setTimeout(() => {
      loadingState.classList.add('sr-only');
      
      const history = getPassportHistory();
      const devices = Object.values(history);
      
      if (devices.length === 0) {
        emptyState.classList.remove('sr-only');
        return;
      }
      
      deviceList.classList.remove('sr-only');
      renderDevices(devices, deviceList);
    }, 400);
  }

  function renderDevices(devices: PassportRecord[], container: HTMLElement) {
    container.innerHTML = '';
    
    devices.forEach(device => {
      const reports = device.reports;
      if (reports.length === 0) return;
      
      const latest: EvidenceReport = reports[0];
      const previous: EvidenceReport | null = reports.length > 1 ? reports[1] : null;
      
      let diffHtml = '';
      if (previous) {
        const { driftDiff, improved, degraded } = compareReports(previous, latest);
        
        let driftTag = '';
        if (improved) driftTag = `<span class="badge-pass diff-badge">↓ ${Math.abs(driftDiff).toFixed(2)}% Improved</span>`;
        else if (degraded) driftTag = `<span class="badge-fail diff-badge">↑ ${Math.abs(driftDiff).toFixed(2)}% Degraded</span>`;
        else driftTag = `<span class="badge-accent diff-badge">Unchanged</span>`;

        diffHtml = `
          <div class="diff-section">
            <p class="text-micro text-tertiary uppercase tracking-wide">Since last test</p>
            <div class="diff-metrics mt-1">
              ${driftTag}
            </div>
          </div>
        `;
      }

      const driftAvg = Math.max(latest.tests.sticks.driftX, latest.tests.sticks.driftY);
      
      const card = document.createElement('div');
      card.className = 'device-card card-base card-hover';
      card.innerHTML = `
        <div class="device-card-header">
          <div class="device-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="6" width="20" height="12" rx="6"></rect>
              <circle cx="6.5" cy="12" r="1.5"></circle>
              <circle cx="17.5" cy="12" r="1.5"></circle>
              <path d="M11.5 12h1"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-h4 device-name">${device.deviceName}</h3>
            <p class="mono text-micro text-secondary">${device.deviceId}</p>
          </div>
        </div>
        
        <div class="device-metrics">
          <div class="metric-box">
            <span class="metric-label">Latest Drift</span>
            <span class="metric-value mono">${driftAvg.toFixed(2)}%</span>
          </div>
          <div class="metric-box">
            <span class="metric-label">Circularity Err</span>
            <span class="metric-value mono">${latest.tests.sticks.circularityError.toFixed(1)}%</span>
          </div>
          <div class="metric-box">
            <span class="metric-label">Total Tests</span>
            <span class="metric-value mono">${reports.length}</span>
          </div>
        </div>
        
        ${diffHtml}
        
        <div class="device-actions mt-4">
          <a href="${buildShareUrl(latest)}" class="btn-secondary w-full justify-center" target="_blank" rel="noopener">View Shareable Report</a>
        </div>
      `;
      container.appendChild(card);
    });
  }
</script>

<style>
  .passport-page {
    padding-top: 80px;
    padding-bottom: var(--spacing-section);
  }
  
  .passport-hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
    padding: 2.5rem;
    background: linear-gradient(145deg, var(--color-surface-1), var(--color-surface-2));
    border: 1px solid var(--color-border-subtle);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }
  
  .hero-content {
    max-width: 60ch;
  }
  
  .hero-content h1 {
    margin-bottom: 0.75rem;
  }
  
  .dashboard-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 400px;
    background: var(--color-surface-1);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-border-subtle);
  }
  
  .spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-border-subtle);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 1rem;
  }
  
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  
  .empty-icon {
    margin-bottom: 1rem;
    opacity: 0.5;
  }
  
  .device-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  
  .device-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s var(--ease-smooth);
  }
  
  .device-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }
  
  .device-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  
  .device-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-surface-2);
    border-radius: var(--radius-md);
    color: var(--color-accent);
  }
  
  .device-name {
    margin: 0 0 0.25rem 0;
    line-height: 1.2;
  }
  
  .device-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  
  .metric-box {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.5rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    text-align: center;
  }
  
  .metric-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.25rem;
  }
  
  .metric-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  
  .diff-section {
    padding: 0.75rem;
    background: rgba(37, 99, 235, 0.05);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(37, 99, 235, 0.1);
  }
  
  .diff-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
  }
  
  @media (max-width: 768px) {
    .passport-hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.5rem;
    }
  }
</style>
