---
/**
 * /test/controller/xbox — Xbox Controller Tester & Drift Diagnostics
 * Target keyword: xbox controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Xbox Controller Tester' },
];

const faqs = [
  {
    "question": "Why is my Xbox controller drifting?",
    "answer": "Xbox controller drift is typically caused by debris accumulating inside the joystick module or normal wear of the potentiometer sensor components after prolonged use."
  },
  {
    "question": "Can Xbox stick drift be fixed without taking it apart?",
    "answer": "Sometimes compressed air or contact cleaner can temporarily dislodge debris causing drift, but severe cases require soldering a new joystick module."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Xbox Controller Tester & Drift Diagnostics",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Diagnose Xbox Series X|S and Xbox One controllers for input lag, stick drift, and faulty buttons. Fast, free, and accurate."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Xbox Controller Tester",
          "item": "https://controllertesting.com/test/controller/xbox"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Why is my Xbox controller drifting?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Xbox controller drift is typically caused by debris accumulating inside the joystick module or normal wear of the potentiometer sensor components after prolonged use."
          }
        },
        {
          "@type": "Question",
          "name": "Can Xbox stick drift be fixed without taking it apart?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sometimes compressed air or contact cleaner can temporarily dislodge debris causing drift, but severe cases require soldering a new joystick module."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="Xbox Controller Tester & Drift Diagnostics"
  description="Diagnose Xbox Series X|S and Xbox One controllers for input lag, stick drift, and faulty buttons. Fast, free, and accurate."
  toolName="Xbox Controller Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell xbox-brand-shell" data-model="xbox">
      <Interactive3DVisualizer modelUrl="/models/xbox_controller.glb" isRigid={true} />
    </div>
    <style>
      .xbox-brand-shell {
        --ambient-glow: #107C10;
        background: radial-gradient(circle at center, rgba(16, 124, 16, 0.25) 0%, transparent 70%),
                    repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(16, 124, 16, 0.05) 10px, rgba(16, 124, 16, 0.05) 20px);
        box-shadow: inset 0 0 40px rgba(16, 124, 16, 0.1), 0 0 60px rgba(16, 124, 16, 0.2);
        border: 1px solid rgba(16, 124, 16, 0.3);
        border-radius: 12px;
        padding: 1rem;
      }
    </style>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How can I check my Xbox controller for stick drift?">
      <p>You can check your Xbox controller for stick drift by connecting it to a PC or Mac and using a browser-based gamepad tester. The tool will display the exact axial offset of your analog sticks. Any constant input registering above five percent without touch indicates hardware drift.</p>
      
      <h3 style="color: var(--color-accent); margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: bold;">Recommended Actions</h3>
      <p>Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto px-4">
      <PremiumFaqAccordion faqs={faqs} title="Xbox Controller FAQs" subtitle="Common issues and questions about Microsoft's Xbox controllers." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>
