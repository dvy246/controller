---
/**
 * /test/controller/index.astro — Controller Tools Hub
 * SEO Title: Online Controller Tester — 21 Free Gamepad Diagnostic Tools
 * Hub index listing all 21 controller tools.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Hub' },
];

const controllerTools = [
  { name: 'Quick Health Check (60s)', href: '/test/controller/quick-health', desc: 'Express 60-second guided checkup for drift, buttons & triggers', badge: 'Flagship' },
  { name: 'Stick Drift Detector', href: '/test/controller/drift', desc: 'Real-time 0.1% stick drift canvas visualizer', badge: 'High Priority' },
  { name: 'Full Diagnostic Wizard', href: '/test/controller/full-diagnostic', desc: '5-step hardware checkup for sticks, buttons & triggers', badge: 'Flagship' },
  { name: 'Controller Health Score™', href: '/test/controller/health-score', desc: 'Compute 0-100 score & export printable PDF report card', badge: 'Flagship' },
  { name: 'PS Controller WebHID Calibration', href: '/test/controller/ps-calibration', desc: 'Firmware-level center offset calibration & permanent save via WebHID', badge: 'Flagship' },
  { name: 'Steering Wheel & Pedals', href: '/test/controller/steering-wheel', desc: 'Test 900°/1080° steering rotation, throttle, brake & clutch linearity', badge: 'Specialized' },
  { name: 'Fight Stick & Hitbox', href: '/test/controller/fight-stick', desc: 'Vewlix 8-button layout & SOCD cleaner test for arcade sticks', badge: 'Specialized' },
  { name: 'Flight Stick & HOTAS', href: '/test/controller/flight-stick', desc: 'Flight sim joysticks, 128+ buttons & multi-axis throttle quadrant', badge: 'Specialized' },
  { name: 'MIDI Keyboard & Controller', href: '/test/midi', desc: 'Test USB MIDI keyboards, drum pads, CC messages & velocity', badge: 'Specialized' },
  { name: 'Button Tester', href: '/test/controller/buttons', desc: 'Interactive button matrix & ghosting detector' },
  { name: 'Trigger Pressure Tester', href: '/test/controller/triggers', desc: 'Analog L2/R2 pressure curve analyzer' },
  { name: 'Vibration Tester', href: '/test/controller/vibration', desc: 'Dual haptic rumble motor pulse tester' },
  { name: 'Circularity Test', href: '/test/controller/circularity', desc: '360-degree stick range of motion & error' },
  { name: 'Deadzone Visualizer', href: '/test/controller/deadzone', desc: 'Inner & outer deadzone threshold tuning' },
  { name: 'Polling Rate Checker', href: '/test/controller/polling-rate', desc: 'Real-time Hz input report frequency' },
  { name: '8-Way D-Pad Tester', href: '/test/controller/dpad', desc: '8-way directional pad precision & diagonal inputs' },
  { name: 'Latency Estimator', href: '/test/controller/latency', desc: 'Input delay & visual reaction speed timer' },
  { name: 'Multi-Controller Tester', href: '/test/controller/multi', desc: 'Test 4 gamepads simultaneously in browser' },
  { name: 'Drift Timeline Tracker', href: '/test/controller/timeline', desc: 'LocalStorage hardware degradation tracker' },
  { name: 'Gyroscope Tester', href: '/test/controller/gyroscope', desc: '3-axis motion sensor calibration' },
  { name: 'Touchpad Tester', href: '/test/controller/touchpad', desc: 'PS5 DualSense multi-touch trackpad' },
  { name: 'Microphone Tester', href: '/test/controller/microphone', desc: 'Built-in mic & 3.5mm headset audio' },
  { name: 'Competitive Readiness', href: '/test/controller/competitive-readiness', desc: 'Esports tournament benchmark assessor' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Controller Diagnostic Tools',
  numberOfItems: controllerTools.length,
  itemListElement: controllerTools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://controllertesting.com${t.href}`,
  })),
};
function getHubIcon(href: string) {
  if (href.includes('/quick-health')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-qh" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#06B6D4"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="url(#grad-qh)" fill-opacity="0.2" stroke="url(#grad-qh)" stroke-width="2" stroke-linejoin="round"/><path d="M7 12h3l1.5-3 3 6 1.5-3h3" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  if (href.includes('/drift')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-drift" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#00F2FE"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#grad-drift)" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="url(#grad-drift)" fill-opacity="0.3" stroke="#00F2FE" stroke-width="1.5"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/full-diagnostic')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-diag" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6366F1"/><stop offset="100%" stop-color="#A855F7"/></linearGradient></defs><rect x="3" y="4" width="18" height="16" rx="3" fill="url(#grad-diag)" fill-opacity="0.2" stroke="url(#grad-diag)" stroke-width="2"/><path d="M7 12h3l2-4 2 8 2-4h3" stroke="#C084FC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  if (href.includes('/health-score')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-score" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="url(#grad-score)" fill-opacity="0.25" stroke="url(#grad-score)" stroke-width="2" stroke-linejoin="round"/></svg>`;
  if (href.includes('/ps-calibration')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-hid" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#38BDF8"/><stop offset="100%" stop-color="#818CF8"/></linearGradient></defs><rect x="5" y="5" width="14" height="14" rx="3" fill="url(#grad-hid)" fill-opacity="0.2" stroke="url(#grad-hid)" stroke-width="2"/><rect x="9" y="9" width="6" height="6" fill="#38BDF8"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4" stroke="#818CF8" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/steering-wheel')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-wheel" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F97316"/><stop offset="100%" stop-color="#EF4444"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#grad-wheel)" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="url(#grad-wheel)" stroke="#EF4444" stroke-width="1.5"/><path d="M12 3v6M4.5 16.5l5.2-3M19.5 16.5l-5.2-3" stroke="#F97316" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/fight-stick')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-fight" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#EC4899"/><stop offset="100%" stop-color="#3B82F6"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="3" fill="url(#grad-fight)" fill-opacity="0.2" stroke="url(#grad-fight)" stroke-width="2"/><circle cx="7" cy="12" r="2.5" fill="#EF4444"/><circle cx="13" cy="9.5" r="1.5" fill="#3B82F6"/><circle cx="17" cy="9.5" r="1.5" fill="#10B981"/><circle cx="13" cy="14.5" r="1.5" fill="#F59E0B"/><circle cx="17" cy="14.5" r="1.5" fill="#EC4899"/></svg>`;
  if (href.includes('/flight-stick')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-flight" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#0EA5E9"/><stop offset="100%" stop-color="#2563EB"/></linearGradient></defs><path d="M12 2v10" stroke="url(#grad-flight)" stroke-width="3" stroke-linecap="round"/><path d="M8 7h8" stroke="#38BDF8" stroke-width="2" stroke-linecap="round"/><path d="M12 12l-5 8M12 12l5 8M4 20h16" stroke="url(#grad-flight)" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/midi')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-midi" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#A855F7"/><stop offset="100%" stop-color="#EC4899"/></linearGradient></defs><rect x="2" y="5" width="20" height="14" rx="3" fill="url(#grad-midi)" fill-opacity="0.2" stroke="url(#grad-midi)" stroke-width="2"/><path d="M7 5v8M12 5v8M17 5v8" stroke="#C084FC" stroke-width="2"/><rect x="5.5" y="5" width="3" height="6" fill="#A855F7"/><rect x="10.5" y="5" width="3" height="6" fill="#EC4899"/><rect x="15.5" y="5" width="3" height="6" fill="#A855F7"/></svg>`;
  if (href.includes('/buttons')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-btn" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="6" fill="url(#grad-btn)" fill-opacity="0.2" stroke="url(#grad-btn)" stroke-width="2"/><circle cx="16" cy="8.5" r="1.5" fill="#EF4444"/><circle cx="13.5" cy="12" r="1.5" fill="#3B82F6"/><circle cx="18.5" cy="12" r="1.5" fill="#10B981"/><circle cx="16" cy="15.5" r="1.5" fill="#F59E0B"/></svg>`;
  if (href.includes('/triggers')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-trig" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#10B981"/><stop offset="100%" stop-color="#06B6D4"/></linearGradient></defs><rect x="4" y="3" width="6" height="18" rx="3" fill="url(#grad-trig)" fill-opacity="0.2" stroke="url(#grad-trig)" stroke-width="2"/><rect x="14" y="3" width="6" height="18" rx="3" fill="url(#grad-trig)" fill-opacity="0.2" stroke="url(#grad-trig)" stroke-width="2"/><rect x="4" y="10" width="6" height="11" rx="2" fill="#10B981"/><rect x="14" y="6" width="6" height="15" rx="2" fill="#06B6D4"/></svg>`;
  if (href.includes('/vibration')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-vib" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#8B5CF6"/><stop offset="100%" stop-color="#EC4899"/></linearGradient></defs><rect x="9" y="6" width="6" height="12" rx="2" fill="url(#grad-vib)" fill-opacity="0.3" stroke="url(#grad-vib)" stroke-width="2"/><path d="M5 8c-1.5 2-1.5 6 0 8M19 8c1.5 2 1.5 6 0 8M2 5c-2.5 3.5-2.5 10.5 0 14M22 5c2.5 3.5 2.5 10.5 0 14" stroke="#EC4899" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/circularity')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-circ" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#2563EB"/><stop offset="100%" stop-color="#38BDF8"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#grad-circ)" stroke-width="2" stroke-dasharray="4 2"/><circle cx="12" cy="12" r="3" fill="#38BDF8"/><path d="M12 3v18M3 12h18" stroke="url(#grad-circ)" stroke-width="1.5" stroke-opacity="0.5"/></svg>`;
  if (href.includes('/deadzone')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-dz" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#EF4444"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#grad-dz)" stroke-width="2"/><circle cx="12" cy="12" r="5" fill="url(#grad-dz)" fill-opacity="0.25" stroke="#EF4444" stroke-width="1.5"/><path d="M12 7v10M7 12h10" stroke="#F59E0B" stroke-width="1.5"/></svg>`;
  if (href.includes('/polling-rate')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-hz" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#00F2FE"/><stop offset="100%" stop-color="#4FACFE"/></linearGradient></defs><path d="M2 13h4l3-8 4 14 3-10 2 4h4" stroke="url(#grad-hz)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
  if (href.includes('/dpad')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-dpad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#06B6D4"/></linearGradient></defs><path d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7V2z" fill="url(#grad-dpad)" fill-opacity="0.2" stroke="url(#grad-dpad)" stroke-width="2" stroke-linejoin="round"/><path d="M12 5v4M12 15v4M5 12h4M15 12h4" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/latency')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-lat" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#EF4444"/></linearGradient></defs><circle cx="12" cy="13" r="8" stroke="url(#grad-lat)" stroke-width="2"/><path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" fill="url(#grad-lat)" fill-opacity="0.3" stroke="#F59E0B" stroke-width="1.5" stroke-linejoin="round"/></svg>`;
  if (href.includes('/multi')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-multi" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6366F1"/><stop offset="100%" stop-color="#A855F7"/></linearGradient></defs><rect x="2" y="3" width="9" height="8" rx="2" fill="url(#grad-multi)" fill-opacity="0.2" stroke="url(#grad-multi)" stroke-width="2"/><rect x="13" y="3" width="9" height="8" rx="2" fill="url(#grad-multi)" fill-opacity="0.2" stroke="url(#grad-multi)" stroke-width="2"/><rect x="2" y="13" width="9" height="8" rx="2" fill="url(#grad-multi)" fill-opacity="0.2" stroke="url(#grad-multi)" stroke-width="2"/><rect x="13" y="13" width="9" height="8" rx="2" fill="url(#grad-multi)" fill-opacity="0.2" stroke="url(#grad-multi)" stroke-width="2"/></svg>`;
  if (href.includes('/timeline')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-tl" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#10B981"/><stop offset="100%" stop-color="#3B82F6"/></linearGradient></defs><path d="M3 3v18h18" stroke="url(#grad-tl)" stroke-width="2" stroke-linecap="round"/><path d="M7 16l4-4 4 2 5-7" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="16" r="2" fill="#10B981"/><circle cx="11" cy="12" r="2" fill="#10B981"/><circle cx="15" cy="14" r="2" fill="#3B82F6"/><circle cx="20" cy="7" r="2" fill="#3B82F6"/></svg>`;
  if (href.includes('/gyroscope')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-gyro" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#38BDF8"/><stop offset="100%" stop-color="#C084FC"/></linearGradient></defs><circle cx="12" cy="12" r="9" stroke="url(#grad-gyro)" stroke-width="2"/><ellipse cx="12" cy="12" rx="9" ry="3" stroke="#38BDF8" stroke-width="1.5" transform="rotate(45 12 12)"/><circle cx="12" cy="12" r="3" fill="#C084FC"/></svg>`;
  if (href.includes('/touchpad')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-touch" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#2563EB"/><stop offset="100%" stop-color="#38BDF8"/></linearGradient></defs><rect x="3" y="5" width="18" height="14" rx="3" fill="url(#grad-touch)" fill-opacity="0.2" stroke="url(#grad-touch)" stroke-width="2"/><circle cx="9" cy="12" r="2" fill="#38BDF8"/><circle cx="15" cy="12" r="2" fill="#60A5FA"/></svg>`;
  if (href.includes('/microphone')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-mic" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#EC4899"/><stop offset="100%" stop-color="#F59E0B"/></linearGradient></defs><rect x="9" y="3" width="6" height="11" rx="3" fill="url(#grad-mic)" fill-opacity="0.2" stroke="url(#grad-mic)" stroke-width="2"/><path d="M19 10v1a7 7 0 0 1-14 0v-1M12 18v4M8 22h8" stroke="#EC4899" stroke-width="2" stroke-linecap="round"/></svg>`;
  if (href.includes('/competitive-readiness')) return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-esports" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#FBBF24"/></linearGradient></defs><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34M18 4H6v7a6 6 0 0 0 12 0V4z" fill="url(#grad-esports)" fill-opacity="0.2" stroke="url(#grad-esports)" stroke-width="2" stroke-linejoin="round"/></svg>`;
  return `<svg width="26" height="26" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="grad-def" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#60A5FA"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="6" fill="url(#grad-def)" fill-opacity="0.2" stroke="url(#grad-def)" stroke-width="2"/></svg>`;
}
---

<BaseLayout
  title="Online Controller Tester — 21 Free Gamepad Diagnostic Tools | ControllerTesting.com"
  description="Test any gamepad online. 21 free diagnostic tools for stick drift, button response, trigger linearity, polling rate, and rumble motors. Works with PS5, Xbox, Switch & PC."
  schema={itemListSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-header">
        <span class="hub-badge">21 Diagnostic Tools</span>
        <h1 class="hub-title">Controller Diagnostic Hub</h1>
        <p class="hub-subtitle">
          Select a tool below to diagnose stick drift, button responsiveness, trigger linearity, or complete health checkups. All tools run 100% locally in your browser.
        </p>
      </header>

      <div class="grid-tools">
        {controllerTools.map((tool) => (
          <a href={tool.href} class={`tool-hub-card card-hover ${tool.badge === 'Flagship' ? 'card-gradient' : 'card-base'}`}>
            <div class="card-top-bar">
              <span class="card-icon" set:html={getHubIcon(tool.href)} aria-hidden="true" />
              {tool.badge && <span class="badge-tag">{tool.badge}</span>}
            </div>
            <h2 class="card-tool-name">{tool.name}</h2>
            <p class="card-tool-desc">{tool.desc}</p>
            <span class="card-action-link">
              Run test
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page {
    padding-top: 96px;
    padding-bottom: var(--spacing-section);
  }

  .container-site {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .hub-header {
    margin-bottom: 2.5rem;
  }

  .hub-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.25em 0.75em;
    border-radius: var(--radius-pill);
    margin-bottom: 0.75rem;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .hub-title {
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .hub-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 65ch;
  }

  .grid-tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    width: 100%;
  }

  .tool-hub-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    text-decoration: none;
    cursor: pointer;
    border-radius: 1.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    backdrop-filter: blur(16px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .tool-hub-card:hover {
    transform: translateY(-4px);
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 16px 36px -12px rgba(37, 99, 235, 0.25), 0 0 0 1px rgba(59, 130, 246, 0.2);
    text-decoration: none;
  }

  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-icon {
    width: 48px;
