---
/**
 * /test/controller/buttons — Controller Button Tester & Ghosting Tool
 * Master SEO & Technical Content Optimization
 * Primary keyword: controller button test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import ButtonTester from '@components/tools/controller/ButtonTester.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Button Tester' },
];

const faqs = [
  {
    question: 'How do I test if my controller buttons are sticking or unresponsive?',
    answer: 'Press each face button, bumper, and trigger while watching the interactive button matrix visualizer above. Healthy switches illuminate instantaneously upon actuation and extinguish immediately when released. If an input stays lit or requires excessive force to register, the conductive membrane or switch is worn.',
  },
  {
    question: 'What is gamepad button ghosting and does this test detect it?',
    answer: 'Button ghosting occurs when pressing multiple simultaneous inputs causes adjacent buttons to register false presses or fail to register at all. Our tool samples simultaneous button combinations across the entire 18-input Gamepad API matrix to verify proper input isolation.',
  },
  {
    question: 'What buttons are tested in this tool?',
    answer: 'The matrix tests all 18 standard inputs: Face Buttons (A/Cross, B/Circle, X/Square, Y/Triangle), Shoulder Bumpers (L1/R1, LB/RB), Analog Triggers (L2/R2, LT/RT), Thumbstick Clicks (L3/R3), D-Pad (Up, Down, Left, Right), Select/Share/Back, Start/Options/Menu, and Guide/Home/Touchpad buttons.',
  },
  {
    question: 'Can I clean sticky controller buttons without taking the controller apart?',
    answer: 'Yes. For minor sticking caused by dust or liquid residue, apply 2 drops of 99% isopropyl alcohol around the edges of the sticky button using a cotton swab, press the button rapidly 40 times to work the alcohol into the guide channel, and allow 15 minutes to dry before retesting.',
  },
  {
    question: 'What is the difference between conductive rubber membranes and mechanical microswitches?',
    answer: 'Most standard gamepads (DualSense, standard Xbox) use silicone rubber domes with conductive carbon pills that complete a circuit when pressed against the PCB. Pro controllers often use mechanical mouse-click microswitches with tactile metal leaf springs that offer faster actuation and zero membrane degradation.',
  }
];
---

<ToolLayout
  title="Controller Button Test — Free Online Gamepad Button Checker | ControllerTesting.com"
  description="Test every button on your PS5, Xbox, Switch, or PC controller online for free. Check face buttons, bumpers, triggers, D-pad, and stick clicks for ghosting and sticking."
  keywords="controller button test, gamepad button tester, test controller buttons online, ps5 button test, xbox controller button test, gamepad button check"
  toolName="Controller Button Test"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <ButtonTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Button Actuation & Health Guidelines</h2>
      <p class="results-text">
        Every button input is polled in real-time at 60fps via the browser Gamepad API. Evaluate your controller switches against these standards:
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Instant Response (Healthy)</strong>
          <p class="legend-text">Switch activates with light pressure and releases cleanly with zero lingering or chatter.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Sticky / Heavy Press (Watch)</strong>
          <p class="legend-text">Button requires heavy force to actuate or slowly pops back up. Caused by residue in the plastic button channel.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Dead Switch / Ghosting (Fault)</strong>
          <p class="legend-text">Button fails to illuminate or triggers unpressed adjacent inputs. Membrane tear or PCB trace oxidation.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need a complete controller health checkup?</h3>
        <p class="export-desc">Combine button testing with stick drift, trigger linearity, and rumble motor diagnostics.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/full-diagnostic" class="btn-primary">Run Full Wizard</a>
        <a href="/test/controller/health-score" class="btn-secondary">Get Health Score</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Isolated 0.1% stick centering detector.</p>
    </a>
    <a href="/test/controller/triggers" class="tool-card card-base card-hover">
      <h3 class="tool-name">Trigger Pressure Tester</h3>
      <p class="tool-desc">Analog L2/R2 pressure curve analyzer.</p>
    </a>
    <a href="/test/controller/dpad" class="tool-card card-base card-hover">
      <h3 class="tool-name">8-Way D-Pad Tester</h3>
      <p class="tool-desc">Directional pad diagonal precision test.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Measure input report frequency in Hz.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>How Controller Button Switches Work</h2>
    <p>
      Face buttons, shoulder bumpers, and D-pads in gaming controllers rely on mechanical and electrical contact points to translate physical finger actuation into digital input signals.
    </p>

    <h3>Conductive Rubber Membrane Mechanics</h3>
    <p>
      Standard controllers (such as the Sony DualSense and Microsoft Xbox Wireless Controller) use flexible silicone rubber membranes positioned beneath the exterior plastic keycaps.
    </p>
    <ul>
      <li><strong>The Conductive Pill:</strong> Underneath each silicone dome sits a small disk of conductive carbon. When you press the button, the dome collapses and presses the carbon pill against split copper or gold PCB traces.</li>
      <li><strong>Circuit Closure:</strong> Bridging the PCB traces completes the circuit, sending a logic-low or logic-high signal to the controller’s main microcontroller.</li>
      <li><strong>Tactile Spring Return:</strong> The natural elasticity of the silicone rubber pushes the button back up when finger pressure is released.</li>
    </ul>

    <h2>Common Button Failures and Diagnostic Symptoms</h2>
    <ol>
      <li>
        <strong>Unresponsive or Intermittent Press:</strong> The conductive carbon coating has eroded from friction, or dust/oil residue is insulating the PCB contact pads.
      </li>
      <li>
        <strong>Sticky or Slow-Return Buttons:</strong> Sugary liquid residue, dirt, or plastic mold flash is binding the exterior button cylinder against the top shell guide tube.
      </li>
      <li>
        <strong>Double-Press / Chatter:</strong> A torn silicone dome collapses unevenly, causing the contact pill to bounce against the PCB traces and register multiple rapid presses.
      </li>
      <li>
        <strong>Broken Bumper Actuator:</strong> Xbox bumpers utilize plastic bridge fulcrums that can crack under heavy drops, preventing the physical bumper from depressing the internal microswitch.
      </li>
    </ol>

    <h2>Step-by-Step Button Remediation Guide</h2>
    <ul>
      <li><strong>External Cleaning:</strong> Dip a cotton swab in 99% isopropyl alcohol and rub it around the circumference of sticky buttons while pressing rapidly.</li>
      <li><strong>Internal Membrane Replacement:</strong> If carbon pads are worn smooth or torn, replacement silicone rubber membrane sets are readily available and require only simple screwdriver disassembly to install.</li>
      <li><strong>Microswitch Replacement:</strong> For mouse-click style bumpers or D-pads with dead tactile switches, desoldering and installing a fresh Omron or Kailh microswitch restores crisp click response.</li>
    </ul>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .results-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { margin-left: 1.25rem; margin-bottom: 1rem; }
  .prose li { margin-bottom: 0.5rem; }
</style>
