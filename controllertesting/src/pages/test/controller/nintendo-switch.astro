---
/**
 * /test/controller/nintendo-switch — Nintendo Switch Controller Tester & Joy-Con Drift Repair Guide
 * Target keyword: nintendo-switch controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Nintendo Switch Tester' },
];

const faqs = [
  {
    "question": "How do I connect my Nintendo Switch controller to PC or Mac?",
    "answer": "For Joy-Cons, press and hold the small sync button on the rail until the lights flash, then pair via Bluetooth on your PC/Mac. For the Pro Controller, use a USB-C cable or hold the sync button on top to pair via Bluetooth."
  },
  {
    "question": "What is Joy-Con drift?",
    "answer": "Joy-Con drift is a hardware defect where the analog stick registers movement even when you aren't touching it. It is caused by the carbon pads wearing down inside the potentiometer module over time."
  },
  {
    "question": "How can I fix Joy-Con drift permanently?",
    "answer": "The only permanent fix is replacing the stock analog sticks with Hall-effect joystick modules. Hall-effect sensors use magnets instead of physical contacts, completely eliminating wear and tear that causes drift."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Nintendo Switch Controller Tester & Joy-Con Drift Repair Guide",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Test your Nintendo Switch Pro Controller and Joy-Cons for stick drift instantly in your browser. Plus, a complete guide on how to fix Joy-Con drift permanently."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Nintendo Switch Tester",
          "item": "https://controllertesting.com/test/controller/nintendo-switch"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I connect my Nintendo Switch controller to PC or Mac?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For Joy-Cons, press and hold the small sync button on the rail until the lights flash, then pair via Bluetooth on your PC/Mac. For the Pro Controller, use a USB-C cable or hold the sync button on top to pair via Bluetooth."
          }
        },
        {
          "@type": "Question",
          "name": "What is Joy-Con drift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Joy-Con drift is a hardware defect where the analog stick registers movement even when you aren't touching it. It is caused by the carbon pads wearing down inside the potentiometer module over time."
          }
        },
        {
          "@type": "Question",
          "name": "How can I fix Joy-Con drift permanently?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The only permanent fix is replacing the stock analog sticks with Hall-effect joystick modules. Hall-effect sensors use magnets instead of physical contacts, completely eliminating wear and tear that causes drift."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="Nintendo Switch Controller Tester & Joy-Con Drift Repair Guide"
  description="Test your Nintendo Switch Pro Controller and Joy-Cons for stick drift instantly in your browser. Plus, a complete guide on how to fix Joy-Con drift permanently."
  toolName="Nintendo Switch Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell nintendo-brand-shell" data-model="switch">
      <Interactive3DVisualizer modelUrl="/models/switch_controller.glb" isRigid={true} />
    </div>
    <style>
      .nintendo-brand-shell {
        --ambient-glow: #E60012;
        background: radial-gradient(circle at center, rgba(230, 0, 18, 0.45) 0%, rgba(230, 0, 18, 0.15) 100%),
                    repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(230, 0, 18, 0.1) 10px, rgba(230, 0, 18, 0.1) 20px);
        box-shadow: inset 0 0 60px rgba(230, 0, 18, 0.2), 0 0 80px rgba(230, 0, 18, 0.3);
        border: 1px solid rgba(230, 0, 18, 0.5);
        border-radius: 12px;
        padding: 1rem;
      }
    </style>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="What is the best way to fix Nintendo Switch controller drift?">
      <p>To fix Nintendo Switch controller drift permanently, replace the faulty potentiometer stick with a Hall-effect sensor module. For a temporary fix, use electronic contact cleaner under the rubber stick skirt to remove debris. Always re-calibrate your controller in system settings afterward to ensure accurate input.</p>
      
      <h3 style="color: var(--color-accent); margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: bold;">Recommended Actions</h3>
      <p>Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto px-4">
      <PremiumFaqAccordion faqs={faqs} title="Nintendo Switch FAQs" subtitle="Common issues and questions about Nintendo Joy-Cons and Pro Controllers." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>
