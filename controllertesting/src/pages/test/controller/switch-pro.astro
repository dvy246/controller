---
/**
 * /test/controller/switch-pro — Switch Pro Controller Tester & Input Validator
 * Target keyword: switch-pro controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Switch Pro Controller Tester' },
];

const faqs = [
  {
    "question": "Is the Switch Pro Controller prone to drift?",
    "answer": "While generally more durable than Joy-Cons, the Switch Pro Controller still uses standard potentiometers and can develop drift over years of heavy use."
  }
];

---

<ToolLayout
  title="Switch Pro Controller Tester & Input Validator"
  description="Test your Nintendo Switch Pro Controller's polling rate, button inputs, and analog sticks for precision issues and drift."
  toolName="Switch Pro Controller Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>


  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell nintendo-brand-shell" data-model="switch">
      <Interactive3DVisualizer />
    </div>
    <style>
      .nintendo-brand-shell {
        --ambient-glow: #E60012;
        box-shadow: 0 0 60px rgba(230, 0, 18, 0.15);
        border-color: rgba(230, 0, 18, 0.3);
      }
    </style>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── Semantic SEO Content Slot ── */}
  <Fragment slot="content">
    <section class="max-w-4xl mx-auto mt-16 px-6">
      <h2 class="text-[var(--text-h2)] font-extrabold tracking-tight mb-6">Switch Pro Controller Technical Diagnostics</h2>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        The Nintendo Switch Pro Controller is highly regarded for its ergonomic design and battery life, but its joystick modules still rely on traditional carbon-film potentiometers. Over time, friction degrades these tracks, leading to <strong>stick drift</strong>. Our diagnostic suite connects to the Pro Controller via Bluetooth or USB, allowing you to instantly visualize exactly how much axial offset the left and right analog sticks are experiencing without needing a dedicated app.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Digital Triggers and Face Buttons</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        Unlike the PS5 or Xbox controllers, the Switch Pro Controller uses <strong>digital triggers (ZL/ZR)</strong> rather than analog sliders. This means they are either fully pressed (1.0) or fully released (0.0). You can use our button matrix to ensure these triggers, alongside the oversized ABXY face buttons and the notoriously finicky D-Pad, are responding instantly without any mechanical switch bounce (double-clicking).
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">HD Rumble and Gyroscope Sensors</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
        The Switch Pro Controller also features linear resonant actuators (LRA) for Nintendo's proprietary "HD Rumble" and a high-precision 6-axis IMU (gyroscope and accelerometer) for motion controls in games like Splatoon and Zelda. Our advanced haptic and gyroscope tools allow you to stream telemetry directly from these sensors to verify they haven't been damaged by drops or firmware glitches.
      </p>
    </section>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How to calibrate a Switch Pro Controller on PC?">
      <p class="text-lg">To calibrate a Switch Pro Controller on a PC, connect it via USB or Bluetooth. Open the Windows joy.cpl settings or Steam's controller configuration to adjust deadzones. For precise hardware-level testing, use a web-based tester to verify analog stick circularity and center offsets.</p>
      
      <h3 class="text-blue-400 mt-12 mb-4 text-2xl font-extrabold tracking-tight">Recommended Actions</h3>
      <p class="text-lg">Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto mt-32 mb-20 px-6">
      <PremiumFaqAccordion faqs={faqs} title="Switch Pro Controller FAQs" subtitle="Common issues and questions about Nintendo's Pro Controller." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/gyroscope" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🧭</div>
      <h3 class="card-tool-name">Switch Gyro Tester</h3>
      <p class="card-tool-desc">Test the 6-axis motion controls and IMU tilt.</p>
    </a>
    <a href="/test/controller/vibration" class="tool-hub-card card-hover card-base">
      <div class="card-icon">📳</div>
      <h3 class="card-tool-name">HD Rumble Check</h3>
      <p class="card-tool-desc">Verify the linear resonant actuators (LRA) are firing.</p>
    </a>
    <a href="/test/controller/circularity" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🎯</div>
      <h3 class="card-tool-name">Stick Circularity</h3>
      <p class="card-tool-desc">Measure the error rate on the Pro Controller's stick rims.</p>
    </a>
  </Fragment>
</ToolLayout>
