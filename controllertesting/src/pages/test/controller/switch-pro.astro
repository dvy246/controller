---
/**
 * /test/controller/switch-pro — Switch Pro Controller Tester & Input Validator
 * Target keyword: switch-pro controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive2DVisualizer from '../../../components/tools/controller/Interactive2DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Switch Pro Controller Tester' },
];

const faqs = [
  {
    "question": "Is the Switch Pro Controller prone to drift?",
    "answer": "While generally more durable than Joy-Cons, the Switch Pro Controller still uses standard potentiometers and can develop drift over years of heavy use."
  }
];

---

<ToolLayout
  title="Switch Pro Controller Tester & Input Validator"
  description="Test your Nintendo Switch Pro Controller's polling rate, button inputs, and analog sticks for precision issues and drift."
  toolName="Switch Pro Controller Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>


  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <Interactive2DVisualizer isRigid={true} />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── Semantic SEO Content Slot ── */}
  <Fragment slot="content">
    <section class="max-w-4xl mx-auto mt-16 px-6">
      <h2 class="text-h2 mb-6">Switch Pro Controller Technical Diagnostics</h2>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        The Pro Controller is comfortable and long-lived — except for its sticks. The joystick modules use carbon-film potentiometers, and friction wears those tracks into <strong>stick drift</strong> over time. Connect the pad over Bluetooth or USB, and this tool shows the resting offset of each stick the moment it connects. No dedicated app required.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">Digital Triggers and Face Buttons</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed mb-6">
        Unlike PS5 or Xbox pads, the Pro Controller uses <strong>digital ZL/ZR triggers</strong>, not analog sliders — each reads 1.0 fully pressed or 0.0 released. Use the button matrix to check those, the ABXY face buttons, and the D-pad (whose diagonals are a known weak point) for bounce-free registration.
      </p>
      
      <h3 class="text-[var(--text-h3)] font-bold mb-4 mt-10">HD Rumble and Gyroscope Sensors</h3>
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
        The Pro Controller also packs linear resonant actuators (LRA) for Nintendo's "HD Rumble" and a 6-axis IMU for motion aiming in Splatoon and Zelda. The haptic and gyro tools stream those sensors so you can confirm they survived drops and firmware updates intact.
      </p>
    </section>
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How to calibrate a Switch Pro Controller on PC?">
      <p class="text-lg">To calibrate a Switch Pro Controller on a PC, connect it via USB or Bluetooth. Open the Windows joy.cpl settings or Steam's controller configuration to adjust deadzones. For precise hardware-level testing, use a web-based tester to verify analog stick circularity and center offsets.</p>
      
      <h3 class="text-h3 text-accent mt-8 mb-4">Recommended Actions</h3>
      <p class="text-lg">      Start with the <a href="/test/controller/drift">Stick Drift Test</a>. Sticks resting in the 2–10% band usually respond to contact cleaner and a deadzone bump; above 10%, plan a module swap rather than repeated cleaning.</p>
    </PremiumGuideCard>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/gyroscope" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🧭</div>
      <h3 class="card-tool-name">Switch Gyro Tester</h3>
      <p class="card-tool-desc">Test the 6-axis motion controls and IMU tilt.</p>
    </a>
    <a href="/test/controller/vibration" class="tool-hub-card card-hover card-base">
      <div class="card-icon">📳</div>
      <h3 class="card-tool-name">HD Rumble Check</h3>
      <p class="card-tool-desc">Verify the linear resonant actuators (LRA) are firing.</p>
    </a>
    <a href="/test/controller/circularity" class="tool-hub-card card-hover card-base">
      <div class="card-icon">🎯</div>
      <h3 class="card-tool-name">Stick Circularity</h3>
      <p class="card-tool-desc">Measure the error rate on the Pro Controller's stick rims.</p>
    </a>
  </Fragment>
</ToolLayout>
