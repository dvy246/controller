---
/**
 * /test/controller/switch-pro — Switch Pro Controller Tester & Input Validator
 * Target keyword: switch-pro controller tester
 */

import ToolLayout from '../../../layouts/ToolLayout.astro';
import Interactive3DVisualizer from '../../../components/tools/controller/Interactive3DVisualizer.astro';
import DiagnosticResultsBento from '../../../components/seo/DiagnosticResultsBento.astro';
import PremiumGuideCard from '../../../components/seo/PremiumGuideCard.astro';
import PremiumFaqAccordion from '../../../components/seo/PremiumFaqAccordion.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Switch Pro Controller Tester' },
];

const faqs = [
  {
    "question": "Is the Switch Pro Controller prone to drift?",
    "answer": "While generally more durable than Joy-Cons, the Switch Pro Controller still uses standard potentiometers and can develop drift over years of heavy use."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Switch Pro Controller Tester & Input Validator",
      "operatingSystem": "Web Browser",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "Test your Nintendo Switch Pro Controller's polling rate, button inputs, and analog sticks for precision issues and drift."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://controllertesting.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tests",
          "item": "https://controllertesting.com/test/controller/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Switch Pro Controller Tester",
          "item": "https://controllertesting.com/test/controller/switch-pro"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the Switch Pro Controller prone to drift?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "While generally more durable than Joy-Cons, the Switch Pro Controller still uses standard potentiometers and can develop drift over years of heavy use."
          }
        }
      ]
    }
  ]
};
---

<ToolLayout
  title="Switch Pro Controller Tester & Input Validator"
  description="Test your Nintendo Switch Pro Controller's polling rate, button inputs, and analog sticks for precision issues and drift."
  toolName="Switch Pro Controller Tester"
  category="Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />
  </Fragment>

  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <div class="doppelrand-shell nintendo-brand-shell" data-model="switch">
      <Interactive3DVisualizer />
    </div>
    <style>
      .nintendo-brand-shell {
        background: linear-gradient(135deg, rgba(255, 0, 50, 0.15) 0%, transparent 50%, rgba(0, 195, 227, 0.15) 100%);
        border: 2px solid transparent;
        background-clip: padding-box;
        position: relative;
        border-radius: 12px;
        padding: 1rem;
      }
      .nintendo-brand-shell::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        margin: -2px;
        border-radius: inherit;
        background: linear-gradient(135deg, #ff0032 0%, #00c3e3 100%);
        opacity: 0.5;
      }
    </style>
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <DiagnosticResultsBento />
  </Fragment>

  {/* ── SEO Repair Guide Section ── */}
  <Fragment slot="export">
    <PremiumGuideCard title="How to calibrate a Switch Pro Controller on PC?">
      <p>To calibrate a Switch Pro Controller on a PC, connect it via USB or Bluetooth. Open the Windows joy.cpl settings or Steam's controller configuration to adjust deadzones. For precise hardware-level testing, use a web-based tester to verify analog stick circularity and center offsets.</p>
      
      <h3 style="color: var(--color-accent); margin-bottom: 0.5rem; font-size: 1.2rem; font-weight: bold;">Recommended Actions</h3>
      <p>Always begin by using our free <a href="/test/controller/drift">drift diagnostic tool</a> to identify the exact cause of any input inconsistencies before attempting repairs.</p>
    </PremiumGuideCard>

    <div class="max-w-4xl mx-auto px-4">
      <PremiumFaqAccordion faqs={faqs} title="Switch Pro Controller FAQs" subtitle="Common issues and questions about Nintendo's Pro Controller." />
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Universal Stick Drift Test</h3>
      <p class="tool-desc">Test any controller across all major platforms.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Check for sticky or failing face buttons and triggers.</p>
    </a>
  </Fragment>
</ToolLayout>
