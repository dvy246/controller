---
/**
 * /test/controller/microphone — Controller Microphone Tester
 * Master SEO & Technical Content Optimization
 * Primary keyword: controller microphone test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import MicrophoneTester from '@components/tools/controller/MicrophoneTester.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Microphone Tester' },
];

const faqs = [
  {
    question: 'How do I test the built-in microphone on a PS5 DualSense controller online?',
    answer: 'Connect your DualSense via USB-C cable to your PC/Mac, select "Wireless Controller" as your default sound input device in system settings, click "Start Microphone Test" above, and speak normally. The live audio visualizer plots frequency spectrum and peak volume levels in decibels (dBFS).',
  },
  {
    question: 'Can I test a 3.5mm gaming headset plugged into my controller?',
    answer: 'Yes! Plug your headset into the 3.5mm TRRS jack on your PS5 or Xbox controller. When selected as the system audio input, the Web Audio API analyzes microphone clarity, background noise floor, and signal-to-noise ratio.',
  },
  {
    question: 'Why does my controller headset microphone sound quiet or muffled?',
    answer: 'Low volume is often caused by a CTIA vs. OMTP pinout standard mismatch (ground and microphone pins swapped) or dust buildup inside the 3.5mm jack housing. In Windows Sound settings, verify that input level is set to 80–90% with microphone boost enabled.',
  },
  {
    question: 'How does the PS5 DualSense dual-microphone noise canceling work?',
    answer: 'The DualSense contains two MEMS microphones: a primary voice mic below the PS button and a secondary environmental mic on the top edge. Onboard DSP inverts environmental noise to phase-cancel background room hum and game audio from television speakers.',
  },
  {
    question: 'Does the Xbox Wireless Controller have a built-in microphone?',
    answer: 'No. Standard Microsoft Xbox controllers do not contain internal microphones, but they feature a 3.5mm TRRS auxiliary port and proprietary expansion port for external gaming headsets and chatpads.',
  }
];
---

<ToolLayout
  title="Controller Microphone Test — Free Online Built-In Mic & Headset Tester | ControllerTesting.com"
  description="Test built-in controller microphones and 3.5mm headset audio on PS5 DualSense and Xbox controllers online for free. Real-time audio spectrum & dBFS level meter."
  keywords="controller microphone test, dualsense mic test, ps5 controller microphone check, test controller headset mic, xbox controller 3.5mm audio test, controller mic test online"
  toolName="Microphone Tester"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <MicrophoneTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Microphone Acoustic Performance Benchmarks</h2>
      <p class="results-text">
        Speak at normal conversation distance and monitor input decibel thresholds:
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">-18 dBFS to -6 dBFS (Optimal)</strong>
          <p class="legend-text">Crisp speech clarity; low noise floor (&lt; -45 dBFS); ideal voice transmission for in-game party chat and Discord.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">&lt; -30 dBFS (Low Gain / Muffled)</strong>
          <p class="legend-text">Weak audio signal. Requires increasing OS input gain or checking microphone positioning near the mouth.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">0 dBFS Continuous (Static / Short)</strong>
          <p class="legend-text">Severe buzzing or constant clipping. Indicates dirty 3.5mm TRRS jack contacts, ground loop, or broken mic wire.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need a full gamepad diagnostic checkup?</h3>
        <p class="export-desc">Combine acoustic microphone diagnostics with stick drift, haptic vibration, and button tests.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/vibration" class="btn-primary">Test Vibration</a>
        <a href="/test/controller/full-diagnostic" class="btn-secondary">Full Diagnostic</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/vibration" class="tool-card card-base card-hover">
      <h3 class="tool-name">Vibration Tester</h3>
      <p class="tool-desc">Test dual haptic rumble motors.</p>
    </a>
    <a href="/test/controller/ps5" class="tool-card card-base card-hover">
      <h3 class="tool-name">PS5 Master Tester</h3>
      <p class="tool-desc">Complete DualSense hardware diagnostic suite.</p>
    </a>
    <a href="/test/controller/touchpad" class="tool-card card-base card-hover">
      <h3 class="tool-name">Touchpad Tester</h3>
      <p class="tool-desc">DualSense multi-touch capacitive tracking.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>Controller Audio Hardware & Microphone Acoustic Processing</h2>
    <p>
      Modern gaming controllers integrate high-definition USB audio codecs to transmit multi-channel party audio, spatial game effects, and microphone voice streams without requiring dedicated soundcards.
    </p>

    <h3>DualSense Beamforming MEMS Microphone Array</h3>
    <ul>
      <li>
        <strong>Primary Voice Mic:</strong> Positioned directly below the PS logo button, angled toward the user’s mouth to capture primary vocal frequencies (100Hz–8kHz).
      </li>
      <li>
        <strong>Secondary Ambient Mic:</strong> Located on the upper rear spine between the shoulder bumpers. It samples environmental room reverberation and button clicking noise, allowing real-time digital signal processing (DSP) to subtract ambient clutter from voice chat.
      </li>
    </ul>

    <h3>3.5mm TRRS Headset Jack Standards: CTIA vs. OMTP</h3>
    <p>
      Both PlayStation and Xbox controllers adhere to the modern <strong>CTIA standard</strong>: Tip = Left Audio, Ring 1 = Right Audio, Ring 2 = Ground, Sleeve = Microphone. Connecting an older OMTP headset (where Ground and Mic are reversed) results in hollow, quiet voice capture and heavy static crackle.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .results-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
</style>
