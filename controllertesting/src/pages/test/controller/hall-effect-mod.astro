---
import ToolLayout from '@layouts/ToolLayout.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Hall Effect Mod' },
];
---

<ToolLayout
  title="Hall Effect Mod Verification Hub | ControllerTesting"
  description="Verify your Hall effect joystick mod. Run 'Before & After' benchmarks to generate a verifiable Mod Success Certificate."
  toolName="Hall Effect Mod Verification"
  category="Modding & Repair"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="tool">
    <div class="card-base p-8 rounded-2xl mb-8 relative overflow-hidden">
      <div class="absolute -right-8 -top-8 w-40 h-40 opacity-10 text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.673 4.673a2.25 2.25 0 01-3.182 0l-3.32-3.32a2.25 2.25 0 010-3.182l4.673-4.673m8.973 7.19l1.052-1.052a2.25 2.25 0 000-3.182l-2.1-2.1a2.25 2.25 0 00-3.182 0l-1.052 1.052m3.282 3.282l-3.282-3.282" />
      </svg>
    </div>
    
    <div class="relative z-10 max-w-2xl">
      <h2 class="text-h2 mb-2">Hall Effect Mod Verifier</h2>
      <p class="text-secondary mb-6 text-sm leading-relaxed">
        Replacing ALPS potentiometers with electromagnetic Hall effect sensors? Benchmark your controller before the mod, then verify the result after. Comparing the two readings shows whether the swap reduced drift and improved circularity.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <!-- Before Mod Card -->
      <div class="bg-surface-1 border border-surface-3 p-6 rounded-xl relative">
        <div class="absolute top-4 right-4 text-xs font-bold px-2 py-1 bg-surface-2 rounded-md text-secondary">Step 1</div>
        <h3 class="text-lg font-bold text-primary mb-1">Pre-Mod Baseline</h3>
        <p class="text-xs text-secondary mb-4">Record the original resting drift and circularity error. Keep the sticks still for 2 seconds, then rotate them around the edge.</p>
        
        <div class="space-y-4">
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Avg Drift</span>
            <span id="pre-drift" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Circularity Error</span>
            <span id="pre-circ" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <button id="btn-record-pre" class="w-full btn-secondary py-2 rounded-lg text-sm font-bold cursor-pointer transition-colors duration-200 focus-ring">Record Baseline</button>
        </div>
      </div>

      <!-- After Mod Card -->
      <div class="bg-surface-1 border border-surface-3 p-6 rounded-xl relative">
         <div class="absolute top-4 right-4 text-xs font-bold px-2 py-1 bg-surface-2 rounded-md text-secondary">Step 2</div>
        <h3 class="text-lg font-bold text-primary mb-1">Post-Mod Verification</h3>
        <p class="text-xs text-secondary mb-4">Repeat the same measurement with the Hall effect modules installed and compare.</p>
        
        <div class="space-y-4">
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Avg Drift</span>
            <span id="post-drift" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Circularity Error</span>
            <span id="post-circ" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <button id="btn-record-post" class="w-full btn-primary py-2 rounded-lg text-sm font-bold opacity-50 cursor-not-allowed transition-colors duration-200 focus-ring" disabled>Measure After Mod</button>
        </div>
      </div>
    </div>

    <div id="certificate-section" class="hidden text-center pt-6 border-t border-surface-3" role="status">
      <h3 id="cert-title" class="text-h3 text-primary mb-2"></h3>
      <p id="cert-text" class="text-sm text-secondary"></p>
    </div>
  </div>
  </Fragment>
</ToolLayout>

<script>
  // Each recording: 2 s with sticks at rest (drift), then 6 s of full rotations (circularity).
  const REST_MS = 2000;
  const ROTATE_MS = 6000;
  const BINS = 36;

  function activeGamepad(): Gamepad | null {
    const pads = navigator.getGamepads ? navigator.getGamepads() : [];
    for (const gp of pads) if (gp && gp.connected) return gp;
    return null;
  }

  function measure(onPhase: (label: string) => void): Promise<{ drift: string; circ: string } | null> {
    return new Promise((resolve) => {
      if (!activeGamepad()) return resolve(null);
      const startedAt = performance.now();
      let restMax = 0;
      const binMax = [new Array(BINS).fill(0), new Array(BINS).fill(0)];
      onPhase('Hands off the sticks…');
      const tick = () => {
        const gp = activeGamepad();
        const elapsed = performance.now() - startedAt;
        if (!gp) return resolve(null);
        const sticks = [[gp.axes[0] ?? 0, gp.axes[1] ?? 0], [gp.axes[2] ?? 0, gp.axes[3] ?? 0]];
        if (elapsed < REST_MS) {
          for (const [x, y] of sticks) restMax = Math.max(restMax, Math.hypot(x, y));
        } else if (elapsed < REST_MS + ROTATE_MS) {
          onPhase('Rotate both sticks around the edge…');
          sticks.forEach(([x, y], i) => {
            const r = Math.hypot(x, y);
            if (r < 0.5) return;
            const bin = Math.floor(((Math.atan2(y, x) + Math.PI) / (2 * Math.PI)) * BINS) % BINS;
            binMax[i][bin] = Math.max(binMax[i][bin], r);
          });
        } else {
          const errors = binMax.map((bins) => {
            const filled = bins.filter((r) => r > 0);
            if (filled.length < BINS * 0.75) return null;
            return (filled.reduce((sum, r) => sum + Math.abs(r - 1), 0) / filled.length) * 100;
          });
          if (errors.some((e) => e === null)) return resolve(null);
          return resolve({ drift: (restMax * 100).toFixed(2), circ: Math.max(...(errors as number[])).toFixed(2) });
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const btnPre = document.getElementById('btn-record-pre') as HTMLButtonElement;
    const btnPost = document.getElementById('btn-record-post') as HTMLButtonElement;
    const preDrift = document.getElementById('pre-drift');
    const preCirc = document.getElementById('pre-circ');
    const postDrift = document.getElementById('post-drift');
    const postCirc = document.getElementById('post-circ');
    const certSection = document.getElementById('certificate-section');
    const certTitle = document.getElementById('cert-title');
    const certText = document.getElementById('cert-text');

    let baseline: { drift: string; circ: string } | null = null;

    function enablePost() {
      btnPost.disabled = false;
      btnPost.classList.remove('opacity-50', 'cursor-not-allowed');
    }

    try {
      const saved = localStorage.getItem('hall_mod_baseline');
      if (saved) {
        baseline = JSON.parse(saved);
        if (preDrift) preDrift.textContent = baseline!.drift + '%';
        if (preCirc) preCirc.textContent = baseline!.circ + '%';
        btnPre.textContent = 'Re-record Baseline';
        enablePost();
      }
    } catch (e) {
      console.error('Failed to parse baseline data', e);
    }

    btnPre?.addEventListener('click', async () => {
      const result = await measure((label) => (btnPre.textContent = label));
      if (!result) {
        btnPre.textContent = 'No complete reading — connect a controller and retry';
        return;
      }
      baseline = result;
      if (preDrift) preDrift.textContent = result.drift + '%';
      if (preCirc) preCirc.textContent = result.circ + '%';
      btnPre.textContent = 'Baseline Recorded ✓';
      try {
        localStorage.setItem('hall_mod_baseline', JSON.stringify(result));
      } catch {}
      enablePost();
    });

    btnPost?.addEventListener('click', async () => {
      if (!baseline) return;
      const result = await measure((label) => (btnPost.textContent = label));
      if (!result) {
        btnPost.textContent = 'No complete reading — retry';
        return;
      }
      if (postDrift) postDrift.textContent = result.drift + '%';
      if (postCirc) postCirc.textContent = result.circ + '%';
      btnPost.textContent = 'Measure Again';

      const improved = parseFloat(result.drift) < parseFloat(baseline.drift);
      const clean = parseFloat(result.drift) < 2;
      if (certTitle) certTitle.textContent = improved && clean ? 'Drift reduced after the mod' : 'No clear improvement yet';
      if (certText) {
        certText.textContent = `Resting drift ${baseline.drift}% → ${result.drift}%, circularity error ${baseline.circ}% → ${result.circ}%.` +
          (improved && clean ? '' : ' Check sensor seating and recalibrate, then measure again.');
      }
      certSection?.classList.remove('hidden');
    });
  });
</script>
