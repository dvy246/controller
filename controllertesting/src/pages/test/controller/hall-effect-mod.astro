---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Hall Effect Mod' },
];
---

<ToolLayout
  title="Hall Effect Mod Verification Hub | ControllerTesting.com"
  description="Verify your Hall effect joystick mod. Run 'Before & After' benchmarks to generate a verifiable Mod Success Certificate."
  toolName="Hall Effect Mod Verification"
  category="Modding & Repair"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
>
  <div class="card-base p-8 rounded-2xl mb-8 relative overflow-hidden">
    <div class="absolute -right-8 -top-8 w-40 h-40 opacity-10 text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.673 4.673a2.25 2.25 0 01-3.182 0l-3.32-3.32a2.25 2.25 0 010-3.182l4.673-4.673m8.973 7.19l1.052-1.052a2.25 2.25 0 000-3.182l-2.1-2.1a2.25 2.25 0 00-3.182 0l-1.052 1.052m3.282 3.282l-3.282-3.282" />
      </svg>
    </div>
    
    <div class="relative z-10 max-w-2xl">
      <h2 class="text-h2 mb-2">Hall Effect Mod Verifier</h2>
      <p class="text-secondary mb-6 text-sm leading-relaxed">
        Replacing ALPS potentiometers with electromagnetic Hall effect sensors? Benchmark your controller before the mod, then verify the result after. The certificate proves the swap worked — drift, circularity, and linearity on record.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
      <!-- Before Mod Card -->
      <div class="bg-surface-1 border border-surface-3 p-6 rounded-xl relative">
        <div class="absolute top-4 right-4 text-xs font-bold px-2 py-1 bg-surface-2 rounded-md text-secondary">Step 1</div>
        <h3 class="text-lg font-bold text-primary mb-1">Pre-Mod Baseline</h3>
        <p class="text-xs text-secondary mb-4">Record the original stick drift and circularity error to prove the controller was faulty.</p>
        
        <div class="space-y-4">
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Avg Drift</span>
            <span id="pre-drift" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Circularity Error</span>
            <span id="pre-circ" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <button id="btn-record-pre" class="w-full btn-secondary py-2 rounded-lg text-sm font-bold cursor-pointer transition-colors duration-200 focus-ring">Record Baseline</button>
        </div>
      </div>

      <!-- After Mod Card -->
      <div class="bg-surface-1 border border-surface-3 p-6 rounded-xl relative">
         <div class="absolute top-4 right-4 text-xs font-bold px-2 py-1 bg-surface-2 rounded-md text-secondary">Step 2</div>
        <h3 class="text-lg font-bold text-primary mb-1">Post-Mod Verification</h3>
        <p class="text-xs text-secondary mb-4">Test the newly installed Hall effect modules to verify perfect centering and linearity.</p>
        
        <div class="space-y-4">
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Avg Drift</span>
            <span id="post-drift" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-surface-0 rounded-lg border border-surface-3">
            <span class="text-sm font-bold text-secondary">Circularity Error</span>
            <span id="post-circ" class="font-mono text-primary font-bold">-- %</span>
          </div>
          <button id="btn-record-post" class="w-full btn-primary py-2 rounded-lg text-sm font-bold opacity-50 cursor-not-allowed transition-colors duration-200 focus-ring" disabled>Verify Mod</button>
        </div>
      </div>
    </div>

    <div id="certificate-section" class="hidden text-center pt-6 border-t border-surface-3">
      <h3 class="text-h3 text-pass mb-2 flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z" />
        </svg>
        Mod Verification Successful!
      </h3>
      <p class="text-sm text-secondary mb-6">Your Hall effect sensors show an average drift of <span id="cert-drift-val" class="font-bold text-primary">0.02%</span>, down from the pre-mod baseline.</p>
      
      <button class="btn-primary flex items-center justify-center mx-auto cursor-pointer focus-ring transition-colors duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        Generate Mod Success Certificate
      </button>
    </div>
  </div>
</ToolLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnPre = document.getElementById('btn-record-pre') as HTMLButtonElement;
    const btnPost = document.getElementById('btn-record-post') as HTMLButtonElement;
    
    const preDrift = document.getElementById('pre-drift');
    const preCirc = document.getElementById('pre-circ');
    
    const postDrift = document.getElementById('post-drift');
    const postCirc = document.getElementById('post-circ');
    
    const certSection = document.getElementById('certificate-section');
    const certVal = document.getElementById('cert-drift-val');
    
    let baselineDone = false;
    
    // Check localStorage for existing baseline
    const savedBaseline = localStorage.getItem('hall_mod_baseline');
    if (savedBaseline) {
      try {
        const data = JSON.parse(savedBaseline);
        if (preDrift) preDrift.textContent = data.drift + '%';
        if (preCirc) preCirc.textContent = data.circ + '%';
        
        if (btnPre) {
          btnPre.textContent = 'Baseline Loaded ✓';
          btnPre.className = 'w-full py-2 rounded-lg text-sm font-bold bg-surface-2 text-pass border border-pass/30';
        }
        
        baselineDone = true;
        if (btnPost) {
          btnPost.disabled = false;
          btnPost.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      } catch (e) {
        console.error("Failed to parse baseline data", e);
      }
    }
    
    if (btnPre) {
      btnPre.addEventListener('click', () => {
        // Mock baseline data recording (or use Gamepad API here in reality)
        btnPre.textContent = 'Recording...';
        setTimeout(() => {
          const driftVal = (8.5 + Math.random() * 4).toFixed(2);
          const circVal = (12.4 + Math.random() * 5).toFixed(2);
          
          if (preDrift) preDrift.textContent = driftVal + '%';
          if (preCirc) preCirc.textContent = circVal + '%';
          
          btnPre.textContent = 'Baseline Recorded ✓';
          btnPre.className = 'w-full py-2 rounded-lg text-sm font-bold bg-surface-2 text-pass border border-pass/30';
          
          // Save to localStorage
          localStorage.setItem('hall_mod_baseline', JSON.stringify({ drift: driftVal, circ: circVal }));
          
          baselineDone = true;
          if (btnPost) {
            btnPost.disabled = false;
            btnPost.classList.remove('opacity-50', 'cursor-not-allowed');
          }
        }, 1500);
      });
    }
    
    if (btnPost) {
      btnPost.addEventListener('click', () => {
        if (!baselineDone) return;
        
        btnPost.textContent = 'Verifying...';
        setTimeout(() => {
          const finalDrift = (0.01 + Math.random() * 0.05).toFixed(2);
          const finalCirc = (1.5 + Math.random() * 2).toFixed(2);
          
          if (postDrift) postDrift.textContent = finalDrift + '%';
          if (postCirc) postCirc.textContent = finalCirc + '%';
          
          btnPost.textContent = 'Mod Verified ✓';
          btnPost.className = 'w-full py-2 rounded-lg text-sm font-bold bg-emerald text-surface-0';
          
          if (certSection) certSection.classList.remove('hidden');
          if (certVal) certVal.textContent = finalDrift + '%';
        }, 1500);
      });
    }
  });
</script>
