---
/**
 * /test/controller/triggers — Trigger Linearity & Pressure Tester
 * Master SEO & Technical Content Optimization
 * Primary keyword: controller trigger test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import TriggerTester from '@components/tools/controller/TriggerTester.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Trigger Pressure Test' },
];

const faqs = [
  {
    question: 'Why does my controller trigger only reach 80% or 90% when fully depressed?',
    answer: 'Truncated trigger travel is caused by worn or displaced internal rubber dampers, cracked trigger stop hinges, or potentiometer track oxidation. In racing games, capping below 100% prevents your vehicle from achieving maximum full-throttle acceleration.',
  },
  {
    question: 'How does analog trigger pressure testing work?',
    answer: 'The Gamepad API samples the analog trigger axes (typically buttons[6] and buttons[7]) as high-precision 64-bit float values from 0.0000 (resting) to 1.0000 (fully bottomed out). Our visualizer graphs your trigger displacement curve in real time at 60fps.',
  },
  {
    question: 'What is the difference between potentiometer and Hall-effect triggers?',
    answer: 'Potentiometer triggers use physical contact wipers that develop dead zones and electrical jitter over time. Modern controllers (such as Xbox Series X and Hall-effect gamepads) use magnetic Hall-effect sensors and permanent neodymium magnets to measure trigger depth with zero friction wear.',
  },
  {
    question: 'Does this tool test PS5 DualSense adaptive triggers?',
    answer: 'Yes. It measures the physical analog travel distance. While browser APIs cannot dynamically program the DualSense micro-motor resistance profiles, our tool accurately tracks whether the trigger travel registers smoothly from 0% to 100% without signal clipping.',
  },
  {
    question: 'How do I fix a controller trigger that does not reach 100%?',
    answer: 'Inspect the trigger housing for dislodged rubber silencing pads that block full travel. If the issue is sensor-related, calibrate the trigger endpoints using Windows Game Controllers settings (joy.cpl) or increase in-game trigger sensitivity / maximum deadzone to 90%.',
  }
];
---

<ToolLayout
  title="Controller Trigger Test — Free Online L2/R2 Pressure & Linearity Tester | ControllerTesting.com"
  description="Test your PS5, Xbox, Switch, or PC gamepad's L2/R2 (LT/RT) analog triggers online. Measures 0.00 to 1.00 pressure linearity, dead zones, and throttle truncation free."
  keywords="controller trigger test, analog trigger tester, l2 r2 trigger test, gamepad trigger pressure test, ps5 trigger test, xbox trigger check"
  toolName="Controller Trigger Test"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <TriggerTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Trigger Linearity Performance Benchmarks</h2>
      <p class="results-text">
        Analog triggers must provide smooth, proportional input progression across the entire stroke. Evaluate your trigger readings against these standards:
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Full Linear Range (Healthy)</strong>
          <p class="legend-text">Rests at 0.00% when untouched and reaches 100.0% smoothly when bottomed out without signal spikes.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Truncated Stroke (Watch)</strong>
          <p class="legend-text">Trigger caps out between 85% and 95% at full pull. Caused by swollen rubber dampers or misaligned magnet sensors.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Dead Band / Jitter (Fault)</strong>
          <p class="legend-text">Trigger fails to register initial 20% travel or flickers wildly. Indicates broken return spring or oxidized sensor.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need a complete gamepad hardware checkup?</h3>
        <p class="export-desc">Combine trigger linearity analysis with stick drift, button matrix, and haptic rumble diagnostics.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/full-diagnostic" class="btn-primary">Run Full Wizard</a>
        <a href="/test/controller/health-score" class="btn-secondary">Get Health Score</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Isolated 0.1% stick centering detector.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Test button ghosting and response speed.</p>
    </a>
    <a href="/test/controller/vibration" class="tool-card card-base card-hover">
      <h3 class="tool-name">Vibration Tester</h3>
      <p class="tool-desc">Test dual haptic rumble motors independently.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Measure input report frequency in Hz.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>The Importance of Analog Trigger Linearity</h2>
    <p>
      Unlike digital microswitch bumpers (L1/R1) that operate as simple binary ON/OFF contacts, analog triggers (L2/LT and R2/RT) measure progressive displacement across a continuous physical stroke.
    </p>
    <p>
      In racing simulations (such as <em>iRacing</em>, <em>Forza Motorsport</em>, and <em>F1</em>), precise modulation between 15% and 85% trigger travel dictates throttle feathering and trail-braking control. In tactical shooters, hair-trigger response determines weapon aim-down-sight (ADS) engagement speed.
    </p>

    <h3>Sensor Architectures: Hall Effect vs. Potentiometers</h3>
    <ul>
      <li><strong>Hall-Effect Magnetic Sensors:</strong> Used in modern Xbox Wireless and premium third-party gamepads. A permanent neodymium magnet affixed to the trigger arm moves closer to a Hall IC on the motherboard. The IC measures the changing magnetic flux density without physical friction, providing lifetime calibration stability.</li>
      <li><strong>Rotational Potentiometers:</strong> Common in older gamepads and budget controllers. A mechanical wiper rotates across a resistive film, making them vulnerable to dirt accumulation, dead initial travel, and electrical noise spikes.</li>
    </ul>

    <h2>Diagnosing Common Trigger Hardware Faults</h2>
    <ol>
      <li>
        <strong>Truncated 100% Throttle:</strong> If your trigger stops at <code>0.88</code> or <code>0.92</code> under maximum finger pressure, the internal silicone dampening pad has compressed or slipped out of place, physically halting trigger travel before the sensor reaches maximum saturation.
      </li>
      <li>
        <strong>Resting Trigger Drag (Ghost Pull):</strong> If the trigger reports <code>0.03</code> or <code>0.05</code> while resting untouched, the internal trigger return spring has fatigued, causing accidental aim-down-sight zooming or weapon firing.
      </li>
      <li>
        <strong>Stepped / Non-Linear Jumps:</strong> If trigger values jump abruptly (e.g., skipping from 0.30 directly to 0.70), debris or magnet misalignment is causing non-linear sensor saturation.
      </li>
    </ol>

    <h2>Step-by-Step Remediation Protocols</h2>
    <ul>
      <li><strong>In-Game Maximum Deadzone Tuning:</strong> If a trigger physically bottoms out at 90%, configure your game's trigger outer deadzone to 10% (or max threshold to 90%) to force full in-game throttle at physical bottom-out.</li>
      <li><strong>Damper Cleaning & Re-Seating:</strong> Disassemble the outer grip shell and inspect the silicone bumper stop at the base of the trigger lever. Replace flattened dampener pads to restore full mechanical swing.</li>
      <li><strong>Trigger Spring Replacement:</strong> Install a high-tension replacement torsion spring if the trigger exhibits loose initial play or fails to reset to true 0.00% rest.</li>
    </ul>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .results-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { margin-left: 1.25rem; margin-bottom: 1rem; }
  .prose li { margin-bottom: 0.5rem; }
</style>
