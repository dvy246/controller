---
/**
 * /test/controller/vibration — Controller Vibration & Rumble Tester
 * Master SEO & Technical Content Optimization
 * Primary keyword: controller vibration test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import VibrationTester from '@components/tools/controller/VibrationTester.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Vibration & Rumble Test' },
];

const faqs = [
  {
    question: 'Why does my controller not vibrate during the web rumble test?',
    answer: 'Browser-based haptic vibration requires a browser that implements the W3C GamepadHapticActuator API (Google Chrome, Microsoft Edge, Brave, and Opera). Additionally, ensure that vibration is enabled in your Windows/macOS Bluetooth settings and that the controller battery is above 15%.',
  },
  {
    question: 'What is the difference between heavy and light rumble motors?',
    answer: 'Standard gamepads use two asymmetric motors. The left grip contains a heavy eccentric rotating mass (ERM) motor tuned for low-frequency rumbles (explosions, terrain impacts), while the right grip contains a smaller motor tuned for sharp, high-frequency cues (gunfire, ricochets).',
  },
  {
    question: 'Does this test support PS5 DualSense and Nintendo Switch HD Rumble?',
    answer: 'Yes. The tool sends dual-rumble commands to DualSense, Xbox Wireless, and Switch Pro controllers. DualSense advanced voice-coil haptics will execute standard low and high frequency baseline rumble when connected via USB to PC browsers.',
  },
  {
    question: 'Can running repeated vibration tests damage my controller?',
    answer: 'No. The pulses generated by the tool adhere strictly to the controller manufacturer’s standard duty cycles and thermal limits, identical to in-game rumble events.',
  },
  {
    question: 'How do I fix a controller motor that rattles loudly during vibration?',
    answer: 'A harsh rattling sound usually indicates that the brass eccentric weight has loosened on the motor shaft or the rubber isolation dampener surrounding the motor has degraded. Disassembling the grip and securing the rubber sleeve resolves the rattling.',
  }
];
---

<ToolLayout
  title="Controller Vibration Test — Free Online Gamepad Rumble & Haptic Tester | ControllerTesting.com"
  description="Test your PS5, Xbox, Switch, or PC controller's vibration motors and haptic rumble online for free. Check left/right dual-motor pulses and haptic response instantly."
  keywords="controller vibration test, gamepad rumble tester, test controller vibration online, ps5 haptic feedback test, xbox rumble check, gamepad vibration check"
  toolName="Controller Vibration Test"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <VibrationTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Haptic Motor Diagnostics & Benchmarks</h2>
      <p class="results-text">
        Click the trigger buttons above to send vibration pulses through the browser GamepadHapticActuator interface. Evaluate your rumble feedback:
      </p>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Dual Motor Balanced (Healthy)</strong>
          <p class="legend-text">Left motor delivers deep, heavy low-frequency rumble; right motor delivers crisp high-frequency buzz with no chassis rattle.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Chassis Rattle (Wear)</strong>
          <p class="legend-text">Motors vibrate but produce loud buzzing or plastic-on-plastic rattling. Caused by dislodged rubber isolation pads.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Single Motor Dead (Fault)</strong>
          <p class="legend-text">One grip fails to respond entirely. Indicates disconnected wire harness, blown MOSFET on PCB, or depleted battery.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need a full hardware diagnostic checkup?</h3>
        <p class="export-desc">Combine haptic rumble tests with analog stick drift, button matrix, and trigger linearity scans.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/full-diagnostic" class="btn-primary">Run Full Wizard</a>
        <a href="/test/controller/health-score" class="btn-secondary">Get Health Score</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Isolated 0.1% stick centering detector.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Test face buttons and shoulder bumpers.</p>
    </a>
    <a href="/test/controller/triggers" class="tool-card card-base card-hover">
      <h3 class="tool-name">Trigger Pressure Tester</h3>
      <p class="tool-desc">Analog L2/R2 pressure curve analyzer.</p>
    </a>
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Measure input report frequency in Hz.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>How Gamepad Haptic Vibration Technology Operates</h2>
    <p>
      Tactile rumble feedback enhances situational awareness in gaming, communicating critical cues such as vehicle wheel slip, weapon reload confirmation, incoming damage direction, and environmental physics.
    </p>

    <h3>Motor Technologies: ERM vs. Linear Resonant Actuators (LRA)</h3>
    <ul>
      <li>
        <strong>Eccentric Rotating Mass (ERM) Motors:</strong> Standard in Xbox Wireless Controllers and DualShock 4. Small DC motors spin off-center brass counterweights. The resulting centrifugal imbalance creates strong, mechanical body vibration. The left motor uses a larger, multi-plate weight for heavy low-frequency rumbling, while the right motor uses a lightweight single-plate weight for high-frequency vibration.
      </li>
      <li>
        <strong>Linear Resonant Actuators (Voice-Coil LRA):</strong> Featured in Nintendo Switch Joy-Cons (HD Rumble) and PS5 DualSense. Instead of spinning weights, an electromagnetic voice coil drives a suspended magnetic mass linearly against springs. This allows microsecond transient response and wide-bandwidth acoustic haptic feedback.
      </li>
    </ul>

    <h2>Technical Explanation of the Web Gamepad Vibration API</h2>
    <p>
      This tool communicates directly with your operating system's controller driver via the standard W3C <code>GamepadHapticActuator</code> interface using the <code>playEffect("dual-rumble", ...)</code> specification.
    </p>
    <p>
      When you trigger a vibration test, the browser sends two normalized intensity parameters:
    </p>
    <ul>
      <li><code>startDelay</code>: Latency offset in milliseconds before motor activation.</li>
      <li><code>duration</code>: Total duration of the vibration burst in milliseconds.</li>
      <li><code>weakMagnitude</code>: High-frequency small motor intensity (0.0 to 1.0).</li>
      <li><code>strongMagnitude</code>: Low-frequency heavy motor intensity (0.0 to 1.0).</li>
    </ul>

    <h2>Troubleshooting Gamepad Vibration Failures on PC</h2>
    <ol>
      <li><strong>Low Battery Lockout:</strong> Many controllers (including Xbox and PlayStation) automatically disable rumble motors when battery charge drops below 15% to conserve logic power.</li>
      <li><strong>Browser Permissions:</strong> Ensure you are using a Chromium-based browser (Chrome, Edge, Brave, Opera) with gamepad input permissions granted. Safari and Firefox currently do not expose the <code>GamepadHapticActuator</code> API.</li>
      <li><strong>Bluetooth Driver Limitations:</strong> Certain generic Bluetooth dongles lack support for HID output report packets, preventing vibration commands from reaching the controller. Connecting via USB cable immediately restores rumble functionality.</li>
    </ol>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 0.5rem; }
  .results-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { margin-left: 1.25rem; margin-bottom: 1rem; }
  .prose li { margin-bottom: 0.5rem; }
</style>
