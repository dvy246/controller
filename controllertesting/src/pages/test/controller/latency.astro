---
/**
 * /test/controller/latency — Controller Latency & Reaction Delay Tool
 * Master SEO & Technical Content Optimization
 * Primary keyword: controller latency test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import LatencyEstimator from '@components/tools/controller/LatencyEstimator.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Latency Estimator' },
];

const faqs = [
  {
    question: 'How do I test my controller input latency online?',
    answer: 'Connect your controller via USB or Bluetooth, click Start Reaction Test above, and press any face button or trigger as soon as the screen flashes emerald green. The high-resolution timer (using window.performance.now) calculates your end-to-end reaction latency in milliseconds.',
  },
  {
    question: 'What is a good controller reaction latency benchmark?',
    answer: 'Standard human visual reaction time averages between 190ms and 240ms. Competitive esports players using 1000Hz overclocked wired controllers and 240Hz+ gaming monitors regularly achieve composite times under 160ms to 175ms.',
  },
  {
    question: 'How much input lag does Bluetooth add compared to a wired USB connection?',
    answer: 'Standard Bluetooth adds between 4ms and 12ms of transport latency due to wireless packet queuing and interference. Direct USB connections reduce transport latency to 1ms (at 1000Hz polling rate) or 4ms (at standard 250Hz XInput).',
  },
  {
    question: 'What constitutes the "Total System Latency" pipeline in gaming?',
    answer: 'Total system latency is the sum of: Controller Hardware Actuation (~1ms) + Polling Transport Lag (1–8ms) + Game Engine Processing (~16ms at 60fps) + GPU Render Queue (~5–10ms) + Display Scanout & Pixel Response (~2–10ms) + Human Neural Reaction Time (~180–220ms).',
  },
  {
    question: 'How do I minimize controller input delay on PC?',
    answer: 'Connect directly to a motherboard USB 3.0 port with a high-quality data cable, overclock your PlayStation controller to 1000Hz using HIDUSBF, enable Nvidia Reflex Low Latency or AMD Anti-Lag in game settings, and use a high refresh rate monitor with low display lag.',
  }
];
---

<ToolLayout
  title="Controller Input Latency Test — Free Online Gamepad Response Timer | ControllerTesting.com"
  description="Measure your controller input latency and reaction speed online for free. Benchmark wired vs Bluetooth lag on PS5, Xbox, Switch, and PC controllers."
  keywords="controller latency test, gamepad input lag test, controller reaction time test, bluetooth vs wired controller lag, ps5 controller latency test, xbox input delay test"
  toolName="Controller Input Latency Test"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <LatencyEstimator />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Composite Reaction Speed Benchmarks</h2>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">&lt; 180 ms (Esports Tier)</strong>
          <p class="legend-text">Top 5% human reaction speed combined with low-latency wired hardware. Instant trigger response in tactical shooters.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">180 – 240 ms (Standard Gamer)</strong>
          <p class="legend-text">Average human visual reaction window. Excellent responsiveness for ranked battle royale and fighting games.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">&gt; 240 ms (High Total Delay)</strong>
          <p class="legend-text">Noticeable visual or input delay. Consider switching from Bluetooth to wired USB or enabling Game Mode on your monitor.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need to check input reporting frequency?</h3>
        <p class="export-desc">Measure your controller’s USB polling rate in Hz (125Hz, 250Hz, 500Hz, 1000Hz) and packet jitter.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/controller/polling-rate" class="btn-primary">Check Polling Rate (Hz)</a>
        <a href="/test/controller/full-diagnostic" class="btn-secondary">Full Diagnostic</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/controller/polling-rate" class="tool-card card-base card-hover">
      <h3 class="tool-name">Polling Rate Checker</h3>
      <p class="tool-desc">Measure input report frequency in Hz.</p>
    </a>
    <a href="/test/controller/buttons" class="tool-card card-base card-hover">
      <h3 class="tool-name">Button Tester</h3>
      <p class="tool-desc">Test button ghosting and mechanical switch chatter.</p>
    </a>
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Isolated 0.1% stick centering detector.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>The Anatomy of Gaming Input Latency</h2>
    <p>
      In competitive gaming (such as <em>Call of Duty: Warzone</em>, <em>Apex Legends</em>, <em>Fortnite</em>, and <em>Rocket League</em>), victory often comes down to milliseconds.
    </p>
    <p>
      When an in-game event occurs on screen, your total response delay is governed by a multi-stage input pipeline:
    </p>

    <h3>The 5 Stages of the Gaming Latency Pipeline</h3>
    <ol>
      <li><strong>Display Lag (1–15ms):</strong> The time it takes for your monitor to receive a video frame from the GPU, process pixel overdrive, and illuminate the liquid crystal/OLED matrix.</li>
      <li><strong>Human Neural Processing (180–220ms):</strong> Optical photons hit the retina, travel via the optic nerve to the visual cortex, and trigger motor neurons in the thumb/fingers.</li>
      <li><strong>Mechanical Switch Pre-Travel (1–3ms):</strong> Physical displacement of the button or trigger before closing the conductive silicone membrane or microswitch contact.</li>
      <li><strong>Controller USB/Wireless Transport (1–8ms):</strong> The microcontroller serializes the input packet and transmits it across USB interrupt endpoints or Bluetooth 2.4GHz RF channels.</li>
      <li><strong>Operating System & Game Engine Render Loop (4–16ms):</strong> Windows/macOS driver stack, game input buffering, simulation tick, and DirectX/Vulkan frame presentation.</li>
    </ol>

    <h2>Wired USB vs. Bluetooth Wireless Comparison</h2>
    <p>
      While modern Bluetooth controllers (such as Xbox Wireless and DualSense) provide freedom of movement, wireless packet loss and 2.4GHz Wi-Fi congestion can cause periodic latency spikes of 15ms to 30ms. A direct wired USB-C connection overclocked to <code>1000Hz</code> guarantees a deterministic 1.0ms transport interval on every single frame.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 1rem; }
  .results-legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .legend-card { padding: 1rem; border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 0.375rem; }
  .legend-pass { background: var(--color-pass-bg); border: 1px solid var(--color-pass); }
  .legend-pass .legend-title { color: var(--color-pass); }
  .legend-warning { background: var(--color-warning-bg); border: 1px solid var(--color-warning); }
  .legend-warning .legend-title { color: var(--color-warning); }
  .legend-fail { background: var(--color-fail-bg); border: 1px solid var(--color-fail); }
  .legend-fail .legend-title { color: var(--color-fail); }
  .legend-title { font-family: var(--font-mono); font-size: var(--text-small); }
  .legend-text { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.5; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
  .prose ul { margin-left: 1.25rem; margin-bottom: 1rem; }
  @media (max-width: 768px) { .results-legend-grid { grid-template-columns: 1fr; } }
</style>
