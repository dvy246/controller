---
/**
 * /test/controller/timeline — Drift Timeline Tracker
 * Master SEO & Technical Content Optimization
 * Primary keyword: stick drift timeline tracker
 */

import ToolLayout from '@layouts/ToolLayout.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/controller' },
  { name: 'Controller Tests', url: '/test/controller' },
  { name: 'Drift Timeline' },
];

const faqs = [
  {
    question: 'How does the Drift Timeline Tracker monitor controller degradation?',
    answer: 'Every time you run a Stick Drift Test or Health Score check, your browser saves the exact timestamp, left/right stick drift percentages, and controller model key in client-side LocalStorage. The interactive chart graphs your hardware wear curve over weeks and months.',
  },
  {
    question: 'Is my controller telemetry sent to an external server?',
    answer: 'No. All historical diagnostic snapshots, drift logs, and charts remain 100% private in your local browser storage. No identifying hardware serial numbers or IP addresses are uploaded.',
  },
  {
    question: 'How often should I log a controller drift test?',
    answer: 'We recommend running a test every 2 to 4 weeks (or after every 50 hours of gameplay). This creates a high-resolution trendline to detect premature wear before your warranty expires.',
  },
  {
    question: 'What does a sudden spike in drift percentage indicate?',
    answer: 'A sudden jump from 2% to 12% drift usually indicates physical debris (dust, pet hair, or food crumbs) trapped beneath the analog wiper rather than normal gradual track wear. Cleaning with compressed air or 99% isopropyl alcohol often reverses sudden spikes.',
  },
  {
    question: 'How does the predictive wear model estimate remaining lifespan?',
    answer: 'By calculating your monthly drift escalation rate (e.g., +0.5% drift per month), the tool projects the estimated date when drift will exceed your competitive deadzone limit (typically 8.0%), signaling when to service or replace the controller.',
  }
];
---

<ToolLayout
  title="Stick Drift Timeline Tracker — Free Controller Wear & Lifespan Chart | ControllerTesting.com"
  description="Track stick drift degradation over time with our free hardware timeline tracker. Log test results, visualize wear curves, and predict controller lifespan."
  keywords="stick drift timeline tracker, controller wear tracker, gamepad degradation history, track stick drift over time, ps5 controller drift lifespan, controller drift chart"
  toolName="Drift Timeline Tracker"
  category="Controller Diagnostic"
  categoryUrl="/test/controller"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Fragment slot="tool">
    <div class="timeline-container" id="timeline-container">
      <div id="timeline-empty-state" class="timeline-empty" style="display: none;">
        <div class="empty-icon">📈</div>
        <h2 class="empty-title">No Drift History Yet</h2>
        <p class="empty-desc">You need to test your controller for stick drift first to build a timeline.</p>
        <a href="/test/controller/drift" class="btn-primary empty-btn">Run Stick Drift Test</a>
      </div>
      
      <div id="timeline-content" style="display: none;">
        <div class="timeline-header">
          <div class="timeline-summary">
            <h3 class="timeline-title">Drift Degradation History</h3>
            <p class="timeline-subtitle" id="timeline-subtitle">Loading history...</p>
          </div>
          <button class="btn-secondary btn-sm" id="btn-clear-history">Clear History</button>
        </div>
        
        <div class="chart-wrapper card-base">
          <canvas id="drift-chart" width="800" height="350"></canvas>
        </div>

        <div class="history-table-wrapper">
          <table class="history-table">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Model</th>
                <th scope="col">Stick</th>
                <th scope="col">Drift %</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody id="history-table-body">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </Fragment>

  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Understanding Your Degradation Trendline</h2>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">Stable Baseline (0.0% – 2.5%)</strong>
          <p class="legend-text">Your drift remains flat within normal mechanical spring tolerances. Potentiometer carbon tracks are healthy.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">Gradual Wear (2.6% – 8.0%)</strong>
          <p class="legend-text">Linear upward slope reflecting normal carbon film friction. Compensate by adjusting in-game inner deadzones.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">Critical Spike / Failure (&gt; 8.0%)</strong>
          <p class="legend-text">Exceeds standard deadzone filtering capacity. Plan for sensor cleaning, Hall-effect module upgrade, or RMA claim.</p>
        </div>
      </div>
    </div>
  </Fragment>
  
  <Fragment slot="related-tools">
    <a href="/test/controller/drift" class="tool-card card-base card-hover">
      <span class="tool-badge">Test Now</span>
      <h3 class="tool-name">Stick Drift Tester</h3>
      <p class="tool-desc">Measure analog stick precision to 0.1% accuracy.</p>
    </a>
    <a href="/test/controller/health-score" class="tool-card card-base card-hover">
      <h3 class="tool-name">Health Score Report</h3>
      <p class="tool-desc">Generate a printable report card for your controller.</p>
    </a>
    <a href="/fix-or-replace" class="tool-card card-base card-hover">
      <h3 class="tool-name">Fix vs Replace Calculator</h3>
      <p class="tool-desc">Calculate if it's worth repairing or buying a new controller.</p>
    </a>
  </Fragment>
  
  <Fragment slot="content">
    <h2>The Science of Potentiometer Wear Curves</h2>
    <p>
      Stick drift rarely occurs overnight. In resistive thumbstick modules (such as Alps Alpine RKJXV sensors found in PS5 DualSense and Xbox controllers), degradation follows three distinct mechanical phases:
    </p>
    <ol>
      <li>
        <strong>Phase 1: Factory Break-In (0–50 Hours):</strong> The metal wiper fingers smooth the initial microscopic surface roughness of the carbon graphite film. Drift typically rests between <code>0.5%</code> and <code>2.0%</code>.
      </li>
      <li>
        <strong>Phase 2: Carbon Shedding & Micro-Grooving (50–400 Hours):</strong> Continuous rotational friction grinds away the carbon layer, shedding conductive graphite dust across the resistive substrate. Drift slowly climbs from <code>2.5%</code> to <code>6.0%</code>.
      </li>
      <li>
        <strong>Phase 3: Substrate Pitting & Wiper Fatigue (400+ Hours):</strong> The carbon film wears through to the underlying phenolic resin baseboard. Electrical contact fluctuates wildly, producing erratic spikes greater than <code>10.0%</code> that can no longer be filtered by software deadzones.
      </li>
    </ol>

    <h2>Predictive Lifespan Tracking for Competitive Gamers</h2>
    <p>
      By logging regular diagnostic snapshots, you can calculate your controller’s exact degradation velocity (e.g., <code>+0.4% drift per 100 hours</code>). This enables you to submit warranty claims before the 1-year coverage window closes or schedule a Hall-effect upgrade before important tournaments.
    </p>
  </Fragment>
</ToolLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const emptyState = document.getElementById('timeline-empty-state');
    const contentState = document.getElementById('timeline-content');
    const subtitle = document.getElementById('timeline-subtitle');
    const tableBody = document.getElementById('history-table-body');
    const clearBtn = document.getElementById('btn-clear-history');

    function loadHistory() {
      let history = [];
      try {
        const historyStr = localStorage.getItem('ct_drift_history');
        if (historyStr) {
          history = JSON.parse(historyStr);
        } else {
          // Fallback to legacy single item
          const legacy = localStorage.getItem('ct_last_drift');
          if (legacy) {
            history = [JSON.parse(legacy)];
          }
        }
      } catch (e) {
        console.error('Failed to parse drift history', e);
      }
      return history;
    }

    function formatDate(ms) {
      return new Date(ms).toLocaleDateString(undefined, { 
        month: 'short', 
        day: 'numeric',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

    function getBadgeClass(drift) {
      if (drift > 10) return 'badge-fail';
      if (drift > 2) return 'badge-warning';
      return 'badge-pass';
    }

    function getStatusText(drift) {
      if (drift > 10) return 'Severe';
      if (drift > 2) return 'Minor';
      return 'Healthy';
    }

    const history = loadHistory();

    if (!history || history.length === 0) {
      if (emptyState) emptyState.style.display = 'flex';
      return;
    }

    if (contentState) contentState.style.display = 'block';
    
    // Sort chronological
    history.sort((a, b) => a.date - b.date);

    if (subtitle) {
      subtitle.textContent = `Tracking ${history.length} record${history.length > 1 ? 's' : ''} over time`;
    }

    // Populate Table
    if (tableBody) {
      tableBody.innerHTML = history.reverse().map(entry => `
        <tr>
          <td class="mono">${formatDate(entry.date)}</td>
          <td><strong>${entry.model || 'Unknown'}</strong></td>
          <td style="text-transform: capitalize;">${entry.side || 'Left'}</td>
          <td class="mono font-bold text-accent">${entry.drift}%</td>
          <td><span class="m-val ${getBadgeClass(entry.drift)}">${getStatusText(entry.drift)}</span></td>
        </tr>
      `).join('');
      // Re-reverse for chart
      history.reverse();
    }

    // Render Chart
    const ctx = document.getElementById('drift-chart');
    if (ctx && window.Chart) {
      new window.Chart(ctx, {
        type: 'line',
        data: {
          labels: history.map(h => formatDate(h.date).split(',')[0]), // Just date for labels
          datasets: [{
            label: 'Drift Percentage',
            data: history.map(h => h.drift),
            borderColor: '#2563EB', // Color accent
            backgroundColor: 'rgba(37, 99, 235, 0.1)',
            borderWidth: 3,
            pointBackgroundColor: '#0C0C14',
            pointBorderColor: '#2563EB',
            pointBorderWidth: 2,
            pointRadius: 5,
            pointHoverRadius: 7,
            fill: true,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: '#1E1E2E',
              titleColor: '#FFFFFF',
              bodyColor: '#A1A1AA',
              borderColor: 'rgba(255,255,255,0.1)',
              borderWidth: 1,
              padding: 12,
              displayColors: false,
              callbacks: {
                label: (context) => `Drift: ${context.raw}%`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: {
                color: 'rgba(255,255,255,0.05)',
              },
              ticks: {
                color: '#A1A1AA',
                callback: (val) => `${val}%`
              }
            },
            x: {
              grid: {
                display: false
              },
              ticks: {
                color: '#A1A1AA'
              }
            }
          }
        }
      });
    }

    // Clear handler
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear your drift history? This cannot be undone.')) {
          localStorage.removeItem('ct_drift_history');
          localStorage.removeItem('ct_last_drift');
          window.location.reload();
        }
      });
    }
  });
</script>

<style>
  .timeline-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 400px;
    padding: var(--spacing-card-sm) 0;
  }

  .timeline-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    background: var(--color-surface-2);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-card);
    margin: auto 0;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .empty-title {
    font-size: var(--text-h3);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .empty-desc {
    color: var(--color-text-secondary);
    max-width: 400px;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  
  .empty-btn {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--spacing-card);
    flex-wrap: wrap;
    gap: var(--spacing-card-sm);
  }

  .timeline-title {
    font-size: var(--text-h3);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .timeline-subtitle {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .chart-wrapper {
    width: 100%;
    height: 350px;
    padding: var(--spacing-card);
    margin-bottom: var(--spacing-card-lg);
    background: var(--color-surface-2);
  }

  .history-table-wrapper {
    overflow-x: auto;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
  }

  .history-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .history-table th {
    padding: 1rem 1.25rem;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    border-bottom: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.02);
  }

  .history-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.9375rem;
  }

  .history-table tr:last-child td {
    border-bottom: none;
  }

  .history-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .font-bold {
    font-weight: 700;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .m-val {
    font-size: var(--text-micro);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-pass {
    background: var(--color-pass-bg);
    color: var(--color-pass);
    border: 1px solid var(--color-pass);
  }

  .badge-warning {
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border: 1px solid var(--color-warning);
  }

  .badge-fail {
    background: var(--color-fail-bg);
    color: var(--color-fail);
    border: 1px solid var(--color-fail);
  }

  /* Shared Results legend from drift */
  .results-summary {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-card-sm);
  }

  .results-legend-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-card-sm);
  }

  .legend-card {
    padding: var(--spacing-card-sm);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .legend-pass {
    background: var(--color-pass-bg);
    border: 1px solid var(--color-pass);
  }
  .legend-pass .legend-title { color: var(--color-pass); }

  .legend-warning {
    background: var(--color-warning-bg);
    border: 1px solid var(--color-warning);
  }
  .legend-warning .legend-title { color: var(--color-warning); }

  .legend-fail {
    background: var(--color-fail-bg);
    border: 1px solid var(--color-fail);
  }
  .legend-fail .legend-title { color: var(--color-fail); }

  .legend-title {
    font-family: var(--font-mono);
    font-size: var(--text-small);
  }

  .legend-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .results-legend-grid {
      grid-template-columns: 1fr;
    }
    
    .timeline-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
