---
/**
 * /test/keyboard/index.astro — Keyboard Diagnostic Hub
 * SEO Title: Online Keyboard Tester — Mechanical Keyboard & NKRO Matrix Test
 * Hub index listing all keyboard diagnostic tools.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/keyboard' },
  { name: 'Keyboard Hub' },
];

const keyboardTools = [
  { name: 'Full 100% Keyboard Tester (ANSI)', href: '/keyboard-tester/full', desc: 'Test all 104 keys for press, hold, and key ghosting on standard full ANSI layout', badge: 'Flagship' },
  { name: 'TKL 80% Mechanical Keyboard Tester', href: '/keyboard-tester/tkl', desc: 'Tenkeyless layout keyboard matrix diagnostic with switch sound feedback', badge: 'Popular' },
  { name: '60% Compact Keyboard Tester', href: '/keyboard-tester/60-percent', desc: 'Compact 61-key layout testing Fn layer combinations and modifier keys' },
  { name: 'NKRO N-Key Rollover Test', href: '/keyboard-tester/full', desc: 'Verify N-Key Rollover capacity — test how many simultaneous keypresses your PCB registers' },
  { name: 'Key Switch Chatter & Bounce Test', href: '/keyboard-tester/tkl', desc: 'Detect mechanical switch contact bounce double-typing faults in milliseconds' },
  { name: 'Keyboard Polling Rate & Latency', href: '/keyboard-tester/full', desc: 'Measure USB keyboard report rate in Hz (1000Hz / 8000Hz) and input delay' },
];


const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Keyboard Diagnostic Tools',
  numberOfItems: keyboardTools.length,
  itemListElement: keyboardTools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://controllertesting.com${t.href}`,
  })),
};

function getKeyboardIcon(href: string) {
  if (href.includes('ansi-104') || href.includes('tkl-87') || href.includes('compact-60') || href.includes('mac-100')) {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 16h8"/></svg>`;
  }
  if (href.includes('nkro')) {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20M7 7l10 10M17 7L7 17"/></svg>`;
  }
  if (href.includes('chatter')) {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`;
  }
  if (href.includes('latency')) {
    return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M12 2v3M9 2h6"/></svg>`;
  }
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/></svg>`;
}
---

<BaseLayout
  title="Online Keyboard Tester — Mechanical Keyboard & NKRO Matrix Test | ControllerTesting.com"
  description="Test any keyboard online. Diagnostic tools for 100% ANSI, TKL 80%, 60%, Mac layouts, N-Key Rollover (NKRO), switch chatter double-typing, and latency."
  schema={itemListSchema}
  breadcrumbs={breadcrumbs}

  localized={true}>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-header">
        <span class="hub-badge">Keyboard Diagnostic Suite</span>
        <h1 class="text-h1 mb-2">Keyboard Diagnostic Hub</h1>
        <p class="hub-subtitle">
          Test mechanical and membrane keyboards online. Check key responsiveness, NKRO rollover capacity, switch chatter double-clicks, and layout mapping.
        </p>
      </header>

      <div class="grid-tools">
        {keyboardTools.map((tool) => (
          <a href={tool.href} class="tool-hub-card card-base card-hover">
            <div class="card-top-bar">
              <span class="card-icon" set:html={getKeyboardIcon(tool.href)} aria-hidden="true" />
              {tool.badge && <span class="badge-tag">{tool.badge}</span>}
            </div>
            <h2 class="card-tool-name">{tool.name}</h2>
            <p class="card-tool-desc">{tool.desc}</p>
            <span class="card-action-link">
              Run test
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 96px; padding-bottom: var(--spacing-section); }
  .container-site { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: 1.5rem; }
  .hub-header { margin-bottom: 2.5rem; }
  .hub-badge { display: inline-block; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); background: rgba(37, 99, 235, 0.1); padding: 0.25em 0.75em; border-radius: var(--radius-pill); margin-bottom: 0.75rem; border: 1px solid rgba(37, 99, 235, 0.2); }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .grid-tools { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; width: 100%; }
</style>
