---
/**
 * /test/mouse/index.astro — Mouse Tools Hub
 * SEO Title: Online Mouse Tester — 10 Free Mouse Diagnostic Tools
 * Hub index listing all mouse tools.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/mouse' },
  { name: 'Mouse Hub' },
];

const mouseTools = [
  { name: 'CPS Test (Click Speed)', href: '/test/mouse/cps', desc: 'Test clicks per second in 5s, 10s & 30s modes', badge: 'Popular' },
  { name: 'Mouse Polling Rate', href: '/test/mouse/polling-rate', desc: 'Test mouse report rate in Hz up to 8000Hz (8KKHz)', badge: 'Flagship' },
  { name: 'DPI Analyzer', href: '/test/mouse/dpi', desc: 'Calculate true hardware DPI & pixel sensitivity' },
  { name: 'Click Latency', href: '/test/mouse/click-latency', desc: 'Measure mouse click response delay in ms' },
  { name: 'Mouse Button Tester', href: '/test/mouse/buttons', desc: 'Test MB1, MB2, MB3, MB4, MB5 side buttons' },
  { name: 'Scroll Wheel Tester', href: '/test/mouse/scroll', desc: 'Test scroll direction & reverse jumping faults' },
  { name: 'Double-Click Test', href: '/test/mouse/double-click', desc: 'Detect Omron mechanical switch double-click chatter', badge: 'Essential' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Mouse Diagnostic Tools',
  numberOfItems: mouseTools.length,
  itemListElement: mouseTools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://controllertesting.com${t.href}`,
  })),
};
function getMouseIcon(href: string) {
  if (href.includes('/cps')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 18v4M4.93 4.93l4.24 4.24M14.83 14.83l4.24 4.24M2 12h6M18 12h4"/><circle cx="12" cy="12" r="3"/></svg>`;
  if (href.includes('/polling-rate')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 9l-5 5-4-4-5 5"/></svg>`;
  if (href.includes('/dpi')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`;
  if (href.includes('/click-latency')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M12 2v3M9 2h6"/></svg>`;
  if (href.includes('/buttons')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="6"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="6" y1="9" x2="18" y2="9"/></svg>`;
  if (href.includes('/scroll')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="4" width="10" height="16" rx="5"/><line x1="12" y1="7" x2="12" y2="11"/><path d="M10 16l2 2 2-2"/></svg>`;
  if (href.includes('/double-click')) return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`;
  return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="6"/></svg>`;
}
---

<BaseLayout
  title="Online Mouse Tester — 10 Free Mouse Diagnostic Tools | ControllerTesting.com"
  description="Test gaming mouse performance online. 10 free diagnostic tools for CPS click speed, polling rate Hz, DPI calculation, click latency, and double-click faults."
  schema={itemListSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-header">
        <span class="hub-badge">Mouse Diagnostic Suite</span>
        <h1 class="hub-title">Mouse Diagnostic Hub</h1>
        <p class="hub-subtitle">
          Diagnose mouse polling rate (Hz), click latency, CPS speed, DPI accuracy, and double-clicking switch faults. 100% browser-based.
        </p>
      </header>

      <div class="grid-tools">
        {mouseTools.map((tool) => (
          <a href={tool.href} class="tool-hub-card card-base card-hover">
            <div class="card-top-bar">
              <span class="card-icon" set:html={getMouseIcon(tool.href)} aria-hidden="true" />
              {tool.badge && <span class="badge-tag">{tool.badge}</span>}
            </div>
            <h2 class="card-tool-name">{tool.name}</h2>
            <p class="card-tool-desc">{tool.desc}</p>
            <span class="card-action-link">
              Run test
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 96px; padding-bottom: var(--spacing-section); }
  .container-site { width: 100%; max-width: 1280px; margin-inline: auto; padding-inline: 1.5rem; }
  .hub-header { margin-bottom: 2.5rem; }
  .hub-badge { display: inline-block; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); background: rgba(37, 99, 235, 0.1); padding: 0.25em 0.75em; border-radius: var(--radius-pill); margin-bottom: 0.75rem; border: 1px solid rgba(37, 99, 235, 0.2); }
  .hub-title { font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .grid-tools { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; width: 100%; }
  .tool-hub-card { display: flex; flex-direction: column; gap: 0.875rem; padding: 1.5rem; text-decoration: none; cursor: pointer; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); transition: background var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast); }
  .tool-hub-card:hover { background: var(--color-surface-3); border-color: var(--color-accent); transform: translateY(-3px); text-decoration: none; }
  .card-top-bar { display: flex; align-items: center; justify-content: space-between; }
  .card-icon { width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--color-surface-3); border: 1px solid var(--color-border-subtle); display: flex; align-items: center; justify-content: center; color: var(--color-accent); }
  .card-tool-name { font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); letter-spacing: -0.01em; }
  .badge-tag { font-family: var(--font-mono); font-size: 0.55rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; background: rgba(37, 99, 235, 0.15); color: var(--color-accent); padding: 0.2em 0.55em; border-radius: 3px; border: 1px solid rgba(37, 99, 235, 0.2); }
  .card-tool-desc { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.5; flex-grow: 1; }
  .card-action-link { display: flex; align-items: center; gap: 0.375rem; font-size: var(--text-small); font-weight: 600; color: var(--color-accent); margin-top: 0.25rem; }
</style>
