---
/**
 * /test/mouse/polling-rate — Mouse Polling Rate Checker
 * Master SEO & Technical Content Optimization
 * Primary keyword: mouse polling rate test
 */

import ToolLayout from '@layouts/ToolLayout.astro';
import MousePollingTester from '@components/tools/mouse/MousePollingTester.astro';

const breadcrumbs = [
  { name: 'Tests', url: '/test/mouse' },
  { name: 'Mouse Tests', url: '/test/mouse' },
  { name: 'Mouse Polling Rate' },
];

const faqs = [
  {
    question: 'How do I test my mouse polling rate (Hz) online?',
    answer: 'Move your mouse cursor rapidly in circles inside the test zone above. The diagnostic engine calculates the millisecond delta between successive mousemove PointerEvents and displays your real-time peak and average polling frequency in Hertz (Hz).',
  },
  {
    question: 'What is the difference between 125Hz, 1000Hz, and 8000Hz (8KHz)?',
    answer: 'A standard office mouse polls at 125Hz (updates every 8.0ms). A standard gaming mouse polls at 1000Hz (updates every 1.0ms). Modern 8000Hz (8KHz) gaming mice transmit cursor updates every 0.125ms, virtually eliminating cursor position quantization on 240Hz+ displays.',
  },
  {
    question: 'Why does my 4000Hz or 8000Hz mouse cause game stuttering or FPS drops?',
    answer: '8KHz polling generates up to 8,000 CPU interrupts per second, saturating a single CPU core in game engines (like older DirectX 11 titles) that process window messages on the main render thread. Running a modern multi-threaded CPU and enabling raw input fixes micro-stutter.',
  },
  {
    question: 'Why is my mouse polling rate lower than advertised during slow movements?',
    answer: 'Optical sensors only dispatch USB interrupt packets when physical cursor motion exceeds sensor count thresholds. Slow, deliberate mouse movements naturally report lower instantaneous Hz because fewer report packets are required.',
  },
  {
    question: 'How do I change my mouse polling rate to 1000Hz or higher?',
    answer: 'Open your mouse manufacturer software (Logitech G HUB, Razer Synapse, Glorious Core, Wootility) and navigate to Device Settings &gt; Polling Rate / Report Rate. Select 1000Hz, 2000Hz, 4000Hz, or 8000Hz.',
  }
];
---

<ToolLayout
  title="Mouse Polling Rate Test — Free Online Mouse Hz & 8KHz Checker | ControllerTesting.com"
  description="Test your gaming mouse polling rate in Hz online for free. Measure 125Hz, 500Hz, 1000Hz, 4000Hz, and 8000Hz (8KHz) report intervals and jitter."
  keywords="mouse polling rate test, mouse hz test online, test mouse report rate, 8000hz mouse test, check mouse polling rate, 1000hz mouse checker"
  toolName="Mouse Polling Rate Checker"
  category="Mouse Diagnostic"
  categoryUrl="/test/mouse"
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  {/* ── Tool Interactive Island ── */}
  <Fragment slot="tool">
    <MousePollingTester />
  </Fragment>

  {/* ── Results Slot ── */}
  <Fragment slot="results">
    <div class="results-summary">
      <h2 class="section-title">Mouse Polling Rate Performance Tiers</h2>
      <div class="results-legend-grid">
        <div class="legend-card legend-pass">
          <strong class="legend-title">1000Hz – 8000Hz (0.125ms – 1.0ms)</strong>
          <p class="legend-text">Competitive Esports Tier. Near-zero cursor delay; eliminates micro-stutter on 240Hz, 360Hz, and 540Hz displays.</p>
        </div>
        <div class="legend-card legend-warning">
          <strong class="legend-title">500Hz (2.0ms)</strong>
          <p class="legend-text">Standard Gaming Baseline. Balanced tracking performance with minimal CPU interrupt overhead.</p>
        </div>
        <div class="legend-card legend-fail">
          <strong class="legend-title">125Hz (8.0ms)</strong>
          <p class="legend-text">Office Mouse Default. High cursor latency and visible stair-stepping motion in fast-paced FPS shooters.</p>
        </div>
      </div>
    </div>
  </Fragment>

  {/* ── Export Slot ── */}
  <Fragment slot="export">
    <div class="export-banner">
      <div>
        <h3 class="export-title">Need to measure true hardware DPI?</h3>
        <p class="export-desc">Calculate your optical sensor's true Dots Per Inch (DPI) and test for sensor deviation.</p>
      </div>
      <div class="export-buttons">
        <a href="/test/mouse/dpi" class="btn-primary">DPI Analyzer</a>
        <a href="/test/mouse/cps" class="btn-secondary">CPS Speed Test</a>
      </div>
    </div>
  </Fragment>

  {/* ── Related Tools Slot ── */}
  <Fragment slot="related-tools">
    <a href="/test/mouse/dpi" class="tool-card card-base card-hover">
      <h3 class="tool-name">DPI Analyzer</h3>
      <p class="tool-desc">Calculate true optical mouse sensor DPI.</p>
    </a>
    <a href="/test/mouse/click-latency" class="tool-card card-base card-hover">
      <h3 class="tool-name">Click Latency</h3>
      <p class="tool-desc">Measure switch response time in ms.</p>
    </a>
    <a href="/test/mouse/cps" class="tool-card card-base card-hover">
      <h3 class="tool-name">CPS Test</h3>
      <p class="tool-desc">Test clicks per second speed.</p>
    </a>
  </Fragment>

  {/* ── SEO Content Slot ── */}
  <Fragment slot="content">
    <h2>The Physics of Mouse Report Rates & High-Refresh Displays</h2>
    <p>
      Your mouse's polling rate (measured in Hertz, <code>Hz</code>) determines how frequently the onboard optical sensor (such as PixArt PAW3395, PAW3950, or Logitech HERO 2) sends USB interrupt packets containing $(X, Y)$ coordinate displacement data to the operating system.
    </p>

    <h3>Report Intervals & Display Frame Pacing</h3>
    <ul>
      <li>
        <strong>125Hz (8.0ms interval):</strong> On a 240Hz monitor (refreshing every 4.16ms), a 125Hz mouse skips entire video frames between coordinate updates, creating visible cursor judder.
      </li>
      <li>
        <strong>1000Hz (1.0ms interval):</strong> Dispatches 1 report per millisecond, ensuring 4 fresh coordinate packets for every frame displayed at 240Hz.
      </li>
      <li>
        <strong>8000Hz (0.125ms interval):</strong> Dispatches 8 reports per millisecond, aligning with pixel scanout on ultra-high-refresh 360Hz, 480Hz, and 540Hz OLED gaming monitors.
      </li>
    </ul>

    <h2>USB Host Controllers & 8KHz CPU Interrupt Demands</h2>
    <p>
      Running 8000Hz polling requires connecting your mouse directly to a rear motherboard USB 3.2 Gen 2 port directly routed to the CPU PCIe lanes (avoiding unpowered front panel USB headers or external hubs) to prevent packet queue congestion and USB bus resets.
    </p>
  </Fragment>
</ToolLayout>

<style>
  .results-summary { display: flex; flex-direction: column; gap: 1rem; }
  .results-legend-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .legend-card { padding: 1rem; border-radius: var(--radius-sm); display: flex; flex-direction: column; gap: 0.375rem; }
  .legend-pass { background: var(--color-pass-bg); border: 1px solid var(--color-pass); }
  .legend-pass .legend-title { color: var(--color-pass); }
  .legend-warning { background: var(--color-warning-bg); border: 1px solid var(--color-warning); }
  .legend-warning .legend-title { color: var(--color-warning); }
  .legend-fail { background: var(--color-fail-bg); border: 1px solid var(--color-fail); }
  .legend-fail .legend-title { color: var(--color-fail); }
  .legend-title { font-family: var(--font-mono); font-size: var(--text-small); }
  .legend-text { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.5; }
  .export-banner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .export-title { font-size: 1.125rem; font-weight: 700; margin-bottom: 0.25rem; }
  .export-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .prose { line-height: 1.7; color: var(--color-text-secondary); }
  .prose h2, .prose h3 { color: var(--color-text-primary); margin-top: 1.5rem; margin-bottom: 0.75rem; }
  .prose p { margin-bottom: 1rem; }
  @media (max-width: 768px) { .results-legend-grid { grid-template-columns: 1fr; } }
</style>
