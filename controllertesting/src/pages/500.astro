---
/**
 * 500.astro — Custom 500 Internal Server Error Page
 * SEO Title: Server Error (500) | ControllerTesting.com
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Server Error' }
];
---

<BaseLayout
  title="500 — Internal Server Error | ControllerTesting.com"
  description="An unexpected error occurred. Please refresh or return to ControllerTesting.com diagnostic tools."
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <Header />
  <div class="error-container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="error-badge">ERROR 500</div>
    <h1 class="text-h1 text-gradient">System Interruption</h1>
    <p class="error-desc">
      An unexpected internal error occurred while processing your request. Please try refreshing the page or navigating back to our diagnostic tools.
    </p>

    <div class="cta-row">
      <button type="button" onclick="window.location.reload()" class="btn-primary">Refresh Page</button>
      <a href="/" class="btn-secondary">Return Home</a>
    </div>
  </div>
  <Footer />
</BaseLayout>

<style>
  .error-container {
    max-width: 800px;
    padding-top: calc(var(--header-height, 64px) + 2rem);
    margin: 0 auto 4rem;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .error-badge {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-warning);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-warning) 20%, transparent);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.05em;
  }
  .error-desc {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 540px;
    line-height: 1.6;
  }
  .cta-row {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
