---

<BaseLayout
  title="Free Embeddable Controller Diagnostic Widgets | ControllerTesting.com"
  description="Enrich your gaming website, blog, or store with interactive controller testing widgets. Free, customizable, mobile-friendly iframe embed snippets for drift, polling rate, and health score."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Header />

  <main id="main-content" class="embeds-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <!-- Hero -->
      <section class="embeds-hero">
        <div class="hero-text-col">
          <span class="section-eyebrow">Widget Suite for Webmasters</span>
          <h1 class="hero-title text-h1">Embed Interactive Controller<br/>Diagnostic Widgets</h1>
          <p class="hero-desc text-lead">
            Enhance your gaming blog, hardware reviews, or e-commerce store with zero-dependency, real-time gamepad testing tools. Free for commercial and personal websites.
          </p>
          <ul class="hero-benefits" role="list" aria-label="Widget benefits">
            {benefits.map((b) => (
              <li class="benefit-chip">
                <span class="benefit-icon" set:html={b.icon} aria-hidden="true" />
                {b.label}
              </li>
            ))}
          </ul>
        </div>
        <div class="hero-preview-col" aria-hidden="true">
          <div class="preview-mockup">
            <div class="preview-bar">
              <span class="dot red"></span><span class="dot amber"></span><span class="dot green"></span>
              <span class="preview-url">controllertesting.com/embed/drift</span>
            </div>
            <div class="preview-content">
              <div class="preview-drift-ring">
                <div class="drift-ring-outer"></div>
                <div class="drift-ring-inner"></div>
                <div class="drift-dot"></div>
              </div>
              <div class="preview-chips">
                <span class="preview-chip pass">DRIFT 0.04% — PASS</span>
                <span class="preview-chip">1000 Hz</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Widget cards -->
      <section class="widgets-section" aria-labelledby="widgets-heading">
        <h2 class="sr-only" id="widgets-heading">Available Widgets</h2>
        <div class="widgets-grid">
          {widgets.map((w) => (
            <article class="widget-card card-base card-hover" id={`widget-${w.id}`}>
              <div class="widget-card-header">
                <div class="widget-icon-wrap" aria-hidden="true" set:html={w.icon} />
                <div class="widget-meta">
                  <span class="widget-num">{w.num}</span>
                  <span class="badge-tag">{w.tag}</span>
                </div>
              </div>
              <h3 class="widget-title">{w.title}</h3>
              <p class="widget-desc">{w.desc}</p>
              <div class="code-block-wrap">
                <div class="code-block-topbar">
                  <span class="code-lang">HTML</span>
                  <span class="code-dots" aria-hidden="true">···</span>
                </div>
                <pre class="code-snippet" id={`code-${w.id}`}><code>{w.code}</code></pre>
              </div>
              <button
                type="button"
                class="copy-btn"
                data-target={`code-${w.id}`}
                aria-label={`Copy HTML embed code for ${w.title}`}
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                Copy HTML Code
              </button>
            </article>
          ))}
        </div>
      </section>

      <!-- FAQ section -->
      <section class="faq-section card-base" aria-labelledby="faq-heading">
        <h2 class="section-title" id="faq-heading">Frequently Asked Questions</h2>
        <div class="faq-list" role="list">
          {faqs.map((faq) => (
            <div class="faq-item" role="listitem">
              <h3 class="faq-q">{faq.question}</h3>
              <p class="faq-a">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Copy button behavior with visual feedback
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const el = document.getElementById(targetId);
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.innerText);
        const orig = btn.innerHTML;
        btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Copied!`;
        btn.classList.add('copied');
        setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('copied'); }, 2000);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  });
</script>

