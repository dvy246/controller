const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.subtitle,
  datePublished: '2026-08-02T00:00:00Z',
  dateModified: '2026-08-10T00:00:00Z',
  author: {
    '@type': 'Person',
    name: 'ControllerTesting.com Research Team',
    url: 'https://controllertesting.com/about'
  },
  publisher: {
    '@type': 'Organization',
    name: 'ControllerTesting.com',
    url: 'https://controllertesting.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://controllertesting.com/favicon.svg'
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://controllertesting.com/learn/${article.slug}`
  }
};
---

<BaseLayout
  title={`${article.title} | ControllerTesting.com`}
  description={article.subtitle}
  breadcrumbs={breadcrumbs}
  schema={[faqSchema, articleSchema]}

  localized={true}>
  <Header />

  <main id="main-content" class="learn-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="learn-hero">
        <span class="badge-tag mb-3">Learn guide</span>
        <h1 class="text-h1 mb-2">{article.title}</h1>
        <p class="learn-subtitle">{article.subtitle}</p>
      </header>

      <AuthorByline
        datePublished="2026-08-02"
        dateModified="2026-08-10"
        readingTime="5 min read"
      />

      <div class="learn-body card-base">
        {article.sections.map((s) => (
          <section class="learn-section">
            <h2 class="section-title">{s.h}</h2>
            {s.body.map((p) => (
              <p class="learn-text">{p}</p>
            ))}
          </section>
        ))}
      </div>

      <div class="learn-faq card-base">
        <div class="faq-header">
          <div class="faq-icon-wrapper">
            <svg class="faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h2 class="section-title !mb-0">Quick Answers</h2>
        </div>
        
        <div class="faq-list">
          {article.faqs.map((f) => (
            <div class="faq-item group">
              <h3 class="faq-q">{f.q}</h3>
              <p class="faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="learn-sources card-base">
        <h2 class="section-title">Official sources &amp; specifications</h2>
        <ul class="learn-source-list">
          <li><a href="https://developer.mozilla.org/en-US/docs/Web/API/Gamepad_API" rel="noopener" target="_blank">MDN Web Docs — Gamepad API ↗</a></li>
          <li><a href="https://www.w3.org/TR/gamepad/" rel="noopener" target="_blank">W3C Gamepad API specification ↗</a></li>
          <li><a href="https://www.playstation.com/accessories/" rel="noopener" target="_blank">PlayStation official accessories ↗</a></li>
          <li><a href="https://www.xbox.com/en-US/accessories/controllers" rel="noopener" target="_blank">Xbox official controllers ↗</a></li>
          <li><a href="https://support.nintendo.com" rel="noopener" target="_blank">Nintendo Support ↗</a></li>
          <li><a href="https://store.steampowered.com/steamdeck/" rel="noopener" target="_blank">Valve — Steam Deck ↗</a></li>
        </ul>
      </div>

      <div class="learn-related card-base">
        <h2 class="section-title">Do it, don't just read it</h2>
        <div class="learn-related-links">
          {article.related.map((r) => (
            <a href={r.href} class={r.primary ? 'btn-primary' : 'btn-secondary'}>{r.label}</a>
          ))}
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .learn-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .learn-hero { margin-bottom: 2.5rem; max-width: 820px; }
  .learn-hero .badge-tag { margin-bottom: 0.875rem; }
  .learn-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.65; margin: 0; }
  
  .learn-body { 
    padding: 2.5rem; 
    display: flex; 
    flex-direction: column; 
    gap: 2.5rem; 
    margin-bottom: 2rem; 
    border-radius: 24px;
    background: var(--color-surface-1);
  }
  
  .learn-section { display: flex; flex-direction: column; gap: 1rem; }
  .learn-section .section-title { font-size: 1.375rem; font-weight: 700; color: var(--color-text-primary); margin: 0; }
  .learn-text { font-size: 1.0625rem; color: var(--color-text-secondary); line-height: 1.75; margin: 0; }
  
  .learn-faq { 
    padding: 2.5rem; 
    display: flex; 
    flex-direction: column; 
    gap: 2rem; 
    margin-bottom: 2rem; 
    border-radius: 24px; 
    background: var(--color-surface-1); 
  }
  
  .faq-header { display: flex; align-items: center; gap: 1rem; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 1.5rem; }
  .faq-icon-wrapper { width: 40px; height: 40px; border-radius: 12px; background: rgba(37, 99, 235, 0.1); display: flex; align-items: center; justify-content: center; color: var(--color-accent-blue); }
  .faq-icon { width: 20px; height: 20px; }
  .faq-list { display: flex; flex-direction: column; gap: 1.25rem; }
  .faq-item { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem; border-radius: 16px; background: var(--color-surface-2); border: 1px solid transparent; transition: all 0.2s ease; }
  .faq-item:hover { border-color: rgba(37, 99, 235, 0.3); background: var(--color-surface-3); transform: translateY(-1px); }
  .faq-q { font-size: 1.125rem; font-weight: 600; color: var(--color-text-primary); transition: color 0.2s ease; margin: 0; }
  .faq-item:hover .faq-q { color: var(--color-accent-blue); }
  .faq-a { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; margin: 0; }

  .learn-sources {
    padding: 2.25rem 2.5rem;
    margin-bottom: 2rem;
    border-radius: 24px;
    background: var(--color-surface-1);
  }
  .learn-sources .section-title { font-size: 1.25rem; margin-bottom: 1.25rem; }
  .learn-source-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .learn-source-list li a {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color 0.2s ease;
  }
  .learn-source-list li a:hover {
    color: var(--color-accent-blue);
    text-decoration: underline;
  }

  .learn-related { 
    padding: 2.25rem 2.5rem; 
    display: flex; 
    align-items: center; 
    justify-content: space-between; 
    gap: 2rem; 
    flex-wrap: wrap; 
    border-radius: 24px;
    background: var(--color-surface-1);
  }
  .learn-related .section-title { font-size: 1.25rem; margin: 0; }
  .learn-related-links { display: flex; gap: 0.875rem; flex-wrap: wrap; }
  
  @media (max-width: 768px) {
    .learn-body, .learn-faq, .learn-sources, .learn-related { padding: 1.75rem; }
    .learn-source-list { grid-template-columns: 1fr; }
    .learn-related { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .learn-related-links { width: 100%; flex-direction: column; }
    .learn-related-links a { width: 100%; text-align: center; }
  }
</style>