---
/**
 * /about — who runs ControllerTesting.com, how the tools work, and their limits.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'About Us' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: 'https://controllertesting.com/about',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://controllertesting.com/about#divy-yadav',
    name: 'Divy Yadav',
    url: 'https://controllertesting.com/about',
    worksFor: { '@id': 'https://controllertesting.com/#organization' },
  },
};

const sections = [
  {
    title: 'How the tools work',
    body: [
      'Every test reads your controller through the browser\'s standard Gamepad API (and Web MIDI or Web Audio where a tool needs them). Stick positions, button presses and trigger values are processed in your browser; nothing is installed and no account is needed.',
      'The browser decides how often it hands input to a web page, so timing figures such as polling rate are "browser-observed": they can read lower than what the controller sends over USB. Each tool page has a "How this test works & its limits" section, and the methodology page explains the math.',
    ],
  },
  {
    title: 'What we measure and what we estimate',
    body: [
      'Drift, circularity, button and trigger results come from your own controller, live. The reliability pages are different: they show modeled reference estimates, labeled as such, not measurements from a large population of controllers. They will only become measured figures as consenting visitors contribute anonymous drift samples.',
      'We do not publish invented scores, lab results or testimonials. If a figure on this site cannot be traced to your own test, a cited source or a labeled estimate, treat it as a bug and tell us.',
    ],
  },
  {
    title: 'Privacy and how the site is funded',
    body: [
      'Controller input never leaves your browser unless you opt in to anonymous test telemetry. Google Analytics and Google AdSense run only according to your cookie choice; ads are how the site stays free. Details are in the privacy policy.',
    ],
  },
];
---

<BaseLayout
  title="About ControllerTesting.com"
  description="Who builds ControllerTesting.com, how its browser-based controller tests work, what they can and cannot measure, and how the site is funded."
  breadcrumbs={breadcrumbs}
  schema={personSchema}
  localized={false}
>
  <Header />

  <main id="main-content" class="pt-24 pb-20 bg-surface-0 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">

      <div class="mb-6">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <header class="rounded-2xl bg-surface-1 border border-surface-2 p-8 sm:p-12 mb-8">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-text-primary tracking-tight mb-4 leading-tight">
          About ControllerTesting.com
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          ControllerTesting.com is a set of free, browser-based tests for game controllers, mice and keyboards. It
          exists because checking a controller for stick drift or a dead button should not require installing
          software, creating an account or paying for a basic checkup.
        </p>
      </header>

      <section id="divy-yadav" class="rounded-2xl bg-surface-1 border border-surface-2 p-8 sm:p-10 mb-8">
        <h2 class="text-2xl font-bold text-text-primary mb-4 tracking-tight">Who runs it</h2>
        <p class="text-text-secondary leading-relaxed">
          The site is built and maintained by <strong class="text-text-primary">Divy Yadav</strong>, who writes the
          tools, the guides and the methodology, and answers the contact inbox.
        </p>
        <!-- BIO: add 2–3 true first-person sentences: background, which controllers you own and test on, why you built the site. -->
      </section>

      {sections.map((section) => (
        <section class="rounded-2xl bg-surface-1 border border-surface-2 p-8 sm:p-10 mb-8">
          <h2 class="text-2xl font-bold text-text-primary mb-4 tracking-tight">{section.title}</h2>
          <div class="space-y-4 text-text-secondary leading-relaxed">
            {section.body.map((p) => <p>{p}</p>)}
          </div>
        </section>
      ))}

      <section class="rounded-2xl bg-surface-1 border border-surface-2 p-8 sm:p-10">
        <h2 class="text-2xl font-bold text-text-primary mb-4 tracking-tight">Contact</h2>
        <p class="text-text-secondary leading-relaxed mb-6">
          Found a wrong number, a broken test or a controller we handle badly? Reports like that are the most useful
          thing you can send.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact" class="btn-primary text-sm px-5 py-2.5 rounded-lg font-medium">Contact</a>
          <a href="/test/methodology" class="btn-secondary text-sm px-5 py-2.5 rounded-lg font-medium">Testing methodology</a>
          <a href="/privacy" class="btn-secondary text-sm px-5 py-2.5 rounded-lg font-medium">Privacy policy</a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>
