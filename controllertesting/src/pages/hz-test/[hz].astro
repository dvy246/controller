---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import HzVisualizer from '../../components/features/HzVisualizer.astro';

export function getStaticPaths() {
  const refreshRates = ['60hz', '120hz', '144hz', '240hz', '360hz', '540hz'];

  return refreshRates.map(hz => ({
    params: { hz }
  }));
}

const { hz } = Astro.params;
const numericHz = parseInt(hz.replace('hz', ''), 10) || 144;

const title = `Monitor ${numericHz}Hz Refresh Rate & Motion Blur Test`;
const description = `Test your monitor's true ${numericHz}Hz refresh rate, ghosting persistence, frame pacing, and motion blur performance. WebGL-accelerated display benchmark.`;
const canonical = `https://controllertesting.com/hz-test/${hz}`;

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: `${numericHz}Hz Test` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header />
  <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-h1">
        {numericHz}Hz Refresh Rate & Motion Blur Test
      </h1>
      <p class="mt-2 text-secondary max-w-3xl">
        Benchmark your display's ability to render true <span class="text-accent font-semibold">{numericHz} Hz</span> frame output without motion blur, pixel trail ghosting, or frame stuttering.
      </p>
    </div>

    <!-- Component -->
    <HzVisualizer targetHz={numericHz} />

    <!-- AEO/GEO FAQ -->
    <section class="mt-16 bg-surface-1 p-6 sm:p-8 rounded-2xl border border-surface-3">
      <h2 class="text-h2 mb-6">Display Hz & Pixel Persistence FAQ</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-secondary">
        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold mb-2">Why is my monitor locked at 60Hz instead of {numericHz}Hz?</h3>
          <p>
            Make sure your display settings in Windows/macOS are explicitly set to {numericHz}Hz. Also verify that you are using a high-bandwidth Cable (DisplayPort 1.4+ or HDMI 2.1).
          </p>
        </div>

        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold mb-2">What causes monitor ghosting?</h3>
          <p>
            Ghosting occurs when monitor pixels fail to change colors fast enough to keep up with the refresh rate, leaving a visible trail behind moving objects. Adjusting your monitor's Overdrive setting can eliminate this artifact.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
