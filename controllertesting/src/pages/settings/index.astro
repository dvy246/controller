---
/**
 * /settings — Game Controller Settings Hub (one page per game)
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import { GAMES } from '../../data/gameSettings';

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Settings' }];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Game Controller Settings — Deadzone & Sensitivity Guides',
    description: 'Per-game controller settings starting points: deadzone scale, response curve and sensitivity for Fortnite, Apex, Warzone, Valorant, CS2 and more.',
    url: 'https://controllertesting.com/settings'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: GAMES.map((g, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${g.name} controller settings`,
      url: `https://controllertesting.com/settings/${g.slug}`
    }))
  }
];
---

<BaseLayout
  title="Game Controller Settings & Deadzone Guides | CT"
  description="Deadzone scale, response curve and sensitivity starting points for Fortnite, Apex, Warzone, Valorant, CS2 and five more games, plus how to measure your stick first."
  breadcrumbs={breadcrumbs}
  schema={schemaData}

  localized={false}>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-hero">
        <span class="badge-tag mb-3">Settings Hub</span>
        <h1 class="text-h1 mb-2">Game Controller Settings</h1>
        <p class="hub-subtitle">
          Deadzone, response curve and sensitivity starting points for 10 games, with the deadzone scale each game
          actually uses. Pick your game; every page shows how to measure your own stick first, because the right
          deadzone is just above your controller's resting noise, not a number copied from someone else.
        </p>
      </header>

      <div class="game-grid">
        {GAMES.map((game) => (
          <a href={`/settings/${game.slug}`} class="settings-card card-base card-hover">
            <h2 class="text-h3">{game.name}</h2>
            <p class="settings-card-meta">Scale: {game.deadzoneScale} · Start: {game.deadzoneRange}</p>
            <span class="settings-card-link">Settings &amp; deadzone &rarr;</span>
          </a>
        ))}
      </div>

      <section class="hub-note card-base">
        <h2 class="section-title">Why deadzones differ between games</h2>
        <p class="hub-text">
          Fortnite uses a 0–50 deadzone slider, Apex and Warzone use 0–100, Rocket League uses 0–1 floats, and some
          games (Street Fighter 6, Elden Ring) expose no deadzone at all. A "10%" deadzone means different stick travel
          in each game — and your controller's own drift profile matters more than any preset. Measure first with the
          <a href="/test/controller/drift" class="hub-link">Stick Drift Detector</a>.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .hub-hero { margin-bottom: 2.5rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 70ch; }
  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .settings-card-meta { font-size: var(--text-small); color: var(--color-text-secondary); }
  .settings-card { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .settings-card-link { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); }
  .hub-note { padding: 2rem; }
  .hub-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; }
  .hub-link { color: var(--color-accent); }
</style>
