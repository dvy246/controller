---
/**
 * /settings — Game Controller Settings Hub (10 games × 3 controllers = 30 pages)
 * Zero competitor coverage (verified: controllertest.io has no /settings pages).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const games = [
  { slug: 'fortnite', name: 'Fortnite' },
  { slug: 'apex-legends', name: 'Apex Legends' },
  { slug: 'warzone', name: 'Call of Duty: Warzone' },
  { slug: 'rocket-league', name: 'Rocket League' },
  { slug: 'street-fighter-6', name: 'Street Fighter 6' },
  { slug: 'valorant', name: 'Valorant' },
  { slug: 'counter-strike-2', name: 'Counter-Strike 2' },
  { slug: 'overwatch-2', name: 'Overwatch 2' },
  { slug: 'halo-infinite', name: 'Halo Infinite' },
  { slug: 'elden-ring', name: 'Elden Ring' },
];

const controllers = [
  { slug: 'ps5-dualsense', name: 'PS5 DualSense' },
  { slug: 'xbox-wireless', name: 'Xbox Wireless Controller' },
  { slug: 'switch-pro', name: 'Switch Pro Controller' },
];

const breadcrumbs = [{ name: 'Home', url: '/' }, { name: 'Settings' }];

const schemaData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Game Controller Settings — Deadzone & Sensitivity Guides',
    description: 'Per-game controller settings starting points: deadzone, response curve and sensitivity for Fortnite, Apex, Warzone, Valorant, CS2 and more, tuned per controller.',
    url: 'https://controllertesting.com/settings/'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: games.map((g, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `Settings for ${g.name}`,
      url: `https://controllertesting.com/settings/${g.slug}/ps5-dualsense`
    }))
  }
];
---

<BaseLayout
  title="Game Controller Settings — Deadzone & Sensitivity Guides | ControllerTesting.com"
  description="Per-game controller settings starting points: deadzone, response curve and sensitivity for Fortnite, Apex, Warzone, Valorant, CS2 and more, tuned per controller."
  breadcrumbs={breadcrumbs}
  schema={schemaData}

  localized={true}>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-hero">
        <span class="badge-tag mb-3">Settings Hub</span>
        <h1 class="text-h1 mb-2">Game Controller Settings</h1>
        <p class="hub-subtitle">
          Community-standard deadzone and sensitivity starting points for 10 competitive titles.
          Deadzone scales differ per game — every page shows the correct scale and a "test first" step.
        </p>
      </header>

      {games.map((game) => (
        <section class="game-block">
          <h2 class="text-h2">{game.name}</h2>
          <div class="game-grid">
            {controllers.map((c) => (
              <a href={`/settings/${game.slug}/${c.slug}`} class="settings-card card-base card-hover">
                <h3 class="text-h3">{game.name} on {c.name}</h3>
                <span class="settings-card-link">Deadzone &amp; sensitivity &rarr;</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <section class="hub-note card-base">
        <h2 class="section-title">Why deadzones differ between games</h2>
        <p class="hub-text">
          Fortnite uses a 0–50 deadzone slider, Apex and Warzone use 0–100, Rocket League uses 0–1 floats, and some
          games (Street Fighter 6, Elden Ring) expose no deadzone at all. A "10%" deadzone means different stick travel
          in each game — and your controller's own drift profile matters more than any preset. Measure first with the
          <a href="/test/controller/drift" class="hub-link">Stick Drift Detector</a>.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .hub-hero { margin-bottom: 2.5rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 70ch; }
  .game-block { margin-bottom: 2rem; }
  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .settings-card { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .settings-card-link { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent); }
  .hub-note { padding: 2rem; }
  .hub-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; }
  .hub-link { color: var(--color-accent); }
</style>
