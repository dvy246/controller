---
/**
 * /audio-test/index.astro — Audio Test Hub
 * SEO Title: Audio Test: Spatial Sound & Bluetooth Latency
 * Hub index for the Sonic-Space Spatial Audio Tester routes.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: 'Audio Test Hub' },
];

const audioTests = [
  { name: 'Surround Sound Spatial Test', href: '/audio-test/surround-sound', desc: '3D HRTF directional radar for 7.1 virtualized gaming audio', badge: 'Flagship' },
  { name: 'Bluetooth Latency Flash Test', href: '/audio-test/bluetooth-latency', desc: 'Wireless headset audio delay measurement in ms' },
  { name: 'Bass Frequency Response Test', href: '/audio-test/bass-frequency', desc: 'Low-end driver response sweep down to 20Hz' },
];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Gaming Audio Diagnostic Tests',
  numberOfItems: audioTests.length,
  itemListElement: audioTests.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `https://controllertesting.com${t.href}`,
  })),
};
---

<BaseLayout
  title="Audio Test: Spatial Sound & Bluetooth Latency | CT"
  description="Test gaming headset audio online free: 3D spatial HRTF accuracy, wireless Bluetooth latency, and bass frequency response with uncompressed web audio."
  schema={itemListSchema}
  breadcrumbs={breadcrumbs}
  localized={false}>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-header">
        <span class="badge-tag">Sonic-Space Audio Suite</span>
        <h1 class="hub-title text-h1">Audio Test Hub</h1>
        <p class="hub-subtitle">
          Verify your gaming headset's spatial accuracy, wireless latency, and bass extension before the next match. All tests run locally through the Web Audio API.
        </p>
      </header>

      <div class="grid-tools">
        {audioTests.map((tool) => (
          <a href={tool.href} class="tool-hub-card card-base card-hover">
            <div class="card-top-bar">
              <span class="card-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 0 1 9 9"/><path d="M12 8a4 4 0 0 1 4 4"/><path d="M12 13a2.5 2.5 0 0 1 2.5 2.5V19a2.5 2.5 0 0 1-5 0v-3.5A2.5 2.5 0 0 1 12 13z"/></svg>
              </span>
              {tool.badge && <span class="badge-tag">{tool.badge}</span>}
            </div>
            <h2 class="card-tool-name">{tool.name}</h2>
            <p class="card-tool-desc">{tool.desc}</p>
            <span class="card-action-link">
              Run test
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 96px; padding-bottom: var(--spacing-section); }
  .hub-header { margin-bottom: 2.5rem; }
  .hub-header .badge-tag { margin-bottom: 0.75rem; }
  .hub-title { font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .grid-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1.25rem; width: 100%; }
</style>