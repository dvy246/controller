---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';
import AudioRadar from '@components/features/AudioRadar.astro';

export function getStaticPaths() {
  const features = ['surround-sound', 'bluetooth-latency', 'bass-frequency'];

  return features.map(feature => ({
    params: { feature }
  }));
}

const { feature } = Astro.params;
const formattedFeature = feature.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const title = `Gaming Headset ${formattedFeature} & Spatial 3D Audio Test`;
const description = `Test your gaming headset for ${formattedFeature}, 3D spatial HRTF directional accuracy, and wireless Bluetooth latency. Free uncompressed web audio benchmark.`;
const canonical = `https://controllertesting.com/audio-test/${feature}`;

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: `${formattedFeature} Test` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}
  localized={true}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header />
  <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-h1">
        Gaming Audio Benchmark: {formattedFeature}
      </h1>
      <p class="mt-2 text-secondary max-w-3xl">
        Benchmark your headset's binaural 3D driver resolution, positional footstep tracking, and input-to-sound latency directly in browser.
      </p>
    </div>

    <!-- Component -->
    <AudioRadar featureKey={feature} />

    <!-- AEO/GEO FAQ -->
    <section class="mt-16 bg-[var(--color-surface-1)] p-6 sm:p-8 rounded-2xl border border-[var(--color-border-default)]">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-6">Gaming Audio & Latency FAQ</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-[var(--color-text-secondary)]">
        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">Why is Bluetooth audio latency bad for gaming?</h3>
          <p class="leading-relaxed">
            Standard Bluetooth (SBC/AAC codecs) introduces 150ms to 300ms of audio delay, causing footsteps and gunshot audio to lag behind on-screen actions. Dedicated 2.4GHz wireless headsets reduce latency under 20ms.
          </p>
        </div>

        <div class="bg-[var(--color-surface-2)] p-5 sm:p-6 rounded-xl border border-[var(--color-border-subtle)]">
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-2">How does 3D Spatial Audio work?</h3>
          <p class="leading-relaxed">
            It uses Head-Related Transfer Functions (HRTF) to simulate sound timing and volume differences between your left and right ear, giving the illusion of 360-degree directionality.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
