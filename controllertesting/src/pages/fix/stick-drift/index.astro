---
/**
 * /fix/stick-drift — Stick Drift Repair category hub (12 controllers)
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';

const guides = [
  { slug: 'ps5-dualsense', name: 'PS5 DualSense', sensor: 'Potentiometer' },
  { slug: 'xbox-wireless', name: 'Xbox Wireless (Series X/S)', sensor: 'Potentiometer' },
  { slug: 'switch-pro', name: 'Switch Pro Controller', sensor: 'Potentiometer' },
  { slug: 'joy-con', name: 'Joy-Con (L/R)', sensor: 'Potentiometer (ALPS)' },
  { slug: 'ps4-dualshock-4', name: 'PS4 DualShock 4', sensor: 'Potentiometer (ALPS)' },
  { slug: 'dualsense-edge', name: 'DualSense Edge', sensor: 'Swappable modules' },
  { slug: 'xbox-elite-2', name: 'Xbox Elite Series 2', sensor: 'Potentiometer' },
  { slug: '8bitdo-ultimate', name: '8BitDo Ultimate', sensor: 'Hall effect' },
  { slug: 'scuf-instinct-pro', name: 'SCUF Instinct Pro', sensor: 'Potentiometer' },
  { slug: 'steam-deck', name: 'Steam Deck (LCD/OLED)', sensor: 'Potentiometer / Hall effect' },
  { slug: 'gamecube', name: 'GameCube Controller', sensor: 'Potentiometer' },
  { slug: 'logitech-f310', name: 'Logitech F310 / F710', sensor: 'Potentiometer' },
];

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Repair Guides', url: '/fix' },
  { name: 'Stick Drift' },
];
---

<BaseLayout
  title="Fix Controller Stick Drift — Repair Guides for 12 Controllers | ControllerTesting.com"
  description="Step-by-step stick drift fix guides for PS5 DualSense, Xbox, Switch Pro, Joy-Con, DualShock 4, Edge, Elite 2, 8BitDo, SCUF, Steam Deck, GameCube and Logitech."
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="hub-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-hero">
        <span class="badge-tag">Repair Category</span>
        <h1 class="hub-title">Stick Drift Repair Guides</h1>
        <p class="hub-subtitle">
          Diagnose with a real measurement, clean or replace, then verify the fix with a re-test. Choose your controller:
        </p>
      </header>

      <div class="guide-grid">
        {guides.map((g) => (
          <a href={`/fix/stick-drift/${g.slug}`} class="guide-card card-base card-hover">
            <h2 class="guide-title">How to fix {g.name} stick drift</h2>
            <span class="guide-sensor">{g.sensor}</span>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hub-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .hub-hero { margin-bottom: 2.5rem; }
  .badge-tag { display: inline-block; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; color: var(--color-accent); background: rgba(37, 99, 235, 0.1); padding: 0.25em 0.75em; border-radius: var(--radius-pill); margin-bottom: 0.75rem; border: 1px solid rgba(37, 99, 235, 0.2); }
  .hub-title { font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .guide-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
  .guide-card { padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .guide-title { font-size: 1.0625rem; font-weight: 700; }
  .guide-sensor { font-family: var(--font-mono); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-tertiary); }
</style>
