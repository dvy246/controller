    {
      slug: 'ps5-dualsense',
      name: 'PS5 DualSense',
      platform: 'PlayStation 5 / PC',
      sensor: 'Potentiometer (ALPS modules)',
      intro: '90% of DualSense stick drift is carbon dust inside the green ALPS potentiometer housings. Cleaning fixes most cases; Hall-effect module swaps fix the rest permanently.',
      steps: [
        { title: 'Measure the exact drift', body: 'Run our Stick Drift Detector to identify which axis (left/right stick, X/Y) is drifting and how bad it is. Record the percentage before you open anything.' },
        { title: 'Flush the potentiometer wipers', body: 'Remove the shell, lift the stick module flex cable, and spray 99% isopropyl alcohol into the green potentiometer housings while rotating the stick. Re-seat everything and re-test.' },
        { title: 'Adjust in-game deadzones as a stopgap', body: 'While the module is drying, set an in-game deadzone that covers your measured drift (see our game settings guides). This restores playability instantly.' },
