      ],
      reliabilitySlug: null,
      moduleReplacement: 'LCD: drop-in modules · OLED: Hall effect (no wear parts)',
      warrantyNote: 'Opening the Deck voids warranty. Valve warranty covers drift on OLED models; contact Steam Support first.',
    },
    {
      slug: 'gamecube',
      name: 'Nintendo GameCube Controller',
      platform: 'GameCube / Switch (via adapter) / PC',
      sensor: 'Potentiometer',
      intro: 'GameCube sticks are famously durable, but 20-year-old controllers can develop center wobble or drift from a worn wiper track. Cleaning and drop-in modules are the fixes.',
      steps: [
        { title: 'Measure the exact drift', body: 'Run our Stick Drift Detector through an adapter (e.g., for Switch or PC) and note the at-rest offset.' },
        { title: 'Clean the stick box', body: 'Open the stick box and flush 99% isopropyl alcohol through the sensor while rotating the stick.' },
        { title: 'Replace the stick box', body: 'GameCube stick boxes are drop-in replacements (approx. $8–$15); many aftermarket boxes are tighter than the 20-year-old originals.' },
        { title: 'Re-test the fix', body: 'Re-run the Stick Drift Detector and confirm center, plus full 360° range.' },
      ],
      reliabilitySlug: null,
      moduleReplacement: 'Swappable modules: Yes (drop-in stick box)',
      warrantyNote: 'No warranty to void on out-of-production hardware — safe to repair yourself.',
    },
    {
      slug: 'logitech-f310',
      name: 'Logitech F310 / F710',
      platform: 'PC',
      sensor: 'Potentiometer',
      intro: 'Budget Logitech pads drift like any potentiometer stick. Given the F310 costs about as much as a module kit, replacement often beats repair.',
      steps: [
        { title: 'Measure the exact drift', body: 'Run our Stick Drift Detector in both XInput (X) and DirectInput (D) modes and compare.' },
        { title: 'Clean the stick sensors', body: 'Open the shell and flush 99% isopropyl alcohol through the sensor housings while rotating.' },
        { title: 'Compare repair cost vs replacement', body: 'F310 replacement is often cheaper than module kits — use our Fix vs Replace calculator to decide.' },
        { title: 'Re-test the fix', body: 'If you repaired it, re-run the Stick Drift Detector and confirm center in both input modes.' },
      ],
      reliabilitySlug: null,
      moduleReplacement: 'Swappable modules: No (soldered; budget price makes replacement the economical fix)',
      warrantyNote: 'Logitech warranty is typically 2 years; register your product before opening it.',
    },
  ];

  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Repair Guides', url: '/fix' },
  { name: 'Stick Drift', url: '/fix/stick-drift' },
  { name: guide.name },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Fix ${guide.name} Stick Drift`,
  description: `Step-by-step guide to fix ${guide.name} controller stick drift: diagnose, clean, adjust deadzones, repair or replace, and verify.`,
  step: guide.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.body,
  })),
};

const reliabilitySnippet = guide.reliabilitySlug
  ? `Baseline data: our ${guide.reliabilitySlug === 'hall-effect-generic' ? 'Hall-effect sensor' : guide.name} reliability dataset is compiled from documented test results — see the full report below.`
  : 'Baseline data: we do not yet publish reliability numbers for this model — no invented figures here. Measure your own unit with the drift tool.';
---

<BaseLayout
  title={`How to Fix ${guide.name} Stick Drift — Step-by-Step Repair Guide | ControllerTesting.com`}
  description={`Step-by-step guide to fix ${guide.name} controller stick drift: ${guide.sensor} diagnosis, cleaning, deadzone tuning, and replacement options.`}
  schema={howToSchema}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="guide-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="guide-hero">
        <span class="badge-tag mb-3">Repair Guide · {guide.sensor}</span>
        <h1 class="text-h1 mb-2">How to Fix {guide.name} Stick Drift</h1>
        <p class="guide-subtitle">
          {guide.intro}
        </p>
      </header>

      <div class="guide-body card-base">
        {guide.steps.map((step, i) => (
          <div class="guide-step">
            <h2 class="section-title">Step {i + 1}: {step.title}</h2>
            <p class="guide-text">{step.body}</p>
          </div>
        ))}

        <div class="guide-step">
          <h2 class="section-title">Module &amp; Parts Reference</h2>
          <p class="guide-text"><strong>Sensor type:</strong> {guide.sensor}</p>
          <p class="guide-text"><strong>{guide.moduleReplacement}</strong></p>
          <p class="guide-text"><strong>Safety &amp; warranty:</strong> {guide.warrantyNote}</p>
          <p class="guide-text">{reliabilitySnippet}</p>
        </div>
      </div>

      <div class="guide-cta card-base">
        <div>
          <h2 class="section-title">Verify your fix — Re-test now</h2>
          <p class="guide-text">
            Repairs only count when the measurement confirms them. Run the Stick Drift Detector again to confirm 0%–0.5% at rest, then log the result in your drift timeline.
          </p>
        </div>
        <div class="guide-cta-buttons">
          <a href="/test/controller/drift" class="btn-primary">Re-test Stick Drift</a>
          <a href="/test/controller/timeline" class="btn-secondary">Log in Timeline</a>
        </div>
      </div>

      <div class="guide-cta card-base">
        <div>
          <h2 class="section-title">Still drifting? Compare alternatives</h2>
          <p class="guide-text">
            If repeated repairs fail, check Hall-effect controllers — they use contactless magnetic sensors that do not accumulate the carbon dust that causes drift.
          </p>
        </div>
        <div class="guide-cta-buttons">
          <a href="/reliability/hall-effect-generic" class="btn-primary">Hall Effect Reliability Data</a>
          <a href="/compare/dualsense-vs-xbox-series" class="btn-secondary">Compare Controllers</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .guide-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .guide-hero { margin-bottom: 2.5rem; }
  .guide-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .guide-body { padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 1.5rem; }
  .guide-step { display: flex; flex-direction: column; gap: 0.5rem; }
  .guide-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
  .guide-cta { padding: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .guide-cta-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  @media (max-width: 640px) { .guide-cta { flex-direction: column; align-items: flex-start; } }
</style>
