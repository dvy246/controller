---
/**
 * /fix/stick-drift/ps5-dualsense — Step-by-Step PS5 DualSense Drift Repair Guide
 * SEO Title: How to Fix PS5 Controller Stick Drift — Step-by-Step Repair Guide
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/global/Header.astro';
import Footer from '../../../components/global/Footer.astro';
import Breadcrumbs from '../../../components/global/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Repair Guides' },
  { name: 'Fix PS5 Stick Drift' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Fix PS5 Controller Stick Drift',
  description: 'Complete step-by-step guide to fix PS5 DualSense thumbstick drift without soldering.',
  step: [
    { '@type': 'HowToStep', name: 'Run Diagnostic Test', text: 'Run our Stick Drift Test to identify which potentiometer track is drifting.' },
    { '@type': 'HowToStep', name: 'Clean Potentiometers', text: 'Use 99% isopropyl alcohol and compressed air to flush carbon dust from the green potentiometer wipers.' },
    { '@type': 'HowToStep', name: 'Adjust In-Game Deadzones', text: 'Set in-game deadzones in Fortnite, Call of Duty, or Apex Legends to match your measured drift percentage.' },
  ],
};
---

<BaseLayout
  title="How to Fix PS5 Controller Stick Drift — Step-by-Step Guide | ControllerTesting.com"
  description="Step-by-step guide to fix PS5 DualSense controller stick drift. Clean potentiometer wipers, adjust deadzones, or upgrade to Hall-effect magnetic sticks."
  schema={schema}
  breadcrumbs={breadcrumbs}
>
  <Header />

  <main id="main-content" class="guide-page">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="guide-hero">
        <span class="badge-tag">Repair Guide</span>
        <h1 class="guide-title">How to Fix PS5 DualSense Stick Drift</h1>
        <p class="guide-subtitle">
          Follow our verified 3-stage repair methodology: Deadzone Tuning (Software), Potentiometer Flushing (DIY Clean), and Hall-Effect Upgrades (Permanent Hardware Fix).
        </p>
      </header>

      <div class="guide-body card-base">
        <h2 class="section-title">Step 1: Test and Measure Exact Drift Percentage</h2>
        <p class="guide-text">
          Before taking apart your DualSense controller, test your left and right analog thumbsticks to measure the exact percentage of drift.
        </p>
        <a href="/test/controller/drift" class="btn-primary">Run Free Stick Drift Test &rarr;</a>

        <h2 class="section-title">Step 2: Clean Potentiometer Carbon Wipers</h2>
        <p class="guide-text">
          90% of stick drift is caused by graphite carbon dust accumulating inside the green ALPS potentiometer housings on the controller motherboard.
        </p>

        <h2 class="section-title">Step 3: Permanent Fix — Hall-Effect Magnetic Modules</h2>
        <p class="guide-text">
          If cleaning fails, replace traditional potentiometer modules with Hall-effect magnetic sensor modules ($12 on Amazon). Hall-effect sticks use contactless magnetic sensors that never wear out.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .guide-page { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .guide-hero { margin-bottom: 2.5rem; }
  .badge-tag { display: inline-block; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; color: var(--color-accent); background: rgba(37, 99, 235, 0.1); padding: 0.25em 0.75em; border-radius: var(--radius-pill); margin-bottom: 0.75rem; border: 1px solid rgba(37, 99, 235, 0.2); }
  .guide-title { font-size: var(--text-h1); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem; }
  .guide-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; max-width: 65ch; }
  .guide-body { padding: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .section-title { font-size: 1.25rem; font-weight: 700; color: var(--color-text-primary); }
  .guide-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.6; }
</style>
