---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import SensConverterUI from '../../components/features/SensConverterUI.astro';
import gamesData from '../../data/gameEngineConstants.json';

export function getStaticPaths() {
  const keys = Object.keys(gamesData);
  const paths = [];

  for (let i = 0; i < keys.length; i++) {
    for (let j = 0; j < keys.length; j++) {
      if (i !== j) {
        paths.push({
          params: { from: keys[i], to: keys[j] }
        });
      }
    }
  }
  return paths;
}

const { from, to } = Astro.params;
const games = gamesData as Record<string, { name: string }>;

const fromName = games[from]?.name || from;
const toName = games[to]?.name || to;

const title = `Convert ${fromName} to ${toName} Sensitivity (1:1 360° Match)`;
const description = `Accurately convert your in-game sensitivity from ${fromName} to ${toName}. Includes 360-degree turn distance (cm/in) calculator and hardware DPI scaling.`;
const canonical = `https://controllertesting.com/sensitivity-converter/${from}-to-${to}`;

const breadcrumbs = [
  { name: 'Tools', url: '/tools' },
  { name: `${fromName} to ${toName}` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "url": canonical,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<BaseLayout title={title} description={description} canonical={canonical} breadcrumbs={breadcrumbs}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Header />
  <main class="min-h-screen pt-24 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <Breadcrumbs items={breadcrumbs} />
    </div>

    <!-- Header -->
    <div class="mb-8 text-center sm:text-left">
      <h1 class="text-h1">
        {fromName} to {toName} Sensitivity Converter
      </h1>
      <p class="mt-2 text-secondary max-w-3xl">
        Maintain your exact muscle memory when switching from <span class="text-accent font-semibold">{fromName}</span> to <span class="text-pass font-semibold">{toName}</span>. Calculates exact sensitivity values, 360-degree rotation distance, and hardware eDPI.
      </p>
    </div>

    <!-- Converter Component -->
    <SensConverterUI fromGameKey={from} toGameKey={to} />

    <!-- AEO/GEO FAQ -->
    <section class="mt-16 bg-surface-1 p-6 sm:p-8 rounded-2xl border border-surface-3">
      <h2 class="text-h2 mb-6">Sensitivity Conversion & Motor Memory Guide</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-secondary">
        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold mb-2">Why does sensitivity differ between {fromName} and {toName}?</h3>
          <p>
            Different game engines use different <strong>Yaw multipliers</strong> (the angular degree change per mouse counts or analog stick tick). For instance, Valorant uses a yaw of 0.07 while CS2 uses 0.022. Direct numerical sensitivity numbers are non-transferable without conversion.
          </p>
        </div>

        <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
          <h3 class="font-semibold mb-2">What is cm/360° distance?</h3>
          <p>
            It is the physical distance (in centimeters or inches) your hand must move across the mousepad to rotate your in-game camera 360 degrees. Matching cm/360° distance ensures 1:1 muscle memory transfer.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
