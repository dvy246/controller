---
/**
 * /connect/index.astro — Hub for controller × platform pairing guides.
 * 4 controllers × 3 platforms (PC/macOS/Steam Deck).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Breadcrumbs from '@components/global/Breadcrumbs.astro';

const controllers = [
  { slug: 'ps5-dualsense', name: 'PS5 DualSense', tag: 'Bluetooth / USB-C' },
  { slug: 'ps4-dualshock-4', name: 'PS4 DualShock 4', tag: 'Bluetooth / micro-USB' },
  { slug: 'xbox-wireless', name: 'Xbox Wireless Controller', tag: 'Xbox Wireless / Bluetooth / USB' },
  { slug: 'switch-pro', name: 'Nintendo Switch Pro Controller', tag: 'Bluetooth / USB-C' },
];

// Questions taken from real Search Console queries for these guides.
const faqs = [
  {
    question: 'How do I connect a Switch Pro Controller to Windows?',
    answer: 'Hold the SYNC button on the top edge until the player LEDs run, then open Settings → Bluetooth & devices → Add device → Bluetooth and select "Pro Controller". Windows pairs it, but most games only read it through Steam Input, so turn on Steam Input for Switch controllers in Steam → Settings → Controller.',
    link: { url: '/connect/switch-pro/pc', label: 'Switch Pro Controller on PC guide' },
  },
  {
    question: 'Does the Xbox Wireless Adapter work on macOS?',
    answer: 'Microsoft documents the Xbox Wireless Adapter for Windows PCs only, and Apple\'s instructions cover Bluetooth pairing. On a Mac, pair a Bluetooth-capable Xbox controller (Model 1708 or a Series X|S controller) from System Settings → Bluetooth instead.',
    link: { url: '/connect/xbox-wireless/mac', label: 'Xbox controller on macOS guide' },
  },
  {
    question: 'Do DualSense adaptive triggers and haptics work on PC?',
    answer: 'Sony says haptic feedback on PC needs a USB connection and a game that supports it, and adaptive triggers also depend on game support. Over Bluetooth the DualSense still works as a standard controller.',
    link: { url: '/test/controller/triggers', label: 'Trigger pressure tester' },
  },
];

const platforms = [
  { slug: 'pc', name: 'PC (Windows)' },
  { slug: 'mac', name: 'macOS' },
  { slug: 'steam-deck', name: 'Steam Deck' },
];

const breadcrumbs = [{ name: 'Connect & Pair', url: '/connect' }];

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: controllers.flatMap((c, i) =>
    platforms.map((p, j) => ({
      '@type': 'ListItem',
      position: i * platforms.length + j + 1,
      name: `${c.name} on ${p.name}`,
      url: `https://controllertesting.com/connect/${c.slug}/${p.slug}`,
    }))
  ),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title="Connect & Pair | ControllerTesting"
  description="Step-by-step connection and pairing guides for PS5 DualSense, PS4 DualShock 4, Xbox Wireless, and Switch Pro controllers on Windows, macOS, and Steam Deck."
  breadcrumbs={breadcrumbs}
  schema={[itemListSchema, faqSchema]}

  localized={false}>
  <Header />

  <main id="main-content" class="connect-hub">
    <div class="container-site">
      <Breadcrumbs items={breadcrumbs} />

      <header class="hub-hero">
        <span class="badge-tag">Connect &amp; Pair</span>
        <h1 class="text-h1 mb-2">Connect your controller on any device</h1>
        <p class="hub-subtitle">
          Pick the guide that matches both your controller and the device you're connecting it to, because the
          pairing method changes with each combination.
        </p>
        <div class="hub-intro">
          <p class="hub-text">
            On Windows, the Xbox Wireless Controller works natively over USB, the Xbox Wireless Adapter or Bluetooth.
            PlayStation and Nintendo controllers pair over Bluetooth too, but many games only see them through Steam Input.
            On a Mac, support depends on your macOS version: the DualShock 4 needs Catalina or later, the DualSense needs
            Big Sur 11.3, and the Switch Pro Controller needs Ventura 13. On Steam Deck, all four pair from
            Settings → Bluetooth and Steam Input handles the layout, though Valve notes that many Xbox controllers need a
            firmware update first.
          </p>
          <p class="hub-text">
            Each guide covers the button combination that starts pairing, the wired option, the problems people commonly
            hit with that pair, and links to the official Sony, Microsoft, Apple, Nintendo or Valve support page it is
            based on. When you're paired, run a tester to check every input.
          </p>
        </div>
      </header>

      <div class="hub-grid card-base">
        <div class="hub-row hub-row-head">
          <span class="hub-cell">Controller</span>
          {platforms.map((p) => <span class="hub-cell">{p.name}</span>)}
        </div>
        {controllers.map((c) => (
          <div class="hub-row">
            <span class="hub-cell hub-name">
              <strong>{c.name}</strong>
              <span class="hub-tag">{c.tag}</span>
            </span>
            {platforms.map((p) => (
              <span class="hub-cell"><a class="hub-link" href={`/connect/${c.slug}/${p.slug}`}>Pair {p.name} →</a></span>
            ))}
          </div>
        ))}
      </div>

      <section class="hub-faq" aria-labelledby="hub-faq-title">
        <h2 id="hub-faq-title" class="section-title">Common pairing questions</h2>
        {faqs.map((f) => (
          <div class="hub-faq-item">
            <h3 class="hub-faq-q">{f.question}</h3>
            <p class="hub-text">{f.answer}</p>
            <a class="hub-link" href={f.link.url}>{f.link.label} →</a>
          </div>
        ))}
      </section>

      <div class="hub-cta card-base">
        <div>
          <h2 class="section-title">Already connected? Test the pad</h2>
          <p class="hub-text">
            A controller that connects isn't automatically healthy. Run the 2-minute diagnostic after pairing to confirm sticks, buttons, and triggers.
          </p>
        </div>
        <div class="hub-cta-buttons">
          <a href="/test/controller/full-diagnostic" class="btn-primary">Run Full Diagnostic</a>
          <a href="/test/controller/polling-rate" class="btn-secondary">Polling Rate Check</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .connect-hub { padding-top: 80px; padding-bottom: var(--spacing-section); }
  .hub-hero { margin-bottom: 2.5rem; max-width: 720px; }
  .hub-hero .badge-tag { margin-bottom: 0.75rem; }
  .hub-subtitle { font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.6; }
  .hub-grid { padding: 1.5rem; margin-bottom: 2.5rem; overflow-x: auto; }
  .hub-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 1rem; padding: 0.875rem 0; border-top: 1px solid var(--color-border-subtle); align-items: center; }
  .hub-row-head { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 1rem; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.06em; text-transform: uppercase; padding-bottom: 0.875rem; }
  .hub-cell { display: flex; flex-direction: column; gap: 0.25rem; }
  .hub-name strong { color: var(--color-text-primary); font-size: 1rem; }
  .hub-tag { font-family: var(--font-mono); font-size: 0.625rem; color: var(--color-text-tertiary); }
  .hub-link { color: var(--color-accent); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .hub-link:hover { text-decoration: underline; }
  .hub-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .hub-cta { padding: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .hub-cta-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .section-title { margin-bottom: 0.5rem; }
  .hub-intro { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; }
  .hub-text { font-size: 1rem; color: var(--color-text-secondary); line-height: 1.7; margin: 0; }
  .hub-faq { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2.5rem; max-width: 760px; }
  .hub-faq-item { display: flex; flex-direction: column; gap: 0.375rem; border-bottom: 1px solid var(--color-border-subtle); padding-bottom: 1.25rem; }
  .hub-faq-item:last-child { border-bottom: none; padding-bottom: 0; }
  .hub-faq-q { font-size: 1rem; font-weight: 700; color: var(--color-text-primary); }
  @media (max-width: 720px) { .hub-grid { font-size: 0.875rem; } }
  @media (max-width: 640px) { .hub-cta { flex-direction: column; align-items: flex-start; } }
</style>