---
/**
 * ToolLayout.astro — ControllerTesting.com
 * Card-based tool page layout following prd_addendum.md specification:
 * 1. Breadcrumbs
 * 2. Hero Card
 * 3. Tool Card (interactive slot)
 * 4. Results Card
 * 5. Action Cards (Fix/Optimize/Upgrade)
 * 6. Export Card
 * 7. Related Tools
 * 8. SEO Content
 * 9. FAQ Card
 * 10. Trust Card
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import TelemetryConsent from '../components/global/TelemetryConsent.astro';
import PremiumFaqAccordion from '../components/seo/PremiumFaqAccordion.astro';
import HowToGetStarted from '../components/global/HowToGetStarted.astro';
import InterlinkStrip from '../components/global/InterlinkStrip.astro';
import { resolveGamesForTool } from '../data/arcadeInterlinks';

export interface Props {
  title: string;
  description: string;
  toolName: string;
  category: string;
  categoryUrl: string;
  breadcrumbs: Array<{ name: string; url?: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  schema?: object | object[];
  /** Set true only for tools that actually wire recordTelemetry
      (drift, circularity, …). Hides the consent banner otherwise. */
  telemetryEnabled?: boolean;
}

const {
  title,
  description,
  toolName,
  category,
  categoryUrl,
  breadcrumbs,
  faqs = [],
  schema = [],
  telemetryEnabled = false,
} = Astro.props;

// Auto-generate WebApplication + FAQPage JSON-LD schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: toolName,
  url: Astro.url.href,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const allSchemas = [
  webAppSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(Array.isArray(schema) ? schema : [schema]),
];

const relatedGames = resolveGamesForTool(Astro.url.pathname);
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  schema={allSchemas}
>
  <Header />

  <main id="main-content" class="tool-page">
    <div class="container-site">

      {/* ── 1. Breadcrumbs ── */}
      <Breadcrumbs items={breadcrumbs} />

      {/* ── 2. Hero Card ── */}
      <header class="tool-hero-card card-base" data-reveal>
        {/* Decorative accent line at top */}
        <div class="tool-hero-accent-bar" aria-hidden="true"></div>
        <div class="tool-hero-header">
          <div class="tool-hero-top-row">
            <span class="tool-category-badge">{category}</span>
            <span class="tool-hero-live-badge" aria-hidden="true">
              <span class="live-dot"></span>
              Browser API
            </span>
          </div>
          <h1 class="tool-title">{toolName}</h1>
          <p class="tool-description">{description}</p>
        </div>
      </header>

      {/* ── 3. Tool Card (Interactive Slot) ── */}
      <section class="tool-interactive-card card-tool" aria-label={`Interactive ${toolName} interface`}>
        <slot name="tool" />
      </section>

      {/* ── 4. Results Card (Slot, gated) ── */}
      {Astro.slots.has('results') && (
        <section class="tool-results-card" aria-label="Test results summary" aria-live="polite">
          <slot name="results" />
        </section>
      )}

      {/* ── 4.1 Decision Strip Slot ── */}
      {Astro.slots.has('decision-strip') && (
        <slot name="decision-strip" />
      )}

      {/* ── 4.5. How to Get Started Section (Standardized sitewide) ── */}
      <HowToGetStarted />

      {/* ── 4.6. Telemetry Consent (moved here per UX audit) ── */}
      {telemetryEnabled && <TelemetryConsent />}

      {/* ── 5. Action Cards (3-col: Fix / Optimize / Upgrade) ── */}
      <section class="tool-actions-section" aria-label="Recommended next actions">
        <div class="actions-header">
          <h2 class="actions-title">What would you like to do next?</h2>
          <p class="actions-subtitle">Select a diagnostic calibration suite, deadzone analyzer, or high-frequency overclock tool.</p>
        </div>
        <div class="actions-grid">

          <!-- Card 1: Fix -->
          <div class="action-card-v2 action-card-v2--amber group">
            <div class="action-card-body">
              <div class="action-card-header">
                <div class="action-icon-v2 action-icon-v2--amber" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </div>
                <span class="action-badge-v2 action-badge-v2--amber">Fix</span>
              </div>
              <h3 class="action-title-v2 action-title-v2--amber">Repair &amp; Calibration</h3>
              <p class="action-desc-v2">Calibrate zero-point offsets or follow step-by-step repair guides.</p>
            </div>
            <div class="action-card-footer">
              <a href="/calibrate/dualsense/hall-effect" class="action-cta action-cta--amber">
                <span>WebHID Calibration</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <!-- Card 2: Optimize -->
          <div class="action-card-v2 action-card-v2--emerald group">
            <div class="action-card-body">
              <div class="action-card-header">
                <div class="action-icon-v2 action-icon-v2--emerald" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/></svg>
                </div>
                <span class="action-badge-v2 action-badge-v2--emerald">Optimize</span>
              </div>
              <h3 class="action-title-v2 action-title-v2--emerald">Game Deadzones</h3>
              <p class="action-desc-v2">Calculate exact radial vs axial deadzone overlays for Fortnite, Apex, &amp; COD.</p>
            </div>
            <div class="action-card-footer">
              <a href="/deadzone-calculator/fortnite/ps5" class="action-cta action-cta--emerald">
                <span>Deadzone Calculator</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <!-- Card 3: Telemetry -->
          <div class="action-card-v2 action-card-v2--blue group">
            <div class="action-card-body">
              <div class="action-card-header">
                <div class="action-icon-v2 action-icon-v2--blue" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                </div>
                <span class="action-badge-v2 action-badge-v2--blue">Telemetry</span>
              </div>
              <h3 class="action-title-v2 action-title-v2--blue">Overclock &amp; Circularity</h3>
              <p class="action-desc-v2">Verify true hardware polling Hz stability and statistical circularity grades.</p>
            </div>
            <div class="action-card-footer">
              <a href="/overclock-validator/ps5/usb-c" class="action-cta action-cta--blue">
                <span>Hz &amp; Circularity Tools</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>

        </div>
      </section>

      {/* ── 6. Export Card (Slot, gated) ── */}
      {Astro.slots.has('export') && (
        <section class="tool-export-card">
          <slot name="export" />
        </section>
      )}

      {/* ── 7. Related Tools (Slot, gated) ── */}
      {Astro.slots.has('related-tools') && (
        <section class="related-tools-section">
          <h2 class="section-title">Related Diagnostic Tools</h2>
          <div class="grid-related">
            <slot name="related-tools" />
          </div>
        </section>
      )}

      {/* ── 7.5. Related Games (auto from arcadeInterlinks registry) ── */}
      {relatedGames.length > 0 && (
        <InterlinkStrip
          type="games"
          title="Practice what you just tested"
          subtitle="Turn your test results into skill. These arcade games train the exact inputs you just measured — drift, buttons, triggers, D-pad and reaction time."
          links={relatedGames}
        />
      )}

      {/* ── 8. SEO Educational Content ── */}
      {Astro.slots.has('content') && (
        <article class="tool-content-section card-base prose max-w-none p-6 sm:p-10 md:p-12 mb-12">
          <slot name="content" />
        </article>
      )}

      {/* ── 9. FAQ Card (Unified Premium Accordion) ── */}
      {faqs.length > 0 && (
        <PremiumFaqAccordion faqs={faqs} />
      )}

      {/* ── 9.5. Methodology & Limits Collapsible ── */}
      <div class="mb-16 methodology-collapsible-wrap" data-reveal>
        <details class="methodology-collapsible">
          <summary class="methodology-summary">
            <span class="methodology-label">How this test works &amp; its limits</span>
            <span class="methodology-icon-wrap" aria-hidden="true">
              <svg class="methodology-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </summary>
          <div class="methodology-body">
            <ul class="methodology-list">
              <li>This test reads your controller through the browser's standard Gamepad API — no drivers, no installs, nothing leaves your device.</li>
              <li>Readings depend on connection mode: Bluetooth reports at lower rates than USB. Compare like-for-like (wired vs wired).</li>
              <li>We measure the input reaching the browser — display lag and game-engine queues are outside this test's view.</li>
              <li>A clean reading now does not guarantee no drift in-game: deadzones differ per game, and wear develops over time. Use the Drift Timeline to track yours.</li>
              <li>This is a diagnostic, not a hardware-lab certification. For repair or RMA decisions, confirm with a second run or second tool.</li>
            </ul>
            <a href="/test/methodology" class="methodology-link">
              <span>Read the full methodology</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </details>
      </div>

      {/* ── 10. Trust Card ── */}
      <section class="tool-trust-card card-base">
        <div class="trust-grid">
          <div class="trust-item">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="g-trust-lock" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#10B981"/>
                  <stop offset="100%" stop-color="#06B6D4"/>
                </linearGradient>
              </defs>
              <rect x="3" y="11" width="18" height="11" rx="3" fill="url(#g-trust-lock)" fill-opacity="0.2" stroke="url(#g-trust-lock)" stroke-width="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="#10B981" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <div>
              <strong class="trust-title">100% Client-Side</strong>
              <p class="trust-desc">All Gamepad API data stays in your browser. Zero tracking or data collection.</p>
            </div>
          </div>
          <div class="trust-item">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="g-trust-zap" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#F59E0B"/>
                  <stop offset="100%" stop-color="#EF4444"/>
                </linearGradient>
              </defs>
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="url(#g-trust-zap)" fill-opacity="0.25" stroke="url(#g-trust-zap)" stroke-width="2" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong class="trust-title">Instant Results</strong>
              <p class="trust-desc">No downloads, plugins, or software installation needed. Works instantly.</p>
            </div>
          </div>
          <div class="trust-item">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="g-trust-check" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#3B82F6"/>
                  <stop offset="100%" stop-color="#8B5CF6"/>
                </linearGradient>
              </defs>
              <circle cx="12" cy="12" r="10" fill="url(#g-trust-check)" fill-opacity="0.2" stroke="url(#g-trust-check)" stroke-width="2"/>
              <polyline points="16 9 10.5 15 8 12.5" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong class="trust-title">Free Forever</strong>
              <p class="trust-desc">No paywalls, subscription requirements, or hidden usage limits.</p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page {
    padding-top: 80px;
    padding-bottom: var(--spacing-section);
  }

  .tool-hero-card {
    margin-bottom: 1.25rem;
    overflow: hidden;
    padding: 0;  /* accent bar is full-width, header handles its own insets */
  }

  /* Decorative gradient line at top of hero card */
  .tool-hero-accent-bar {
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      #818cf8 50%,
      var(--color-accent) 100%
    );
    margin-bottom: 0;
    border-radius: 0;
    opacity: 0.7;
  }

  .tool-hero-header {
    /* Deliberate content inset — text must never touch the border */
    padding: 1.5rem 1.75rem 1.75rem;
  }

  @media (max-width: 768px) {
    .tool-hero-header {
      padding: 1.25rem 1.25rem 1.5rem;
    }
  }

  .tool-hero-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .tool-hero-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    padding: 0.15em 0.5em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-subtle);
  }

  .live-dot {
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-pass);
    box-shadow: 0 0 5px var(--color-pass);
    animation: live-pulse 2s ease-in-out infinite;
  }

  @keyframes live-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot { animation: none; }
  }

  .tool-category-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.2em 0.65em;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .tool-title {
    font-size: clamp(1.625rem, 2.5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .tool-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 65ch;
    font-weight: 400;
  }

  .tool-interactive-card {
    margin-bottom: var(--space-16, 4rem);
  }

  .tool-interactive-card.card-tool:has(.doppelrand-shell) {
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .tool-results-card {
    margin-bottom: var(--space-16, 4rem);
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
  }

  .section-title {
    font-size: var(--text-h2);
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .tool-interactive-card,
  .tool-results-card,
  .tool-actions-section,
  .related-tools-section,
  .tool-content-section,
  .tool-faq-section,
  .tool-export-card,
  .tool-limits-card,
  .methodology-collapsible-wrap,
  .how-to-get-started-card {
    margin-bottom: var(--space-16, 4rem);
  }

  /* Methodology & limits */
  .tool-limits-card {
    padding: 0;
    overflow: hidden;
  }

  .limits-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    list-style: none;
  }

  .limits-summary::-webkit-details-marker { display: none; }

  .limits-summary:hover { color: var(--color-accent); }

  .limits-toggle {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    transition: transform var(--duration-fast);
  }

  .tool-limits-card[open] .limits-toggle { transform: rotate(45deg); }

  .limits-body {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 1rem;
  }

  .limits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .limits-list li {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .limits-list li::before { content: '•'; position: absolute; left: 0; color: var(--color-accent); }

  .limits-link { font-size: var(--text-small); color: var(--color-accent); text-decoration: underline; }

  /* ── Actions Section Header ── */
  .actions-header {
    margin-bottom: 2rem;
  }

  .actions-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    color: var(--color-text-primary, #ffffff);
    letter-spacing: -0.02em;
    margin: 0 0 0.375rem 0;
    line-height: 1.3;
  }

  .actions-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-secondary, #a1a1aa);
    line-height: 1.6;
    margin: 0;
    max-width: 56ch;
  }

  /* ── Actions Grid ── */
  .actions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .actions-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Action Card v2 base ── */
  .action-card-v2 {
    background: #121215;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    padding: 1.625rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background 300ms ease, border-color 300ms ease, box-shadow 300ms ease, transform 200ms ease;
  }

  .action-card-v2:hover {
    background: #16161a;
    transform: translateY(-1px);
  }

  .action-card-v2--amber:hover   { border-color: rgba(245, 158, 11, 0.35);  box-shadow: 0 8px 24px rgba(245, 158, 11, 0.07); }
  .action-card-v2--emerald:hover { border-color: rgba(16, 185, 129, 0.35);  box-shadow: 0 8px 24px rgba(16, 185, 129, 0.07); }
  .action-card-v2--blue:hover    { border-color: rgba(59, 130, 246, 0.35);  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.07); }

  /* ── Action Card body (flex: 1, grows to fill) ── */
  .action-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* ── Action Card header row: icon + badge ── */
  .action-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.125rem;
    flex-wrap: nowrap;
  }

  /* ── Icon v2 ── */
  .action-icon-v2 {
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 200ms ease;
  }

  .group:hover .action-icon-v2 { transform: scale(1.06); }

  .action-icon-v2--amber   { background: rgba(245, 158, 11, 0.1);  border: 1px solid rgba(245, 158, 11, 0.25);  color: #f59e0b; }
  .action-icon-v2--emerald { background: rgba(16, 185, 129, 0.1);  border: 1px solid rgba(16, 185, 129, 0.25);  color: #10b981; }
  .action-icon-v2--blue    { background: rgba(59, 130, 246, 0.1);  border: 1px solid rgba(59, 130, 246, 0.25);  color: #60a5fa; }

  /* ── Badge v2 ── */
  .action-badge-v2 {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
