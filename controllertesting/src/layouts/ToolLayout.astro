---
/**
 * ToolLayout.astro — ControllerTesting.com
 * Card-based tool page layout following prd_addendum.md specification:
 * 1. Breadcrumbs
 * 2. Hero Card
 * 3. Tool Card (interactive slot)
 * 4. Results Card
 * 5. Action Cards (Fix/Optimize/Upgrade)
 * 6. Export Card
 * 7. Related Tools
 * 8. SEO Content
 * 9. FAQ Card
 * 10. Trust Card
 */

import BaseLayout from './BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import TelemetryConsent from '../components/global/TelemetryConsent.astro';

export interface Props {
  title: string;
  description: string;
  toolName: string;
  category: string;
  categoryUrl: string;
  breadcrumbs: Array<{ name: string; url?: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  schema?: object | object[];
}

const {
  title,
  description,
  toolName,
  category,
  categoryUrl,
  breadcrumbs,
  faqs = [],
  schema = [],
} = Astro.props;

// Auto-generate WebApplication + FAQPage JSON-LD schemas
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: toolName,
  url: Astro.url.href,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
} : null;

const allSchemas = [
  webAppSchema,
  ...(faqSchema ? [faqSchema] : []),
  ...(Array.isArray(schema) ? schema : [schema]),
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  schema={allSchemas}
>
  <Header />

  <main id="main-content" class="tool-page">
    <div class="container-site">

      {/* ── 1. Breadcrumbs ── */}
      <Breadcrumbs items={breadcrumbs} />

      {/* ── 2. Hero Card ── */}
      <header class="tool-hero-card card-base">
        <div class="tool-hero-header">
          <span class="tool-category-badge">{category}</span>
          <h1 class="tool-title">{toolName}</h1>
          <p class="tool-description">{description}</p>
        </div>
      </header>

      {/* ── 3. Tool Card (Interactive Slot) ── */}
      <section class="tool-interactive-card card-tool" aria-label={`Interactive ${toolName} interface`}>
        <slot name="tool" />
      </section>

      {/* ── 3.5. Telemetry Consent (sitewide opt-in) ── */}
      <TelemetryConsent />

      {/* ── 4. Results Card (Slot) ── */}
      <section class="tool-results-card card-base" aria-label="Test results summary">
        <slot name="results" />
      </section>

      {/* ── 5. Action Cards (3-col: Fix / Optimize / Upgrade) ── */}
      <section class="tool-actions-section" aria-label="Recommended next actions">
        <h2 class="section-title">What would you like to do next?</h2>
        <div class="grid-actions">
          <div class="action-card card-base card-hover">
            <span class="action-badge badge-warning">Fix Problem</span>
            <h3 class="action-title">Repair & Calibration</h3>
            <p class="action-desc">Calibrate zero-point offsets or follow step-by-step repair guides.</p>
            <a href="/calibrate/dualsense/hall-effect" class="btn-secondary">WebHID Calibration</a>
          </div>
          <div class="action-card card-base card-hover">
            <span class="action-badge badge-pass">Optimize</span>
            <h3 class="action-title">Game Deadzones</h3>
            <p class="action-desc">Calculate exact radial vs axial deadzone overlays for Fortnite, Apex, & COD.</p>
            <a href="/deadzone-calculator/fortnite/ps5" class="btn-secondary">Deadzone Calculator</a>
          </div>
          <div class="action-card card-base card-hover">
            <span class="action-badge badge-info">Hardware Telemetry</span>
            <h3 class="action-title">Overclock & Circularity</h3>
            <p class="action-desc">Verify true hardware polling Hz stability and statistical circularity grades.</p>
            <a href="/overclock-validator/ps5/usb-c" class="btn-secondary">Hz & Circularity Tools</a>
          </div>
        </div>
      </section>

      {/* ── 6. Export Card (Slot) ── */}
      <section class="tool-export-card">
        <slot name="export" />
      </section>

      {/* ── 7. Related Tools ── */}
      <section class="related-tools-section">
        <h2 class="section-title">Related Diagnostic Tools</h2>
        <div class="grid-related">
          <slot name="related-tools" />
        </div>
      </section>

      {/* ── 8. SEO Educational Content ── */}
      <article class="tool-content-section card-base prose">
        <slot name="content" />
      </article>

      {/* ── 9. FAQ Card ── */}
      {faqs.length > 0 && (
        <section class="tool-faq-section" aria-label="Frequently Asked Questions">
          <h2 class="section-title">Frequently Asked Questions</h2>
          <div class="faq-accordion">
            {faqs.map((faq) => (
              <details class="faq-item">
                <summary class="faq-question">{faq.question}</summary>
                <p class="faq-answer">{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* ── 9.5. Methodology & Limits Collapsible ── */}
      <details class="tool-limits-card card-base">
        <summary class="limits-summary">
          <span>How this test works &amp; its limits</span>
          <span class="limits-toggle" aria-hidden="true">+</span>
        </summary>
        <div class="limits-body">
          <ul class="limits-list">
            <li>This test reads your controller through the browser's standard Gamepad API — no drivers, no installs, nothing leaves your device.</li>
            <li>Readings depend on connection mode: Bluetooth reports at lower rates than USB. Compare like-for-like (wired vs wired).</li>
            <li>We measure the input reaching the browser — display lag and game-engine queues are outside this test's view.</li>
            <li>A clean reading now does not guarantee no drift in-game: deadzones differ per game, and wear develops over time. Use the Drift Timeline to track yours.</li>
            <li>This is a diagnostic, not a hardware-lab certification. For repair or RMA decisions, confirm with a second run or second tool.</li>
          </ul>
          <a href="/test/methodology" class="limits-link">Read the full methodology &rarr;</a>
        </div>
      </details>

      {/* ── 10. Trust Card ── */}
      <section class="tool-trust-card card-base">
        <div class="trust-grid">
          <div class="trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <div>
              <strong class="trust-title">100% Client-Side</strong>
              <p class="trust-desc">All Gamepad API data stays in your browser. Zero tracking or data collection.</p>
            </div>
          </div>
          <div class="trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <div>
              <strong class="trust-title">Instant Results</strong>
              <p class="trust-desc">No downloads, plugins, or software installation needed. Works instantly.</p>
            </div>
          </div>
          <div class="trust-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <strong class="trust-title">Free Forever</strong>
              <p class="trust-desc">No paywalls, subscription requirements, or hidden usage limits.</p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .tool-page {
    padding-top: 80px;
    padding-bottom: var(--spacing-section);
  }

  .tool-hero-card {
    margin-bottom: 1.5rem;
  }

  .tool-category-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: rgba(37, 99, 235, 0.1);
    padding: 0.25em 0.75em;
    border-radius: var(--radius-pill);
    margin-bottom: 0.75rem;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .tool-title {
    font-size: var(--text-h1);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .tool-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 60ch;
  }

  .tool-interactive-card {
    margin-bottom: 2.5rem;
    min-height: 350px;
  }

  .tool-interactive-card.card-tool:has(.doppelrand-shell) {
    padding: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .tool-results-card {
    margin-bottom: 2.5rem;
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
  }

  .section-title {
    font-size: var(--text-h2);
    font-weight: 700;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .tool-interactive-card,
  .tool-results-card,
  .tool-actions-section,
  .related-tools-section,
  .tool-content-section,
  .tool-faq-section,
  .tool-export-card,
  .tool-limits-card {
    margin-bottom: var(--space-12, 3rem);
  }

  /* Methodology & limits */
  .tool-limits-card {
    padding: 0;
    overflow: hidden;
  }

  .limits-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    list-style: none;
  }

  .limits-summary::-webkit-details-marker { display: none; }

  .limits-summary:hover { color: var(--color-accent); }

  .limits-toggle {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    transition: transform var(--duration-fast);
  }

  .tool-limits-card[open] .limits-toggle { transform: rotate(45deg); }

  .limits-body {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 1rem;
  }

  .limits-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-bottom: 0.875rem;
  }

  .limits-list li {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: 1rem;
    position: relative;
  }

  .limits-list li::before { content: '▸'; position: absolute; left: 0; color: var(--color-accent); }

  .limits-link { font-size: var(--text-small); color: var(--color-accent); text-decoration: underline; }

  .action-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .action-badge {
    width: fit-content;
  }

  .action-title {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .action-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
    flex-grow: 1;
  }

  /* Ultra-Premium FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .faq-item {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: rgba(59, 130, 246, 0.3);
    background: var(--color-surface-2);
  }

  .faq-item[open] {
    border-color: rgba(59, 130, 246, 0.4);
    background: var(--color-surface-2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .faq-question {
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: "＋";
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-accent);
    transition: transform 0.25s ease;
  }

  .faq-item[open] .faq-question::after {
    content: "−";
    transform: rotate(180deg);
  }

  .faq-answer {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-top: 0.875rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  /* Trust grid */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .trust-item svg {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .trust-title {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .trust-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .trust-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
