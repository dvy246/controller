---
/**
 * BaseLayout.astro — ControllerTesting.com
 * Every page uses this. SEO head, theme, fonts, structured data.
 * Skills applied: design-taste-frontend, DESIGN.md
 */

import '../styles/global.css';
import GlobalSearch from '../components/global/GlobalSearch.astro';
import CookieConsent from '../components/global/CookieConsent.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: object | object[];
  noindex?: boolean;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  breadcrumbs?: Array<{ name: string; url?: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  keywords?: string;
  /**
   * Mark pages that have auto-synced locale variants.
   * When true, hreflang alternates are emitted for all 10 locales.
   */
  localized?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://controllertesting.com/og-default.png',
  ogImageAlt = 'ControllerTesting.com online hardware diagnostic tools',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = 'website',
  schema,
  noindex = false,
  breadcrumbs,
  faqs = [],
  keywords,
  localized = false,
} = Astro.props;

// Astro's build.pathname includes '.html' when build.format === 'file'.
// Normalize to the clean served route so canonicals, hreflang, and sitemap
// URLs stay consistent (no '.html', no trailing slash except root).
const rawPath = Astro.url.pathname;
const cleanPath = rawPath === '/' ? '/' : rawPath.replace(/\.html$/, '').replace(/\/$/, '');

const canonicalUrl = canonical ?? new URL(cleanPath, Astro.site).href;

// hreflang alternate links — en-only launch (2026-08-10).
// The former 10-locale hreflang set pointed at English-content copies under
// /es /de /fr /ja /pt /ko /ru /zh-tw /it (generated by sync-locales.js),
// producing 2,750 near-duplicate URLs Google treats as duplicates BEFORE it
// evaluates hreflang. Locale trees are disabled until genuine translations
// exist; languageSet stays empty, so no alternate links are emitted.
// Re-enable by restoring the languageSet below AND real localized pages.
const languageSet = localized ? [] : [];

// Auto-generate BreadcrumbList schema
const breadcrumbSchema = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        ...(crumb.url ? { item: crumb.url } : {}),
      })),
    }
  : null;

const faqSchema = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : null;

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ControllerTesting.com',
  url: 'https://controllertesting.com',
  description: 'Free online gamepad tester and controller diagnostic suite. Test stick drift, buttons, triggers, vibration, polling rate, and deadzone on PS5, Xbox, Switch, and PC controllers.',
  dateModified: '2026-08-10',
  inLanguage: 'en',
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ResearchOrganization'],
  name: 'ControllerTesting.com',
  url: 'https://controllertesting.com',
  logo: {
    '@type': 'ImageObject',
    url: 'https://controllertesting.com/favicon.svg',
    width: 512,
    height: 512
  },
  description: 'Browser-based controller diagnostic suite and hardware reliability research laboratory. Free gamepad tester for PS5, Xbox, Switch, and PC controllers.',
  foundingDate: '2025',
  sameAs: [
    'https://www.reddit.com/r/consolerepair'
  ],
  knowsAbout: [
    'Gamepad API',
    'Hardware Diagnostics',
    'Controller Drift',
    'Joy-Con Drift',
    'Stick Drift Detection',
    'Input Latency',
    'Polling Rate',
    'Controller Deadzone',
    'Stick Circularity',
    'Hall Effect Sticks',
    'PS5 DualSense',
    'Xbox Controller',
    'Nintendo Switch Controller'
  ],
  publishingPrinciples: 'https://controllertesting.com/test/methodology',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'support@controllertesting.com',
    contactType: 'customer support'
  }
};

// Collect all schemas
const schemas = [
  webSiteSchema,
  organizationSchema,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
  ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* ── Theme flash prevention ── */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ct-theme');
          var theme = t || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>

    {/* ── Token-gated Cloudflare Web Analytics ── */}
    {import.meta.env?.PUBLIC_CF_ANALYTICS_TOKEN && (
      <script
        type="text/partytown"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN}"}`}
      />
    )}

    {/* ── Core SEO ── */}
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && <meta http-equiv="content-language" content="en" />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    {/* ── Open Graph ── */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={ogImageWidth.toString()} />
    <meta property="og:image:height" content={ogImageHeight.toString()} />
    <meta property="og:site_name" content="ControllerTesting.com" />
    <meta property="og:locale" content="en_US" />

    {/* ── Twitter Card ── */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@controllertesting" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="application-name" content="ControllerTesting.com" />

    {/* ── Favicon & App Icons ── */}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="controllertesting" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#06060B" />

    {/* ── Google Search Console site verification (replace token when domain is live) ── */}
    {/* <meta name="google-site-verification" content="REPLACE_WITH_GSC_TOKEN" /> */}

    {/* ── Bing Webmaster Tools verification ── */}
    {/* <meta name="msvalidate.01" content="REPLACE_WITH_BING_TOKEN" /> */}

    {/* ── Fonts: Geist (self-hosted variable woff2 — zero third-party request) ── */}
    <link rel="preload" href="/fonts/geist-variable.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />
    <link rel="preload" href="/fonts/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin fetchpriority="low" />

    {/* ── Structured Data ── */}
    {schemas.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(schemas.length === 1 ? schemas[0] : schemas)} />
    )}

    {/* ── Performance hints ── */}
    {/* LCP hero image preload — reduces largest contentful paint on homepage */}
    {cleanPath === '/' && <link rel="preload" href="/images/controller-hero.jpg" as="image" type="image/jpeg" fetchpriority="high" />}

    {/* ── Google Consent Mode v2 defaults (required for AdSense EU compliance) ── */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Default: deny all until user consents (GDPR/ePrivacy compliant)
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });
      // Restore previous consent if stored
      try {
        var stored = localStorage.getItem('ct_cookie_consent');
        if (stored && stored.indexOf('accepted') !== -1) {
          gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted'
          });
        }
      } catch(e) {}
    </script>

    <slot name="head" />
  </head>
  <body>
    {/* ── Accessible Skip to Main Content Link (Vercel Guidelines) ── */}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[var(--color-accent)] focus:text-white focus:rounded-lg focus:shadow-xl font-semibold text-sm">
      Skip to main content
    </a>

    <slot />

    <GlobalSearch />
    <CookieConsent />

    {/* ── Scroll-reveal + global scripts ──
         Theme toggle intentionally lives ONLY in Header.astro
         (#theme-toggle + .theme-switch). A duplicate handler here caused
         a double-toggle bug (dark→light→dark per click) making the toggle
         appear broken. Do not re-add. */}
    <script is:inline>
      // High-performance compositor-only IntersectionObserver for [data-reveal]
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target); // Unobserve immediately to free GPU memory
            }
          });
        }, { rootMargin: '0px 0px -50px 0px', threshold: 0.1 });

        document.querySelectorAll('[data-reveal]').forEach(function(el) {
          revealObserver.observe(el);
        });
      } else {
        document.querySelectorAll('[data-reveal]').forEach(function(el) {
          el.classList.add('is-revealed');
        });
      }
    </script>
  </body>
</html>
