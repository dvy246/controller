---
export interface Props {
  featureKey: string;
}

const { featureKey } = Astro.props;
---

<div class="w-full max-w-4xl mx-auto p-4 sm:p-6 bg-surface-1/90 backdrop-blur-md rounded-2xl border border-surface-3 shadow-2xl">
  <!-- Header -->
  <div class="mb-6 pb-4 border-b border-surface-2 flex items-center justify-between">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        </svg>
        Binaural 3D Audio & Latency Engine
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Feature Mode: <span class="capitalize font-semibold text-blue-400">{featureKey.replace('-', ' ')}</span></p>
    </div>
  </div>

  <!-- Radar Container -->
  <div class="relative w-full aspect-square max-w-md mx-auto bg-slate-950 rounded-full border-2 border-surface-3 flex items-center justify-center overflow-hidden p-6 shadow-inner">
    <!-- Concentric Radar Rings -->
    <div class="absolute inset-4 rounded-full border border-blue-500/20"></div>
    <div class="absolute inset-16 rounded-full border border-blue-500/30"></div>
    <div class="absolute inset-28 rounded-full border border-blue-500/40"></div>

    <!-- Center User Marker -->
    <div class="relative z-10 w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center border-2 border-white shadow-lg shadow-blue-500/50">
      <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
    </div>

    <!-- Directional Target Button (Interactive Radar Node) -->
    <div id="radar-node" class="absolute w-8 h-8 bg-emerald-500 rounded-full border-2 border-white shadow-lg shadow-emerald-500/50 transition-all duration-300 flex items-center justify-center cursor-pointer" style="top: 20%; left: 70%;">
      <span class="w-2 h-2 bg-white rounded-full animate-ping"></span>
    </div>
  </div>

  <!-- Action Controls -->
  <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
    <button id="play-sound-btn" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/25 transition-all duration-200 cursor-pointer flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
      </svg>
      Play 3D Spatial Audio Pulse
    </button>
  </div>

  <!-- Latency / Spatial Feedback Card -->
  <div class="mt-6 p-4 bg-surface-2 rounded-xl border border-surface-3 text-center">
    <span class="text-xs text-slate-400 uppercase tracking-wider block mb-1">Measured Latency / Spatial Result</span>
    <span id="audio-result" class="text-base font-semibold text-emerald-400">Ready to test. Wear headphones for 3D binaural effect.</span>
  </div>
</div>

<script>
  let audioCtx: AudioContext | null = null;
  const playBtn = document.getElementById('play-sound-btn');
  const radarNode = document.getElementById('radar-node');
  const audioResult = document.getElementById('audio-result');

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
    }
  }

  function playSpatialPulse() {
    initAudio();
    if (!audioCtx) return;

    const osc = audioCtx.createOscillator();
    const panner = audioCtx.createStereoPanner ? audioCtx.createStereoPanner() : null;
    const gain = audioCtx.createGain();

    // Random panning between -1 (Left) and 1 (Right)
    const panVal = (Math.random() * 2) - 1;
    if (panner) panner.pan.value = panVal;

    osc.type = 'sine';
    osc.frequency.setValueAtTime(440, audioCtx.currentTime);

    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);

    if (panner) {
      osc.connect(panner);
      panner.connect(gain);
    } else {
      osc.connect(gain);
    }

    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime + 0.5);

    // Position radar node visually based on panVal
    if (radarNode) {
      const leftPercent = 50 + (panVal * 35);
      radarNode.style.left = `${leftPercent}%`;
    }

    if (audioResult) {
      audioResult.textContent = `Panned ${panVal < 0 ? 'Left' : 'Right'} (${Math.abs(Math.round(panVal * 100))}% offset). Audio latency: clean.`;
    }
  }

  playBtn?.addEventListener('click', playSpatialPulse);
</script>
