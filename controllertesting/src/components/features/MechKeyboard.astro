---
export interface Props {
  layoutKey: string;
}

const { layoutKey } = Astro.props;
---

<div class="w-full max-w-5xl mx-auto p-4 sm:p-6 bg-surface-1/90 backdrop-blur-md rounded-2xl border border-surface-3 shadow-2xl">
  <!-- Controls & Switch Sound Selector -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-surface-2">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 4v16m8-8H4" />
        </svg>
        Mechanical Keyboard & Anti-Ghosting Matrix
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Layout: <span class="capitalize font-semibold text-blue-400">{layoutKey.replace('-', ' ')}</span></p>
    </div>

    <!-- Switch Type Selector -->
    <div class="flex items-center gap-2 text-xs">
      <span class="text-slate-400">Switch Sound:</span>
      <select id="switch-sound-select" class="bg-slate-950 border border-surface-3 rounded-lg px-3 py-1.5 text-slate-200 font-semibold focus:border-blue-500 focus:outline-none cursor-pointer">
        <option value="blue">Clicky (Blue Switch)</option>
        <option value="red">Linear (Red Switch)</option>
        <option value="brown">Tactile (Brown Switch)</option>
      </select>
    </div>
  </div>

  <!-- Telemetry Badge Bar -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 bg-slate-950 p-4 rounded-xl border border-surface-3 font-mono text-sm">
    <div class="flex items-center gap-6">
      <div>
        <span class="text-slate-400 text-xs block">ACTIVE KEYS</span>
        <span id="active-keys-count" class="text-emerald-400 font-bold text-lg">0</span>
      </div>
      <div>
        <span class="text-slate-400 text-xs block">MAX ROLLOVER (NKRO)</span>
        <span id="max-nkro-count" class="text-blue-400 font-bold text-lg">0 Keys</span>
      </div>
      <div>
        <span class="text-slate-400 text-xs block">LAST KEY PRESSED</span>
        <span id="last-key-pressed" class="text-amber-400 font-bold text-lg">None</span>
      </div>
    </div>
  </div>

  <!-- 3D Styled Keyboard Grid Container -->
  <div class="bg-slate-950 p-4 sm:p-6 rounded-xl border border-surface-3 overflow-x-auto">
    <div class="min-w-[650px] grid grid-cols-12 gap-1.5" id="keyboard-grid">
      <!-- Keys generated by JS -->
    </div>
  </div>
</div>

<script>
  let activeKeys = new Set<string>();
  let maxNKRO = 0;
  let audioCtx: AudioContext | null = null;

  const keyList = [
    'Escape', 'F1', 'F2', 'F3', 'F4', 'F5', 'F6', 'F7', 'F8', 'F9', 'F10', 'F11',
    'Backquote', 'Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5', 'Digit6', 'Digit7', 'Digit8', 'Digit9', 'Digit0', 'Minus',
    'Tab', 'KeyQ', 'KeyW', 'KeyE', 'KeyR', 'KeyT', 'KeyY', 'KeyU', 'KeyI', 'KeyO', 'KeyP', 'Backspace',
    'CapsLock', 'KeyA', 'KeyS', 'KeyD', 'KeyF', 'KeyG', 'KeyH', 'KeyJ', 'KeyK', 'KeyL', 'Semicolon', 'Enter',
    'ShiftLeft', 'KeyZ', 'KeyX', 'KeyC', 'KeyV', 'KeyB', 'KeyN', 'KeyM', 'Comma', 'Period', 'Slash', 'ShiftRight',
    'ControlLeft', 'AltLeft', 'Space', 'AltRight', 'ControlRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown', 'ArrowRight'
  ];

  const grid = document.getElementById('keyboard-grid');
  const activeCountEl = document.getElementById('active-keys-count');
  const maxNkroEl = document.getElementById('max-nkro-count');
  const lastKeyEl = document.getElementById('last-key-pressed');
  const soundSelect = document.getElementById('switch-sound-select') as HTMLSelectElement;

  function initAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
  }

  function playKeySound() {
    initAudio();
    if (!audioCtx) return;

    const soundType = soundSelect?.value || 'blue';
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type = soundType === 'blue' ? 'square' : soundType === 'red' ? 'sine' : 'triangle';
    osc.frequency.setValueAtTime(soundType === 'blue' ? 800 : 400, audioCtx.currentTime);

    gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start();
    osc.stop(audioCtx.currentTime + 0.08);
  }

  function renderGrid() {
    if (!grid) return;
    grid.innerHTML = '';

    keyList.forEach(code => {
      const keyEl = document.createElement('div');
      keyEl.id = `key-${code}`;
      keyEl.className = 'h-10 bg-surface-2 border border-surface-3 rounded flex items-center justify-center text-xs font-mono text-slate-300 font-semibold transition-all duration-100 select-none';
      keyEl.textContent = code.replace('Key', '').replace('Digit', '');
      grid.appendChild(keyEl);
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.repeat) return;
    activeKeys.add(e.code);
    playKeySound();

    if (activeKeys.size > maxNKRO) maxNKRO = activeKeys.size;

    const keyEl = document.getElementById(`key-${e.code}`);
    if (keyEl) {
      keyEl.classList.remove('bg-surface-2', 'text-slate-300');
      keyEl.classList.add('bg-blue-600', 'text-white', 'border-blue-400', 'shadow-md', 'shadow-blue-500/50', 'scale-95');
    }

    if (activeCountEl) activeCountEl.textContent = activeKeys.size.toString();
    if (maxNkroEl) maxNkroEl.textContent = `${maxNKRO} Keys`;
    if (lastKeyEl) lastKeyEl.textContent = e.code.replace('Key', '');
  });

  window.addEventListener('keyup', (e) => {
    activeKeys.delete(e.code);

    const keyEl = document.getElementById(`key-${e.code}`);
    if (keyEl) {
      keyEl.classList.remove('bg-blue-600', 'text-white', 'border-blue-400', 'shadow-md', 'shadow-blue-500/50', 'scale-95');
      keyEl.classList.add('bg-emerald-600/40', 'text-emerald-300'); // Highlight tested keys in subtle green
    }

    if (activeCountEl) activeCountEl.textContent = activeKeys.size.toString();
  });

  renderGrid();
</script>
