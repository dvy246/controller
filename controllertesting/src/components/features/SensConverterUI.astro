---
import gamesData from '../../data/gameEngineConstants.json';

export interface Props {
  fromGameKey: string;
  toGameKey: string;
}

const { fromGameKey, toGameKey } = Astro.props;
const games = gamesData as Record<string, { name: string; yaw: number; defaultFov: number }>;

const fromGame = games[fromGameKey] || games['valorant'];
const toGame = games[toGameKey] || games['counter-strike-2'];
---

<div class="w-full max-w-4xl mx-auto bg-surface-1/90 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-surface-3 shadow-2xl">
  <!-- Header -->
  <div class="mb-8 border-b border-surface-2 pb-4 flex items-center justify-between">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        360° Sensitivity & Distance Math Engine
      </h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Convert mouse & controller sensitivity with 100% 1:1 cm/360° motor memory match.</p>
    </div>
  </div>

  <!-- Calculator Inputs -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <!-- From Game Card -->
    <div class="bg-surface-2 p-5 rounded-xl border border-surface-3">
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">SOURCE GAME</label>
      <div class="text-lg font-bold text-blue-400 mb-4">{fromGame.name}</div>

      <div class="space-y-4">
        <div>
          <label for="input-sens" class="block text-xs text-slate-300 mb-1">In-Game Sensitivity</label>
          <input type="number" id="input-sens" value="1.0" step="0.01" min="0.01" class="w-full bg-slate-950 border border-surface-3 rounded-lg px-3 py-2 text-white font-mono focus:border-blue-500 focus:outline-none transition-colors" />
        </div>

        <div>
          <label for="input-dpi" class="block text-xs text-slate-300 mb-1">Mouse / Hardware DPI</label>
          <input type="number" id="input-dpi" value="800" step="50" min="100" class="w-full bg-slate-950 border border-surface-3 rounded-lg px-3 py-2 text-white font-mono focus:border-blue-500 focus:outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- To Game Card (Output) -->
    <div class="bg-surface-2 p-5 rounded-xl border border-blue-500/30 bg-blue-950/10">
      <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">TARGET GAME</label>
      <div class="text-lg font-bold text-emerald-400 mb-4">{toGame.name}</div>

      <div class="space-y-4">
        <div>
          <span class="block text-xs text-slate-300 mb-1">Converted Sensitivity</span>
          <div id="output-sens" class="w-full bg-slate-950 border border-emerald-500/40 rounded-lg px-3 py-2 text-emerald-400 font-mono font-bold text-xl">
            0.00
          </div>
        </div>

        <div>
          <span class="block text-xs text-slate-300 mb-1">360° Turn Distance</span>
          <div id="output-cm" class="w-full bg-slate-950 border border-surface-3 rounded-lg px-3 py-2 text-slate-200 font-mono text-sm">
            0.0 cm / 0.0 inches
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Visualizer -->
  <div class="bg-slate-950 p-6 rounded-xl border border-surface-3 text-center">
    <span class="text-xs text-slate-400 uppercase tracking-wider block mb-3">360° Rotation Distance Visualizer</span>
    <div class="relative w-full h-8 bg-surface-2 rounded-full overflow-hidden border border-surface-3 flex items-center px-2">
      <div id="distance-bar" class="h-4 bg-gradient-to-r from-blue-500 to-emerald-400 rounded-full transition-all duration-300" style="width: 50%;"></div>
    </div>
    <p class="text-xs text-slate-400 mt-2" id="visual-desc">Calculated distance for a full 360-degree rotation.</p>
  </div>
</div>

<script define:vars={{ fromYaw: fromGame.yaw, toYaw: toGame.yaw }}>
  const inputSens = document.getElementById('input-sens');
  const inputDpi = document.getElementById('input-dpi');
  const outputSens = document.getElementById('output-sens');
  const outputCm = document.getElementById('output-cm');
  const distanceBar = document.getElementById('distance-bar');

  function calculate() {
    const sens = parseFloat(inputSens?.value || '1.0');
    const dpi = parseFloat(inputDpi?.value || '800');

    if (isNaN(sens) || isNaN(dpi) || sens <= 0 || dpi <= 0) return;

    // Calculate 360 distance in inches
    // 360 distance (inches) = 360 / (sens * dpi * yaw)
    const distanceInches = 360 / (sens * dpi * fromYaw);
    const distanceCm = distanceInches * 2.54;

    // Target converted sensitivity
    const targetSens = 360 / (distanceInches * dpi * toYaw);

    if (outputSens) outputSens.textContent = targetSens.toFixed(3);
    if (outputCm) outputCm.textContent = `${distanceCm.toFixed(1)} cm / ${distanceInches.toFixed(1)} inches`;

    // Scale visual bar relative to average (approx 30cm)
    if (distanceBar) {
      const percentage = Math.min(Math.max((distanceCm / 60) * 100, 10), 100);
      distanceBar.style.width = `${percentage}%`;
    }
  }

  inputSens?.addEventListener('input', calculate);
  inputDpi?.addEventListener('input', calculate);

  calculate();
</script>
