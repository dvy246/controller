---
/**
 * InterpretationCard.astro — Evidence Interpretation Protocol UI
 *
 * THE differentiating component. Every competitor shows a raw number.
 * This card shows: what the number means, how it compares, how confident
 * the measurement is, and what to do next.
 *
 * Design rules (from frontend-design + web-interface-guidelines):
 * - Structure encodes information: 5 sections map to 5 interpretation layers
 * - font-variant-numeric: tabular-nums on all data columns
 * - Verdict colors use existing design tokens (pass/warning/fail)
 * - aria-live="polite" on dynamic verdict updates
 * - prefers-reduced-motion respected on reveal animation
 * - No transition: all — explicit transform + opacity only
 * - Semantic HTML: details/summary for limitations accordion
 */
---

<!-- Container rendered client-side by tool scripts. This template defines
     the static structure; JS fills it via data attributes. -->
<div
  class="interpretation-card"
  id="interpretation-card"
  role="region"
  aria-label="Test interpretation"
  aria-live="polite"
  data-reveal
  style="display: none;"
>
  <!-- ── 1. Measurement + Verdict Header ── -->
  <div class="interp-header">
    <div class="interp-measurement">
      <span class="interp-label" id="interp-metric-label">Stick Drift</span>
      <div class="interp-value-row">
        <span class="interp-value" id="interp-metric-value">0.00</span>
        <span class="interp-unit" id="interp-metric-unit">%</span>
      </div>
    </div>
    <div class="interp-verdict-badge" id="interp-verdict-badge" data-verdict="normal">
      <span class="interp-verdict-dot" aria-hidden="true"></span>
      <span class="interp-verdict-text" id="interp-verdict-text">Normal</span>
    </div>
  </div>

  <!-- ── 2. Interpretation Explanation ── -->
  <p class="interp-explanation" id="interp-explanation">
    Within normal variance.
  </p>

  <!-- ── 3. Model Comparison Bar ── -->
  <div class="interp-comparison" id="interp-comparison" style="display: none;">
    <div class="interp-comparison-header">
      <span class="interp-comparison-label">
        Compared to <strong id="interp-model-name">—</strong>
      </span>
      <span class="interp-sample-count" id="interp-sample-count">
        N=0
      </span>
    </div>
    <div class="interp-percentile-bar" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
      <div class="interp-percentile-fill" id="interp-percentile-fill" style="width: 50%;"></div>
      <span class="interp-percentile-marker" id="interp-percentile-marker" style="left: 50%;">
        <span class="interp-percentile-label" id="interp-percentile-label">Better than 50%</span>
      </span>
    </div>
    <p class="interp-dataset-date" id="interp-dataset-date">
      Dataset: —
    </p>
  </div>

  <!-- ── 4. Confidence Factors ── -->
  <div class="interp-confidence">
    <div class="interp-confidence-header">
      <span class="interp-confidence-badge" id="interp-confidence-badge" data-level="medium">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M12 16v-4M12 8h.01"/></svg>
        <span id="interp-confidence-text">Medium confidence</span>
      </span>
    </div>
    <ul class="interp-factors" id="interp-factors">
      <li>Controller model identified from device data</li>
    </ul>
    <p class="interp-improve" id="interp-improve">
      For higher confidence: use USB, keep sticks untouched for 30+ seconds.
    </p>
  </div>

  <!-- ── 5. What this test cannot prove (collapsed by default) ── -->
  <details class="interp-limitations">
    <summary class="interp-limitations-toggle">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 9v4m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
      What this test cannot prove
    </summary>
    <ul class="interp-limitations-list" id="interp-limitations-list">
      <li>Browser Gamepad API reads the OS-level driver output, not raw hardware.</li>
    </ul>
  </details>

  <!-- ── 6. Next Steps ── -->
  <div class="interp-next-steps" id="interp-next-steps">
    <!-- Populated by JS -->
  </div>
</div>

<style>
  /* ══════════════════════════════════════════════════════════════
     InterpretationCard — uses existing design system tokens.
     Structure IS the design: 5 sections for 5 interpretation layers.
     ══════════════════════════════════════════════════════════════ */

  .interpretation-card {
    margin-top: var(--space-6);
    padding: var(--space-6);
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    font-family: var(--font-sans);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--duration-slow) var(--ease-spring),
                transform var(--duration-slow) var(--ease-spring);
  }

  .interpretation-card[style*="display: block"],
  .interpretation-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .interpretation-card {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }

  /* ── 1. Header: Measurement + Verdict ── */
  .interp-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .interp-label {
    font-size: var(--text-micro);
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .interp-value-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .interp-value {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--color-text-primary);
  }

  .interp-unit {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-tertiary);
  }

  .interp-verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .interp-verdict-badge[data-verdict="normal"] {
    background: var(--color-pass-bg);
    color: var(--color-pass);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .interp-verdict-badge[data-verdict="watch"] {
    background: var(--color-warning-bg);
    color: var(--color-warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .interp-verdict-badge[data-verdict="action-needed"] {
    background: var(--color-fail-bg);
    color: var(--color-fail);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .interp-verdict-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  /* ── 2. Explanation ── */
  .interp-explanation {
    font-size: var(--text-body);
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
    max-width: 65ch;
  }

  /* ── 3. Comparison Bar ── */
  .interp-comparison {
    padding: var(--space-4);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-5);
  }

  .interp-comparison-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .interp-comparison-label {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .interp-comparison-label strong {
    color: var(--color-text-primary);
  }

  .interp-sample-count {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .interp-percentile-bar {
    position: relative;
    height: 6px;
    background: var(--color-surface-3);
    border-radius: var(--radius-pill);
    overflow: visible;
    margin-bottom: var(--space-6);
  }

  .interp-percentile-fill {
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-accent), var(--color-pass));
    transition: width var(--duration-slow) var(--ease-spring);
  }

  @media (prefers-reduced-motion: reduce) {
    .interp-percentile-fill {
      transition: none;
    }
  }

  .interp-percentile-marker {
    position: absolute;
    top: 12px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: left var(--duration-slow) var(--ease-spring);
  }

  @media (prefers-reduced-motion: reduce) {
    .interp-percentile-marker {
      transition: none;
    }
  }

  .interp-percentile-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .interp-dataset-date {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    text-align: right;
  }

  /* ── 4. Confidence ── */
  .interp-confidence {
    margin-bottom: var(--space-5);
  }

  .interp-confidence-header {
    margin-bottom: var(--space-2);
  }

  .interp-confidence-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .interp-confidence-badge[data-level="high"] {
    color: var(--color-pass);
  }

  .interp-confidence-badge[data-level="medium"] {
    color: var(--color-warning);
  }

  .interp-confidence-badge[data-level="low"] {
    color: var(--color-fail);
  }

  .interp-factors {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2) 0;
  }

  .interp-factors li {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding: var(--space-1) 0;
    padding-left: var(--space-4);
    position: relative;
  }

  .interp-factors li::before {
    content: "›";
    position: absolute;
    left: var(--space-1);
    color: var(--color-text-tertiary);
    font-weight: 700;
  }

  .interp-improve {
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
    font-style: italic;
  }

  /* ── 5. Limitations Accordion ── */
  .interp-limitations {
    margin-bottom: var(--space-5);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .interp-limitations-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    user-select: none;
    background: rgba(255, 255, 255, 0.02);
    list-style: none;
  }

  .interp-limitations-toggle::-webkit-details-marker {
    display: none;
  }

  .interp-limitations-toggle:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .interp-limitations-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .interp-limitations-list {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
    margin: 0;
    list-style: none;
  }

  .interp-limitations-list li {
    font-size: var(--text-small);
    color: var(--color-text-tertiary);
    line-height: 1.6;
    padding: var(--space-1) 0;
    padding-left: var(--space-4);
    position: relative;
  }

  .interp-limitations-list li::before {
    content: "⚠";
    position: absolute;
    left: 0;
    font-size: 11px;
    opacity: 0.6;
  }

  /* ── 6. Next Steps ── */
  .interp-next-steps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .interp-next-steps a,
  .interp-next-steps button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    font-weight: 600;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    border: none;
    transition: background var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  .interp-next-steps a:focus-visible,
  .interp-next-steps button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .interp-step-primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .interp-step-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-text-inverse) !important;
  }

  .interp-step-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-subtle) !important;
  }

  .interp-step-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-text-primary) !important;
  }

  /* ── Light theme overrides ── */
  [data-theme="light"] .interpretation-card {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.08);
  }

  [data-theme="light"] .interp-comparison {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.06);
  }

  [data-theme="light"] .interp-limitations-toggle {
    background: rgba(0, 0, 0, 0.02);
  }

  [data-theme="light"] .interp-limitations-toggle:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  [data-theme="light"] .interp-step-secondary {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.1) !important;
    color: #27272a;
  }

  [data-theme="light"] .interp-step-secondary:hover {
    background: rgba(0, 0, 0, 0.07);
    color: #09090b !important;
  }
</style>
