---
export interface Props {
  device: string;
  game: string;
}

const { device, game } = Astro.props;
---

<div class="w-full max-w-5xl mx-auto p-4 sm:p-6 bg-surface-1/80 backdrop-blur-md rounded-2xl border border-surface-3 shadow-2xl">
  <!-- Controls Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-surface-2">
    <div>
      <h2 class="text-xl font-bold text-slate-100 flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v3m0 12v3M3 12h3m12 0h3" />
        </svg>
        Target Practice & Input Precision
      </h2>
      <p class="text-xs text-slate-400 mt-1">Profile: <span class="capitalize font-semibold text-blue-400">{device}</span> • Engine: <span class="capitalize font-semibold text-blue-400">{game.replace('-', ' ')}</span></p>
    </div>

    <!-- Stats Bar -->
    <div class="flex items-center gap-4 text-sm font-mono">
      <div class="bg-surface-2 px-3 py-1.5 rounded-lg border border-surface-3">
        <span class="text-slate-400 text-xs block">SCORE</span>
        <span id="score-val" class="text-emerald-400 font-bold text-lg">0</span>
      </div>
      <div class="bg-surface-2 px-3 py-1.5 rounded-lg border border-surface-3">
        <span class="text-slate-400 text-xs block">ACCURACY</span>
        <span id="accuracy-val" class="text-blue-400 font-bold text-lg">100%</span>
      </div>
      <div class="bg-surface-2 px-3 py-1.5 rounded-lg border border-surface-3">
        <span class="text-slate-400 text-xs block">TIME LEFT</span>
        <span id="timer-val" class="text-amber-400 font-bold text-lg">30s</span>
      </div>
    </div>
  </div>

  <!-- Main Canvas Container -->
  <div class="relative w-full aspect-video bg-slate-950 rounded-xl overflow-hidden border border-surface-3 cursor-crosshair group">
    <canvas id="aim-canvas" class="w-full h-full block"></canvas>
    
    <!-- Start Overlay -->
    <div id="start-overlay" class="absolute inset-0 bg-slate-950/80 backdrop-blur-sm flex flex-col items-center justify-center p-6 text-center transition-opacity duration-300">
      <h3 class="text-2xl font-bold text-white mb-2">Ready to Test Your Aim?</h3>
      <p class="text-sm text-slate-300 max-w-md mb-6">
        Click targets as fast as possible. If using a controller, stick input will control the crosshair position.
      </p>
      <button id="start-btn" class="btn-primary shadow-lg">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3" />
        </svg>
        Start 30-Second Challenge
      </button>
    </div>
  </div>

  <!-- Post Game Analysis -->
  <div id="result-card" class="hidden mt-6 p-4 bg-surface-2 rounded-xl border border-surface-3 animate-fade-in">
    <h3 class="text-lg font-semibold text-slate-100 mb-2">Performance & Hardware Analysis</h3>
    <p class="text-sm text-slate-300" id="result-desc">
      Analyzing target acquisition speed, tracking error, and micro-adjustment performance...
    </p>
  </div>
</div>

<script>
  let score = 0;
  let totalClicks = 0;
  let targetHits = 0;
  let timeLeft = 30;
  let isRunning = false;
  let timerId: number | null = null;

  const canvas = document.getElementById('aim-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const startBtn = document.getElementById('start-btn');
  const startOverlay = document.getElementById('start-overlay');
  const scoreVal = document.getElementById('score-val');
  const accuracyVal = document.getElementById('accuracy-val');
  const timerVal = document.getElementById('timer-val');
  const resultCard = document.getElementById('result-card');
  const resultDesc = document.getElementById('result-desc');

  let target = { x: 0, y: 0, r: 25 };

  let logicalW = 800;
  let logicalH = 450;

  function resizeCanvas() {
    if (!canvas) return;
    logicalW = canvas.parentElement?.clientWidth || 800;
    logicalH = canvas.parentElement?.clientHeight || 450;
    // High-DPI backing store (CSS size × dpr, capped at 2)
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = logicalW * dpr;
    canvas.height = logicalH * dpr;
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function spawnTarget() {
    if (!canvas) return;
    const padding = 50;
    target.x = padding + Math.random() * (logicalW - padding * 2);
    target.y = padding + Math.random() * (logicalH - padding * 2);
  }

  function draw() {
    if (!ctx || !canvas) return;
    ctx.clearRect(0, 0, logicalW, logicalH);

    if (isRunning) {
      // Draw grid background
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      const gridSize = 40;
      for (let x = 0; x < logicalW; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, logicalH);
        ctx.stroke();
      }
      for (let y = 0; y < logicalH; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(logicalW, y);
        ctx.stroke();
      }

      // Draw Target
      ctx.beginPath();
      ctx.arc(target.x, target.y, target.r, 0, Math.PI * 2);
      ctx.fillStyle = '#2563EB';
      ctx.fill();
      ctx.lineWidth = 3;
      ctx.strokeStyle = '#60A5FA';
      ctx.stroke();

      // Inner Ring
      ctx.beginPath();
      ctx.arc(target.x, target.y, target.r * 0.5, 0, Math.PI * 2);
      ctx.fillStyle = '#EF4444';
      ctx.fill();

      // Center Dot
      ctx.beginPath();
      ctx.arc(target.x, target.y, 4, 0, Math.PI * 2);
      ctx.fillStyle = '#FFFFFF';
      ctx.fill();
    }

    requestAnimationFrame(draw);
  }

  function updateStats() {
    if (scoreVal) scoreVal.textContent = score.toString();
    if (accuracyVal) {
      const acc = totalClicks > 0 ? Math.round((targetHits / totalClicks) * 100) : 100;
      accuracyVal.textContent = `${acc}%`;
    }
    if (timerVal) timerVal.textContent = `${timeLeft}s`;
  }

  function startGame() {
    score = 0;
    totalClicks = 0;
    targetHits = 0;
    timeLeft = 30;
    isRunning = true;
    if (startOverlay) startOverlay.style.opacity = '0';
    setTimeout(() => { if (startOverlay) startOverlay.style.display = 'none'; }, 300);
    if (resultCard) resultCard.classList.add('hidden');

    spawnTarget();
    updateStats();

    timerId = window.setInterval(() => {
      timeLeft--;
      updateStats();
      if (timeLeft <= 0) {
        endGame();
      }
    }, 1000);
  }

  function endGame() {
    isRunning = false;
    if (timerId !== null) window.clearInterval(timerId);
    timerId = null;
    if (startOverlay) {
      startOverlay.style.display = 'flex';
      setTimeout(() => { startOverlay.style.opacity = '1'; }, 10);
    }

    const accuracy = totalClicks > 0 ? Math.round((targetHits / totalClicks) * 100) : 0;

    if (resultCard && resultDesc) {
      resultCard.classList.remove('hidden');
      resultDesc.innerHTML = `You scored <strong>${score}</strong> points with <strong>${accuracy}% accuracy</strong>. ${
        accuracy < 85 
          ? 'Consider adjusting your inner deadzone or lowering your stick sensitivity for higher precision.' 
          : 'Outstanding responsiveness and precision tracking!'
      }`;
    }
  }

  canvas?.addEventListener('click', (e) => {
    if (!isRunning || !canvas) return;
    const rect = canvas.getBoundingClientRect();
    const clickX = (e.clientX - rect.left) * (logicalW / rect.width);
    const clickY = (e.clientY - rect.top) * (logicalH / rect.height);

    totalClicks++;
    const dist = Math.hypot(clickX - target.x, clickY - target.y);

    if (dist <= target.r) {
      targetHits++;
      score += 100;
      spawnTarget();
    }
    updateStats();
  });

  startBtn?.addEventListener('click', startGame);

  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();
  requestAnimationFrame(draw);
</script>
