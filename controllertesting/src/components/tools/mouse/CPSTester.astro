---
/**
 * CPSTester.astro — Interactive Clicks Per Second (CPS) Speed Tester
 * Timed 1s, 5s, 10s, 30s click speed counter with real-time CPS graph and peak score.
 */
---

<div class="cps-tester" id="cps-root">
  <div class="cps-header-card">
    <div class="cps-timer-selector" role="group" aria-label="CPS Test Duration">
      <button type="button" class="btn-time active" data-time="5">5 Seconds</button>
      <button type="button" class="btn-time" data-time="10">10 Seconds</button>
      <button type="button" class="btn-time" data-time="30">30 Seconds</button>
    </div>
    <div class="cps-live-stats">
      <span class="stat-label">TIME REMAINING: <strong class="mono" id="cps-time-rem">5.0s</strong></span>
      <span class="stat-label">TOTAL CLICKS: <strong class="mono" id="cps-total-clicks">0</strong></span>
    </div>
  </div>

  <div class="cps-click-target" id="cps-target">
    <span class="cps-target-title" id="cps-target-title">CLICK HERE TO START TEST</span>
    <span class="cps-target-score text-gradient" id="cps-score-display">0.0 CPS</span>
  </div>

  <div class="cps-results-row">
    <div class="cps-res-box">
      <span class="res-label">LAST CPS</span>
      <span class="res-val mono" id="cps-last-val">0.0</span>
    </div>
    <div class="cps-res-box">
      <span class="res-label">PEAK CPS</span>
      <span class="res-val mono" id="cps-peak-val">0.0</span>
    </div>
    <div class="cps-res-box">
      <span class="res-label">RATING</span>
      <span class="res-val badge-pass" id="cps-rating-val">Awaiting Test</span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let testDuration = 5;
    let isRunning = false;
    let clickCount = 0;
    let startTime = 0;
    let timerId: number | null = null;
    let peakCPS = 0;

    const target = document.getElementById('cps-target');
    const title = document.getElementById('cps-target-title');
    const scoreDisplay = document.getElementById('cps-score-display');
    const timeRem = document.getElementById('cps-time-rem');
    const totalClicksEl = document.getElementById('cps-total-clicks');
    const lastVal = document.getElementById('cps-last-val');
    const peakVal = document.getElementById('cps-peak-val');
    const ratingVal = document.getElementById('cps-rating-val');

    // Duration buttons
    document.querySelectorAll('.btn-time').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        if (isRunning) return;
        document.querySelectorAll('.btn-time').forEach((b) => b.classList.remove('active'));
        (e.target as HTMLElement).classList.add('active');
        testDuration = parseInt((e.target as HTMLElement).getAttribute('data-time') || '5', 10);
        if (timeRem) timeRem.textContent = `${testDuration}.0s`;
      });
    });

    function finishTest() {
      isRunning = false;
      if (timerId) clearInterval(timerId);

      const finalCPS = parseFloat((clickCount / testDuration).toFixed(1));
      if (finalCPS > peakCPS) peakCPS = finalCPS;

      if (title) title.textContent = 'TEST COMPLETE! CLICK TO RETRY';
      if (scoreDisplay) scoreDisplay.textContent = `${finalCPS} CPS`;
      if (lastVal) lastVal.textContent = String(finalCPS);
      if (peakVal) peakVal.textContent = String(peakCPS);

      if (ratingVal) {
        if (finalCPS >= 12) { ratingVal.textContent = 'Godlike (ButterFly/Jitter)'; ratingVal.className = 'res-val badge-pass'; }
        else if (finalCPS >= 8) { ratingVal.textContent = 'Fast Gamer'; ratingVal.className = 'res-val badge-pass'; }
        else if (finalCPS >= 5) { ratingVal.textContent = 'Average'; ratingVal.className = 'res-val badge-warning'; }
        else { ratingVal.textContent = 'Casual'; ratingVal.className = 'res-val badge-warning'; }
      }
    }

    target?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      if (!isRunning) {
        isRunning = true;
        clickCount = 1;
        startTime = performance.now();
        if (title) title.textContent = 'CLICK AS FAST AS YOU CAN!';

        timerId = window.setInterval(() => {
          const elapsed = (performance.now() - startTime) / 1000;
          const rem = Math.max(0, testDuration - elapsed);
          if (timeRem) timeRem.textContent = `${rem.toFixed(1)}s`;
          const currentCPS = (clickCount / Math.max(0.1, elapsed)).toFixed(1);
          if (scoreDisplay) scoreDisplay.textContent = `${currentCPS} CPS`;

          if (rem <= 0) {
            finishTest();
          }
        }, 50);
      } else {
        clickCount++;
        if (totalClicksEl) totalClicksEl.textContent = String(clickCount);
      }
    });
  });
</script>

<style>
  .cps-tester { display: flex; flex-direction: column; gap: 1.5rem; }
  .cps-header-card { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); flex-wrap: wrap; gap: 1rem; }
  .cps-timer-selector { display: flex; gap: 0.5rem; }
  .btn-time { padding: 0.4rem 0.875rem; background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); color: var(--color-text-secondary); font-size: var(--text-small); font-weight: 600; cursor: pointer; }
  .btn-time.active { background: var(--color-accent); color: white; border-color: var(--color-accent); }
  .cps-live-stats { display: flex; gap: 1.5rem; font-size: var(--text-small); color: var(--color-text-secondary); }
  .cps-click-target { height: 260px; background: var(--color-surface-2); border: 2px dashed var(--color-accent); border-radius: var(--radius-card); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; cursor: pointer; user-select: none; transition: background 0.15s, border-color 0.15s; }
  .cps-click-target:active { background: rgba(37, 99, 235, 0.1); border-style: solid; }
  .cps-target-title { font-size: 1.25rem; font-weight: 800; color: var(--color-text-primary); letter-spacing: -0.01em; }
  .cps-target-score { font-family: var(--font-mono); font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; line-height: 1; }
  .cps-results-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cps-res-box { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.375rem; text-align: center; }
  .res-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .res-val { font-size: 1.75rem; font-weight: 700; }
  @media (max-width: 768px) { .cps-results-row { grid-template-columns: 1fr; } }
</style>
