---
/**
 * MousePollingTester.astro — Real-time Mouse Polling Rate (Hz) & Frequency Tester
 * Measures mouse USB report frequency up to 8000Hz (8kHz) using High-Resolution Timestamps.
 */
---

<div class="m-polling-tester" id="mpoll-root">
  <div class="mpoll-target" id="mpoll-target-area">
    <span class="mpoll-title">MOVE MOUSE RAPIDLY INSIDE THIS BOX</span>
    <span class="mpoll-hz text-gradient" id="mpoll-hz-display" aria-live="polite">0 Hz</span>
    <span class="mpoll-sub" id="mpoll-ms-display">0.00 ms update interval</span>
  </div>

  <div class="mpoll-stats">
    <div class="mpoll-card">
      <span class="m-label">AVERAGE HZ</span>
      <span class="m-val mono" id="mpoll-avg-hz">0 Hz</span>
    </div>
    <div class="mpoll-card">
      <span class="m-label">MAX PEAK HZ</span>
      <span class="m-val mono" id="mpoll-max-hz">0 Hz</span>
    </div>
    <div class="mpoll-card">
      <span class="m-label">RATING</span>
      <span class="m-val badge-pass" id="mpoll-rating" aria-live="polite">Move Mouse</span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    let lastTime = performance.now();
    let samples: number[] = [];
    let maxHz = 0;

    const target = document.getElementById('mpoll-target-area');
    const hzDisplay = document.getElementById('mpoll-hz-display');
    const msDisplay = document.getElementById('mpoll-ms-display');
    const avgHzEl = document.getElementById('mpoll-avg-hz');
    const maxHzEl = document.getElementById('mpoll-max-hz');
    const ratingEl = document.getElementById('mpoll-rating');

    target?.addEventListener('mousemove', (e) => {
      const now = performance.now();
      const delta = now - lastTime;
      lastTime = now;

      if (delta > 0 && delta < 50) {
        samples.push(delta);
        if (samples.length > 50) samples.shift();

        const avgDelta = samples.reduce((a, b) => a + b, 0) / samples.length;
        const currentHz = Math.round(1000 / avgDelta);

        if (currentHz > maxHz && currentHz <= 8500) {
          maxHz = currentHz;
        }

        if (hzDisplay) hzDisplay.textContent = `${currentHz} Hz`;
        if (msDisplay) msDisplay.textContent = `${avgDelta.toFixed(2)} ms update interval`;
        if (avgHzEl) avgHzEl.textContent = `${Math.round(1000 / avgDelta)} Hz`;
        if (maxHzEl) maxHzEl.textContent = `${maxHz} Hz`;

        if (ratingEl) {
          if (maxHz >= 3500) ratingEl.textContent = '8KHz HyperSpeed (8000Hz)';
          else if (maxHz >= 1800) ratingEl.textContent = '4KHz High Speed (4000Hz)';
          else if (maxHz >= 800) ratingEl.textContent = 'Standard Esports (1000Hz)';
          else if (maxHz >= 400) ratingEl.textContent = 'Medium (500Hz)';
          else ratingEl.textContent = 'Basic (125Hz)';
        }
      }
    });
  });
</script>

<style>
  .m-polling-tester { display: flex; flex-direction: column; gap: 1.5rem; }
  .mpoll-target { height: 260px; background: var(--color-surface-2); border: 2px dashed var(--color-accent); border-radius: var(--radius-card); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; cursor: crosshair; user-select: none; }
  .mpoll-title { font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); letter-spacing: -0.01em; }
  .mpoll-hz { font-family: var(--font-mono); font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
  .mpoll-sub { font-size: var(--text-small); color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  .mpoll-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .mpoll-card { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.25rem; display: flex; flex-direction: column; align-items: center; gap: 0.375rem; text-align: center; }
  .m-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .m-val { font-size: 1.75rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  @media (max-width: 768px) { .mpoll-stats { grid-template-columns: 1fr; } }
</style>
