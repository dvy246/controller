---
/**
 * DoubleClickTester.astro — Mouse Double-Click Fault & Switch Bounce Detector
 * Detects hardware switch chatter where a single physical click registers as two rapid electrical signals (< 80ms interval).
 */
---

<div class="dc-tester" id="dc-root">
  <div class="dc-hero-card">
    <div class="dc-target-box" id="dc-click-target">
      <span class="dc-title">CLICK HERE REPEATEDLY (SINGLE CLICKS ONLY)</span>
      <span class="dc-status-text text-gradient" id="dc-status-msg">No Faults Detected</span>
      <span class="dc-sub">Single-click 50–100 times to test mechanical switch debounce integrity.</span>
    </div>

    <div class="dc-stats-row">
      <div class="dc-stat">
        <span class="m-label">TOTAL TEST CLICKS</span>
        <span class="m-val mono" id="dc-total-count">0</span>
      </div>
      <div class="dc-stat">
        <span class="m-label">DOUBLE-CLICK FAULTS</span>
        <span class="m-val mono warning" id="dc-fault-count">0</span>
      </div>
      <div class="dc-stat">
        <span class="m-label">FASTEST INTERVAL</span>
        <span class="m-val mono" id="dc-fastest-ms">0 ms</span>
      </div>
    </div>
  </div>

  <div class="tester-controls">
    <button type="button" class="btn-secondary" id="btn-reset-dc">Reset Counter</button>
  </div>
</div>

<script>
  import { detectDoubleClickFault } from '../../../lib/mouse';

  document.addEventListener('DOMContentLoaded', () => {
    let totalClicks = 0;
    let faultCount = 0;
    let lastClickTime = 0;
    let fastestMs = 9999;
    const intervals: number[] = [];

    const target = document.getElementById('dc-click-target');
    const msgEl = document.getElementById('dc-status-msg');
    const totalEl = document.getElementById('dc-total-count');
    const faultEl = document.getElementById('dc-fault-count');
    const fastestEl = document.getElementById('dc-fastest-ms');

    target?.addEventListener('mousedown', (e) => {
      e.preventDefault();
      const now = performance.now();
      totalClicks++;

      if (lastClickTime > 0) {
        const interval = Math.round(now - lastClickTime);
        intervals.push(interval);
        if (interval < fastestMs) fastestMs = interval;

        // Debounce threshold for double click fault is under 80ms
        if (interval < 80) {
          faultCount++;
          if (msgEl) {
            msgEl.textContent = `DOUBLE-CLICK FAULT DETECTED (${interval}ms)!`;
            msgEl.className = 'dc-status-text warning';
          }
        } else {
          if (msgEl && faultCount === 0) {
            msgEl.textContent = 'Switch Healthy (No Faults)';
            msgEl.className = 'dc-status-text pass';
          }
        }
      }

      lastClickTime = now;

      if (totalEl) totalEl.textContent = String(totalClicks);
      if (faultEl) faultEl.textContent = String(faultCount);
      if (fastestEl && fastestMs < 9999) fastestEl.textContent = `${fastestMs} ms`;
    });

    document.getElementById('btn-reset-dc')?.addEventListener('click', () => {
      totalClicks = 0;
      faultCount = 0;
      lastClickTime = 0;
      fastestMs = 9999;
      intervals.length = 0;

      if (totalEl) totalEl.textContent = '0';
      if (faultEl) faultEl.textContent = '0';
      if (fastestEl) fastestEl.textContent = '0 ms';
      if (msgEl) {
        msgEl.textContent = 'No Faults Detected';
        msgEl.className = 'dc-status-text text-gradient';
      }
    });
  });
</script>

<style>
  .dc-tester { display: flex; flex-direction: column; gap: 1.5rem; }
  .dc-hero-card { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .dc-target-box { height: 220px; background: var(--color-surface-1); border: 2px dashed var(--color-accent); border-radius: var(--radius-card); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; cursor: pointer; user-select: none; }
  .dc-title { font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); }
  .dc-status-text { font-family: var(--font-mono); font-size: 1.75rem; font-weight: 800; }
  .dc-status-text.warning { color: var(--color-fail); }
  .dc-status-text.pass { color: var(--color-pass); }
  .dc-sub { font-size: var(--text-small); color: var(--color-text-secondary); }
  .dc-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .dc-stat { background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; align-items: center; gap: 0.375rem; text-align: center; }
  .m-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .m-val { font-size: 1.75rem; font-weight: 700; }
  .m-val.warning { color: var(--color-fail); }
  .tester-controls { display: flex; justify-content: flex-end; }
  @media (max-width: 768px) { .dc-stats-row { grid-template-columns: 1fr; } }
</style>
