---
/**
 * DriftTester.astro — Interactive Stick Drift Diagnostic Tool
 * Calculates stick position, drift percentage, live visual crosshair,
 * and deadzone threshold alerts using Web Gamepad API.
 * 
 * UPGRADED: High-energy premium UI & dynamic hardware simulator overlay.
 */
import InterpretationCard from '../../features/InterpretationCard.astro';
---
<div class="doppelrand-shell group relative" id="drift-tester-root" data-model="none">
  <div class="doppelrand-core flex flex-col gap-8 relative z-10">
    {/* Dynamic ambient glow based on controller type */}
    <div class="ambient-glow" id="ambient-glow"></div>

    {/* ── Status Bar ── */}
    <div class="tester-status-bar card-base">
      <div class="status-indicator">
        <span class="status-dot" id="gp-status-dot"></span>
        <span class="status-text font-medium" id="gp-status-text">Connect a controller and press any button...</span>
      </div>
      <div class="controller-name tracking-wider text-accent" id="gp-model-name">NO DEVICE</div>
    </div>

  {/* ── Visualizers Grid (Left & Right Sticks) ── */}
  <div class="sticks-grid relative z-10">

    {/* Left Analog Stick */}
    <div class="stick-card card-gradient card-hover group/stick">
      <div class="stick-card-header">
        <h3 class="stick-title text-primary font-bold tracking-tight">Left Analog Stick</h3>
        <span class="drift-value font-mono text-2xl" id="left-drift-val">0.0%</span>
      </div>

      <div class="canvas-container relative flex justify-center items-center py-6">
        <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent rounded-full opacity-50 blur-xl pointer-events-none transition-opacity group-hover/stick:opacity-100"></div>
        <canvas id="left-stick-canvas" width="280" height="280" class="relative z-10 drop-shadow-2xl"></canvas>
      </div>

      <div class="stick-metrics">
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">X Axis</span>
          <span class="m-val mono text-primary" id="left-x-val">0.0000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">Y Axis</span>
          <span class="m-val mono text-primary" id="left-y-val">0.0000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">Status</span>
          <span class="m-val badge-pass inline-flex" id="left-status-badge">Healthy</span>
        </div>
      </div>
    </div>

    {/* Right Analog Stick */}
    <div class="stick-card card-gradient card-hover group/stick">
      <div class="stick-card-header">
        <h3 class="stick-title text-primary font-bold tracking-tight">Right Analog Stick</h3>
        <span class="drift-value font-mono text-2xl" id="right-drift-val">0.0%</span>
      </div>

      <div class="canvas-container relative flex justify-center items-center py-6">
        <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent rounded-full opacity-50 blur-xl pointer-events-none transition-opacity group-hover/stick:opacity-100"></div>
        <canvas id="right-stick-canvas" width="280" height="280" class="relative z-10 drop-shadow-2xl"></canvas>
      </div>

      <div class="stick-metrics">
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">X Axis</span>
          <span class="m-val mono text-primary" id="right-x-val">0.0000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">Y Axis</span>
          <span class="m-val mono text-primary" id="right-y-val">0.0000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-xs text-secondary">Status</span>
          <span class="m-val badge-pass inline-flex" id="right-status-badge">Healthy</span>
        </div>
      </div>
    </div>

  </div>

  {/* ── Controls & Calibration ── */}
  <div class="tester-controls mt-4 relative z-10">
    <a href="/test/controller/deadzone" class="premium-btn btn-primary shadow-lg shadow-blue-500/20" id="btn-calibrate">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crosshair"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg>
      Calibrate Deadzone
    </a>
    <button type="button" class="premium-btn btn-secondary glass-panel hover:bg-white/5" id="btn-reset-history">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      Reset Canvas Trail
    </button>
  </div>
  
  <InterpretationCard />
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';
  import { recordTelemetry, mapGamepadToModelKey } from '../../../lib/telemetry';
  import { addPoints } from '../../../lib/rewards';
  import { interpretDrift } from '../../../lib/interpretation';
  import { saveToPassport } from '../../../lib/passport';
  import { generateUUID, detectEnvironment, checkCapabilities } from '../../../lib/report';

  let lastTelemetryAt = 0;
  let lastSavedAt = 0;
  let lastSavedDrift = -1;
  let rewarded = false;

  function awardFirstMeasurement(): void {
    if (rewarded) return;
    rewarded = true;
    addPoints(50);
  }

  function persistLastDrift(state: ReturnType<typeof parseGamepadState>): void {
    const now = Date.now();
    if (now - lastSavedAt < 3000) return;
    const driftingLeft = state.leftStick.driftPct > 0;
    const drivingRight = state.rightStick.driftPct > 0;
    const drift = driftingLeft ? state.leftStick.driftPct : drivingRight ? state.rightStick.driftPct : 0;
    if (drift <= 0 || drift > 50) return;
    if (Math.abs(drift - lastSavedDrift) < 0.5 && now - lastSavedAt < 15000) return;
    lastSavedAt = now;
    lastSavedDrift = drift;
    awardFirstMeasurement();
    const stick = driftingLeft ? state.leftStick : state.rightStick;
    try {
      const entry = {
        model: state.detectedModel,
        modelKey: mapGamepadToModelKey(state.detectedModel),
        drift: Math.round(drift * 100) / 100,
        driftX: Math.round(stick.x * 10000) / 10000,
        driftY: Math.round(stick.y * 10000) / 10000,
        side: driftingLeft ? 'left' : 'right',
        date: now,
      };
      const historyStr = localStorage.getItem('ct_drift_history');
      let history = [];
      if (historyStr) {
        try { history = JSON.parse(historyStr); } catch(e) {}
      }
      history.push(entry);
      if (history.length > 100) history = history.slice(-100);
      localStorage.setItem('ct_drift_history', JSON.stringify(history));
      localStorage.setItem('ct_last_drift', JSON.stringify(entry));
      
      const report = {
        id: generateUUID(),
        timestamp: now,
        protocolVersion: '2.4.0',
        device: { name: state.detectedModel || 'Unknown Gamepad' },
        environment: detectEnvironment(),
        capabilities: checkCapabilities(),
        tests: {
          sticks: { 
            driftX: Math.abs(state.leftStick.driftPct), 
            driftY: Math.abs(state.rightStick.driftPct), 
            circularityError: 0, 
            deadzoneRecommendation: drift > 3 ? 0.05 : 0.02 
          },
        },
        confidence: 'high' as const,
        limitations: []
      };
      saveToPassport(report);
    } catch {
      /* storage unavailable — ignore */
    }
  }

  function maybeRecordDriftSample(state: ReturnType<typeof parseGamepadState>): void {
    const now = Date.now();
    if (now - lastTelemetryAt < 5000) return;
    const drift =
      state.leftStick.driftPct > 0 ? state.leftStick.driftPct :
      state.rightStick.driftPct > 0 ? state.rightStick.driftPct : 0;
    if (drift <= 0 || drift > 50) return;
    const modelKey = mapGamepadToModelKey(state.detectedModel);
    if (!modelKey) return;
    lastTelemetryAt = now;
    recordTelemetry({
      modelKey,
      driftX: state.leftStick.x,
      driftY: state.leftStick.y,
      circularityError: 0,
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const rootEl = document.getElementById('drift-tester-root');
    const statusDot = document.getElementById('gp-status-dot');
    const statusText = document.getElementById('gp-status-text');
    const modelName = document.getElementById('gp-model-name');

    const leftCanvas = document.getElementById('left-stick-canvas') as HTMLCanvasElement;
    const rightCanvas = document.getElementById('right-stick-canvas') as HTMLCanvasElement;
    if (!leftCanvas || !rightCanvas) return;

    const leftCtx = leftCanvas.getContext('2d');
    const rightCtx = rightCanvas.getContext('2d');

    // High-DPI backing store (logical 280×280, sharp on retina)
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    leftCanvas.width = 280 * dpr;
    leftCanvas.height = 280 * dpr;
    rightCanvas.width = 280 * dpr;
    rightCanvas.height = 280 * dpr;
    leftCtx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    rightCtx?.setTransform(dpr, 0, 0, dpr, 0, 0);

    const leftXVal = document.getElementById('left-x-val');
    const leftYVal = document.getElementById('left-y-val');
    const leftDriftVal = document.getElementById('left-drift-val');
    const leftBadge = document.getElementById('left-status-badge');

    const rightXVal = document.getElementById('right-x-val');
    const rightYVal = document.getElementById('right-y-val');
    const rightDriftVal = document.getElementById('right-drift-val');
    const rightBadge = document.getElementById('right-status-badge');

    const leftTrail: { x: number; y: number }[] = [];
    const rightTrail: { x: number; y: number }[] = [];

    let animId: number | null = null;
    let currentBrand = 'none';

    // Premium styling colors based on hardware model
    function getHardwareBrandColor(modelKey: string | null) {
      if (!modelKey) return { hex: '255, 255, 255', brand: 'generic' }; 
      if (modelKey.includes('ps5') || modelKey.includes('ps4')) return { hex: '37, 99, 235', brand: 'playstation' }; // PlayStation Blue
      if (modelKey.includes('xbox')) return { hex: '16, 185, 129', brand: 'xbox' }; // Xbox Green
      if (modelKey.includes('switch')) return { hex: '239, 68, 68', brand: 'switch' }; // Switch Red
      return { hex: '139, 92, 246', brand: 'generic' }; // Generic Violet
    }

    function renderStick(
      ctx: CanvasRenderingContext2D | null,
      x: number,
      y: number,
      trail: { x: number; y: number }[],
      brandColors: { hex: string; brand?: string }
    ) {
      if (!ctx) return;
      const w = ctx.canvas.width;
      const h = ctx.canvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const radius = (w / 2) - 25; // padding

      ctx.clearRect(0, 0, w, h);

      // Background outer circle (premium glass effect)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(12, 12, 20, 0.4)'; // glass dark
      ctx.fill();
      
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, 'rgba(255,255,255,0.15)');
      grad.addColorStop(1, 'rgba(255,255,255,0.02)');
      ctx.strokeStyle = grad;
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Deadzone threshold circle (5%)
      ctx.beginPath();
      ctx.arc(cx, cy, radius * 0.05, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.5)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Center crosshair axes
      ctx.beginPath();
      ctx.moveTo(cx - radius, cy);
      ctx.lineTo(cx + radius, cy);
      ctx.moveTo(cx, cy - radius);
      ctx.lineTo(cx, cy + radius);
      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Draw stick position trail (hardware colored)
      const px = cx + x * radius;
      const py = cy + y * radius;
      trail.push({ x: px, y: py });
      if (trail.length > 80) trail.shift();

      for (let i = 0; i < trail.length; i++) {
        const pt = trail[i];
        const alpha = (i / trail.length) * 0.5;
        ctx.beginPath();
        ctx.arc(pt.x, pt.y, 2, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${brandColors.hex}, ${alpha})`;
        ctx.fill();
      }

      // Draw current stick position dot with premium glow
      const isDrifting = Math.hypot(x, y) > 0.05;
      
      // Outer glow
      ctx.beginPath();
      ctx.arc(px, py, 14, 0, Math.PI * 2);
      ctx.fillStyle = isDrifting ? 'rgba(239, 68, 68, 0.2)' : `rgba(${brandColors.hex}, 0.3)`;
      ctx.fill();

      // Inner dot
      ctx.beginPath();
      ctx.arc(px, py, 6, 0, Math.PI * 2);
      ctx.fillStyle = isDrifting ? '#EF4444' : '#FFFFFF';
      ctx.fill();
      
      // Dot border
      ctx.strokeStyle = isDrifting ? '#FECACA' : `rgb(${brandColors.hex})`;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    let lastInterpUpdate = 0;
    const interpCard = document.getElementById('interpretation-card');
    const interpMetricLabel = document.getElementById('interp-metric-label');
    const interpMetricValue = document.getElementById('interp-metric-value');
    const interpMetricUnit = document.getElementById('interp-metric-unit');
    const interpVerdictBadge = document.getElementById('interp-verdict-badge');
    const interpVerdictText = document.getElementById('interp-verdict-text');
    const interpExplanation = document.getElementById('interp-explanation');
    const interpComparison = document.getElementById('interp-comparison');
    const interpModelName = document.getElementById('interp-model-name');
    const interpSampleCount = document.getElementById('interp-sample-count');
    const interpPercentileFill = document.getElementById('interp-percentile-fill');
    const interpPercentileMarker = document.getElementById('interp-percentile-marker');
    const interpPercentileLabel = document.getElementById('interp-percentile-label');
    const interpDatasetDate = document.getElementById('interp-dataset-date');
    const interpConfidenceBadge = document.getElementById('interp-confidence-badge');
    const interpConfidenceText = document.getElementById('interp-confidence-text');
    const interpFactors = document.getElementById('interp-factors');
    const interpImprove = document.getElementById('interp-improve');
    const interpLimitationsList = document.getElementById('interp-limitations-list');
    const interpNextSteps = document.getElementById('interp-next-steps');

    let connectionTime = 0;

    function poll() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;

      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        if (statusDot) statusDot.className = 'status-dot active';
        if (statusText) statusText.textContent = 'Controller Connected';
        if (modelName) modelName.textContent = activeGp.id;

        const state = parseGamepadState(activeGp);

        maybeRecordDriftSample(state);
        persistLastDrift(state);

        const modelKey = mapGamepadToModelKey(state.detectedModel);
        const hardwareColors = getHardwareBrandColor(modelKey);
        
        // Update root attribute for CSS dynamic theming
        if (rootEl && currentBrand !== hardwareColors.brand) {
          rootEl.setAttribute('data-model', hardwareColors.brand);
          currentBrand = hardwareColors.brand;
        }

        // Left stick
        renderStick(leftCtx, state.leftStick.x, state.leftStick.y, leftTrail, hardwareColors);
        if (leftXVal) leftXVal.textContent = state.leftStick.x.toFixed(4);
        if (leftYVal) leftYVal.textContent = state.leftStick.y.toFixed(4);
        if (leftDriftVal) {
          leftDriftVal.textContent = `${state.leftStick.driftPct}%`;
          leftDriftVal.style.color = state.leftStick.driftPct > 10 ? '#EF4444' : (state.leftStick.driftPct > 2 ? '#F59E0B' : `rgb(${hardwareColors.hex})`);
        }

        if (leftBadge) {
          if (state.leftStick.driftPct > 10) {
            leftBadge.textContent = 'Severe Drift';
            leftBadge.className = 'm-val badge-fail inline-flex px-2 py-0.5 rounded-md';
          } else if (state.leftStick.driftPct > 2) {
            leftBadge.textContent = 'Minor Drift';
            leftBadge.className = 'm-val badge-warning inline-flex px-2 py-0.5 rounded-md';
          } else {
            leftBadge.textContent = 'Healthy';
            leftBadge.className = 'm-val badge-pass inline-flex px-2 py-0.5 rounded-md';
          }
        }

        // Right stick
        renderStick(rightCtx, state.rightStick.x, state.rightStick.y, rightTrail, hardwareColors);
        if (rightXVal) rightXVal.textContent = state.rightStick.x.toFixed(4);
        if (rightYVal) rightYVal.textContent = state.rightStick.y.toFixed(4);
        if (rightDriftVal) {
          rightDriftVal.textContent = `${state.rightStick.driftPct}%`;
          rightDriftVal.style.color = state.rightStick.driftPct > 10 ? '#EF4444' : (state.rightStick.driftPct > 2 ? '#F59E0B' : `rgb(${hardwareColors.hex})`);
        }

        if (rightBadge) {
          if (state.rightStick.driftPct > 10) {
            rightBadge.textContent = 'Severe Drift';
            rightBadge.className = 'm-val badge-fail inline-flex px-2 py-0.5 rounded-md';
          } else if (state.rightStick.driftPct > 2) {
            rightBadge.textContent = 'Minor Drift';
            rightBadge.className = 'm-val badge-warning inline-flex px-2 py-0.5 rounded-md';
          } else {
            rightBadge.textContent = 'Healthy';
            rightBadge.className = 'm-val badge-pass inline-flex px-2 py-0.5 rounded-md';
          }
        }

        // ── Interpretation Card Update (throttled) ──
        const now = Date.now();
        if (connectionTime === 0) connectionTime = now;
        
        if (now - lastInterpUpdate > 1000) {
          lastInterpUpdate = now;
          const maxDrift = Math.max(state.leftStick.driftPct, state.rightStick.driftPct);
          const sampleDurationSec = Math.floor((now - connectionTime) / 1000);
          
          const interpretation = interpretDrift(maxDrift, state.identity, 'unknown', sampleDurationSec);
          
          if (interpCard) {
            interpCard.style.display = 'block';
            if (!interpCard.classList.contains('is-visible')) {
              // Trigger reflow for animation
              void interpCard.offsetWidth;
              interpCard.classList.add('is-visible');
            }
            
            if (interpMetricLabel) interpMetricLabel.textContent = interpretation.measurement.label;
            if (interpMetricValue) interpMetricValue.textContent = interpretation.measurement.value;
            if (interpMetricUnit) interpMetricUnit.textContent = interpretation.measurement.unit;
            
            if (interpVerdictBadge) {
              interpVerdictBadge.setAttribute('data-verdict', interpretation.interpretation.verdict);
              if (interpVerdictText) interpVerdictText.textContent = interpretation.interpretation.verdict;
            }
            
            if (interpExplanation) interpExplanation.textContent = interpretation.interpretation.explanation;
            
            if (interpretation.comparison && interpComparison) {
              interpComparison.style.display = 'block';
              if (interpModelName) interpModelName.textContent = interpretation.comparison.modelName;
              if (interpSampleCount) interpSampleCount.textContent = 'modeled reference';
              if (interpPercentileFill) interpPercentileFill.style.width = `${interpretation.comparison.percentile}%`;
              if (interpPercentileMarker) interpPercentileMarker.style.left = `${interpretation.comparison.percentile}%`;
              if (interpPercentileLabel) interpPercentileLabel.textContent = interpretation.comparison.betterThan;
              if (interpDatasetDate) interpDatasetDate.textContent = `Reference snapshot: ${interpretation.comparison.datasetDate}`;
            } else if (interpComparison) {
              interpComparison.style.display = 'none';
            }
            
            if (interpConfidenceBadge) {
              interpConfidenceBadge.setAttribute('data-level', interpretation.confidence.level);
              if (interpConfidenceText) interpConfidenceText.textContent = `${interpretation.confidence.level.charAt(0).toUpperCase() + interpretation.confidence.level.slice(1)} confidence`;
            }
            
            if (interpFactors) {
              interpFactors.innerHTML = interpretation.confidence.factors.map(f => `<li>${f}</li>`).join('');
            }
            
            if (interpImprove) interpImprove.textContent = interpretation.confidence.howToImprove;
            
            if (interpLimitationsList) {
              interpLimitationsList.innerHTML = interpretation.limitations.map(l => `<li>${l}</li>`).join('');
            }
            
            if (interpNextSteps) {
              interpNextSteps.innerHTML = interpretation.nextSteps.map(step => {
                const isPrimary = step.priority === 'primary';
                const isCommercial = step.href && step.href.includes('hall-effect');
                let classes = isPrimary ? 'interp-step-primary' : 'interp-step-secondary';
                if (isCommercial) classes += ' interp-step-commercial';
                
                if (step.href) {
                  return `<a href="${step.href}" class="${classes}">${step.action}</a>`;
                }
                return `<button type="button" class="${classes}">${step.action}</button>`;
              }).join('');
            }
            
            // Wire to DecisionStrip if available
            if (typeof window !== 'undefined' && (window as any).updateDecisionStrip) {
              (window as any).updateDecisionStrip(interpretation.interpretation.verdict, state.detectedModel);
            }
          }
        }

      } else {
        if (statusDot) statusDot.className = 'status-dot';
        if (statusText) statusText.textContent = 'Connect a controller and press any button...';
        if (modelName) modelName.textContent = 'NO DEVICE';
        if (rootEl) {
          rootEl.setAttribute('data-model', 'none');
          currentBrand = 'none';
        }
        
        connectionTime = 0;
        if (interpCard) interpCard.style.display = 'none';

        renderStick(leftCtx, 0, 0, leftTrail, { hex: '255,255,255', brand: 'generic' });
        renderStick(rightCtx, 0, 0, rightTrail, { hex: '255,255,255', brand: 'generic' });
      }

      animId = requestAnimationFrame(poll);
    }

    window.addEventListener('gamepadconnected', () => {
      if (!animId) poll();
    });

    // Start polling immediately in case gamepad is already connected
    poll();

    document.getElementById('btn-reset-history')?.addEventListener('click', () => {
      leftTrail.length = 0;
      rightTrail.length = 0;
    });
  });
</script>

<style>
  /* Ambient hardware glow underlay */
  .ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center, rgba(37,99,235,0.08) 0%, transparent 60%);
    pointer-events: none;
    transition: all 1s ease-in-out;
    z-index: 0;
  }

  /* Hardware specific glowing themes */
  .doppelrand-shell[data-model="playstation"] .ambient-glow {
    background: radial-gradient(circle at center, rgba(37,99,235,0.15) 0%, transparent 70%);
  }
  .doppelrand-shell[data-model="xbox"] .ambient-glow {
    background: radial-gradient(circle at center, rgba(16,185,129,0.12) 0%, transparent 70%);
  }
  .doppelrand-shell[data-model="switch"] .ambient-glow {
    background: radial-gradient(circle at left, rgba(239,68,68,0.12) 0%, transparent 50%),
                radial-gradient(circle at right, rgba(59,130,246,0.12) 0%, transparent 50%);
  }

  .tester-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.75rem;
    border-radius: 1rem;
    position: relative;
    z-index: 10;
    gap: 1rem;
