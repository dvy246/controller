---
export interface Props {
  engine: string;
  effect: string;
}

const { engine, effect } = Astro.props;
---

<div class="haptic-composer relative w-full p-4 sm:p-6" data-engine={engine} data-effect={effect}>
  <div class="composer-header mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20">Haptic Waveform</span>
        <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-blue-500/10 text-blue-400 border border-blue-500/20">{engine}</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-white font-mono">Waveform Composer</h2>
      <p class="text-xs text-stone-400 font-mono mt-1">Drag points to sculpt your rumble curve. X = Time (ms), Y = Intensity (0-100%).</p>
    </div>
    
    <button id="play-haptics-btn" class="btn-primary shrink-0 flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-mono text-xs font-bold transition-all shadow-lg shadow-blue-600/20">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      Test on Controller
    </button>
  </div>
  
  <div class="canvas-wrapper bg-[#0D0D0E] border border-[#27272A] rounded-2xl p-4 overflow-hidden relative shadow-inner">
    <div class="flex justify-between items-center mb-2 px-1">
      <span class="text-[10px] font-mono text-stone-400 uppercase tracking-widest flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span> INTENSITY (Y) &uarr;
      </span>
      <span class="text-[10px] font-mono text-stone-400 uppercase tracking-widest">
        TIME (1000MS) &rarr;
      </span>
    </div>
    
    <canvas id="waveform-canvas" width="800" height="300" class="w-full cursor-crosshair touch-none rounded-lg bg-black/40 border border-white/5"></canvas>
  </div>

  <div class="code-gen-panel mt-6 pt-6 border-t border-[#27272A]">
    <div class="flex justify-between items-center mb-3">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
        <h3 class="font-mono font-bold text-xs text-stone-300 uppercase tracking-widest">
          {engine === 'unity' ? 'Unity C# (Input System)' : 'Unreal Engine (C++)'} Output
        </h3>
      </div>
      <button id="copy-code-btn" class="btn-secondary text-xs px-3 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-300 border border-stone-700 font-mono transition-colors">
        Copy Snippet
      </button>
    </div>
    <div class="code-block-wrapper bg-black/80 border border-white/10 rounded-xl p-4 overflow-x-auto shadow-inner group">
      <pre><code id="generated-code" class="text-xs font-mono text-emerald-400/90 leading-relaxed group-hover:text-emerald-400 transition-colors"></code></pre>
    </div>
  </div>
</div>

<style>
  #waveform-canvas {
    aspect-ratio: 8 / 3;
  }
</style>

<script>
  const initComposer = () => {
    const root = document.querySelector('.haptic-composer');
    if (!root) return;

    const engine = root.getAttribute('data-engine');
    const effect = root.getAttribute('data-effect');
    
    const canvas = document.getElementById('waveform-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    const playBtn = document.getElementById('play-haptics-btn');
    const copyBtn = document.getElementById('copy-code-btn');
    const codeOut = document.getElementById('generated-code');

    if (!ctx) return;

    // High-DPI backing store (logical 800×300, sharp on retina)
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = 800 * dpr;
    canvas.height = 300 * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const width = 800;
    const height = 300;
    
    const padX = 20;
    const padY = 20;
    const plotW = width - (padX * 2);
    const plotH = height - (padY * 2);

    // Initial curve points based on effect
    let points = [];
    if (effect === 'explosion') {
      points = [{x: padX, y: padY + plotH}, {x: padX + plotW * 0.08, y: padY}, {x: padX + plotW * 0.28, y: padY + plotH * 0.3}, {x: padX + plotW * 0.65, y: padY + plotH * 0.8}, {x: padX + plotW, y: padY + plotH}];
    } else if (effect === 'heartbeat') {
      points = [{x: padX, y: padY + plotH}, {x: padX + plotW * 0.15, y: padY}, {x: padX + plotW * 0.28, y: padY + plotH}, {x: padX + plotW * 0.42, y: padY + plotH * 0.15}, {x: padX + plotW * 0.55, y: padY + plotH}, {x: padX + plotW, y: padY + plotH}];
    } else if (effect === 'recoil') {
      points = [{x: padX, y: padY + plotH}, {x: padX + plotW * 0.05, y: padY}, {x: padX + plotW * 0.2, y: padY + plotH * 0.6}, {x: padX + plotW * 0.4, y: padY + plotH}, {x: padX + plotW, y: padY + plotH}];
    } else {
      points = [{x: padX, y: padY + plotH/2}, {x: padX + plotW/2, y: padY + plotH/2}, {x: padX + plotW, y: padY + plotH/2}];
    }

    let draggingPoint = null;
    let isPlaying = false;
    let animationFrame = null;
    let playbackProgress = -1;

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      
      const padX = 20;
      const padY = 20;
      const plotW = width - (padX * 2);
      const plotH = height - (padY * 2);

      // Grid
      ctx.strokeStyle = '#1F2937';
      ctx.lineWidth = 1;
      for(let i=0; i<=10; i++) {
        const gx = padX + i * (plotW/10);
        ctx.beginPath();
        ctx.moveTo(gx, padY);
        ctx.lineTo(gx, padY + plotH);
        ctx.stroke();
      }
      for(let j=0; j<=4; j++) {
        const gy = padY + j * (plotH/4);
        ctx.beginPath();
        ctx.moveTo(padX, gy);
        ctx.lineTo(padX + plotW, gy);
        ctx.stroke();
      }

      // Fill gradient
      ctx.beginPath();
      ctx.moveTo(points[0].x, padY + plotH);
      ctx.lineTo(points[0].x, points[0].y);
      for(let i=1; i<points.length; i++) {
        ctx.lineTo(points[i].x, points[i].y);
      }
      ctx.lineTo(points[points.length-1].x, padY + plotH);
      ctx.closePath();
      
      const gradient = ctx.createLinearGradient(0, padY, 0, padY + plotH);
      gradient.addColorStop(0, 'rgba(37, 99, 235, 0.4)');
      gradient.addColorStop(1, 'rgba(37, 99, 235, 0.0)');
      ctx.fillStyle = gradient;
      ctx.fill();

      // Stroke line
      ctx.beginPath();
      ctx.moveTo(points[0].x, points[0].y);
      for(let i=1; i<points.length; i++) {
        ctx.lineTo(points[i].x, points[i].y);
      }
      ctx.strokeStyle = '#3B82F6';
      ctx.lineWidth = 3;
      ctx.lineJoin = 'round';
      ctx.stroke();

      // Control points
      points.forEach((p) => {
        ctx.beginPath();
        ctx.arc(p.x, p.y, draggingPoint === p ? 9 : 6, 0, Math.PI * 2);
        ctx.fillStyle = draggingPoint === p ? '#3B82F6' : '#0F172A';
        ctx.fill();
        ctx.strokeStyle = '#60A5FA';
        ctx.lineWidth = 2;
        ctx.stroke();
      });

      // Playback playhead
      if (playbackProgress >= 0) {
        const px = playbackProgress * width;
        ctx.beginPath();
        ctx.moveTo(px, 0);
        ctx.lineTo(px, height);
        ctx.strokeStyle = '#10B981'; // emerald-500
        ctx.lineWidth = 2;
        ctx.setLineDash([5, 5]);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      
      updateCode();
    };

    const getMousePos = (e) => {
      const rect = canvas.getBoundingClientRect();
      // Support touch as well; map into logical (800×300) space
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: (clientX - rect.left) * (width / rect.width),
        y: (clientY - rect.top) * (height / rect.height)
      };
    };

    const handleDown = (e) => {
      const pos = getMousePos(e);
      const clicked = points.find(p => Math.hypot(p.x - pos.x, p.y - pos.y) < 20);
      if (clicked) {
        draggingPoint = clicked;
        if(e.cancelable) e.preventDefault();
      }
      draw();
    };

    const handleMove = (e) => {
      if (!draggingPoint) return;
      const pos = getMousePos(e);
      const idx = points.indexOf(draggingPoint);
      
      // X constraints
      if (idx > 0 && pos.x <= points[idx-1].x) pos.x = points[idx-1].x + 2;
      if (idx < points.length-1 && pos.x >= points[idx+1].x) pos.x = points[idx+1].x - 2;
      if (idx === 0) pos.x = 0;
      if (idx === points.length-1) pos.x = width;
      
      // Y constraints
      pos.y = Math.max(0, Math.min(height, pos.y));
      
      draggingPoint.x = pos.x;
      draggingPoint.y = pos.y;
      draw();
    };

    const handleUp = () => {
      draggingPoint = null;
      draw();
    };

    canvas.addEventListener('mousedown', handleDown);
    window.addEventListener('mousemove', handleMove);
    window.addEventListener('mouseup', handleUp);
    canvas.addEventListener('touchstart', handleDown, {passive: false});
    window.addEventListener('touchmove', handleMove, {passive: false});
    window.addEventListener('touchend', handleUp);

    const updateCode = () => {
      const normalized = points.map(p => ({
        time: (p.x / width).toFixed(3),
        intensity: (1 - (p.y / height)).toFixed(3)
      }));
      
      let code = '';
      if (engine === 'unity') {
        code = `using UnityEngine;\nusing UnityEngine.InputSystem;\nusing System.Collections;\n\npublic class HapticComposerEffect : MonoBehaviour\n{\n    public void PlayHaptics()\n    {\n        Gamepad pad = Gamepad.current;\n        if (pad == null) return;\n\n        AnimationCurve curve = new AnimationCurve(\n`;
        normalized.forEach(n => {
          code += `            new Keyframe(${n.time}f, ${n.intensity}f),\n`;
        });
        code = code.slice(0, -2); // remove last comma
        code += `\n        );\n        \n        StartCoroutine(ExecuteCurve(pad, curve, 1.0f));\n    }\n\n    private IEnumerator ExecuteCurve(Gamepad pad, AnimationCurve curve, float duration)\n    {\n        float t = 0;\n        while(t < duration)\n        {\n            float val = curve.Evaluate(t / duration);\n            pad.SetMotorSpeeds(val, val);\n            yield return null;\n            t += Time.deltaTime;\n        }\n        pad.ResetHaptics();\n    }\n}`;
      } else {
        code = `// UForceFeedbackEffect dynamic curve for ${effect}\nUForceFeedbackEffect* Create${effect.charAt(0).toUpperCase() + effect.slice(1)}Haptics()\n{\n    UForceFeedbackEffect* ForceFeedback = NewObject<UForceFeedbackEffect>();\n    ForceFeedback->Duration = 1.0f;\n    \n    FForceFeedbackChannelDetails ChannelDetails;\n    \n`;
        normalized.forEach((n, i) => {
          code += `    FForceFeedbackCurvePoint Point${i};\n    Point${i}.Time = ${n.time}f;\n    Point${i}.Value = ${n.intensity}f;\n    ChannelDetails.Curve.Add(Point${i});\n`;
        });
        code += `\n    ForceFeedback->ChannelDetails.Add(ChannelDetails);\n    return ForceFeedback;\n}`;
      }
      codeOut.textContent = code;
    };

    const getIntensityAtTime = (tRatio) => {
      const px = tRatio * width;
      let left = points[0];
      let right = points[points.length-1];
      for(let i=0; i<points.length-1; i++) {
        if (px >= points[i].x && px <= points[i+1].x) {
          left = points[i];
          right = points[i+1];
          break;
        }
      }
      const rangeX = right.x - left.x;
      if (rangeX === 0) return 1 - (left.y / height);
      const ratio = (px - left.x) / rangeX;
      const py = left.y + (right.y - left.y) * ratio;
      return 1 - (py / height);
    };

    const simulateHaptics = async () => {
      if (isPlaying) return;
      
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let pad = null;
      for (const gp of gamepads) {
        if (gp?.vibrationActuator) {
          pad = gp;
          break;
        }
      }

      if (!pad) {
        alert('Gamepad API Haptics not supported or no controller connected. Try pressing a button on a connected DualSense/Xbox controller in Edge/Chrome.');
        return;
      }

      isPlaying = true;
      playBtn.classList.add('opacity-50', 'pointer-events-none');
      
      const duration = 1000;
      const step = 50; 
      const chunks = duration / step;
      let currentChunk = 0;

      const runStep = () => {
        if (currentChunk > chunks) {
          isPlaying = false;
          playbackProgress = -1;
          playBtn.classList.remove('opacity-50', 'pointer-events-none');
          draw();
          return;
        }

        const t = currentChunk / chunks;
        playbackProgress = t;
        const intensity = getIntensityAtTime(t);
        
        try {
           pad.vibrationActuator.playEffect('dual-rumble', {
             startDelay: 0,
             duration: step,
             weakMagnitude: intensity,
             strongMagnitude: intensity
           });
        } catch(e) {}
        
        draw();
        currentChunk++;
        setTimeout(runStep, step);
      };

      runStep();
    };

    playBtn.addEventListener('click', simulateHaptics);

    copyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(codeOut.textContent);
      const originalText = copyBtn.textContent;
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
    });

    draw();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initComposer);
  } else {
    // Note: Astro ViewTransitions may require handling astro:page-load instead
    document.addEventListener('astro:page-load', initComposer, { once: true });
    initComposer();
  }
</script>
