---
/**
 * CircularityTester.astro — Interactive Thumbstick Circularity & Outer Error Calculator
 * Real-time 360-degree boundary plotting, circularity error percentage, and diagonal reach analysis.
 */
---

<div class="doppelrand-shell group relative" data-model="none" id="circ-tester-root">
  {/* Dynamic ambient glow based on controller type */}
  <div class="ambient-glow" id="ambient-glow"></div>
  <div class="doppelrand-core flex flex-col gap-8 relative z-10">
  <div class="tester-status-bar card-base relative z-10">
    <div class="status-indicator">
      <span class="status-dot" id="circ-status-dot"></span>
      <span class="status-text" id="circ-status-text">Rotate both thumbsticks 360 degrees to measure circularity...</span>
    </div>
    <div class="controller-name tracking-wider" id="circ-model-name">No Controller Detected</div>
  </div>

  <div class="circ-grid relative z-10">

    {/* Left Stick Canvas */}
    <div class="circ-card card-gradient card-hover">
      <div class="circ-header">
        <h3 class="circ-title text-stone-100">Left Stick Circularity</h3>
        <span class="circ-err-val" id="left-circ-err">0.0% Error</span>
      </div>
      <div class="canvas-wrap py-4">
        <canvas id="left-circ-canvas" width="280" height="280" class="drop-shadow-2xl"></canvas>
      </div>
      <div class="circ-metrics">
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Points Samples</span>
          <span class="m-val mono text-stone-100" id="left-pts-count">0</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Avg Radius</span>
          <span class="m-val mono text-stone-100" id="left-avg-rad">0.000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Outer Error</span>
          <span class="m-val badge-pass" id="left-circ-badge">Perfect</span>
        </div>
      </div>
    </div>

    {/* Right Stick Canvas */}
    <div class="circ-card card-gradient card-hover">
      <div class="circ-header">
        <h3 class="circ-title text-stone-100">Right Stick Circularity</h3>
        <span class="circ-err-val" id="right-circ-err">0.0% Error</span>
      </div>
      <div class="canvas-wrap py-4">
        <canvas id="right-circ-canvas" width="280" height="280" class="drop-shadow-2xl"></canvas>
      </div>
      <div class="circ-metrics">
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Points Samples</span>
          <span class="m-val mono text-stone-100" id="right-pts-count">0</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Avg Radius</span>
          <span class="m-val mono text-stone-100" id="right-avg-rad">0.000</span>
        </div>
        <div class="metric">
          <span class="m-label uppercase tracking-widest text-stone-400">Outer Error</span>
          <span class="m-val badge-pass" id="right-circ-badge">Perfect</span>
        </div>
      </div>
    </div>

  </div>

  <div class="tester-controls">
    <button type="button" class="btn-secondary" id="btn-reset-circ">Reset Circularity Data</button>
  </div>
  </div>
</div>

<script>
  import { parseGamepadState, calculateCircularityError } from '../../../lib/gamepad';
  import { recordTelemetry, mapGamepadToModelKey } from '../../../lib/telemetry';
  import { addPoints } from '../../../lib/rewards';

  let lastTelemetryAt = 0;
  let rewarded = false;

  function awardFirstMeasurement(): void {
    if (rewarded) return;
    rewarded = true;
    addPoints(50);
  }

  function maybeRecordCircularitySample(model: string, lErr: number, rErr: number, leftPts: number, rightPts: number): void {
    const now = Date.now();
    if (now - lastTelemetryAt < 10000) return;
    const modelKey = mapGamepadToModelKey(model);
    if (!modelKey) return;
    if (leftPts < 20 && rightPts < 20) return;
    lastTelemetryAt = now;
    awardFirstMeasurement();
    recordTelemetry({
      modelKey,
      driftX: 0,
      driftY: 0,
      circularityError: lErr > 0 ? lErr : rErr,
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const leftCanvas = document.getElementById('left-circ-canvas') as HTMLCanvasElement;
    const rightCanvas = document.getElementById('right-circ-canvas') as HTMLCanvasElement;
    if (!leftCanvas || !rightCanvas) return;

    const leftCtx = leftCanvas.getContext('2d');
    const rightCtx = rightCanvas.getContext('2d');

    const leftPoints: { x: number; y: number }[] = [];
    const rightPoints: { x: number; y: number }[] = [];
    let currentBrand = 'none';

    function getHardwareBrandColor(modelKey: string | null) {
      if (!modelKey) return { hex: '255, 255, 255', brand: 'generic' }; 
      if (modelKey.includes('ps5') || modelKey.includes('ps4')) return { hex: '37, 99, 235', brand: 'playstation' }; 
      if (modelKey.includes('xbox')) return { hex: '16, 185, 129', brand: 'xbox' }; 
      if (modelKey.includes('switch')) return { hex: '239, 68, 68', brand: 'switch' }; 
      return { hex: '139, 92, 246', brand: 'generic' }; 
    }

    function renderCircularity(
      ctx: CanvasRenderingContext2D | null,
      points: { x: number; y: number }[],
      currentX: number,
      currentY: number,
      brandColors: { hex: string; brand: string }
    ) {
      if (!ctx) return;
      const w = ctx.canvas.width;
      const h = ctx.canvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const radius = (w / 2) - 24;

      ctx.clearRect(0, 0, w, h);

      // Background outer circle (premium glass effect)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(12, 12, 20, 0.4)';
      ctx.fill();

      // Ideal outer circle boundary
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(${brandColors.hex}, 0.4)`;
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);

      // Plot outer points boundary hull
      if (points.length > 5) {
        ctx.beginPath();
        for (let i = 0; i < points.length; i++) {
          const pt = points[i];
          const px = cx + pt.x * radius;
          const py = cy + pt.y * radius;
          if (i === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.fillStyle = `rgba(${brandColors.hex}, 0.15)`;
        ctx.fill();
        ctx.strokeStyle = `rgb(${brandColors.hex})`;
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // Draw active stick position with glow
      const px = cx + currentX * radius;
      const py = cy + currentY * radius;
      
      ctx.beginPath();
      ctx.arc(px, py, 14, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${brandColors.hex}, 0.3)`;
      ctx.fill();

      ctx.beginPath();
      ctx.arc(px, py, 5, 0, Math.PI * 2);
      ctx.fillStyle = '#FFFFFF';
      ctx.fill();
      ctx.strokeStyle = `rgb(${brandColors.hex})`;
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    function pollCircularity() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const dot = document.getElementById('circ-status-dot');
        const text = document.getElementById('circ-status-text');
        const model = document.getElementById('circ-model-name');
        if (dot) dot.className = 'status-dot active';
        if (text) text.textContent = 'Rotate sticks 360° to measure circularity';
        if (model) model.textContent = activeGp.id;

        const state = parseGamepadState(activeGp);
        const modelKey = mapGamepadToModelKey(state.detectedModel);
        const hardwareColors = getHardwareBrandColor(modelKey);

        const rootEl = document.getElementById('circ-tester-root');
        if (rootEl && currentBrand !== hardwareColors.brand) {
          rootEl.setAttribute('data-model', hardwareColors.brand);
          currentBrand = hardwareColors.brand;
        }

        // Left stick
        const lDist = Math.hypot(state.leftStick.x, state.leftStick.y);
        if (lDist > 0.3) {
          leftPoints.push({ x: state.leftStick.x, y: state.leftStick.y });
          if (leftPoints.length > 300) leftPoints.shift();
        }
        renderCircularity(leftCtx, leftPoints, state.leftStick.x, state.leftStick.y, hardwareColors);

        const lErr = calculateCircularityError(leftPoints);
        const lErrEl = document.getElementById('left-circ-err');
        const lPtsEl = document.getElementById('left-pts-count');
        const lBadge = document.getElementById('left-circ-badge');

        maybeRecordCircularitySample(state.detectedModel, lErr, 0, leftPoints.length, 0);

        if (lErrEl) lErrEl.textContent = `${lErr}% Error`;
        if (lPtsEl) lPtsEl.textContent = String(leftPoints.length);
        if (lBadge) {
          if (lErr > 12) {
            lBadge.textContent = 'High Error';
            lBadge.className = 'm-val badge-fail';
          } else if (lErr > 5) {
            lBadge.textContent = 'Average';
            lBadge.className = 'm-val badge-warning';
          } else {
            lBadge.textContent = 'Excellent';
            lBadge.className = 'm-val badge-pass';
          }
        }

        // Right stick
        const rDist = Math.hypot(state.rightStick.x, state.rightStick.y);
        if (rDist > 0.3) {
          rightPoints.push({ x: state.rightStick.x, y: state.rightStick.y });
          if (rightPoints.length > 300) rightPoints.shift();
        }
        renderCircularity(rightCtx, rightPoints, state.rightStick.x, state.rightStick.y, hardwareColors);

        const rErr = calculateCircularityError(rightPoints);
        const rErrEl = document.getElementById('right-circ-err');
        const rPtsEl = document.getElementById('right-pts-count');
        const rBadge = document.getElementById('right-circ-badge');

        if (rErrEl) rErrEl.textContent = `${rErr}% Error`;
        if (rPtsEl) rPtsEl.textContent = String(rightPoints.length);
        if (rBadge) {
          if (rErr > 12) {
            rBadge.textContent = 'High Error';
            rBadge.className = 'm-val badge-fail';
          } else if (rErr > 5) {
            rBadge.textContent = 'Average';
            rBadge.className = 'm-val badge-warning';
          } else {
            rBadge.textContent = 'Excellent';
            rBadge.className = 'm-val badge-pass';
          }
        }
      } else {
        const dot = document.getElementById('circ-status-dot');
        const text = document.getElementById('circ-status-text');
        const model = document.getElementById('circ-model-name');
        if (dot) dot.className = 'status-dot';
        if (text) text.textContent = 'Connect a controller and press any button...';
        if (model) model.textContent = 'No Controller Detected';
        
        const rootEl = document.getElementById('circ-tester-root');
        if (rootEl) {
          rootEl.setAttribute('data-model', 'none');
          currentBrand = 'none';
        }

        renderCircularity(leftCtx, leftPoints, 0, 0, { hex: '255,255,255', brand: 'generic' });
        renderCircularity(rightCtx, rightPoints, 0, 0, { hex: '255,255,255', brand: 'generic' });
      }

      requestAnimationFrame(pollCircularity);
    }

    pollCircularity();

    document.getElementById('btn-reset-circ')?.addEventListener('click', () => {
      leftPoints.length = 0;
      rightPoints.length = 0;
    });
  });
</script>

<style>
  .circularity-tester {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    padding: 1rem;
    border-radius: 1.5rem;
    background: #000;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
  }

  /* Ambient hardware glow underlay */
  .ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150%;
    height: 150%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at center, rgba(37,99,235,0.08) 0%, transparent 60%);
    pointer-events: none;
    transition: all 1s ease-in-out;
    z-index: 0;
  }

  /* Hardware specific glowing themes */
  .circularity-tester[data-model="playstation"] .ambient-glow {
    background: radial-gradient(circle at center, rgba(37,99,235,0.15) 0%, transparent 70%);
  }
  .circularity-tester[data-model="xbox"] .ambient-glow {
    background: radial-gradient(circle at center, rgba(16,185,129,0.12) 0%, transparent 70%);
  }
  .circularity-tester[data-model="switch"] .ambient-glow {
    background: radial-gradient(circle at left, rgba(239,68,68,0.12) 0%, transparent 50%),
                radial-gradient(circle at right, rgba(59,130,246,0.12) 0%, transparent 50%);
  }

  /* Glass Panels */
  .glass-panel {
    background: rgba(15, 15, 20, 0.4);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .tester-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-radius: 1rem;
    position: relative;
    z-index: 10;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-neutral);
  }
  .status-dot.active {
    background: var(--color-pass);
    box-shadow: 0 0 8px var(--color-pass);
  }

  .status-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .controller-name {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace);
    font-size: 0.875rem;
    color: #fff;
    text-transform: uppercase;
  }
  .circularity-tester[data-model="playstation"] .controller-name { color: #60A5FA; text-shadow: 0 0 10px rgba(96,165,250,0.5); }
  .circularity-tester[data-model="xbox"] .controller-name { color: #34D399; text-shadow: 0 0 10px rgba(52,211,153,0.5); }
  .circularity-tester[data-model="switch"] .controller-name { color: #F87171; text-shadow: 0 0 10px rgba(248,113,113,0.5); }

  .circ-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .circ-card {
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s;
  }
  .circ-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.15);
  }

  .circ-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .circ-title {
    font-size: 1rem;
    font-weight: 700;
  }

  .circ-err-val {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .canvas-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .circ-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .m-label {
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
  }

  .m-val {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .tester-controls {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .circ-grid { grid-template-columns: 1fr; }
  }
</style>
