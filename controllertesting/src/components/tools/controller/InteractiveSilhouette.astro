---
/**
 * InteractiveSilhouette.astro
 * Premium 1:1 Pixel-Perfect 2D Vector Graphic of the PlayStation DualSense / DualShock.
 * Reacts to button presses with zero latency.
 */
import PlayStationSVG from './PlayStationSVG.astro';
---
<div class="silhouette-container flex justify-center items-center h-full w-full py-4 px-2 select-none">
  <PlayStationSVG />
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    // Button mapping array for high-fidelity SVG elements
    const elements = new Array(20);
    for (let i = 0; i < 20; i++) {
      elements[i] = document.querySelector(`[data-btn="${i}"]`);
    }
    
    // Cache last state to avoid unnecessary DOM mutations
    const lastState = new Array(20).fill(false);

    GamepadLoop.subscribe((state) => {
      if (!state) return;
      
      const buttons = state.buttons;
      for (let i = 0; i < buttons.length; i++) {
        if (i < 20) {
          const pressed = buttons[i].pressed;
          if (pressed !== lastState[i]) {
            const el = elements[i];
            if (el) {
              if (pressed) {
                el.classList.add('active');
                el.style.filter = 'drop-shadow(0 0 12px #3B82F6)';
              } else {
                el.classList.remove('active');
                el.style.filter = 'none';
              }
            }
            lastState[i] = pressed;
          }
        }
      }
    });
  });
</script>

<style>
  .silhouette-container {
    background: radial-gradient(circle at center, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
  }
</style>
