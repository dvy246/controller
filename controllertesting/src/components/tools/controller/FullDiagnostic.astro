---
/**
 * FullDiagnostic.astro — Flagship 2-minute Controller Health Checkup
 * Multi-step wizard:
 *   Step 1: Stick Drift & Circularity
 *   Step 2: Button Matrix & Ghosting
 *   Step 3: Trigger Linearity (L2/R2)
 *   Step 4: Vibration/Rumble Motors
 *   Step 5: Health Score Calculation & Summary
 *
 * UPGRADED: Premium High-Energy Wizard UI
 */
---

<div class="diagnostic-wizard relative rounded-3xl overflow-hidden p-[1px] bg-gradient-to-b from-white/10 to-transparent shadow-2xl" id="diag-wizard">
  <div class="absolute inset-0 bg-[#0A0A0E] z-0"></div>
  <div class="ambient-glow absolute -top-[50%] -left-[50%] w-[200%] h-[200%] pointer-events-none z-0 bg-[radial-gradient(ellipse_at_center,rgba(59,130,246,0.08)_0%,transparent_50%)]"></div>

  <div class="wizard-container relative z-10 flex flex-col p-6 sm:p-10 gap-8 h-full bg-[#0A0A0E]/80 backdrop-blur-3xl rounded-[calc(1.5rem-1px)]">
    
    {/* ── Wizard Progress Bar ── */}
    <div class="wizard-header flex flex-col gap-4">
      <div class="wizard-steps-nav flex gap-2 w-full justify-between" role="tablist" aria-label="Diagnostic steps">
        <div class="wiz-step active" id="step-nav-1" role="tab">1. Sticks</div>
        <div class="wiz-step" id="step-nav-2" role="tab">2. Buttons</div>
        <div class="wiz-step" id="step-nav-3" role="tab">3. Triggers</div>
        <div class="wiz-step" id="step-nav-4" role="tab">4. Rumble</div>
        <div class="wiz-step" id="step-nav-5" role="tab">5. Score</div>
      </div>
      <div class="wizard-progress w-full h-1.5 bg-white/5 rounded-full overflow-hidden">
        <div class="wizard-progress-fill h-full bg-blue-500 shadow-[0_0_12px_rgba(59,130,246,0.8)] transition-all duration-500 ease-out" id="wizard-progress-bar" style="width: 20%"></div>
      </div>
    </div>

    {/* ── Step 1: Sticks Diagnostic ── */}
    <div class="wiz-panel active" id="wiz-panel-1">
      <div class="panel-header text-center mb-6">
        <h3 class="text-2xl font-bold tracking-tight text-white mb-2">Analog Stick Calibration</h3>
        <p class="text-stone-400 text-sm">Rotate both analog sticks in full circles, then release them completely.</p>
      </div>
      <div class="panel-body">
        <div class="diag-metrics-row grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="diag-metric-box glass-card">
            <span class="d-label">Left Stick Drift</span>
            <span class="d-val text-yellow-500 text-glow-yellow" id="diag-left-drift">0.0%</span>
          </div>
          <div class="diag-metric-box glass-card">
            <span class="d-label">Right Stick Drift</span>
            <span class="d-val text-emerald-400 text-glow-emerald" id="diag-right-drift">0.0%</span>
          </div>
          <div class="diag-metric-box glass-card">
            <span class="d-label">Circularity Error</span>
            <span class="d-val text-emerald-400 text-glow-emerald" id="diag-circ-error">0.0%</span>
          </div>
        </div>
      </div>
      <div class="panel-footer flex justify-end mt-8 border-t border-white/10 pt-6">
        <button type="button" class="premium-btn primary-gradient" id="btn-next-1">Next: Test Buttons &rarr;</button>
      </div>
    </div>

    {/* ── Step 2: Button Matrix ── */}
    <div class="wiz-panel" id="wiz-panel-2">
      <div class="panel-header text-center mb-6">
        <h3 class="text-2xl font-bold tracking-tight text-white mb-2">Button Response & Ghosting</h3>
        <p class="text-stone-400 text-sm">Press every button on your controller once. Each button will light up green when confirmed.</p>
      </div>
      <div class="panel-body">
        <div class="buttons-matrix grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="btn-test-chip" id="bchip-0">Cross / A</div>
          <div class="btn-test-chip" id="bchip-1">Circle / B</div>
          <div class="btn-test-chip" id="bchip-2">Square / X</div>
          <div class="btn-test-chip" id="bchip-3">Triangle / Y</div>
          <div class="btn-test-chip" id="bchip-4">L1 / LB</div>
          <div class="btn-test-chip" id="bchip-5">R1 / RB</div>
          <div class="btn-test-chip" id="bchip-8">Share / Back</div>
          <div class="btn-test-chip" id="bchip-9">Options / Start</div>
          <div class="btn-test-chip md:col-span-2" id="bchip-10">L3 (Left Stick Click)</div>
          <div class="btn-test-chip md:col-span-2" id="bchip-11">R3 (Right Stick Click)</div>
          <div class="btn-test-chip" id="bchip-12">D-Pad Up</div>
          <div class="btn-test-chip" id="bchip-13">D-Pad Down</div>
          <div class="btn-test-chip" id="bchip-14">D-Pad Left</div>
          <div class="btn-test-chip" id="bchip-15">D-Pad Right</div>
        </div>
      </div>
      <div class="panel-footer flex justify-between mt-8 border-t border-white/10 pt-6">
        <button type="button" class="premium-btn ghost-btn" id="btn-prev-2">&larr; Back</button>
        <button type="button" class="premium-btn primary-gradient" id="btn-next-2">Next: Test Triggers &rarr;</button>
      </div>
    </div>

    {/* ── Step 3: Triggers ── */}
    <div class="wiz-panel" id="wiz-panel-3">
      <div class="panel-header text-center mb-6">
        <h3 class="text-2xl font-bold tracking-tight text-white mb-2">Trigger Pressure Linearity</h3>
        <p class="text-stone-400 text-sm">Press L2 and R2 slowly from 0% to 100% full pull.</p>
      </div>
      <div class="panel-body">
        <div class="triggers-progress-wrap flex flex-col gap-6">
          <div class="trigger-bar-box p-6 glass-card">
            <div class="flex justify-between items-end mb-3">
              <span class="text-sm font-bold tracking-wider text-stone-300 uppercase">L2 Trigger</span>
              <span class="font-mono text-2xl text-blue-400 font-bold" id="l2-val-text">0%</span>
            </div>
            <div class="w-full h-3 bg-black/50 rounded-full overflow-hidden inset-shadow">
              <div class="h-full bg-blue-500 shadow-[0_0_12px_rgba(59,130,246,0.8)] transition-all duration-75" id="l2-bar" style="width: 0%"></div>
            </div>
          </div>
          <div class="trigger-bar-box p-6 glass-card">
            <div class="flex justify-between items-end mb-3">
              <span class="text-sm font-bold tracking-wider text-stone-300 uppercase">R2 Trigger</span>
              <span class="font-mono text-2xl text-blue-400 font-bold" id="r2-val-text">0%</span>
            </div>
            <div class="w-full h-3 bg-black/50 rounded-full overflow-hidden inset-shadow">
              <div class="h-full bg-blue-500 shadow-[0_0_12px_rgba(59,130,246,0.8)] transition-all duration-75" id="r2-bar" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="panel-footer flex justify-between mt-8 border-t border-white/10 pt-6">
        <button type="button" class="premium-btn ghost-btn" id="btn-prev-3">&larr; Back</button>
        <button type="button" class="premium-btn primary-gradient" id="btn-next-3">Next: Test Rumble &rarr;</button>
      </div>
    </div>

    {/* ── Step 4: Vibration / Rumble ── */}
    <div class="wiz-panel" id="wiz-panel-4">
      <div class="panel-header text-center mb-6">
        <h3 class="text-2xl font-bold tracking-tight text-white mb-2">Vibration Motor Test</h3>
        <p class="text-stone-400 text-sm">Click below to test heavy and light rumble motors.</p>
      </div>
      <div class="panel-body">
        <div class="rumble-controls grid grid-cols-1 md:grid-cols-2 gap-4">
          <button type="button" class="premium-btn ghost-glass" id="btn-vibrate-heavy">
            Pulse Heavy Motor (Left)
          </button>
          <button type="button" class="premium-btn ghost-glass" id="btn-vibrate-light">
            Pulse Light Motor (Right)
          </button>
          <button type="button" class="premium-btn ghost-glass md:col-span-2" id="btn-vibrate-both">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 inline"><path d="m22 2-2.2 2.2"/><path d="m2 22 2.2-2.2"/><path d="m2 2 2.2 2.2"/><path d="m22 22-2.2-2.2"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M2 12h2"/><path d="M20 12h2"/></svg>
            Test Both Motors Simultaneously
          </button>
        </div>
      </div>
      <div class="panel-footer flex justify-between mt-8 border-t border-white/10 pt-6">
        <button type="button" class="premium-btn ghost-btn" id="btn-prev-4">&larr; Back</button>
        <button type="button" class="premium-btn primary-gradient" id="btn-next-4">Calculate Final Score &rarr;</button>
      </div>
    </div>

    {/* ── Step 5: Final Score ── */}
    <div class="wiz-panel" id="wiz-panel-5">
      <div class="panel-header text-center mb-2">
        <h3 class="text-2xl font-bold tracking-tight text-white">Diagnostic Results</h3>
      </div>
      <div class="panel-body final-score-body flex justify-center py-8">
        <div class="score-card-hero flex flex-col items-center text-center gap-6 p-10 glass-card rounded-3xl relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-blue-500/10 to-transparent pointer-events-none"></div>
          <div class="score-number-wrap flex flex-col sm:flex-row items-center sm:items-baseline gap-4 relative z-10">
            <span class="score-display text-8xl font-black text-transparent bg-clip-text bg-gradient-to-br from-white to-stone-400 drop-shadow-2xl" id="final-score-num">88</span>
            <span class="score-grade-badge inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold tracking-widest uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/50 shadow-[0_0_15px_rgba(16,185,129,0.2)]" id="final-score-grade">GRADE A</span>
          </div>
          <p class="score-summary-text text-lg text-stone-300 max-w-lg leading-relaxed relative z-10" id="final-score-summary">
            Your controller is in Excellent condition! Stick drift is negligible and all buttons respond within nominal thresholds.
          </p>
        </div>
      </div>
      <div class="panel-footer flex justify-between mt-8 border-t border-white/10 pt-6">
        <button type="button" class="premium-btn ghost-btn" id="btn-prev-5">&larr; Re-test</button>
        <a href="/test/controller/health-score" class="premium-btn border-gradient shadow-blue-glow">View Full Printable Report &rarr;</a>
      </div>
    </div>

  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';
  import { addPoints } from '../../../lib/rewards';

  let rewarded = false;

  document.addEventListener('DOMContentLoaded', () => {
    let currentStep = 1;

    function awardCompletion(): void {
      if (rewarded) return;
      rewarded = true;
      addPoints(50);
    }

    function showStep(step: number) {
      if (step === 5) awardCompletion();
      currentStep = step;

      // Update step nav headers
      for (let i = 1; i <= 5; i++) {
        const nav = document.getElementById(`step-nav-${i}`);
        const panel = document.getElementById(`wiz-panel-${i}`);
        if (nav) nav.className = i === step ? 'wiz-step active' : i < step ? 'wiz-step done' : 'wiz-step';
        if (panel) panel.style.display = i === step ? 'block' : 'none';
        
        // Add entrance animation class to active panel
        if (i === step && panel) {
          panel.classList.remove('animate-in');
          void panel.offsetWidth; // trigger reflow
          panel.classList.add('animate-in');
        }
      }

      // Update progress fill
      const bar = document.getElementById('wizard-progress-bar');
      if (bar) bar.style.width = `${(step / 5) * 100}%`;
    }

    // Step Navigation Listeners
    document.getElementById('btn-next-1')?.addEventListener('click', () => showStep(2));
    document.getElementById('btn-prev-2')?.addEventListener('click', () => showStep(1));
    document.getElementById('btn-next-2')?.addEventListener('click', () => showStep(3));
    document.getElementById('btn-prev-3')?.addEventListener('click', () => showStep(2));
    document.getElementById('btn-next-3')?.addEventListener('click', () => showStep(4));
    document.getElementById('btn-prev-4')?.addEventListener('click', () => showStep(3));
    document.getElementById('btn-next-4')?.addEventListener('click', () => showStep(5));
    document.getElementById('btn-prev-5')?.addEventListener('click', () => showStep(1));

    // Initialize first step
    showStep(1);

    // Live Gamepad Polling
    function pollDiagnostic() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const state = parseGamepadState(activeGp);

        // Step 1 update
        const lDrift = document.getElementById('diag-left-drift');
        const rDrift = document.getElementById('diag-right-drift');
        if (lDrift) {
          lDrift.textContent = `${state.leftStick.driftPct}%`;
          lDrift.className = state.leftStick.driftPct > 10 ? 'd-val text-red-500 text-glow-red' : (state.leftStick.driftPct > 2 ? 'd-val text-yellow-500 text-glow-yellow' : 'd-val text-emerald-400 text-glow-emerald');
        }
        if (rDrift) {
          rDrift.textContent = `${state.rightStick.driftPct}%`;
          rDrift.className = state.rightStick.driftPct > 10 ? 'd-val text-red-500 text-glow-red' : (state.rightStick.driftPct > 2 ? 'd-val text-yellow-500 text-glow-yellow' : 'd-val text-emerald-400 text-glow-emerald');
        }

        // Step 2 update: buttons
        state.buttons.forEach((btn, idx) => {
          const chip = document.getElementById(`bchip-${idx}`);
          if (chip) {
            if (btn.pressed) {
              chip.classList.add('pressed');
            } else {
              // We don't remove 'pressed' to allow user to see what they've successfully hit
              // chip.classList.remove('pressed'); 
            }
          }
        });

        // Step 3 update: triggers
        const l2Text = document.getElementById('l2-val-text');
        const r2Text = document.getElementById('r2-val-text');
        const l2Bar = document.getElementById('l2-bar');
        const r2Bar = document.getElementById('r2-bar');

        const l2Pct = Math.round(state.triggers.l2 * 100);
        const r2Pct = Math.round(state.triggers.r2 * 100);

        if (l2Text) l2Text.textContent = `${l2Pct}%`;
        if (r2Text) r2Text.textContent = `${r2Pct}%`;
        if (l2Bar) {
          l2Bar.style.width = `${l2Pct}%`;
          l2Bar.style.boxShadow = l2Pct > 10 ? '0 0 16px rgba(59,130,246,0.8)' : 'none';
        }
        if (r2Bar) {
          r2Bar.style.width = `${r2Pct}%`;
          r2Bar.style.boxShadow = r2Pct > 10 ? '0 0 16px rgba(59,130,246,0.8)' : 'none';
        }
      }

      requestAnimationFrame(pollDiagnostic);
    }

    pollDiagnostic();

    // Vibration API test
    async function triggerVibration(duration = 300, strong = 1.0, weak = 1.0) {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      for (const gp of gamepads) {
        if (gp && gp.vibrationActuator) {
          try {
            await gp.vibrationActuator.playEffect('dual-rumble', {
              startDelay: 0,
              duration: duration,
              weakMagnitude: weak,
              strongMagnitude: strong,
            });
          } catch (e) {}
        }
      }
    }

    document.getElementById('btn-vibrate-heavy')?.addEventListener('click', () => triggerVibration(500, 1.0, 0.0));
    document.getElementById('btn-vibrate-light')?.addEventListener('click', () => triggerVibration(500, 0.0, 1.0));
    document.getElementById('btn-vibrate-both')?.addEventListener('click', () => triggerVibration(800, 1.0, 1.0));
  });
</script>

<style>
  /* Base Components */
  .wiz-panel {
    display: none;
  }
  .animate-in {
    animation: fadeSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Wizard Steps Nav */
  .wiz-step {
    flex: 1;
    text-align: center;
    padding: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.4);
    border-radius: 0.5rem;
    transition: all 0.3s;
  }
  .wiz-step.active {
    color: #60A5FA;
    background: rgba(59,130,246,0.1);
    box-shadow: inset 0 0 0 1px rgba(59,130,246,0.3);
  }
  .wiz-step.done {
    color: #34D399;
  }

  /* Glass Cards */
  .glass-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 1rem;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
  }

  /* Metrics */
  .d-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.5);
  }
  .d-val {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.75rem;
    font-weight: 700;
  }
  .text-glow-emerald { text-shadow: 0 0 15px rgba(52, 211, 153, 0.6); }
  .text-glow-yellow { text-shadow: 0 0 15px rgba(234, 179, 8, 0.6); }
  .text-glow-red { text-shadow: 0 0 15px rgba(239, 68, 68, 0.6); }

  /* Buttons Matrix */
  .btn-test-chip {
    padding: 0.75rem 0.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
    text-align: center;
    transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .btn-test-chip.pressed {
    background: rgba(16, 185, 129, 0.15);
    border-color: #10B981;
    color: #34D399;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.3), inset 0 0 10px rgba(16,185,129,0.2);
    transform: scale(1.05);
  }

  /* Buttons */
  .premium-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s;
  }
  .primary-gradient {
    background: linear-gradient(135deg, #3B82F6, #2563EB);
    color: white;
    box-shadow: 0 4px 14px 0 rgba(37,99,235,0.39);
  }
  .primary-gradient:hover {
    box-shadow: 0 6px 20px rgba(37,99,235,0.5);
    transform: translateY(-1px);
  }
  .ghost-btn {
    color: rgba(255,255,255,0.6);
  }
  .ghost-btn:hover {
    color: white;
    background: rgba(255,255,255,0.1);
  }
  .ghost-glass {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
  }
  .ghost-glass:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.2);
  }
  .border-gradient {
    background: #000;
    color: white;
    position: relative;
    background-clip: padding-box;
    border: 1px solid transparent;
  }
  .border-gradient::before {
    content: '';
    position: absolute;
    top: -1px; right: -1px; bottom: -1px; left: -1px;
    background: linear-gradient(135deg, #60A5FA, #3B82F6);
    z-index: -1;
    border-radius: inherit;
  }
  .shadow-blue-glow {
    box-shadow: 0 0 20px rgba(59,130,246,0.3);
  }
  .shadow-blue-glow:hover {
    box-shadow: 0 0 30px rgba(59,130,246,0.5);
    transform: translateY(-1px);
  }

  .inset-shadow {
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
  }
</style>
