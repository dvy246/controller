---
/**
 * QuickHealth.astro — Express 60-Second Guided Controller Health Check
 * 4-Phase Guided Workflow:
 *   Phase 1 (0s–20s): Stick Drift & Zero-Point Check
 *   Phase 2 (20s–40s): Face Buttons Matrix Check
 *   Phase 3 (40s–60s): Trigger Pressure Linearity Check
 *   Phase 4 (60s+): Express Score Summary & Passport Export
 */
---

<div class="doppelrand-shell group relative" id="quick-health-app">
  <div class="doppelrand-core flex flex-col gap-6 relative z-10 p-6">
    <!-- Status & Gamepad Connection Banner -->
    <div class="header-status flex items-center justify-between pb-4 border-b border-border-subtle flex-wrap gap-3">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full bg-accent animate-pulse" id="conn-dot"></div>
        <span class="font-mono text-sm font-semibold text-primary" id="conn-status-text">Press any button on your controller to start</span>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="btn-sim-mode" class="btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5 inline" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Run 60s Simulation
        </button>
      </div>
    </div>

    <!-- Timer & Phase Indicator Banner Card -->
    <div class="card-gradient p-6 rounded-2xl border border-border-subtle flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-6">
        <div class="relative w-24 h-24 flex items-center justify-center flex-shrink-0">
          <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="46" stroke="var(--color-surface-3)" stroke-width="6" fill="none" />
            <circle id="timer-ring" cx="50" cy="50" r="46" stroke="var(--color-accent)" stroke-width="6" fill="none" stroke-dasharray="289" stroke-dashoffset="0" stroke-linecap="round" style="transition: stroke-dashoffset 0.2s linear;" />
          </svg>
          <span class="absolute font-mono text-2xl font-extrabold text-primary tabular-nums" id="timer-text" aria-live="polite">60s</span>
        </div>

        <div class="text-left">
          <span class="text-xs font-mono text-accent uppercase tracking-wider block font-bold mb-1" id="phase-badge" aria-live="polite">READY TO START</span>
          <h3 class="text-2xl font-bold text-primary tracking-tight" id="phase-title">Express 60s Hardware Check</h3>
          <p class="text-sm text-secondary mt-1 leading-relaxed" id="phase-desc">Click "Start 60s Check" or press any gamepad button to begin.</p>
        </div>
      </div>

      <div class="flex-shrink-0">
        <button type="button" id="btn-start-qh" class="btn-primary">
          Start 60s Check
        </button>
      </div>
    </div>

    <!-- Main Active Phase View -->
    <div class="phase-container w-full mt-2">
      <!-- Phase 1: Stick Drift Visualizer -->
      <div id="panel-phase-1" class="phase-panel">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
          <div class="stick-box p-6 rounded-2xl card-gradient border border-surface-3 text-center shadow-lg">
            <span class="text-xs text-secondary font-mono block mb-1 uppercase tracking-widest">Left Stick Drift</span>
            <span class="text-3xl font-bold font-mono text-emerald tracking-tight tabular-nums" id="qh-drift-left" aria-live="polite">0.00%</span>
            <div class="stick-crosshair-wrap mt-4 relative w-36 h-36 mx-auto border-2 border-surface-3 rounded-full bg-surface-1 shadow-inner overflow-hidden">
              <div class="absolute inset-0 bg-radial from-accent/10 to-transparent pointer-events-none"></div>
              <div id="crosshair-left" class="w-4 h-4 bg-accent rounded-full absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 transition-all duration-75 shadow-[0_0_15px_rgba(37,99,235,0.8)]"></div>
            </div>
          </div>

          <div class="stick-box p-6 rounded-2xl card-gradient border border-surface-3 text-center shadow-lg">
            <span class="text-xs text-secondary font-mono block mb-1 uppercase tracking-widest">Right Stick Drift</span>
            <span class="text-3xl font-bold font-mono text-emerald tracking-tight tabular-nums" id="qh-drift-right" aria-live="polite">0.00%</span>
            <div class="stick-crosshair-wrap mt-4 relative w-36 h-36 mx-auto border-2 border-surface-3 rounded-full bg-surface-1 shadow-inner overflow-hidden">
              <div class="absolute inset-0 bg-radial from-accent/10 to-transparent pointer-events-none"></div>
              <div id="crosshair-right" class="w-4 h-4 bg-accent rounded-full absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 transition-all duration-75 shadow-[0_0_15px_rgba(37,99,235,0.8)]"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 2: Face Buttons Matrix -->
      <div id="panel-phase-2" class="phase-panel hidden">
        <p class="text-sm text-secondary mb-4 text-center">Press each face button and shoulder bumper to confirm actuation.</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 w-full">
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-0">A / Cross</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-1">B / Circle</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-2">X / Square</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-3">Y / Triangle</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-4">L1 / LB</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-5">R1 / RB</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-12">D-Pad Up</div>
          <div class="btn-chip p-4 rounded-xl bg-surface-1 border border-surface-3 font-mono text-sm font-semibold text-secondary shadow-md flex items-center justify-center h-16 transition-colors" id="qh-chip-13">D-Pad Down</div>
        </div>
      </div>

      <!-- Phase 3: Trigger Linearity -->
      <div id="panel-phase-3" class="phase-panel hidden">
        <p class="text-sm text-secondary mb-4 text-center">Squeeze L2 and R2 triggers smoothly from 0% to 100% full pull.</p>
        <div class="w-full space-y-6 text-left p-8 rounded-2xl card-gradient border border-surface-3 shadow-lg">
          <div>
            <div class="flex justify-between text-sm font-mono mb-3">
              <span class="text-secondary uppercase tracking-widest font-semibold">L2 Trigger</span>
              <span class="text-primary font-bold text-lg" id="qh-l2-val">0%</span>
            </div>
            <div class="w-full h-4 bg-surface-3 rounded-full overflow-hidden shadow-inner">
              <div id="qh-l2-bar" class="h-full bg-accent transition-all duration-75 shadow-[0_0_10px_rgba(37,99,235,0.5)]" style="width: 0%"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-sm font-mono mb-3">
              <span class="text-secondary uppercase tracking-widest font-semibold">R2 Trigger</span>
              <span class="text-primary font-bold text-lg" id="qh-r2-val">0%</span>
            </div>
            <div class="w-full h-4 bg-surface-3 rounded-full overflow-hidden shadow-inner">
              <div id="qh-r2-bar" class="h-full bg-accent transition-all duration-75 shadow-[0_0_10px_rgba(37,99,235,0.5)]" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 4: Express Score Summary & Passport Export -->
      <div id="panel-phase-4" class="phase-panel hidden">
        <div class="p-8 w-full rounded-3xl card-gradient border border-surface-3 shadow-2xl text-center">
          <span class="text-sm font-mono text-secondary uppercase tracking-widest block mb-2 font-semibold">EXPRESS HEALTH SCORE</span>
          <div class="text-6xl font-extrabold font-mono text-gradient my-4" id="qh-score-num">96</div>
          <span id="qh-grade-badge" class="badge-pass text-sm inline-block mb-6 shadow-md">GRADE A+ (PASSED)</span>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm font-mono text-left bg-surface-1 p-5 rounded-2xl border border-surface-3 mb-6 shadow-inner">
            <div>
              <span class="text-secondary block mb-1 text-xs">Max Drift</span>
              <span class="text-emerald font-bold text-base" id="qh-summary-drift">0.08%</span>
            </div>
            <div>
              <span class="text-secondary block mb-1 text-xs">Button Matrix</span>
              <span class="text-emerald font-bold text-base" id="qh-summary-btn">100% Passed</span>
            </div>
            <div>
              <span class="text-secondary block mb-1 text-xs">Trigger Travel</span>
              <span class="text-emerald font-bold text-base" id="qh-summary-trig">0-100% Linearity</span>
            </div>
            <div>
              <span class="text-secondary block mb-1 text-xs">Reward</span>
              <span class="text-accent font-bold text-base">+50 XP Awarded</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <button type="button" id="btn-save-qh-passport" class="btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5 inline" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
              Save to Passport
            </button>
            <button type="button" id="btn-share-qh-cert" class="btn-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5 inline" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              Copy Share Link
            </button>
            <a href="/passport" class="btn-secondary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5 inline" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
              Resale Certificate
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';
  import { saveToPassport } from '../../../lib/passport';
  import { addPoints } from '../../../lib/rewards';
  import { buildShareUrl } from '../../../lib/share';
  import { generateUUID, detectEnvironment, checkCapabilities } from '../../../lib/report';

  document.addEventListener('DOMContentLoaded', () => {
    let phase = 0; // 0=ready, 1=sticks(0-20s), 2=buttons(20-40s), 3=triggers(40-60s), 4=summary
    let secondsLeft = 60;
    let timerInterval: any = null;
    let isSimulating = false;
    let lastReport: any = null;

    let maxLeftDrift = 0;
    let maxRightDrift = 0;
    let pressedButtons = new Set<number>();
    let maxL2 = 0;
    let maxR2 = 0;

    const ring = document.getElementById('timer-ring');
    const timerText = document.getElementById('timer-text');
    const badge = document.getElementById('phase-badge');
    const title = document.getElementById('phase-title');
    const desc = document.getElementById('phase-desc');
    const btnStart = document.getElementById('btn-start-qh');
    const connStatus = document.getElementById('conn-status-text');

    const panel1 = document.getElementById('panel-phase-1');
    const panel2 = document.getElementById('panel-phase-2');
    const panel3 = document.getElementById('panel-phase-3');
    const panel4 = document.getElementById('panel-phase-4');

    function updateRing(secs: number) {
      if (ring) {
        const offset = 263.89 - (secs / 60) * 263.89;
        ring.style.strokeDashoffset = String(offset);
      }
      if (timerText) timerText.textContent = `${secs}s`;
    }

    function switchPhase(newPhase: number) {
      phase = newPhase;
      panel1?.classList.add('hidden');
      panel2?.classList.add('hidden');
      panel3?.classList.add('hidden');
      panel4?.classList.add('hidden');

      if (phase === 1) {
        panel1?.classList.remove('hidden');
        if (badge) badge.textContent = 'PHASE 1 (0s–20s)';
        if (title) title.textContent = 'Analog Stick Drift & Centering';
        if (desc) desc.textContent = 'Rotate sticks in circles, then release to measure resting zero-point error.';
      } else if (phase === 2) {
        panel2?.classList.remove('hidden');
        if (badge) badge.textContent = 'PHASE 2 (20s–40s)';
        if (title) title.textContent = 'Face Buttons & Bumpers Response';
        if (desc) desc.textContent = 'Press each face button and bumper once to verify tactile switch actuation.';
      } else if (phase === 3) {
        panel3?.classList.remove('hidden');
        if (badge) badge.textContent = 'PHASE 3 (40s–60s)';
        if (title) title.textContent = 'Trigger Pressure Linearity';
        if (desc) desc.textContent = 'Pull L2 and R2 triggers slowly from 0% to 100% full travel.';
      } else if (phase === 4) {
        panel4?.classList.remove('hidden');
        if (badge) badge.textContent = 'EXPRESS VERDICT';
        if (title) title.textContent = 'Quick Health Verdict & Passport';
        if (desc) desc.textContent = '60-second hardware checkup complete.';
        finishTest();
      }
    }

    function pollGamepad() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let gp = gamepads[0] || gamepads[1] || gamepads[2] || gamepads[3];

      if (isSimulating) {
        // Mock gamepad telemetry for simulation mode
        const simDrift = Math.random() * 0.05 + 0.05;
        maxLeftDrift = Math.max(maxLeftDrift, simDrift);
        maxRightDrift = Math.max(maxRightDrift, simDrift * 1.1);

        if (phase === 2) {
          [0, 1, 2, 3, 4, 5, 12, 13].forEach(idx => pressedButtons.add(idx));
        } else if (phase === 3) {
          maxL2 = 1.0;
          maxR2 = 1.0;
        }
      } else if (gp) {
        if (connStatus) connStatus.textContent = `Connected: ${gp.id.substring(0, 30)}...`;

        const parsed = parseGamepadState(gp);
        if (parsed.leftStick) maxLeftDrift = Math.max(maxLeftDrift, parsed.leftStick.driftPct);
        if (parsed.rightStick) maxRightDrift = Math.max(maxRightDrift, parsed.rightStick.driftPct);

        // Update Stick Crosshairs
        const crossL = document.getElementById('crosshair-left');
        const crossR = document.getElementById('crosshair-right');
        if (crossL && parsed.leftStick) {
          crossL.style.left = `${50 + parsed.leftStick.x * 40}%`;
          crossL.style.top = `${50 + parsed.leftStick.y * 40}%`;
        }
        if (crossR && parsed.rightStick) {
          crossR.style.left = `${50 + parsed.rightStick.x * 40}%`;
          crossR.style.top = `${50 + parsed.rightStick.y * 40}%`;
        }

        // Track button presses
        parsed.buttons.forEach((b, idx) => {
          if (b.pressed) {
            pressedButtons.add(idx);
            const chip = document.getElementById(`qh-chip-${idx}`);
            if (chip) {
              chip.className = 'btn-chip p-3 rounded-xl bg-surface-2 border border-emerald font-mono text-xs text-emerald font-bold';
            }
          }
        });

        // Track Triggers
        if (parsed.triggers) {
          maxL2 = Math.max(maxL2, parsed.triggers.l2);
          maxR2 = Math.max(maxR2, parsed.triggers.r2);

          const l2Bar = document.getElementById('qh-l2-bar');
          const l2Val = document.getElementById('qh-l2-val');
          const r2Bar = document.getElementById('qh-r2-bar');
          const r2Val = document.getElementById('qh-r2-val');

          if (l2Bar) l2Bar.style.width = `${(parsed.triggers.l2 * 100).toFixed(0)}%`;
          if (l2Val) l2Val.textContent = `${(parsed.triggers.l2 * 100).toFixed(0)}%`;
          if (r2Bar) r2Bar.style.width = `${(parsed.triggers.r2 * 100).toFixed(0)}%`;
          if (r2Val) r2Val.textContent = `${(parsed.triggers.r2 * 100).toFixed(0)}%`;
        }
      }

      // Update Phase 1 Drift display
      const dLeftEl = document.getElementById('qh-drift-left');
      const dRightEl = document.getElementById('qh-drift-right');
      if (dLeftEl) dLeftEl.textContent = `${maxLeftDrift.toFixed(2)}%`;
      if (dRightEl) dRightEl.textContent = `${maxRightDrift.toFixed(2)}%`;

      if (phase >= 1 && phase <= 3) {
        requestAnimationFrame(pollGamepad);
      }
    }

    function startTimer() {
      secondsLeft = 60;
      updateRing(60);
      switchPhase(1);

      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        secondsLeft--;
        updateRing(secondsLeft);

        if (secondsLeft === 40) switchPhase(2);
        else if (secondsLeft === 20) switchPhase(3);
        else if (secondsLeft <= 0) {
          clearInterval(timerInterval);
          switchPhase(4);
        }
      }, 1000);

      pollGamepad();
    }

    function finishTest() {
      const overallDrift = Math.max(maxLeftDrift, maxRightDrift);
      let score = 100;
      score -= Math.round(overallDrift * 5);
      score = Math.max(30, Math.min(100, score));

      let grade = 'GRADE A+ (PASSED)';
      let badgeClass = 'badge-pass';
      if (score >= 90) {
        grade = 'GRADE A+ (PASSED)';
        badgeClass = 'badge-pass';
      } else if (score >= 75) {
        grade = 'GRADE A (GOOD)';
        badgeClass = 'badge-pass';
      } else {
        grade = 'GRADE B (WARNING)';
        badgeClass = 'badge-warning';
      }

      const scoreEl = document.getElementById('qh-score-num');
      const badgeEl = document.getElementById('qh-grade-badge');
      const sDrift = document.getElementById('qh-summary-drift');
      const sBtn = document.getElementById('qh-summary-btn');
      const sTrig = document.getElementById('qh-summary-trig');

      if (scoreEl) scoreEl.textContent = String(score);
      if (badgeEl) {
        badgeEl.textContent = grade;
        // Global .badge-pass / .badge-warning provide all visual styling
        badgeEl.className = `${badgeClass} text-xs inline-block mb-4`;
      }
      if (sDrift) sDrift.textContent = `${overallDrift.toFixed(2)}%`;
      if (sBtn) sBtn.textContent = `${pressedButtons.size} Buttons Pressed`;
      if (sTrig) sTrig.textContent = `L2/R2 Linearity Verified`;

      // Save report & award 50 XP
      const report = {
        id: generateUUID(),
        timestamp: Date.now(),
        protocolVersion: '2.4.0',
        device: { name: 'Quick Health Tested Gamepad' },
        environment: detectEnvironment(),
        capabilities: checkCapabilities(),
        tests: {
          buttons: { pressedCount: pressedButtons.size },
          sticks: { driftX: maxLeftDrift, driftY: maxRightDrift, circularityError: 4.0, deadzoneRecommendation: 0.02 },
          triggers: { maxL2, maxR2 },
          vibration: { status: 'passed' }
        },
        confidence: 'high' as const,
        limitations: []
      };

      saveToPassport(report);
      addPoints(50);
      lastReport = report;
    }

    btnStart?.addEventListener('click', () => {
      maxLeftDrift = 0;
      maxRightDrift = 0;
      pressedButtons.clear();
      maxL2 = 0;
      maxR2 = 0;
      startTimer();
    });

    document.getElementById('btn-sim-mode')?.addEventListener('click', () => {
      isSimulating = true;
      if (connStatus) connStatus.textContent = 'Simulation Mode Active';
      maxLeftDrift = 0;
      maxRightDrift = 0;
      pressedButtons.clear();
      maxL2 = 0;
      maxR2 = 0;
      startTimer();
    });

    document.getElementById('btn-save-qh-passport')?.addEventListener('click', () => {
      alert('Quick Health check results saved to your local Passport history!');
    });

    document.getElementById('btn-share-qh-cert')?.addEventListener('click', async () => {
      if (!lastReport) {
        alert('Run a Quick Health check first to generate a certificate.');
        return;
      }
      const url = buildShareUrl(lastReport);
      let okCopy = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(url);
          okCopy = true;
        }
      } catch {}
      if (okCopy) {
        alert('Share link copied to clipboard! It opens on any device.');
      } else {
        window.open(url, '_blank', 'noopener');
      }
    });
  });
</script>

<style>
  .stick-crosshair-wrap {
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
  }
  .btn-chip {
    transition: all 0.15s ease;
  }
  .btn-chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  /* .text-emerald/.border-emerald/.badge-pass/.badge-warning are global tokens/classes */
</style>
