---
/**
 * ControllerHero.astro — 3D Three.js Realistic Controller Hero
 * 
 * Premium floating 3D controller implementation for the right column of the hero.
 */

export interface Props {
  modelUrl?: string;
  isRigid?: boolean;
}

const { modelUrl = '/models/controller.glb', isRigid = false } = Astro.props;
---
<div class="controller-3d-wrapper" id="hero-container" data-model-url={modelUrl} data-is-rigid={isRigid ? "true" : "false"}>
  
  <!-- Loading State -->
  <div class="loading-spinner" id="loading-spinner">
    <div class="spinner-ring"></div>
    <span class="loading-text">INITIALIZING 3D ENGINE...</span>
  </div>

  <!-- 3D Canvas -->
  <canvas id="webgl-canvas" class="webgl-canvas"></canvas>
  
  <!-- Subtle Tech Overlay / Badge -->
  <div class="telemetry-hud" id="telemetry-hud">
    <div class="status-indicator">
      <span class="status-dot" id="status-dot"></span>
      <span id="status-text">Awaiting Gamepad</span>
    </div>
    <div class="telemetry-dashboard" id="telemetry-data" style="display: none;">
      
      <!-- Sticks -->
      <div class="telemetry-section">
        <div class="telemetry-label">ANALOG STICKS</div>
        <div class="telemetry-row">
          <span class="telemetry-key">LS</span>
          <span class="telemetry-val" id="ls-val">0.00, 0.00</span>
        </div>
        <div class="telemetry-row">
          <span class="telemetry-key">RS</span>
          <span class="telemetry-val" id="rs-val">0.00, 0.00</span>
        </div>
      </div>
      
      <div class="telemetry-divider"></div>

      <!-- Triggers -->
      <div class="telemetry-section">
        <div class="telemetry-label">ANALOG TRIGGERS</div>
        <div class="telemetry-row">
          <span class="telemetry-key">LT</span>
          <div class="telemetry-bar-bg"><div class="telemetry-bar-fill" id="lt-val" style="width: 0%"></div></div>
        </div>
        <div class="telemetry-row">
          <span class="telemetry-key">RT</span>
          <div class="telemetry-bar-bg"><div class="telemetry-bar-fill" id="rt-val" style="width: 0%"></div></div>
        </div>
      </div>

      <div class="telemetry-divider"></div>

      <!-- Active Buttons -->
      <div class="telemetry-section">
        <div class="telemetry-label">ACTIVE INPUTS</div>
        <div class="telemetry-buttons" id="active-buttons">
          <span class="telemetry-empty">None</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Awaiting Connection Overlay -->
  <div id="awaiting-connection-overlay" class="absolute inset-0 z-40 flex flex-col items-center justify-center p-6 bg-surface-0/60 backdrop-blur-sm transition-opacity duration-500 pointer-events-none opacity-100">
    <div class="doppelrand-shell p-[0.375rem] rounded-full bg-accent/10 shadow-[0_0_40px_rgba(37,99,235,0.2)] animate-pulse">
      <div class="doppelrand-core bg-surface-1 border border-accent/30 rounded-full px-8 py-4 flex items-center gap-4 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)]">
        <div class="relative w-4 h-4 flex items-center justify-center">
          <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span>
        </div>
        <span class="text-primary font-bold tracking-wide">Waiting for Controller...</span>
      </div>
    </div>
    <p class="text-secondary text-sm mt-6 max-w-sm text-center font-mono">Connect your controller via USB or Bluetooth and press any button to begin.</p>
  </div>

  <!-- Hardware Mismatch Error Overlay -->
  <div id="mismatch-overlay" class="absolute inset-0 z-50 flex items-center justify-center p-6 bg-surface-0/90 backdrop-blur-md" style="display: none;">
    <div class="text-center p-8 rounded-2xl bg-surface-1 border border-red-500/50 shadow-[0_0_50px_rgba(239,68,68,0.2)] max-w-md">
      <div class="w-16 h-16 mx-auto bg-red-500/10 rounded-full flex items-center justify-center mb-4 border border-red-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-white mb-2">Hardware Mismatch</h3>
      <p class="text-secondary text-sm mb-6" id="mismatch-desc">We expected a PlayStation controller, but detected an Xbox controller.</p>
      <div class="flex gap-3 justify-center">
        <a href="/test/controller" class="btn-secondary text-xs">View All Testers</a>
        <a href="/test/controller/drift" class="btn-primary text-xs">Use Universal Tester</a>
      </div>
    </div>
  </div>
</div>

<style>
  .controller-3d-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-spinner {
    position: absolute;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease;
    opacity: 0;
    pointer-events: none;
  }

  .loading-spinner.active {
    opacity: 1;
  }

  .spinner-ring {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(255,255,255,0.05);
    border-top-color: var(--color-primary, #3b82f6);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }

  .loading-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.15em;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .webgl-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    z-index: 1;
    outline: none;
    opacity: 0;
    transition: opacity 1.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .webgl-canvas.loaded {
    opacity: 1;
    z-index: 2;
  }

  .telemetry-hud {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transition: opacity 1s ease 0.5s;
  }
  
  .webgl-canvas.loaded ~ .telemetry-hud {
    opacity: 1;
  }

  .status-indicator {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 8px 16px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: all 0.3s ease;
  }
  .status-dot.connected { 
    background: var(--color-pass, #10b981); 
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.8); 
  }

  .telemetry-dashboard {
    background: rgba(6, 6, 11, 0.6);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 16px 20px;
    display: flex;
    gap: 24px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.5);
  }

  .telemetry-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 100px;
  }

  .telemetry-divider {
    width: 1px;
    background: rgba(255,255,255,0.1);
    align-self: stretch;
  }

  .telemetry-label {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.65rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.1em;
    margin-bottom: 4px;
  }

  .telemetry-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
  }

  .telemetry-key {
    color: rgba(255,255,255,0.5);
    font-weight: 600;
    width: 20px;
  }

  .telemetry-val {
    color: #3b82f6;
    font-weight: 700;
  }

  .telemetry-bar-bg {
    flex: 1;
    height: 6px;
    background: rgba(255,255,255,0.1);
    border-radius: 3px;
    overflow: hidden;
    width: 60px;
  }

  .telemetry-bar-fill {
    height: 100%;
    background: #3b82f6;
    border-radius: 3px;
    box-shadow: 0 0 8px rgba(59,130,246,0.6);
    transition: width 0.05s linear;
  }

  .telemetry-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-width: 120px;
  }

  .active-btn {
    background: rgba(59,130,246,0.2);
    border: 1px solid rgba(59,130,246,0.5);
    color: #60a5fa;
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    box-shadow: 0 0 8px rgba(59,130,246,0.3);
  }

  .telemetry-empty {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: rgba(255,255,255,0.2);
    font-style: italic;
  }
</style>

<script>
  // @ts-ignore
  import * as THREE from 'https://esm.sh/three@0.160.0';
  // @ts-ignore
  import { GLTFLoader } from 'https://esm.sh/three@0.160.0/examples/jsm/loaders/GLTFLoader.js';
  // @ts-ignore
  import { DRACOLoader } from 'https://esm.sh/three@0.160.0/examples/jsm/loaders/DRACOLoader.js';
  // @ts-ignore
  import { OrbitControls } from 'https://esm.sh/three@0.160.0/examples/jsm/controls/OrbitControls.js';
  import { parseGamepadState } from '../../../lib/gamepad.ts';

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('hero-container') as HTMLElement | null;
    const canvas = document.getElementById('webgl-canvas') as HTMLCanvasElement | null;
    const spinner = document.getElementById('loading-spinner') as HTMLElement | null;
    const maxRotation = 0.5;
    
    if (!container || !canvas) return;

    // Wait for DOM layout
    setTimeout(initThreeJS, 100); 

    let scene: any, camera: any, renderer: any, controls: any;
    let controllerModel: any;
    let leftStickNode: any = null;
    let rightStickNode: any = null;
    let isInteracting = false;
    
    function initThreeJS() {
      if (!container || !canvas || !spinner) return;
      spinner.classList.add('active');

      scene = new THREE.Scene();
      
      // Premium camera setup (tighter FOV for product shots)
      camera = new THREE.PerspectiveCamera(35, container.clientWidth / container.clientHeight, 0.1, 100);
      camera.position.set(0, 1.2, 4);

      renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // High-res for premium feel
      
      // Premium lighting setup
      // Use tone mapping for cinematic look
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.2;

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
      scene.add(ambientLight);

      // Key light
      const keyLight = new THREE.DirectionalLight(0xffffff, 2);
      keyLight.position.set(5, 5, 2);
      scene.add(keyLight);

      // Fill light (subtle blue/purple tint from left)
      const fillLight = new THREE.DirectionalLight(0x8b5cf6, 1.5);
      fillLight.position.set(-5, 0, 5);
      scene.add(fillLight);
      
      // Rim light (sharp highlight from behind)
      const rimLight = new THREE.DirectionalLight(0xffffff, 1.5);
      rimLight.position.set(0, 5, -5);
      scene.add(rimLight);

      controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.04;
      controls.enablePan = false;
      controls.enableZoom = false; // Prevent zooming which breaks layout
      controls.target.set(0, 0, 0);

      controls.addEventListener('start', () => isInteracting = true);
      controls.addEventListener('end', () => isInteracting = false);

      loadControllerModel();
      window.addEventListener('resize', onWindowResize);
      renderer.setAnimationLoop(animate);
    }

    function loadControllerModel() {
      const loader = new GLTFLoader();
      const dracoLoader = new DRACOLoader();
      dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
      loader.setDRACOLoader(dracoLoader);

      const modelUrl = container?.getAttribute('data-model-url') || '/models/controller.glb';
      
      // Load the actual controller GLB
      loader.load(
        modelUrl, 
        (gltf: any) => {
          controllerModel = gltf.scene;
          
          // Ensure materials look premium and find stick nodes
          controllerModel.traverse((child: any) => {
            if (child.isMesh && child.material) {
              // Boost environmental reflection if it's a standard material
              if (child.material.isMeshStandardMaterial) {
                child.material.envMapIntensity = 1.5;
                child.material.needsUpdate = true;
              }
            }
            
            // Try to find thumbstick nodes for live telemetry binding
            const name = child.name.toLowerCase();
            if ((name.includes('left') || name.includes('l3')) && (name.includes('stick') || name.includes('thumb'))) {
               leftStickNode = child;
            }
            if ((name.includes('right') || name.includes('r3')) && (name.includes('stick') || name.includes('thumb'))) {
               rightStickNode = child;
            }
          });

          // Center and scale model properly
          const box = new THREE.Box3().setFromObject(controllerModel);
          const center = box.getCenter(new THREE.Vector3());
          const size = box.getSize(new THREE.Vector3());
          
          // Normalize scale so it always fits perfectly regardless of original GLB scale
          const maxDim = Math.max(size.x, size.y, size.z);
          const scale = 2.0 / maxDim; // Target size of ~2 units
          controllerModel.scale.set(scale, scale, scale);
          
          controllerModel.position.sub(center.multiplyScalar(scale));
          
          const isRigid = container?.getAttribute('data-is-rigid') === 'true';
          if (!isRigid) {
            // Rotate it slightly for a better hero angle if floating
            controllerModel.rotation.x = 0.2;
            controllerModel.rotation.y = -0.3;
          } else {
            // Perfectly centered and straight for rigid diagnostic view
            controllerModel.rotation.x = 0;
            controllerModel.rotation.y = 0;
          }

          scene.add(controllerModel);

          if(spinner) spinner.classList.remove('active');
          if(canvas) canvas.classList.add('loaded');
        },
        undefined,
        (error: any) => {
          console.error('Error loading 3D model:', error);
          if(spinner) spinner.innerHTML = '<span style="color:#ef4444;">Failed to load model</span>';
        }
      );
    }

    const clock = new THREE.Clock();

    function animate() {
      clock.getDelta();
      controls.update();

      const isRigid = container?.getAttribute('data-is-rigid') === 'true';

      if (controllerModel && !isInteracting && !isRigid) {
        // Very slow premium rotation
        controllerModel.rotation.y += 0.002;
        // Floating hover effect
        controllerModel.position.y = Math.sin(clock.getElapsedTime()) * 0.03;
      }

      // Telemetry hook
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
      }

      const statusDot = document.getElementById('status-dot') as HTMLElement | null;
      const statusText = document.getElementById('status-text') as HTMLElement | null;
      const telemetryData = document.getElementById('telemetry-data') as HTMLElement | null;
      const mismatchOverlay = document.getElementById('mismatch-overlay') as HTMLElement | null;
      const mismatchDesc = document.getElementById('mismatch-desc') as HTMLElement | null;
      
      if (activeGp && statusDot && statusText && telemetryData && mismatchOverlay && mismatchDesc && canvas && container) {
        const state = parseGamepadState(activeGp);
        const pageModel = container.getAttribute('data-model') || '';
        const detectedLower = (state.detectedModel || '').toLowerCase();
        
        let expectedStr = "";
        let isMismatch = false;

        // Strict Hardware verification
        if (pageModel === 'playstation' && !detectedLower.includes('playstation') && !detectedLower.includes('dual')) {
          isMismatch = true;
          expectedStr = "PlayStation";
        } else if (pageModel === 'xbox' && !detectedLower.includes('xbox')) {
          isMismatch = true;
          expectedStr = "Xbox";
        } else if (pageModel === 'switch' && !detectedLower.includes('nintendo') && !detectedLower.includes('joy-con')) {
          isMismatch = true;
          expectedStr = "Nintendo Switch";
        }

        if (isMismatch) {
          mismatchOverlay.style.display = 'flex';
          mismatchDesc.textContent = `You are on the ${expectedStr} tester page, but a ${state.detectedModel || 'different gamepad'} was detected. Please switch to the correct testing tool.`;
          statusText.textContent = 'Hardware Mismatch';
          statusDot.classList.remove('connected');
          telemetryData.style.display = 'none';
          canvas.style.filter = 'blur(10px) grayscale(50%)';
          
          const awaitingOverlay = document.getElementById('awaiting-connection-overlay');
          if (awaitingOverlay) awaitingOverlay.style.opacity = '0';
        } else {
          mismatchOverlay.style.display = 'none';
          canvas.style.filter = 'none';

          const awaitingOverlay = document.getElementById('awaiting-connection-overlay');
          if (awaitingOverlay) awaitingOverlay.style.opacity = '0';

          statusDot.classList.add('connected');
          statusText.textContent = state.detectedModel || 'Controller Connected';
          telemetryData.style.display = 'flex';
          
          if (leftStickNode) {
            leftStickNode.rotation.x = state.leftStick.y * maxRotation;
            leftStickNode.rotation.z = -state.leftStick.x * maxRotation;
          }
          if (rightStickNode) {
            rightStickNode.rotation.x = state.rightStick.y * maxRotation;
            rightStickNode.rotation.z = -state.rightStick.x * maxRotation;
          }
          
          if (state.triggers.l2 > 0.1 || state.triggers.r2 > 0.1) {
            const avgTrigger = (state.triggers.l2 + state.triggers.r2) / 2;
            scene.children.forEach((child: any) => {
              if (child.isDirectionalLight && child.position.z === 5) {
                child.intensity = 1.5 + (avgTrigger * 2);
              }
            });
          }

          // 1. Triggers
          const ltVal = document.getElementById('lt-val');
          if (ltVal) ltVal.style.width = `${state.triggers.l2 * 100}%`;
          const rtVal = document.getElementById('rt-val');
          if (rtVal) rtVal.style.width = `${state.triggers.r2 * 100}%`;

        // 2. Buttons
        const activeBtnsNode = document.getElementById('active-buttons');
        if (activeBtnsNode) {
          // Standard Gamepad API Mapping
          const BTN_MAP = ["A/×", "B/○", "X/□", "Y/△", "L1", "R1", "L2", "R2", "Share", "Menu", "L3", "R3", "Up", "Down", "Left", "Right", "Home"];
          const activeHtml: string[] = [];
          
          state.buttons.forEach((btn, idx) => {
            if (btn.pressed) {
              const name = BTN_MAP[idx] || `B${idx}`;
              activeHtml.push(`<span class="active-btn">${name}</span>`);
            }
          });

          if (activeHtml.length > 0) {
            activeBtnsNode.innerHTML = activeHtml.join('');
          } else {
            activeBtnsNode.innerHTML = '<span class="telemetry-empty">None</span>';
          }
        }

        }
      } else {
        if (statusDot) statusDot.classList.remove('connected');
        if (statusText) {
          statusText.style.color = 'rgba(255,255,255,0.6)';
          statusText.textContent = 'Awaiting Gamepad';
        }
        if (telemetryData) telemetryData.style.display = 'none';
        if (mismatchOverlay) mismatchOverlay.style.display = 'none';
        
        const awaitingOverlay = document.getElementById('awaiting-connection-overlay');
        if (awaitingOverlay) awaitingOverlay.style.opacity = '1';
      }

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    }

    function onWindowResize() {
      if (!camera || !renderer || !container) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    }
  });
</script>
