---
/**
 * PlayStationSVG.astro
 * 1:1 Pixel-Perfect 2D Vector Graphic of the PlayStation DualShock 4 Controller.
 * Features central Touchpad with lightbar glow, SHARE & OPTIONS pill buttons,
 * speaker grille, PS Emblem button, iconic △ ◯ ✕ □ action symbols, split D-pad,
 * symmetrical analog thumbsticks (L3/R3), and L1/L2/R1/R2 triggers.
 */
---
<svg id="playstation-svg" viewBox="0 0 700 500" class="w-full max-w-[480px] max-h-[350px] select-none transition-transform duration-300 drop-shadow-[0_20px_40px_rgba(0,0,0,0.85)]" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Drop Shadow Filter for Buttons and Caps -->
    <filter id="ps-shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.7" />
    </filter>
    <filter id="ps-glow-blue" x="-50%" y="-50%" width="200%" height="200%">
      <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#3b82f6" flood-opacity="0.9" />
    </filter>
  </defs>

  <!-- ════════════════════════════════════════════════════════════════════════
       1. TOP SHOULDERS (L1 / L2 & R1 / R2)
       ════════════════════════════════════════════════════════════════════════ -->
  <g id="group-ps-triggers">
    <!-- L2 Trigger (Top Left Slider) -->
    <g id="btn-l2" data-btn="6" class="button-path cursor-pointer">
      <rect x="245" y="20" width="46" height="62" rx="14" class="fill-[#1A1B1F] stroke-[#3F424E] transition-colors" stroke-width="2" />
      <rect id="l2-wire-fill" x="247" y="22" width="42" height="58" rx="12" fill="#3B82F6" class="opacity-0 transition-opacity" />
    </g>
    <!-- R2 Trigger (Top Right Slider) -->
    <g id="btn-r2" data-btn="7" class="button-path cursor-pointer">
      <rect x="409" y="20" width="46" height="62" rx="14" class="fill-[#1A1B1F] stroke-[#3F424E] transition-colors" stroke-width="2" />
      <rect id="r2-wire-fill" x="411" y="22" width="42" height="58" rx="12" fill="#3B82F6" class="opacity-0 transition-opacity" />
    </g>

    <!-- L1 Bumper -->
    <g id="btn-l1" data-btn="4" class="button-path cursor-pointer">
      <rect x="235" y="80" width="70" height="28" rx="10" class="fill-[#24262E] stroke-[#4B4E5A] transition-colors" stroke-width="2" />
      <text x="270" y="98" class="fill-stone-300 font-mono font-bold text-[11px]" text-anchor="middle">L1</text>
    </g>
    <!-- R1 Bumper -->
    <g id="btn-r1" data-btn="5" class="button-path cursor-pointer">
      <rect x="395" y="80" width="70" height="28" rx="10" class="fill-[#24262E] stroke-[#4B4E5A] transition-colors" stroke-width="2" />
      <text x="430" y="98" class="fill-stone-300 font-mono font-bold text-[11px]" text-anchor="middle">R1</text>
    </g>
  </g>

  <!-- ════════════════════════════════════════════════════════════════════════
       2. MAIN BODY SHELL & ERGONOMIC GRIPS
       ════════════════════════════════════════════════════════════════════════ -->
  <!-- Outer Body Path (DualShock 4 Matte Black Shell) -->
  <path d="M 230,105 C 310,95 390,95 470,105 C 520,110 570,135 595,185 C 625,250 645,350 655,435 C 660,475 625,495 590,490 C 555,485 520,410 500,345 C 470,335 430,340 350,340 C 270,340 230,335 200,345 C 180,410 145,485 110,490 C 75,495 40,475 45,435 C 55,350 75,250 105,185 C 130,135 180,110 230,105 Z" fill="#1C1D21" stroke="#3F424E" stroke-width="2.5" />

  <!-- Left Handle Textured Bottom Grip -->
  <path d="M 105,185 C 75,250 55,350 45,435 C 40,475 75,495 110,490 C 135,485 160,440 175,385 C 150,320 125,250 105,185 Z" fill="#17181B" stroke="#2D2F36" stroke-width="1.5" />

  <!-- Right Handle Textured Bottom Grip -->
  <path d="M 595,185 C 625,250 645,350 655,435 C 660,475 625,495 590,490 C 565,485 540,440 525,385 C 550,320 575,250 595,185 Z" fill="#17181B" stroke="#2D2F36" stroke-width="1.5" />

  <!-- ════════════════════════════════════════════════════════════════════════
       3. CENTRAL TOUCHPAD, LIGHTBAR & METRICS (SHARE / OPTIONS / SPEAKER / PS)
       ════════════════════════════════════════════════════════════════════════ -->
  <!-- Central Touchpad (Button 17) -->
  <g id="touchpad-group" class="cursor-pointer" data-btn="17" filter="url(#ps-shadow)">
    <rect id="btn-touchpad" data-btn="17" x="255" y="112" width="190" height="98" rx="14" class="button-path fill-[#22242B] stroke-[#454854] transition-all" stroke-width="2" />
    <!-- Top Lightbar Strip Glow -->
    <path d="M 252,108 L 448,108" fill="none" stroke="#3B82F6" stroke-width="4" stroke-linecap="round" class="opacity-80" />
    <text x="350" y="165" class="fill-stone-400 font-mono font-semibold text-[11px] tracking-widest" text-anchor="middle">TOUCHPAD</text>
  </g>

  <!-- SHARE Button (Top Left Pill, Button 8) -->
  <g id="btn-share" data-btn="8" class="button-path cursor-pointer" transform="translate(226, 125)">
    <text x="8" y="-4" class="fill-stone-400 font-mono font-bold text-[8px] tracking-wider" text-anchor="middle">SHARE</text>
    <rect x="0" y="0" width="16" height="26" rx="7" fill="#24262E" stroke="#4B4E5A" stroke-width="1.5" />
  </g>

  <!-- OPTIONS Button (Top Right Pill, Button 9) -->
  <g id="btn-options" data-btn="9" class="button-path cursor-pointer" transform="translate(458, 125)">
    <text x="8" y="-4" class="fill-stone-400 font-mono font-bold text-[8px] tracking-wider" text-anchor="middle">OPTIONS</text>
    <rect x="0" y="0" width="16" height="26" rx="7" fill="#24262E" stroke="#4B4E5A" stroke-width="1.5" />
  </g>

  <!-- Speaker Grille Micro Dots -->
  <g transform="translate(330, 222)" fill="#3A3C46">
    <circle cx="0" cy="0" r="1.5"/><circle cx="8" cy="0" r="1.5"/><circle cx="16" cy="0" r="1.5"/><circle cx="24" cy="0" r="1.5"/><circle cx="32" cy="0" r="1.5"/>
    <circle cx="4" cy="6" r="1.5"/><circle cx="12" cy="6" r="1.5"/><circle cx="20" cy="6" r="1.5"/><circle cx="28" cy="6" r="1.5"/>
    <circle cx="8" cy="12" r="1.5"/><circle cx="16" cy="12" r="1.5"/><circle cx="24" cy="12" r="1.5"/>
  </g>

  <!-- PlayStation Emblem Button (PS, Button 16) -->
  <g id="btn-ps" data-btn="16" class="button-path cursor-pointer" transform="translate(350, 275)" filter="url(#ps-shadow)">
    <circle cx="0" cy="0" r="15" fill="#1C1D21" stroke="#484B56" stroke-width="1.5" />
    <circle cx="0" cy="0" r="19" fill="none" stroke="#3B82F6" stroke-width="1.5" class="opacity-50" />
    <!-- PlayStation PS 2D Emblem Vector -->
    <path d="M -3,-6 C -3,-6 3,-6 3,-1 C 3,4 -3,3 -3,8 M -6,5 L 6,5" fill="none" stroke="#E2E8F0" stroke-width="2" stroke-linecap="round" />
  </g>

  <!-- ════════════════════════════════════════════════════════════════════════
       4. LEFT D-PAD & RIGHT ACTION BUTTON CLUSTERS
       ════════════════════════════════════════════════════════════════════════ -->
  <!-- Left Split D-PAD Cluster -->
  <g id="group-dpad-ps" transform="translate(170, 240)">
    <!-- Base Recess Circle -->
    <circle cx="0" cy="0" r="54" fill="#131417" stroke="#373942" stroke-width="2" />
    
    <!-- Up ▲ (Button 12) -->
    <path id="btn-dpad-up" data-btn="12" d="M -14,-16 L 14,-16 L 14,-44 C 14,-48 8,-52 0,-52 C -8,-52 -14,-48 -14,-44 Z" class="dpad-btn button-path cursor-pointer fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" filter="url(#ps-shadow)" />
    <!-- Down ▼ (Button 13) -->
    <path id="btn-dpad-down" data-btn="13" d="M -14,16 L 14,16 L 14,44 C 14,48 8,52 0,52 C -8,52 -14,48 -14,44 Z" class="dpad-btn button-path cursor-pointer fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" filter="url(#ps-shadow)" />
    <!-- Left ◀ (Button 14) -->
    <path id="btn-dpad-left" data-btn="14" d="M -16,-14 L -16,14 L -44,14 C -48,14 -52,8 -52,0 C -52,-8 -48,-14 -44,-14 Z" class="dpad-btn button-path cursor-pointer fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" filter="url(#ps-shadow)" />
    <!-- Right ▶ (Button 15) -->
    <path id="btn-dpad-right" data-btn="15" d="M 16,-14 L 16,14 L 44,14 C 48,14 52,8 52,0 C 52,-8 48,-14 46,-14 Z" class="dpad-btn button-path cursor-pointer fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" filter="url(#ps-shadow)" />
  </g>

  <!-- Right Action Buttons Cluster (△ ◯ ✕ □) -->
  <g id="group-action-buttons-ps" transform="translate(530, 240)">
    <!-- Base Recess Circle -->
    <circle cx="0" cy="0" r="54" fill="#131417" stroke="#373942" stroke-width="2" />

    <!-- Triangle △ (Cyan / Green, Button 3) -->
    <g id="btn-triangle" data-btn="3" class="action-btn cursor-pointer" filter="url(#ps-shadow)">
      <circle cx="0" cy="-33" r="16" class="button-path fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" />
      <polygon points="0,-40 -7,-27 7,-27" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linejoin="round" />
    </g>

    <!-- Circle ◯ (Red, Button 1) -->
    <g id="btn-circle" data-btn="1" class="action-btn cursor-pointer" filter="url(#ps-shadow)">
      <circle cx="33" cy="0" r="16" class="button-path fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" />
      <circle cx="33" cy="0" r="7" fill="none" stroke="#EF4444" stroke-width="2.5" />
    </g>

    <!-- Cross ✕ (Cobalt Blue, Button 0) -->
    <g id="btn-cross" data-btn="0" class="action-btn cursor-pointer" filter="url(#ps-shadow)">
      <circle cx="0" cy="33" r="16" class="button-path fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" />
      <path d="M -5,28 L 5,38 M 5,28 L -5,38" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" />
    </g>

    <!-- Square □ (Pink / Magenta, Button 2) -->
    <g id="btn-square" data-btn="2" class="action-btn cursor-pointer" filter="url(#ps-shadow)">
      <circle cx="-33" cy="0" r="16" class="button-path fill-[#24262E] stroke-[#4B4E5A]" stroke-width="1.5" />
      <rect x="-38" y="-5" width="10" height="10" fill="none" stroke="#EC4899" stroke-width="2.5" />
    </g>
  </g>

  <!-- ════════════════════════════════════════════════════════════════════════
       5. SYMMETRICAL ANALOG THUMBSTICKS (L3 Lower-Left, R3 Lower-Right)
       ════════════════════════════════════════════════════════════════════════ -->
  <!-- Left Stick (L3, Axes 0, 1) -->
  <g id="group-left-stick" transform="translate(265, 345)">
    <!-- Outer Base Ring -->
    <circle cx="0" cy="0" r="42" fill="#1C1D21" stroke="#3F424E" stroke-width="2" />
    
    <!-- Interactive Cap Node -->
    <g id="stick-l-cap" data-btn="10" class="button-path cursor-pointer stick-cap-node" filter="url(#ps-shadow)">
      <circle cx="0" cy="0" r="33" fill="#24262E" stroke="#4B4E5A" stroke-width="2" />
      <circle cx="0" cy="0" r="23" fill="#1A1B1F" stroke="#393B44" stroke-width="1.5" />
      <circle cx="0" cy="0" r="14" fill="#262830" />
      <text x="0" y="4" class="fill-stone-400 font-mono font-bold text-[10px]" text-anchor="middle">L3</text>
    </g>
  </g>

  <!-- Right Stick (R3, Axes 2, 3) -->
  <g id="group-right-stick" transform="translate(435, 345)">
    <!-- Outer Base Ring -->
    <circle cx="0" cy="0" r="42" fill="#1C1D21" stroke="#3F424E" stroke-width="2" />
    
    <!-- Interactive Cap Node -->
    <g id="stick-r-cap" data-btn="11" class="button-path cursor-pointer stick-cap-node" filter="url(#ps-shadow)">
      <circle cx="0" cy="0" r="33" fill="#24262E" stroke="#4B4E5A" stroke-width="2" />
      <circle cx="0" cy="0" r="23" fill="#1A1B1F" stroke="#393B44" stroke-width="1.5" />
      <circle cx="0" cy="0" r="14" fill="#262830" />
      <text x="0" y="4" class="fill-stone-400 font-mono font-bold text-[10px]" text-anchor="middle">R3</text>
    </g>
  </g>
</svg>
