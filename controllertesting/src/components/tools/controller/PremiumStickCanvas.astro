---
/**
 * PremiumStickCanvas.astro
 * High-performance Canvas2D visualizer for analog sticks.
 * Uses a static SVG background with high-visibility grid strokes and a transparent Canvas foreground for motion trails.
 */
---
<div class="sticks-container relative w-full flex flex-col items-center justify-between select-none overflow-hidden pb-1">
  
  <!-- High-Visibility Static Grid Background & Dynamic Motion Trails Canvas -->
  <div class="relative w-full aspect-[400/180] min-h-[150px] flex items-center justify-center">
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 400 180" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="stick-bg-grad-l" cx="25%" cy="50%" r="20%">
          <stop offset="0%" stop-color="rgba(16, 185, 129, 0.08)"/>
          <stop offset="100%" stop-color="rgba(0, 0, 0, 0)"/>
        </radialGradient>
        <radialGradient id="stick-bg-grad-r" cx="75%" cy="50%" r="20%">
          <stop offset="0%" stop-color="rgba(37, 99, 235, 0.08)"/>
          <stop offset="100%" stop-color="rgba(0, 0, 0, 0)"/>
        </radialGradient>
      </defs>

      <rect width="400" height="180" fill="url(#stick-bg-grad-l)" />
      <rect width="400" height="180" fill="url(#stick-bg-grad-r)" />

      <!-- Left Stick Grid -->
      <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" fill="none">
        <circle cx="100" cy="90" r="58" fill="rgba(255, 255, 255, 0.03)" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />
        <circle cx="100" cy="90" r="28" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" stroke-dasharray="3,3" />
        <circle cx="100" cy="90" r="6" stroke="rgba(245, 158, 11, 0.6)" stroke-width="1.5" fill="rgba(245, 158, 11, 0.1)" />
        <line x1="100" y1="22" x2="100" y2="158" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
        <line x1="32" y1="90" x2="168" y2="90" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
        <text x="100" y="18" fill="rgba(16, 185, 129, 0.9)" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">L-STICK</text>
      </g>

      <!-- Right Stick Grid -->
      <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" fill="none">
        <circle cx="300" cy="90" r="58" fill="rgba(255, 255, 255, 0.03)" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />
        <circle cx="300" cy="90" r="28" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" stroke-dasharray="3,3" />
        <circle cx="300" cy="90" r="6" stroke="rgba(245, 158, 11, 0.6)" stroke-width="1.5" fill="rgba(245, 158, 11, 0.1)" />
        <line x1="300" y1="22" x2="300" y2="158" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
        <line x1="232" y1="90" x2="368" y2="90" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
        <text x="300" y="18" fill="rgba(96, 165, 250, 0.9)" font-family="monospace" font-size="10" font-weight="bold" text-anchor="middle">R-STICK</text>
      </g>
    </svg>

    <canvas id="premium-sticks" width="400" height="180" class="absolute inset-0 w-full h-full block pointer-events-none z-10" aria-hidden="true"></canvas>
  </div>

  <!-- Coordinates Display Container -->
  <div class="w-full grid grid-cols-2 gap-2 px-1 z-20 pointer-events-none mt-2">
    <div class="flex justify-center items-center overflow-hidden">
      <span class="font-mono text-[10px] font-bold px-2.5 py-1 rounded-md whitespace-nowrap inline-block text-center select-none shadow-sm border border-emerald-500/30 bg-[#0D0D0E]/90 text-emerald-400 backdrop-blur-sm" id="stick-l-val">X: 0.000 Y: 0.000</span>
    </div>
    <div class="flex justify-center items-center overflow-hidden">
      <span class="font-mono text-[10px] font-bold px-2.5 py-1 rounded-md whitespace-nowrap inline-block text-center select-none shadow-sm border border-blue-500/30 bg-[#0D0D0E]/90 text-blue-400 backdrop-blur-sm" id="stick-r-val">X: 0.000 Y: 0.000</span>
    </div>
  </div>
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('premium-sticks') as HTMLCanvasElement | null;
    if (!canvas) return;

    // Hi-DPI backing store: keep logical 400x180 drawing space, scale for retina (capped at 2x)
    const LOGICAL_W = 400;
    const LOGICAL_H = 180;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = LOGICAL_W * dpr;
    canvas.height = LOGICAL_H * dpr;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const W = LOGICAL_W;
    const H = LOGICAL_H;
    const R = 58;
    const CX_L = W / 4;
    const CY_L = H / 2;
    const CX_R = (W / 4) * 3;
    const CY_R = H / 2;

    const TRAIL_LENGTH = 15;
    
    // Pre-allocated float arrays for zero garbage collection
    const leftTrailX = new Float32Array(TRAIL_LENGTH);
    const leftTrailY = new Float32Array(TRAIL_LENGTH);
    const rightTrailX = new Float32Array(TRAIL_LENGTH);
    const rightTrailY = new Float32Array(TRAIL_LENGTH);
    let trailIdx = 0;
    let trailCount = 0;

    const lText = document.getElementById('stick-l-val');
    const rText = document.getElementById('stick-r-val');

    GamepadLoop.subscribe((state) => {
      // Clear canvas each frame
      ctx.clearRect(0, 0, W, H);

      if (!state || !state.connected) {
        trailCount = 0;
        if (lText) lText.textContent = 'X: 0.000 Y: 0.000';
        if (rText) rText.textContent = 'X: 0.000 Y: 0.000';
        return;
      }

      const curLx = CX_L + state.leftStick.x * R;
      const curLy = CY_L + state.leftStick.y * R;
      const curRx = CX_R + state.rightStick.x * R;
      const curRy = CY_R + state.rightStick.y * R;

      // Add to ring buffer
      leftTrailX[trailIdx] = curLx;
      leftTrailY[trailIdx] = curLy;
      rightTrailX[trailIdx] = curRx;
      rightTrailY[trailIdx] = curRy;
      
      trailIdx = (trailIdx + 1) % TRAIL_LENGTH;
      if (trailCount < TRAIL_LENGTH) trailCount++;

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Left Trail
      ctx.beginPath();
      for (let i = 0; i < trailCount; i++) {
        const idx = (trailIdx - trailCount + i + TRAIL_LENGTH) % TRAIL_LENGTH;
        const x = leftTrailX[idx];
        const y = leftTrailY[idx];
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.lineWidth = 3;
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.65)';
      ctx.stroke();

      // Right Trail
      ctx.beginPath();
      for (let i = 0; i < trailCount; i++) {
        const idx = (trailIdx - trailCount + i + TRAIL_LENGTH) % TRAIL_LENGTH;
        const x = rightTrailX[idx];
        const y = rightTrailY[idx];
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.lineWidth = 3;
      ctx.strokeStyle = 'rgba(37, 99, 235, 0.65)';
      ctx.stroke();

      // Left Stick Cursor Head
      ctx.fillStyle = '#10B981';
      ctx.shadowColor = 'rgba(16, 185, 129, 0.9)';
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(curLx, curLy, 6, 0, Math.PI * 2);
      ctx.fill();

      // Right Stick Cursor Head
      ctx.fillStyle = '#3B82F6';
      ctx.shadowColor = 'rgba(59, 130, 246, 0.9)';
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(curRx, curRy, 6, 0, Math.PI * 2);
      ctx.fill();

      // Reset shadow blur
      ctx.shadowBlur = 0;

      // Update text displays cleanly
      if (lText) lText.textContent = `X: ${state.leftStick.x >= 0 ? '+' : ''}${state.leftStick.x.toFixed(3)} Y: ${state.leftStick.y >= 0 ? '+' : ''}${state.leftStick.y.toFixed(3)}`;
      if (rText) rText.textContent = `X: ${state.rightStick.x >= 0 ? '+' : ''}${state.rightStick.x.toFixed(3)} Y: ${state.rightStick.y >= 0 ? '+' : ''}${state.rightStick.y.toFixed(3)}`;
    });
  });
</script>

<style>
  .sticks-container {
    background: transparent;
  }
</style>

