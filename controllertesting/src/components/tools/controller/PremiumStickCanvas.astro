---
/**
 * PremiumStickCanvas.astro
 * High-performance Canvas2D visualizer for analog sticks.
 * Uses a static SVG background with high-visibility grid strokes and a transparent Canvas foreground for motion trails.
 */
---
<div class="sticks-container relative w-full h-full flex items-center justify-center min-h-[190px] select-none overflow-hidden">
  
  <!-- High-Visibility Static Grid Background -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 400 200" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Subtle Radial Backdrop Gradient for Stick Circles -->
      <radialGradient id="stick-bg-grad-l" cx="25%" cy="50%" r="20%">
        <stop offset="0%" stop-color="rgba(16, 185, 129, 0.08)"/>
        <stop offset="100%" stop-color="rgba(0, 0, 0, 0)"/>
      </radialGradient>
      <radialGradient id="stick-bg-grad-r" cx="75%" cy="50%" r="20%">
        <stop offset="0%" stop-color="rgba(37, 99, 235, 0.08)"/>
        <stop offset="100%" stop-color="rgba(0, 0, 0, 0)"/>
      </radialGradient>
    </defs>

    <rect width="400" height="200" fill="url(#stick-bg-grad-l)" />
    <rect width="400" height="200" fill="url(#stick-bg-grad-r)" />

    <!-- Left Stick Grid -->
    <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" fill="none">
      <circle cx="100" cy="100" r="80" fill="rgba(255, 255, 255, 0.03)" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />
      <circle cx="100" cy="100" r="40" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" stroke-dasharray="3,3" />
      <circle cx="100" cy="100" r="8" stroke="rgba(245, 158, 11, 0.6)" stroke-width="1.5" fill="rgba(245, 158, 11, 0.1)" /> <!-- Deadzone -->
      <line x1="100" y1="15" x2="100" y2="185" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
      <line x1="15" y1="100" x2="185" y2="100" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
      <text x="100" y="28" fill="rgba(16, 185, 129, 0.7)" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">L-STICK</text>
    </g>

    <!-- Right Stick Grid -->
    <g stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" fill="none">
      <circle cx="300" cy="100" r="80" fill="rgba(255, 255, 255, 0.03)" stroke="rgba(255, 255, 255, 0.2)" stroke-width="1.5" />
      <circle cx="300" cy="100" r="40" stroke="rgba(255, 255, 255, 0.08)" stroke-width="1" stroke-dasharray="3,3" />
      <circle cx="300" cy="100" r="8" stroke="rgba(245, 158, 11, 0.6)" stroke-width="1.5" fill="rgba(245, 158, 11, 0.1)" /> <!-- Deadzone -->
      <line x1="300" y1="15" x2="300" y2="185" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
      <line x1="215" y1="100" x2="385" y2="100" stroke="rgba(255, 255, 255, 0.18)" stroke-width="1" />
      <text x="300" y="28" fill="rgba(96, 165, 250, 0.7)" font-family="monospace" font-size="9" font-weight="bold" text-anchor="middle">R-STICK</text>
    </g>
  </svg>

  <!-- Dynamic Motion Trails Canvas -->
  <canvas id="premium-sticks" width="400" height="200" class="w-full max-w-full relative z-10 block pointer-events-none"></canvas>

  <!-- Coordinates Display Container (Strict grid-cols-2 with whitespace-nowrap) -->
  <div class="absolute bottom-1.5 inset-x-0 grid grid-cols-2 gap-2 px-2 pointer-events-none z-20 w-full">
    <div class="flex justify-center items-center overflow-hidden">
      <span class="font-mono text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded whitespace-nowrap inline-block text-center select-none shadow-md border border-emerald-500/30 bg-black/80 text-emerald-400 backdrop-blur-sm" id="stick-l-val">X: 0.000 Y: 0.000</span>
    </div>
    <div class="flex justify-center items-center overflow-hidden">
      <span class="font-mono text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded whitespace-nowrap inline-block text-center select-none shadow-md border border-blue-500/30 bg-black/80 text-blue-400 backdrop-blur-sm" id="stick-r-val">X: 0.000 Y: 0.000</span>
    </div>
  </div>
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('premium-sticks') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const W = canvas.width;
    const H = canvas.height;
    const R = 80;
    const CX_L = W / 4;
    const CY_L = H / 2;
    const CX_R = (W / 4) * 3;
    const CY_R = H / 2;

    const TRAIL_LENGTH = 15;
    
    // Pre-allocated float arrays for zero garbage collection
    const leftTrailX = new Float32Array(TRAIL_LENGTH);
    const leftTrailY = new Float32Array(TRAIL_LENGTH);
    const rightTrailX = new Float32Array(TRAIL_LENGTH);
    const rightTrailY = new Float32Array(TRAIL_LENGTH);
    let trailIdx = 0;
    let trailCount = 0;

    const lText = document.getElementById('stick-l-val');
    const rText = document.getElementById('stick-r-val');

    GamepadLoop.subscribe((state) => {
      // Clear canvas each frame
      ctx.clearRect(0, 0, W, H);

      if (!state || !state.connected) {
        trailCount = 0;
        if (lText) lText.textContent = 'X: 0.000 Y: 0.000';
        if (rText) rText.textContent = 'X: 0.000 Y: 0.000';
        return;
      }

      const curLx = CX_L + state.leftStick.x * R;
      const curLy = CY_L + state.leftStick.y * R;
      const curRx = CX_R + state.rightStick.x * R;
      const curRy = CY_R + state.rightStick.y * R;

      // Add to ring buffer
      leftTrailX[trailIdx] = curLx;
      leftTrailY[trailIdx] = curLy;
      rightTrailX[trailIdx] = curRx;
      rightTrailY[trailIdx] = curRy;
      
      trailIdx = (trailIdx + 1) % TRAIL_LENGTH;
      if (trailCount < TRAIL_LENGTH) trailCount++;

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      // Left Trail
      ctx.beginPath();
      for (let i = 0; i < trailCount; i++) {
        const idx = (trailIdx - trailCount + i + TRAIL_LENGTH) % TRAIL_LENGTH;
        const x = leftTrailX[idx];
        const y = leftTrailY[idx];
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.lineWidth = 3;
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.65)';
      ctx.stroke();

      // Right Trail
      ctx.beginPath();
      for (let i = 0; i < trailCount; i++) {
        const idx = (trailIdx - trailCount + i + TRAIL_LENGTH) % TRAIL_LENGTH;
        const x = rightTrailX[idx];
        const y = rightTrailY[idx];
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.lineWidth = 3;
      ctx.strokeStyle = 'rgba(37, 99, 235, 0.65)';
      ctx.stroke();

      // Left Stick Cursor Head
      ctx.fillStyle = '#10B981';
      ctx.shadowColor = 'rgba(16, 185, 129, 0.9)';
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(curLx, curLy, 6, 0, Math.PI * 2);
      ctx.fill();

      // Right Stick Cursor Head
      ctx.fillStyle = '#3B82F6';
      ctx.shadowColor = 'rgba(59, 130, 246, 0.9)';
      ctx.shadowBlur = 10;
      ctx.beginPath();
      ctx.arc(curRx, curRy, 6, 0, Math.PI * 2);
      ctx.fill();

      // Reset shadow blur
      ctx.shadowBlur = 0;

      // Update text displays cleanly
      if (lText) lText.textContent = `X: ${state.leftStick.x >= 0 ? '+' : ''}${state.leftStick.x.toFixed(3)} Y: ${state.leftStick.y >= 0 ? '+' : ''}${state.leftStick.y.toFixed(3)}`;
      if (rText) rText.textContent = `X: ${state.rightStick.x >= 0 ? '+' : ''}${state.rightStick.x.toFixed(3)} Y: ${state.rightStick.y >= 0 ? '+' : ''}${state.rightStick.y.toFixed(3)}`;
    });
  });
</script>

<style>
  .sticks-container {
    background: transparent;
  }
</style>

