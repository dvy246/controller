---
/**
 * SteeringWheelTester.astro — Racing Wheel, Pedals & H-Shifter Diagnostic Tool
 * Visualizes 900° / 1080° steering rotation angle, pedal linearity (Throttle, Brake, Clutch), and H-pattern gear shifter inputs.
 */
---

<div class="wheel-tester" id="wheel-root">
  <div class="tester-status-bar">
    <div class="status-indicator">
      <span class="status-dot" id="wheel-status-dot"></span>
      <span class="status-text" id="wheel-status-text">Connect Logitech G29/G923, Thrustmaster, or Fanatec racing wheel...</span>
    </div>
    <div class="controller-name" id="wheel-model-name">No Racing Wheel Detected</div>
  </div>

  <div class="wheel-main-grid">
    <div class="wheel-angle-card">
      <h3 class="card-title">Steering Rotation Angle</h3>
      <div class="wheel-visualizer">
        <div class="wheel-disc" id="wheel-disc-elem">
          <div class="wheel-center-line"></div>
        </div>
      </div>
      <span class="wheel-angle-val text-gradient" id="wheel-angle-text">0.0°</span>
    </div>

    <div class="pedals-card">
      <h3 class="card-title">Pedal Linearity Bars</h3>
      <div class="pedal-bars-list">

        <div class="pedal-row">
          <div class="p-header"><span>THROTTLE (ACCELERATOR)</span><span class="mono" id="throttle-val">0%</span></div>
          <div class="progress-bar"><div class="progress-bar__fill throttle" id="throttle-bar" style="width: 0%"></div></div>
        </div>

        <div class="pedal-row">
          <div class="p-header"><span>BRAKE</span><span class="mono" id="brake-val">0%</span></div>
          <div class="progress-bar"><div class="progress-bar__fill brake" id="brake-bar" style="width: 0%"></div></div>
        </div>

        <div class="pedal-row">
          <div class="p-header"><span>CLUTCH</span><span class="mono" id="clutch-val">0%</span></div>
          <div class="progress-bar"><div class="progress-bar__fill clutch" id="clutch-bar" style="width: 0%"></div></div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    function pollWheel() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const dot = document.getElementById('wheel-status-dot');
        const text = document.getElementById('wheel-status-text');
        const model = document.getElementById('wheel-model-name');
        if (dot) dot.className = 'status-dot active';
        if (text) text.textContent = 'Racing Wheel Input Active';
        if (model) model.textContent = activeGp.id;

        const state = parseGamepadState(activeGp);
        const steerAxis = state.leftStick.x;
        const degrees = (steerAxis * 450).toFixed(1);

        const disc = document.getElementById('wheel-disc-elem');
        const angleText = document.getElementById('wheel-angle-text');

        if (disc) disc.style.transform = `rotate(${degrees}deg)`;
        if (angleText) angleText.textContent = `${degrees}°`;

        // Pedals
        const throttlePct = Math.round(state.triggers.r2 * 100);
        const brakePct = Math.round(state.triggers.l2 * 100);

        const thVal = document.getElementById('throttle-val');
        const thBar = document.getElementById('throttle-bar');
        if (thVal) thVal.textContent = `${throttlePct}%`;
        if (thBar) thBar.style.width = `${throttlePct}%`;

        const brVal = document.getElementById('brake-val');
        const brBar = document.getElementById('brake-bar');
        if (brVal) brVal.textContent = `${brakePct}%`;
        if (brBar) brBar.style.width = `${brakePct}%`;
      }

      requestAnimationFrame(pollWheel);
    }

    pollWheel();
  });
</script>

<style>
  .wheel-tester { display: flex; flex-direction: column; gap: 1.5rem; }
  .tester-status-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem 1.25rem; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); }
  .status-indicator { display: flex; align-items: center; gap: 0.625rem; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-neutral); }
  .status-dot.active { background: var(--color-pass); box-shadow: 0 0 8px var(--color-pass); }
  .status-text { font-size: var(--text-small); color: var(--color-text-secondary); }
  .controller-name { font-family: var(--font-mono); font-size: var(--text-small); font-weight: 600; color: var(--color-accent); }
  .wheel-main-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .wheel-angle-card, .pedals-card { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; align-items: center; }
  .card-title { font-size: 1.125rem; font-weight: 700; width: 100%; text-align: left; }
  .wheel-visualizer { width: 160px; height: 160px; border-radius: 50%; background: var(--color-surface-1); border: 4px solid var(--color-border-default); position: relative; display: flex; align-items: center; justify-content: center; }
  .wheel-disc { width: 100%; height: 100%; border-radius: 50%; position: relative; transition: transform 0.05s linear; }
  .wheel-center-line { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 4px; height: 30px; background: var(--color-accent); border-radius: 2px; }
  .wheel-angle-val { font-family: var(--font-mono); font-size: 2.25rem; font-weight: 800; }
  .pedal-bars-list { width: 100%; display: flex; flex-direction: column; gap: 1rem; }
  .pedal-row { display: flex; flex-direction: column; gap: 0.375rem; }
  .p-header { display: flex; justify-content: space-between; font-size: var(--text-small); font-weight: 600; }
  .progress-bar__fill.throttle { background: var(--color-pass); }
  .progress-bar__fill.brake { background: var(--color-fail); }
  .progress-bar__fill.clutch { background: var(--color-accent); }
  @media (max-width: 768px) { .wheel-main-grid { grid-template-columns: 1fr; } }
</style>
