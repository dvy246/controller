---
/**
 * FlightStickTester.astro — Flight Stick, HOTAS & Flight Simulator Hardware Tester
 * Supports 128+ buttons, multi-axis throttle quadrant, twist rudder (Yaw), and hat switch (POV).
 */
---

<div class="flight-tester" id="fl-root">
  <div class="tester-status-bar">
    <div class="status-indicator">
      <span class="status-dot" id="fl-status-dot"></span>
      <span class="status-text" id="fl-status-text">Connect Thrustmaster Warthog, Logitech X56, or Turtle Beach flight stick...</span>
    </div>
    <div class="controller-name" id="fl-model-name">No Flight Stick Detected</div>
  </div>

  <div class="fl-main-grid">
    <div class="fl-card">
      <span class="card-title">FLIGHT AXES (PITCH / ROLL / YAW)</span>
      <div class="fl-axis-row"><span>Pitch (X-Axis):</span> <span class="mono" id="fl-pitch-val">0.00</span></div>
      <div class="fl-axis-row"><span>Roll (Y-Axis):</span> <span class="mono" id="fl-roll-val">0.00</span></div>
      <div class="fl-axis-row"><span>Yaw (Twist Rudder):</span> <span class="mono" id="fl-yaw-val">0.00</span></div>
      <div class="fl-axis-row"><span>Throttle Lever:</span> <span class="mono" id="fl-throttle-val">0%</span></div>
    </div>

    <div class="fl-card">
      <span class="card-title">HAT SWITCH (8-WAY POV)</span>
      <div class="hat-display" id="fl-hat-display">CENTER (NEUTRAL)</div>
    </div>
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    function pollFlight() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const dot = document.getElementById('fl-status-dot');
        const text = document.getElementById('fl-status-text');
        const model = document.getElementById('fl-model-name');
        if (dot) dot.className = 'status-dot active';
        if (text) text.textContent = 'HOTAS Polling Active';
        if (model) model.textContent = activeGp.id;

        const state = parseGamepadState(activeGp);
        const pEl = document.getElementById('fl-pitch-val');
        const rEl = document.getElementById('fl-roll-val');
        const yEl = document.getElementById('fl-yaw-val');
        const tEl = document.getElementById('fl-throttle-val');

        if (pEl) pEl.textContent = state.leftStick.x.toFixed(2);
        if (rEl) rEl.textContent = state.leftStick.y.toFixed(2);
        if (yEl) yEl.textContent = state.rightStick.x.toFixed(2);
        if (tEl) tEl.textContent = `${Math.round(state.triggers.r2 * 100)}%`;
      }

      requestAnimationFrame(pollFlight);
    }

    pollFlight();
  });
</script>

<style>
  .flight-tester { display: flex; flex-direction: column; gap: 1.5rem; }
  .tester-status-bar { display: flex; align-items: center; justify-content: space-between; padding: 0.875rem 1.25rem; background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); }
  .status-indicator { display: flex; align-items: center; gap: 0.625rem; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--color-neutral); }
  .status-dot.active { background: var(--color-pass); box-shadow: 0 0 8px var(--color-pass); }
  .status-text { font-size: var(--text-small); color: var(--color-text-secondary); }
  .controller-name { font-family: var(--font-mono); font-size: var(--text-small); font-weight: 600; color: var(--color-accent); }
  .fl-main-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .fl-card { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .card-title { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .fl-axis-row { display: flex; justify-content: space-between; padding: 0.625rem 0; border-bottom: 1px solid var(--color-border-subtle); font-size: var(--text-small); }
  .fl-axis-row span.mono { font-weight: 600; color: var(--color-text-primary); }
  .hat-display { height: 140px; background: var(--color-surface-1); border: 1px solid var(--color-border-default); border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 1.25rem; font-weight: 700; color: var(--color-accent); }
  @media (max-width: 768px) { .fl-main-grid { grid-template-columns: 1fr; } }
</style>
