---
// OverclockValidator.astro
---

<div class="doppelrand-shell w-full max-w-5xl mx-auto" style="isolation: isolate; position: relative;">
  <!-- Ambient glow -->
  <div style="position: absolute; inset: -4px; border-radius: 24px; background: radial-gradient(ellipse at 50% -20%, rgba(37,99,235,0.2) 0%, rgba(99,102,241,0.1) 50%, transparent 70%); filter: blur(16px); z-index: -1; pointer-events: none;" aria-hidden="true"></div>

  <!-- Main container using the new diagnostic-tool-shell CSS class -->
  <div class="diagnostic-tool-shell" style="display: flex; flex-direction: column;">
    
    <!-- TOP TOOLBAR -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 14px 20px; background: #0a0a0c; border-bottom: 1px solid rgba(255,255,255,0.06); min-height: 52px; font-family: var(--font-mono);">
      <div style="display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1;">
        <div style="width: 28px; height: 28px; border-radius: 8px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); display: flex; align-items: center; justify-content: center; color: #60a5fa; flex-shrink: 0;" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
        </div>
        <span style="color: #ffffff; font-weight: 700; font-size: 0.875rem; letter-spacing: -0.01em; font-family: var(--font-sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Hardware Telemetry Dashboard</span>
      </div>
      <div style="display: flex; align-items: center; gap: 12px; flex-shrink: 0;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 8px; height: 8px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.5);" id="connection-status"></div>
          <span style="font-size: 0.6875rem; font-weight: 700; color: #6b7280; text-transform: uppercase; letter-spacing: 0.08em; white-space: nowrap;" id="connection-text">No Device</span>
        </div>
        <button id="reset-stats" style="padding: 4px 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; font-size: 0.6875rem; font-weight: 700; color: #a1a1aa; cursor: pointer; transition: background 150ms ease, border-color 150ms ease; white-space: nowrap;" aria-label="Reset statistics">RESET</button>
      </div>
    </div>

    <!-- MAIN STAGE -->
    <div style="padding: 20px 20px 24px; background: linear-gradient(180deg, #111113 0%, #0E0E10 100%); flex: 1;">
      
      <!-- STATS GRID -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px;" class="ov-stats-grid">
        <!-- Current Hz -->
        <div style="background: rgba(18,18,22,0.95); border: 1px solid rgba(59,130,246,0.14); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; position: relative; overflow: hidden;">
          <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(59,130,246,0.06) 0%, transparent 60%); pointer-events: none;" aria-hidden="true"></div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; position: relative; z-index: 1;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280;">Current Polling</span>
            <svg style="color: rgba(59,130,246,0.4); flex-shrink: 0;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          </div>
          <div style="display: flex; align-items: baseline; gap: 4px; position: relative; z-index: 1;">
            <div style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #ffffff; font-family: var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; line-height: 1;" id="current-hz">0</div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); color: #6b7280;">Hz</span>
          </div>
          <div style="margin-top: 8px; font-size: 0.6875rem; font-family: var(--font-mono); color: rgba(96,165,250,0.7); position: relative; z-index: 1;">Target: 1000Hz (1ms)</div>
        </div>

        <!-- Average Hz -->
        <div style="background: rgba(18,18,22,0.95); border: 1px solid rgba(16,185,129,0.14); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; position: relative; overflow: hidden;">
          <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(16,185,129,0.06) 0%, transparent 60%); pointer-events: none;" aria-hidden="true"></div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; position: relative; z-index: 1;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280;">Stable Average (10s)</span>
            <svg style="color: rgba(16,185,129,0.4); flex-shrink: 0;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <div style="display: flex; align-items: baseline; gap: 4px; position: relative; z-index: 1;">
            <div style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #ffffff; font-family: var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; line-height: 1;" id="avg-hz">0</div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); color: #6b7280;">Hz</span>
          </div>
          <div style="margin-top: 8px; font-size: 0.6875rem; font-family: var(--font-mono); color: rgba(52,211,153,0.7); position: relative; z-index: 1;">Sustained Performance</div>
        </div>

        <!-- Jitter -->
        <div style="background: rgba(18,18,22,0.95); border: 1px solid rgba(245,158,11,0.14); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; position: relative; overflow: hidden;">
          <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(245,158,11,0.06) 0%, transparent 60%); pointer-events: none;" aria-hidden="true"></div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; position: relative; z-index: 1;">
            <span style="font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280;">Input Jitter</span>
            <svg style="color: rgba(245,158,11,0.4); flex-shrink: 0;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div style="display: flex; align-items: baseline; gap: 4px; position: relative; z-index: 1;">
            <div style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #ffffff; font-family: var(--font-mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; line-height: 1;" id="jitter-ms">0.00</div>
            <span style="font-size: 0.75rem; font-family: var(--font-mono); color: #6b7280;">ms</span>
          </div>
          <div style="margin-top: 8px; font-size: 0.6875rem; font-family: var(--font-mono); color: rgba(251,191,36,0.7); position: relative; z-index: 1;">Variance (Std Dev)</div>
        </div>
      </div>

      <!-- CANVAS AREA -->
      <div style="position: relative; border-radius: 14px; overflow: hidden; background: #070709; border: 1px solid rgba(255,255,255,0.06); box-shadow: inset 0 2px 8px rgba(0,0,0,0.4);">
        <div style="position: absolute; top: 14px; left: 14px; z-index: 20; display: flex; align-items: center; gap: 6px; pointer-events: none; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.06);">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #3b82f6; animation: pulse 2s ease-in-out infinite;" aria-hidden="true"></span>
          <span style="font-size: 0.6875rem; font-family: var(--font-mono); font-weight: 700; color: #d4d4d8;">Live Frame Pacing (Δms)</span>
        </div>
        
        <canvas id="pacing-canvas" style="width: 100%; height: 192px; display: block; border-radius: 14px; cursor: crosshair; position: relative; z-index: 10;" aria-label="Live frame pacing visualization chart"></canvas>
        
        <!-- Awaiting input overlay -->
        <div style="position: absolute; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; pointer-events: none; transition: opacity 300ms ease;" id="waiting-overlay" aria-live="polite">
          <div style="display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 20px 28px; background: rgba(0,0,0,0.85); backdrop-filter: blur(12px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.08);">
            <svg style="color: #71717a;" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            <p style="font-size: 0.8125rem; font-weight: 700; color: #ffffff; letter-spacing: 0.04em;">AWAITING INPUT DATA</p>
            <p style="font-size: 0.6875rem; font-family: var(--font-mono); color: #6b7280;">Move analog sticks in continuous circles</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px #3b82f6; }
    50% { opacity: 0.5; box-shadow: 0 0 2px #3b82f6; }
  }

  /* Mobile: stack stats vertically */
  @media (max-width: 600px) {
    .ov-stats-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Tablet: 2-col stats */
  @media (min-width: 601px) and (max-width: 900px) {
    .ov-stats-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }

  /* Connection status animation */
  #connection-status.connected {
    background: #10b981 !important;
    box-shadow: 0 0 8px rgba(16,185,129,0.5) !important;
  }

  /* Reset button hover */
  #reset-stats:hover {
    background: rgba(255,255,255,0.1) !important;
    border-color: rgba(255,255,255,0.2) !important;
  }
</style>


<script>
  // High-performance vanilla JS telemetry logic
  class OverclockValidator {
    canvas: HTMLCanvasElement | null;
    ctx: CanvasRenderingContext2D | null;
    hzDisplay: HTMLElement | null;
    avgHzDisplay: HTMLElement | null;
    jitterDisplay: HTMLElement | null;
    statusDot: HTMLElement | null;
    statusText: HTMLElement | null;
    waitingOverlay: HTMLElement | null;
    resetBtn: HTMLElement | null;
    lastTimestamp: number;
    deltas: number[];
    MAX_SAMPLES: number;
    recentHz: number[];
    isPolling: boolean;
    gamepadIndex: number | null;
    lastAxes: any[];
    lastButtons: any[];
    lastInputTime: number;
    canvasWidth: number = 0;
    canvasHeight: number = 0;

    constructor() {
      this.canvas = document.getElementById('pacing-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas ? this.canvas.getContext('2d', { alpha: false }) : null;
      
      this.hzDisplay = document.getElementById('current-hz');
      this.avgHzDisplay = document.getElementById('avg-hz');
      this.jitterDisplay = document.getElementById('jitter-ms');
      this.statusDot = document.getElementById('connection-status');
      this.statusText = document.getElementById('connection-text');
      this.waitingOverlay = document.getElementById('waiting-overlay');
      this.resetBtn = document.getElementById('reset-stats');
      
      this.setupCanvas();
      
      // State
      this.lastTimestamp = 0;
      this.deltas = []; // ms deltas
      this.MAX_SAMPLES = 200; // fit on canvas
      this.recentHz = [];
      this.isPolling = false;
      this.gamepadIndex = null;
      this.lastAxes = [];
      this.lastButtons = [];
      this.lastInputTime = 0;
      
      // Bind
      this.loop = this.loop.bind(this);
      
      // Init
      window.addEventListener('resize', () => this.setupCanvas());
      window.addEventListener('gamepadconnected', (e: any) => this.onConnect(e));
      window.addEventListener('gamepaddisconnected', (e: any) => this.onDisconnect(e));
      
      this.resetBtn?.addEventListener('click', () => this.resetStats());
      
      // Check existing
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      for (let g of gamepads) {
        if (g) { this.onConnect({ gamepad: g }); break; }
      }
      
      requestAnimationFrame(this.loop);
    }
    
    setupCanvas() {
      if (!this.canvas || !this.ctx) return;
      // High-DPI canvas (setTransform avoids compounding scale() on resize)
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = this.canvas.getBoundingClientRect();
      this.canvas.width = rect.width * dpr;
      this.canvas.height = rect.height * dpr;
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      this.canvasWidth = rect.width;
      this.canvasHeight = rect.height;
      this.drawCanvasBackground();
    }
    
    onConnect(e: any) {
      if (this.gamepadIndex === null && e.gamepad) {
        this.gamepadIndex = e.gamepad.index;
        if (this.statusDot) {
          this.statusDot.classList.replace('bg-red-500', 'bg-emerald-500');
          this.statusDot.style.boxShadow = '0 0 10px rgba(16, 185, 129, 0.6)';
        }
        if (this.statusText) {
          this.statusText.textContent = e.gamepad.id.split('(')[0].trim() || 'Controller Connected';
          this.statusText.classList.replace('text-surface-content-muted', 'text-white');
        }
        this.isPolling = true;
      }
    }
    
    onDisconnect(e: any) {
      if (e.gamepad && e.gamepad.index === this.gamepadIndex) {
        this.gamepadIndex = null;
        if (this.statusDot) {
          this.statusDot.classList.replace('bg-emerald-500', 'bg-red-500');
          this.statusDot.style.boxShadow = '0 0 10px rgba(239, 68, 68, 0.6)';
        }
        if (this.statusText) {
          this.statusText.textContent = 'No Controller Detected';
          this.statusText.classList.replace('text-white', 'text-surface-content-muted');
        }
        this.isPolling = false;
        if (this.waitingOverlay) {
          this.waitingOverlay.style.display = 'flex';
        }
      }
    }
    
    resetStats() {
      this.deltas = [];
      this.recentHz = [];
      if (this.hzDisplay) this.hzDisplay.textContent = '0';
      if (this.avgHzDisplay) this.avgHzDisplay.textContent = '0';
      if (this.jitterDisplay) this.jitterDisplay.textContent = '0.00';
      this.drawCanvasBackground();
    }
    
    hasStateChanged(gamepad: any) {
      if (!gamepad) return false;
      let changed = false;
      
      // Check axes
      if (this.lastAxes.length !== gamepad.axes.length) {
        this.lastAxes = [...gamepad.axes];
        changed = true;
      } else {
        for (let i = 0; i < gamepad.axes.length; i++) {
          if (this.lastAxes[i] !== gamepad.axes[i]) {
            changed = true;
            this.lastAxes[i] = gamepad.axes[i];
          }
        }
      }
      
      // Check buttons
      if (this.lastButtons.length !== gamepad.buttons.length) {
        this.lastButtons = Array.from(gamepad.buttons, (b: any) => b.value);
        changed = true;
      } else {
        for (let i = 0; i < gamepad.buttons.length; i++) {
          if (this.lastButtons[i] !== gamepad.buttons[i].value) {
            changed = true;
            this.lastButtons[i] = gamepad.buttons[i].value;
          }
        }
      }
      
      return changed;
    }
    
    drawCanvasBackground() {
      if (!this.ctx) return;
      this.ctx.fillStyle = '#0f172a'; // Tailwind slate-900 (surface-0 equivalent)
      this.ctx.fillRect(0, 0, this.canvasWidth, this.canvasHeight);
      
      // Grid lines
      this.ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      this.ctx.lineWidth = 1;
      this.ctx.beginPath();
      // Target lines: 1ms (1000Hz), 2ms (500Hz), 4ms (250Hz), 8ms (125Hz)
      const targets = [1, 2, 4, 8];
      const maxDelta = 12; // 12ms max scale
      
      targets.forEach(t => {
        const y = this.canvasHeight - (t / maxDelta) * this.canvasHeight;
        this.ctx!.moveTo(0, y);
        this.ctx!.lineTo(this.canvasWidth, y);
      });
      this.ctx.stroke();
      
      // Labels
      this.ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
      this.ctx.font = '10px monospace';
      targets.forEach(t => {
        const y = this.canvasHeight - (t / maxDelta) * this.canvasHeight;
        this.ctx!.fillText(`${t}ms (${Math.round(1000/t)}Hz)`, 5, Math.max(10, y - 4));
      });
    }
    
    drawGraph() {
      if (!this.ctx) return;
      this.drawCanvasBackground();
      
      if (this.deltas.length < 2) return;
      
      const maxDelta = 12;
      const step = this.canvasWidth / (this.MAX_SAMPLES - 1);
      
      this.ctx.beginPath();
      this.ctx.strokeStyle = '#3b82f6'; // Blue-500
      this.ctx.lineWidth = 2;
      this.ctx.lineCap = 'round';
      this.ctx.lineJoin = 'round';
      
      for (let i = 0; i < this.deltas.length; i++) {
        const delta = Math.min(this.deltas[i], maxDelta); // cap for visual
        const x = i * step + (this.MAX_SAMPLES - this.deltas.length) * step;
        const y = this.canvasHeight - (delta / maxDelta) * this.canvasHeight;
        
        if (i === 0) {
          this.ctx.moveTo(x, y);
        } else {
          this.ctx.lineTo(x, y);
        }
      }
      
      this.ctx.stroke();
      
      // Fill under curve
      this.ctx.lineTo(this.canvasWidth, this.canvasHeight);
      this.ctx.lineTo((this.MAX_SAMPLES - this.deltas.length) * step, this.canvasHeight);
      this.ctx.closePath();
      
      const gradient = this.ctx.createLinearGradient(0, 0, 0, this.canvasHeight);
      gradient.addColorStop(0, 'rgba(59, 130, 246, 0.2)');
      gradient.addColorStop(1, 'rgba(59, 130, 246, 0)');
      this.ctx.fillStyle = gradient;
      this.ctx.fill();
    }
    
    updateStats() {
      if (this.deltas.length < 10) return;
      
      // Calculate current Hz (using recent deltas)
      const recentDeltas = this.deltas.slice(-10);
      const avgRecentDelta = recentDeltas.reduce((a, b) => a + b, 0) / recentDeltas.length;
      const currentHz = avgRecentDelta > 0 ? Math.round(1000 / avgRecentDelta) : 0;
      
      if (this.hzDisplay) this.hzDisplay.textContent = String(currentHz);
      
      this.recentHz.push(currentHz);
      if (this.recentHz.length > 100) this.recentHz.shift(); // rolling avg over ~1s of active movement
      
      // Calculate Average Hz
      const avgHz = Math.round(this.recentHz.reduce((a, b) => a + b, 0) / this.recentHz.length);
      if (this.avgHzDisplay) this.avgHzDisplay.textContent = String(avgHz);
      
      // Calculate Jitter (StdDev of recent deltas)
      const variance = recentDeltas.reduce((acc, val) => acc + Math.pow(val - avgRecentDelta, 2), 0) / recentDeltas.length;
      const stdDev = Math.sqrt(variance);
      
      if (this.jitterDisplay) this.jitterDisplay.textContent = stdDev.toFixed(2);
      
      // UI Colors based on performance
      if (this.avgHzDisplay) {
        if (avgHz >= 900) {
          this.avgHzDisplay.className = "text-4xl font-bold text-blue-400 font-mono tracking-tighter tabular-nums";
        } else if (avgHz >= 450) {
          this.avgHzDisplay.className = "text-4xl font-bold text-emerald-400 font-mono tracking-tighter tabular-nums";
        } else {
          this.avgHzDisplay.className = "text-4xl font-bold text-white font-mono tracking-tighter tabular-nums";
        }
      }
      
      if (this.jitterDisplay) {
        if (stdDev < 1) {
          this.jitterDisplay.className = "text-4xl font-bold text-emerald-400 font-mono tracking-tighter tabular-nums";
        } else if (stdDev > 2) {
          this.jitterDisplay.className = "text-4xl font-bold text-amber-500 font-mono tracking-tighter tabular-nums";
        } else {
          this.jitterDisplay.className = "text-4xl font-bold text-white font-mono tracking-tighter tabular-nums";
        }
      }
    }
    
    loop() {
      if (this.isPolling && this.gamepadIndex !== null) {
        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        const gamepad = gamepads[this.gamepadIndex];
        
        if (gamepad) {
          const now = performance.now();
          if (this.hasStateChanged(gamepad)) {
            
            if (this.waitingOverlay && this.waitingOverlay.style.display !== 'none') {
              this.waitingOverlay.style.display = 'none';
            }
            
            if (this.lastInputTime > 0) {
              const delta = now - this.lastInputTime;
              
              // Filter out absurdly long deltas (e.g. user stopped moving)
              if (delta < 50) {
                this.deltas.push(delta);
                if (this.deltas.length > this.MAX_SAMPLES) {
                  this.deltas.shift();
                }
                
                this.drawGraph();
                this.updateStats();
              }
            }
            this.lastInputTime = now;
          }
        }
      }
      
      // Keep checking high-frequency even if no visible update
      requestAnimationFrame(this.loop);
    }
  }
  
  // Init when DOM ready or page transitions
  document.addEventListener('DOMContentLoaded', () => {
    new OverclockValidator();
  });
</script>
