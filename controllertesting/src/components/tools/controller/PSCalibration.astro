---
/**
 * PSCalibration.astro — PS5 / PS4 stick center & range check
 * Measures each stick's resting offset and outer-range coverage from live
 * Gamepad API input. It reads only: nothing is written to the controller, so
 * the copy never claims a firmware or EEPROM save.
 */
---

<div class="ps-cal-tool" id="ps-cal-root">
  <div class="tester-status-bar">
    <div class="status-indicator">
      <span class="status-dot" id="ps-cal-dot"></span>
      <span class="status-text" id="ps-cal-text" aria-live="polite">Connect your DualSense or DualShock 4 and press any button.</span>
    </div>
    <div class="controller-name" id="ps-cal-model">No controller detected</div>
  </div>

  <div class="cal-main-card">
    <div class="cal-steps-grid">

      <div class="cal-step-card">
        <span class="step-num">STEP 1</span>
        <h3 class="step-title">Connect</h3>
        <p class="step-desc">Plug the controller in with USB (or pair it over Bluetooth) and press any button so the browser exposes it.</p>
      </div>

      <div class="cal-step-card">
        <span class="step-num">STEP 2</span>
        <h3 class="step-title">Measure resting center</h3>
        <p class="step-desc">Let go of both sticks, then sample for 3 seconds. This is the offset a game sees when you are not touching the stick.</p>
        <button type="button" class="btn-secondary" id="btn-zero-center" disabled>Sample Center (3 s)</button>
      </div>

      <div class="cal-step-card">
        <span class="step-num">STEP 3</span>
        <h3 class="step-title">Measure outer range</h3>
        <p class="step-desc">Roll both sticks slowly around their outer edge for 8 seconds to check they reach full deflection in every direction.</p>
        <button type="button" class="btn-secondary" id="btn-calibrate-outer" disabled>Sample Range (8 s)</button>
      </div>

    </div>

    <div class="cal-result-box" id="cal-result-box">
      <span class="res-label">RESULT</span>
      <h2 class="res-status text-gradient" id="cal-status-display">Waiting for a controller</h2>
      <p class="res-sub" id="cal-sub-display">
        This check reads your sticks only. It does not change the controller's own calibration.
      </p>
    </div>
  </div>
</div>

<script>
  import { calculateStickDrift } from '../../../lib/gamepad';
  import { DRIFT_BANDS } from '../../../lib/thresholds';

  const statusEl = document.getElementById('cal-status-display');
  const subEl = document.getElementById('cal-sub-display');
  const btnCenter = document.getElementById('btn-zero-center') as HTMLButtonElement | null;
  const btnOuter = document.getElementById('btn-calibrate-outer') as HTMLButtonElement | null;

  const firstPad = () => Array.from(navigator.getGamepads?.() ?? []).find((g): g is Gamepad => !!g) ?? null;

  function setResult(status: string, sub: string) {
    if (statusEl) statusEl.textContent = status;
    if (subEl) subEl.textContent = sub;
  }

  function onConnect(gp: Gamepad) {
    document.getElementById('ps-cal-dot')?.classList.add('active');
    const text = document.getElementById('ps-cal-text');
    const model = document.getElementById('ps-cal-model');
    if (text) text.textContent = 'Controller connected';
    if (model) model.textContent = gp.id.slice(0, 48);
    if (btnCenter) btnCenter.disabled = false;
    if (btnOuter) btnOuter.disabled = false;
    setResult('Ready', 'Let go of both sticks and press "Sample Center".');
  }

  window.addEventListener('gamepadconnected', (e) => onConnect((e as GamepadEvent).gamepad));
  const existing = firstPad();
  if (existing) onConnect(existing);

  // Collect samples from the first connected pad for `ms`, then hand them back.
  function sample(ms: number, each: (gp: Gamepad) => void, done: () => void) {
    const end = performance.now() + ms;
    const tick = () => {
      const gp = firstPad();
      if (gp) each(gp);
      if (performance.now() < end) requestAnimationFrame(tick);
      else done();
    };
    requestAnimationFrame(tick);
  }

  btnCenter?.addEventListener('click', () => {
    let maxL = 0, maxR = 0, n = 0;
    setResult('Sampling…', 'Keep your thumbs off the sticks.');
    sample(3000, (gp) => {
      maxL = Math.max(maxL, calculateStickDrift(gp.axes[0] ?? 0, gp.axes[1] ?? 0));
      maxR = Math.max(maxR, calculateStickDrift(gp.axes[2] ?? 0, gp.axes[3] ?? 0));
      n++;
    }, () => {
      if (!n) return setResult('No input received', 'Press a button on the controller and try again.');
      const worst = Math.max(maxL, maxR);
      const verdict = worst <= DRIFT_BANDS.healthyMax ? 'Within normal range' : worst <= DRIFT_BANDS.moderateMax ? 'Noticeable resting offset' : 'Heavy resting offset';
      setResult(
        `Left ${maxL.toFixed(1)}% · Right ${maxR.toFixed(1)}%`,
        `${verdict}. Up to ${DRIFT_BANDS.healthyMax}% is normal wear and an in-game deadzone just above it hides it. Higher values usually mean the stick module needs cleaning or replacing.`
      );
    });
  });

  btnOuter?.addEventListener('click', () => {
    // 36 ten-degree sectors per stick; a sector counts once the stick reaches 90% deflection in it.
    const hitL = new Set<number>(), hitR = new Set<number>();
    const mark = (x: number, y: number, hit: Set<number>) => {
      if (Math.hypot(x, y) < 0.9) return;
      hit.add(Math.floor(((Math.atan2(y, x) * 180) / Math.PI + 360) % 360 / 10));
    };
    setResult('Sampling…', 'Roll both sticks slowly around their outer edge.');
    sample(8000, (gp) => {
      mark(gp.axes[0] ?? 0, gp.axes[1] ?? 0, hitL);
      mark(gp.axes[2] ?? 0, gp.axes[3] ?? 0, hitR);
    }, () => {
      const l = Math.round((hitL.size / 36) * 100), r = Math.round((hitR.size / 36) * 100);
      setResult(
        `Range coverage: Left ${l}% · Right ${r}%`,
        l >= 90 && r >= 90
          ? 'Both sticks reach full deflection all the way around.'
          : 'A stick missed full deflection in some directions. Try another slow lap; if it stays low, debris or a worn gate is limiting travel.'
      );
    });
  });
</script>

<style>
  .ps-cal-tool { display: flex; flex-direction: column; gap: 1.5rem; }
  .ps-cal-tool .tester-status-bar { margin-top: 0; }
  .status-indicator { display: flex; align-items: center; gap: 0.625rem; }
  .status-text { font-size: var(--text-small); color: var(--color-text-secondary); }
  .controller-name { font-family: var(--font-mono); font-size: var(--text-small); font-weight: 600; color: var(--color-accent); }
  .cal-main-card { background: var(--color-surface-2); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-card); padding: 1.75rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .cal-steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .cal-step-card { background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .step-num { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-accent); }
  .step-title { font-size: 1.125rem; font-weight: 700; }
  .step-desc { font-size: var(--text-small); color: var(--color-text-secondary); line-height: 1.5; flex-grow: 1; }
  .cal-result-box { background: var(--color-surface-1); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); padding: 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; }
  .res-label { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; color: var(--color-text-tertiary); letter-spacing: 0.08em; }
  .res-status { font-family: var(--font-mono); font-size: 1.75rem; font-weight: 800; }
  .res-sub { font-size: var(--text-small); color: var(--color-text-secondary); max-width: 50ch; line-height: 1.6; }
  @media (max-width: 768px) { .cal-steps-grid { grid-template-columns: 1fr; } }
</style>
