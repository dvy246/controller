---
/**
 * SettingsOptimizer.astro — personalized deadzone readout for /settings/[game]/[controller]
 *
 * Reads the last stick-drift measurement persisted by DriftTester (`ct_last_drift`)
 * and turns it into a game-specific tuning verdict. Thresholds match DriftTester
 * badges (clean <2%, minor 2–10%, severe ≥10%) — no invented numbers.
 * Progressive enhancement: static default text renders without JS; the island
 * upgrades it in-place when a measurement exists in localStorage.
 */
interface Props {
  gameName: string;
  gameRange: string;
  controllerName: string;
}

const { gameName, gameRange, controllerName } = Astro.props;
---

<div class="opt-card card-base" id="settings-optimizer" data-game={gameName} data-range={gameRange}>
  <div class="opt-head">
    <span class="opt-badge">MEASURED STICK PROFILE</span>
    <h3 class="opt-title">Personal {gameName} deadzone for your {controllerName}</h3>
  </div>
  <div class="opt-body" id="opt-body">
    <p class="opt-default">
      No drift measurement on this device yet. Run the <strong>Stick Drift Detector</strong> and this card will
      recommend a personalized deadzone from your actual stick — then re-check here.
    </p>
    <div class="opt-cta">
      <a href="/test/controller/drift" class="btn-primary">Test your stick first</a>
    </div>
  </div>
</div>

<script>
  function renderOptimizer() {
    const card = document.getElementById('settings-optimizer');
    const body = document.getElementById('opt-body');
    if (!card || !body) return;

    const gameName = card.dataset.game || '';
    const gameRange = card.dataset.range || '';

    let raw: string | null = null;
    try {
      raw = localStorage.getItem('ct_last_drift');
    } catch {
      return;
    }
    if (!raw) return;

    let rec: { model?: string; drift?: number; side?: string; date?: number } = {};
    try {
      rec = JSON.parse(raw);
    } catch {
      return;
    }
    const drift = typeof rec.drift === 'number' ? rec.drift : null;
    if (drift === null) return;

    const sideLabel = rec.side === 'right' ? 'right' : 'left';
    const dateLabel = rec.date ? new Date(rec.date).toLocaleDateString() : 'recently';

    let zone: 'clean' | 'minor' | 'severe';
    let verdict: string;
    let action: string;
    if (drift < 2) {
      zone = 'clean';
      verdict = `${rec.model || 'Your controller'} reads ~${drift.toFixed(1)}% stick drift — well inside the clean zone.`;
      action = `Start at the lowest edge of ${gameName}'s recommended range (${gameRange}) and test in-game; a clean stick can usually run lower.`;
    } else if (drift < 10) {
      zone = 'minor';
      verdict = `${rec.model || 'Your controller'} reads ~${drift.toFixed(1)}% on the ${sideLabel} stick — minor drift.`;
      action = `In ${gameName}, set the ${sideLabel} stick deadzone in the upper half of the range (${gameRange}) for now. Re-test every few weeks — drift tends to climb as the stick wears.`;
    } else {
      zone = 'severe';
      verdict = `${rec.model || 'Your controller'} reads ${drift.toFixed(1)}% drift on the ${sideLabel} stick — severe.`;
      action = `Raising the deadzone to the top of ${gameName}'s range (${gameRange}) can mask it, but the honest fix is cleaning or replacing the stick first, then re-measuring.`;
    }

    const zoneClass = zone === 'clean' ? 'zone-pass' : zone === 'minor' ? 'zone-warn' : 'zone-fail';
    const zoneLabel = zone === 'clean' ? 'Clean stick' : zone === 'minor' ? 'Minor drift' : 'Severe drift';

    body.innerHTML = `
      <div class="opt-zone ${zoneClass}">
        <span class="opt-zone-label">${zoneLabel}</span>
        <strong class="opt-zone-read">${drift.toFixed(1)}%</strong>
        <span class="opt-zone-meta">${sideLabel} stick · measured ${dateLabel}</span>
      </div>
      <p class="opt-verdict">${verdict}</p>
      <p class="opt-action">${action}</p>
      <div class="opt-actions">
        <a href="/test/controller/drift" class="btn-primary">Re-test now</a>
        <a href="/test/controller/deadzone" class="btn-secondary">Visualize deadzones</a>
      </div>
    `;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderOptimizer);
  } else {
    renderOptimizer();
  }
</script>

<style>
  .opt-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    margin-top: 1.5rem;
  }
  .opt-head {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .opt-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
  }
  .opt-title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }
  .opt-default {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .opt-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .opt-zone {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface-1);
  }
  .zone-pass {
    border-color: rgba(16, 185, 129, 0.4);
  }
  .zone-pass .opt-zone-label {
    background: var(--color-pass);
  }
  .zone-warn {
    border-color: rgba(245, 158, 11, 0.4);
  }
  .zone-warn .opt-zone-label {
    background: var(--color-warning);
  }
  .zone-fail {
    border-color: rgba(239, 68, 68, 0.4);
  }
  .zone-fail .opt-zone-label {
    background: var(--color-danger);
  }
  .opt-zone-label {
    align-self: stretch;
    width: 6px;
    border-radius: 99px;
    flex: 0 0 auto;
  }
  .opt-zone-read {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .opt-zone-meta {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
  }
  .opt-verdict {
    font-size: 1rem;
    color: var(--color-text-primary);
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
  }
  .opt-action {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .opt-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
</style>