---
/**
 * TriggerBars.astro
 * High-fidelity vertical fill bars for analog triggers (L2 / R2).
 * Features neon pressure gradients, scale tick marks, and zero-latency scaleY transforms.
 */
---
<div class="triggers-container w-full h-full flex justify-around items-center px-2 py-1 select-none">
  
  <!-- L2 / LT Trigger -->
  <div class="trigger-col flex flex-col items-center gap-1.5">
    <div class="trigger-label font-mono font-bold text-[10px] text-stone-400 tracking-wider">LT / L2</div>
    <div class="trigger-bar-wrapper relative w-14 h-28 bg-black/70 rounded-xl overflow-hidden border border-white/10 shadow-inner backdrop-blur-md">
      <!-- Base Idle Track Overlay -->
      <div class="absolute inset-0 bg-blue-500/5 pointer-events-none"></div>
      
      <div id="l2-fill" class="trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 via-indigo-500 to-blue-400 origin-bottom shadow-[0_0_15px_rgba(37,99,235,0.6)]" style="height: 100%; transform: scaleY(0)"></div>
      
      <!-- Scale Tick Marks -->
      <div class="absolute inset-0 pointer-events-none flex flex-col justify-between py-2 px-1">
        <div class="w-full h-px bg-white/20"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/20"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/20"></div>
      </div>
    </div>
    <span class="trigger-value font-mono font-bold text-[10px] text-emerald-400 px-2 py-0.5 rounded bg-black/80 border border-emerald-500/30 shadow-sm" id="l2-val">0.000</span>
  </div>

  <!-- R2 / RT Trigger -->
  <div class="trigger-col flex flex-col items-center gap-1.5">
    <div class="trigger-label font-mono font-bold text-[10px] text-stone-400 tracking-wider">RT / R2</div>
    <div class="trigger-bar-wrapper relative w-14 h-28 bg-black/70 rounded-xl overflow-hidden border border-white/10 shadow-inner backdrop-blur-md">
      <!-- Base Idle Track Overlay -->
      <div class="absolute inset-0 bg-blue-500/5 pointer-events-none"></div>

      <div id="r2-fill" class="trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 via-indigo-500 to-blue-400 origin-bottom shadow-[0_0_15px_rgba(37,99,235,0.6)]" style="height: 100%; transform: scaleY(0)"></div>
      
      <!-- Scale Tick Marks -->
      <div class="absolute inset-0 pointer-events-none flex flex-col justify-between py-2 px-1">
        <div class="w-full h-px bg-white/20"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/20"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/20"></div>
      </div>
    </div>
    <span class="trigger-value font-mono font-bold text-[10px] text-blue-400 px-2 py-0.5 rounded bg-black/80 border border-blue-500/30 shadow-sm" id="r2-val">0.000</span>
  </div>

</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const l2Fill = document.getElementById('l2-fill');
    const r2Fill = document.getElementById('r2-fill');
    const l2Val = document.getElementById('l2-val');
    const r2Val = document.getElementById('r2-val');

    let lastL2 = -1;
    let lastR2 = -1;

    GamepadLoop.subscribe((state) => {
      if (!state) {
        if (l2Val) l2Val.textContent = '0.000';
        if (r2Val) r2Val.textContent = '0.000';
        if (l2Fill) l2Fill.style.transform = 'scaleY(0)';
        if (r2Fill) r2Fill.style.transform = 'scaleY(0)';
        return;
      }
      
      const l2 = state.triggers.l2;
      const r2 = state.triggers.r2;

      if (l2Fill && l2Val && Math.abs(l2 - lastL2) > 0.001) {
        l2Fill.style.transform = `scaleY(${l2})`;
        l2Val.textContent = l2.toFixed(3);
        
        // Highlight when maxed out at full pull (>= 0.98)
        if (l2 >= 0.98) {
          l2Fill.className = 'trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-emerald-600 via-emerald-500 to-emerald-400 origin-bottom shadow-[0_0_20px_rgba(16,185,129,0.9)]';
        } else {
          l2Fill.className = 'trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 via-indigo-500 to-blue-400 origin-bottom shadow-[0_0_15px_rgba(37,99,235,0.6)]';
        }
        lastL2 = l2;
      }

      if (r2Fill && r2Val && Math.abs(r2 - lastR2) > 0.001) {
        r2Fill.style.transform = `scaleY(${r2})`;
        r2Val.textContent = r2.toFixed(3);

        if (r2 >= 0.98) {
          r2Fill.className = 'trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-emerald-600 via-emerald-500 to-emerald-400 origin-bottom shadow-[0_0_20px_rgba(16,185,129,0.9)]';
        } else {
          r2Fill.className = 'trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 via-indigo-500 to-blue-400 origin-bottom shadow-[0_0_15px_rgba(37,99,235,0.6)]';
        }
        lastR2 = r2;
      }
    });
  });
</script>

<style>
  .trigger-fill {
    will-change: transform;
    transition: transform 0.04s linear, background 0.1s ease;
  }
</style>

