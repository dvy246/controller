---
/**
 * TriggerBars.astro
 * High-fidelity vertical fill bars for analog triggers (L2 / R2).
 */
---
<div class="triggers-container w-full h-full flex justify-around items-center px-4">
  
  <!-- L2 Trigger -->
  <div class="trigger-col flex flex-col items-center gap-3">
    <div class="trigger-label font-bold text-stone-400">L2</div>
    <div class="trigger-bar-wrapper relative w-16 h-32 bg-black/50 rounded-xl overflow-hidden border border-white/5 shadow-inner">
      <div id="l2-fill" class="trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 to-blue-400 origin-bottom" style="height: 100%; transform: scaleY(0)"></div>
      
      <!-- Scale Marks -->
      <div class="absolute inset-0 pointer-events-none flex flex-col justify-between py-2">
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
      </div>
    </div>
    <div class="trigger-value font-mono text-sm text-stone-300" id="l2-val">0.000</div>
  </div>

  <!-- R2 Trigger -->
  <div class="trigger-col flex flex-col items-center gap-3">
    <div class="trigger-label font-bold text-stone-400">R2</div>
    <div class="trigger-bar-wrapper relative w-16 h-32 bg-black/50 rounded-xl overflow-hidden border border-white/5 shadow-inner">
      <div id="r2-fill" class="trigger-fill absolute bottom-0 left-0 w-full bg-gradient-to-t from-blue-600 to-blue-400 origin-bottom" style="height: 100%; transform: scaleY(0)"></div>
      
      <!-- Scale Marks -->
      <div class="absolute inset-0 pointer-events-none flex flex-col justify-between py-2">
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
        <div class="w-full h-px bg-white/10"></div>
      </div>
    </div>
    <div class="trigger-value font-mono text-sm text-stone-300" id="r2-val">0.000</div>
  </div>

</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const l2Fill = document.getElementById('l2-fill');
    const r2Fill = document.getElementById('r2-fill');
    const l2Val = document.getElementById('l2-val');
    const r2Val = document.getElementById('r2-val');

    let lastL2 = -1;
    let lastR2 = -1;

    GamepadLoop.subscribe((state) => {
      if (!state) return;
      
      const l2 = state.triggers.l2;
      const r2 = state.triggers.r2;

      if (l2Fill && l2Val && l2 !== lastL2) {
        l2Fill.style.transform = `scaleY(${l2})`;
        l2Val.textContent = l2.toFixed(3);
        
        // Change color when maxed out
        if (l2 >= 1.0) {
          l2Fill.classList.replace('from-blue-600', 'from-emerald-500');
          l2Fill.classList.replace('to-blue-400', 'to-emerald-400');
        } else {
          l2Fill.classList.replace('from-emerald-500', 'from-blue-600');
          l2Fill.classList.replace('to-emerald-400', 'to-blue-400');
        }
        lastL2 = l2;
      }

      if (r2Fill && r2Val && r2 !== lastR2) {
        r2Fill.style.transform = `scaleY(${r2})`;
        r2Val.textContent = r2.toFixed(3);

        if (r2 >= 1.0) {
          r2Fill.classList.replace('from-blue-600', 'from-emerald-500');
          r2Fill.classList.replace('to-blue-400', 'to-emerald-400');
        } else {
          r2Fill.classList.replace('from-emerald-500', 'from-blue-600');
          r2Fill.classList.replace('to-emerald-400', 'to-blue-400');
        }
        lastR2 = r2;
      }
    });
  });
</script>

<style>
  .trigger-fill {
    /* Fast transition for smooth visual feedback. Transform is GPU accelerated. */
    transition: transform 0.05s linear, background-color 0.1s ease;
  }
</style>
