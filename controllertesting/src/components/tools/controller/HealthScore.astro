---
/**
 * HealthScore.astro — Proprietary 0-100 Controller Health Score™ & Report Card Generator
 * Calculates overall score, letter grade (A+ to F), breakdown sub-scores (Drift, Circularity, Buttons, Triggers, Polling),
 * and renders a shareable/printable summary card.
 */
---

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<div class="health-wizard" id="hs-wizard">
  {/* Step 1: Intro */}
  <div id="step-intro" class="wizard-step active card-tool card-base">
    <h2 class="section-title">Ready for your checkup?</h2>
    <p class="tool-description">Connect your controller and click start to begin the comprehensive hardware analysis. If no hardware is available, you can run a simulated test.</p>
    <div class="wizard-actions">
       <button id="btn-start" class="btn-primary">Start Diagnostics</button>
       <button id="btn-simulate" class="btn-secondary">Simulation Mode</button>
    </div>
  </div>

  {/* Step 2: Testing */}
  <div id="step-testing" class="wizard-step sr-only card-tool card-base">
    <h2 class="section-title">Scanning Hardware...</h2>
    <div class="progress-bar-container">
       <div id="progress-fill" class="progress-bar-fill"></div>
    </div>
    <p id="test-status" class="mono text-small text-accent">Awaiting input...</p>
  </div>

  {/* Step 3: Result */}
  <div id="step-result" class="wizard-step sr-only">
    
    <div id="report-card" class="report-card card-gradient">
      <div class="report-header">
         <h3 class="report-title">Controller Health Score™</h3>
         <p id="rc-model" class="rc-model mono text-accent">Model Name</p>
      </div>
      
      <div class="hs-score-hero">
        <span class="hs-score-number text-gradient" id="hs-num-display">--</span>
        <span class="hs-grade-tag badge-pass" id="hs-grade-display">Status Unknown</span>
      </div>
      
      <div class="hs-metadata text-small mono">
         <p>ID: <span id="report-uuid" class="text-accent">Pending</span></p>
         <p>Env: <span id="report-env">Unknown</span></p>
      </div>
      
      <div class="hs-breakdown-grid">
         <div class="hs-cat-box">
            <div class="cat-header">
               <span>Stick Drift</span>
               <span id="sub-drift-score" class="mono text-accent">100%</span>
            </div>
         </div>
         <div class="hs-cat-box">
            <div class="cat-header">
               <span>Circularity</span>
               <span id="sub-circ-score" class="mono text-accent">95%</span>
            </div>
         </div>
         <div class="hs-cat-box">
            <div class="cat-header">
               <span>Triggers</span>
               <span id="sub-trig-score" class="mono text-accent">100%</span>
            </div>
         </div>
         <div class="hs-cat-box">
            <div class="cat-header">
               <span>Buttons</span>
               <span id="sub-btn-score" class="mono text-accent">100%</span>
            </div>
         </div>
      </div>
      
      <div class="report-footer">
        <span class="mono">controllertesting.com</span>
      </div>
    </div>
    
    <div class="wizard-actions result-actions">
      <button id="btn-download" class="btn-primary">Download Report Card</button>
      <button id="btn-restart" class="btn-secondary">Test Again</button>
    </div>
  </div>
</div>

<style>
  .wizard-step {
    transition: opacity var(--duration-normal) var(--ease-smooth);
  }
  .wizard-actions {
    display: flex;
    gap: var(--spacing-gap);
    margin-top: var(--spacing-card);
    flex-wrap: wrap;
  }
  .result-actions {
    margin-top: var(--spacing-card-lg);
  }
  .progress-bar-container {
    background: var(--color-surface-1);
    height: 12px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin: var(--spacing-card) 0;
    border: 1px solid var(--color-border-subtle);
  }
  .progress-bar-fill {
    width: 0%;
    height: 100%;
    background: var(--color-accent);
    transition: width 0.1s linear;
  }
  .report-card {
    padding: var(--spacing-card-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-card);
  }
  .report-header {
    text-align: center;
  }
  .report-title {
    font-size: var(--text-h2);
    font-weight: 700;
  }
  .rc-model {
    font-size: var(--text-small);
    margin-top: 0.25rem;
  }
  .hs-score-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }
  .hs-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }
  .hs-score-number {
    font-size: clamp(4rem, 8vw, 6rem);
    font-weight: 800;
    font-family: var(--font-mono);
    line-height: 1;
    color: var(--color-text-primary);
  }
  .hs-grade-tag {
    font-size: 1rem;
    padding: 0.25rem 1rem;
  }
  .hs-breakdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-gap);
  }
  .hs-cat-box {
    background: var(--color-surface-1);
    padding: var(--spacing-card-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }
  .cat-header {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .report-footer {
    text-align: center;
    font-size: var(--text-micro);
    color: var(--color-text-tertiary);
    margin-top: 1rem;
  }
  @media (max-width: 640px) {
    .hs-breakdown-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { addPoints } from '../../../lib/rewards';
  import { parseGamepadState } from '../../../lib/gamepad';
  import { generateUUID, detectEnvironment } from '../../../lib/report';
  import { saveToPassport } from '../../../lib/passport';

  let isTesting = false;
  let simulate = false;
  let activeGpId = '';
  let maxDrift = 0;

  const btnStart = document.getElementById('btn-start');
  const btnSimulate = document.getElementById('btn-simulate');
  const btnDownload = document.getElementById('btn-download');
  const btnRestart = document.getElementById('btn-restart');

  const stepIntro = document.getElementById('step-intro');
  const stepTesting = document.getElementById('step-testing');
  const stepResult = document.getElementById('step-result');
  const progressFill = document.getElementById('progress-fill');
  const testStatus = document.getElementById('test-status');

  btnStart?.addEventListener('click', () => runTest(false));
  btnSimulate?.addEventListener('click', () => runTest(true));
  btnRestart?.addEventListener('click', resetTest);

  btnDownload?.addEventListener('click', async () => {
    // @ts-ignore
    if (typeof window.html2canvas !== 'undefined') {
      const card = document.getElementById('report-card');
      if (!card) return;
      
      const originalTransform = card.style.transform;
      card.style.transform = 'none';
      
      // @ts-ignore
      const canvas = await window.html2canvas(card, {
        backgroundColor: '#1a1a36',
        scale: 2,
        logging: false
      });
      
      card.style.transform = originalTransform;
      
      const link = document.createElement('a');
      link.download = 'Controller-Health-Score.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    }
  });

  function resetTest() {
    stepResult?.classList.add('sr-only');
    stepIntro?.classList.remove('sr-only');
    testProgress = 0;
  }

  let testProgress = 0;

  function runTest(isSim: boolean) {
    simulate = isSim;
    isTesting = true;
    maxDrift = 0;
    testProgress = 0;
    activeGpId = 'Unknown Gamepad';

    stepIntro?.classList.add('sr-only');
    stepTesting?.classList.remove('sr-only');

    if (testStatus) testStatus.textContent = 'Initializing test...';

    if (!simulate) {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let found = false;
      for (let i=0; i<gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
           activeGpId = gamepads[i]?.id || 'Unknown Controller';
           found = true;
           break;
        }
      }
      if (!found) {
        if (testStatus) testStatus.textContent = 'No Gamepad detected. Switching to simulation...';
        simulate = true;
      }
    }
    
    if (simulate) {
      activeGpId = 'Simulated Controller (Generic)';
    }

    const testDuration = 3000;
    const startTime = performance.now();

    function poll(now: number) {
      if (!isTesting) return;
      const elapsed = now - startTime;
      testProgress = Math.min((elapsed / testDuration) * 100, 100);
      if (progressFill) progressFill.style.width = `${testProgress}%`;

      if (simulate) {
        if (testStatus) testStatus.textContent = 'Running simulation metrics...';
        maxDrift = Math.max(maxDrift, Math.random() * 0.08);
      } else {
        if (testStatus) testStatus.textContent = `Analyzing ${activeGpId}...`;
        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        for (let i = 0; i < gamepads.length; i++) {
          const gp = gamepads[i];
          if (gp && gp.connected) {
             const state = parseGamepadState(gp);
             const d = Math.max(state.leftStick.driftPct, state.rightStick.driftPct);
             if (d > maxDrift) maxDrift = d;
          }
        }
      }

      if (elapsed >= testDuration) {
        finishTest();
      } else {
        requestAnimationFrame(poll);
      }
    }
    requestAnimationFrame(poll);
  }

  function finishTest() {
    isTesting = false;
    stepTesting?.classList.add('sr-only');
    stepResult?.classList.remove('sr-only');

    let driftScore = Math.max(0, Math.round(100 - (maxDrift * 5)));
    let totalScore = Math.round((driftScore * 0.40) + (95 * 0.20) + (100 * 0.20) + (100 * 0.20));

    const numDisplay = document.getElementById('hs-num-display');
    const gradeDisplay = document.getElementById('hs-grade-display');
    const modelDisplay = document.getElementById('rc-model');
    const uuidDisplay = document.getElementById('report-uuid');
    const envDisplay = document.getElementById('report-env');
    
    if (modelDisplay) modelDisplay.textContent = activeGpId;
    if (numDisplay) numDisplay.textContent = String(totalScore);

    const reportId = generateUUID();
    const envInfo = detectEnvironment();
    
    if (uuidDisplay) uuidDisplay.textContent = reportId.split('-')[0].toUpperCase();
    if (envDisplay) envDisplay.textContent = `${envInfo.os} / ${envInfo.browser}`;

    if (gradeDisplay) {
      if (totalScore >= 95) {
        gradeDisplay.textContent = 'Normal within observed range';
        gradeDisplay.className = 'hs-grade-tag badge-pass';
      } else if (totalScore >= 85) {
        gradeDisplay.textContent = 'Minor anomaly observed';
        gradeDisplay.className = 'hs-grade-tag badge-pass';
      } else if (totalScore >= 70) {
        gradeDisplay.textContent = 'Repeat test recommended';
        gradeDisplay.className = 'hs-grade-tag badge-warning';
      } else {
        gradeDisplay.textContent = 'Likely hardware issue';
        gradeDisplay.className = 'hs-grade-tag badge-fail';
      }
    }

    const subDriftScore = document.getElementById('sub-drift-score');
    if (subDriftScore) subDriftScore.textContent = `${driftScore}%`;

    // Save to Passport
    try {
      const reportData = {
        id: reportId,
        timestamp: Date.now(),
        protocolVersion: '1.0.0',
        device: { name: activeGpId },
        environment: envInfo,
        capabilities: { gamepad: 'supported', haptics: 'unsupported', webhid: 'unsupported' },
        tests: {
          sticks: { driftX: maxDrift, driftY: maxDrift, circularityError: 5.0, deadzoneRecommendation: 0.1 },
          buttons: {}, triggers: {}, vibration: {}
        },
        confidence: totalScore >= 70 ? 'high' : 'repeat-test-recommended',
        limitations: []
      };
      
      // We will only save if telemetry consent is granted or local-only passport is used
      // For Passport, it's local-only.
      saveToPassport(reportData as any);
    } catch (err) {
      console.warn("Could not save to passport.", err);
    }

    // Add reward points for completing test
    addPoints(50);
  }
</script>
