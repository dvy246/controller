---
/**
 * DashboardBento.astro — Unified Controller Diagnostic Dashboard
 * A high-density, dark-tech bento grid layout for real-time visualization.
 * 
 * Uses the 5-Layer Surface Depth System and 8px Spatial Grid.
 */
import InteractiveSilhouette from './InteractiveSilhouette.astro';
import PremiumStickCanvas from './PremiumStickCanvas.astro';
import TriggerBars from './TriggerBars.astro';
import DiagnosticSequence from './DiagnosticSequence.astro';
---
<div class="dashboard-root" id="bento-dashboard-root" data-model="none">
  <!-- ── Top Status Bar ── -->
  <div class="dashboard-header card-base mb-4 flex items-center justify-between p-4 rounded-2xl">
    <div class="flex items-center gap-3">
      <span class="status-dot" id="dash-status-dot"></span>
      <span class="status-text text-sm font-medium text-stone-300" id="dash-status-text">Waiting for controller connection...</span>
    </div>
    <div class="controller-name font-mono text-sm tracking-wider uppercase text-stone-400" id="dash-model-name">
      NO DEVICE
    </div>
  </div>

  <!-- ── Bento Grid ── -->
  <div class="bento-grid">
    
    <!-- Guided Sequence Overlay -->
    <DiagnosticSequence />

    <!-- 1. Interactive Silhouette (Left large cell) -->
    <div class="bento-cell bento-visualizer card-base relative overflow-hidden group">
      <div class="cell-header">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><rect x="2" y="6" width="20" height="12" rx="6"/><path d="M12 12h.01"/><path d="M16 12h.01"/><path d="M8 12h.01"/></svg>
          <h2 class="cell-title">Controller Visualizer</h2>
        </div>
      </div>
      <div class="cell-content flex flex-col justify-center flex-1 w-full h-full min-h-[300px] lg:min-h-0">
        <InteractiveSilhouette />
      </div>
    </div>

    <!-- 2. Analog Sticks -->
    <div class="bento-cell bento-sticks card-base">
      <div class="cell-header flex justify-between items-center">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          <div>
            <h2 class="cell-title">Analog Sticks</h2>
            <span class="cell-subtitle">Linearity, Drift & Circularity</span>
          </div>
        </div>
      </div>
      <div class="cell-content flex-1 flex flex-col min-h-[200px] lg:min-h-0">
        <PremiumStickCanvas />
      </div>
    </div>

    <!-- 3. Triggers -->
    <div class="bento-cell bento-triggers card-base">
      <div class="cell-header">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>
          <div>
            <h2 class="cell-title">Triggers</h2>
            <span class="cell-subtitle">Analog Pressure (0-1)</span>
          </div>
        </div>
      </div>
      <div class="cell-content flex-1 flex flex-col min-h-[200px] lg:min-h-0">
        <TriggerBars />
      </div>
    </div>

    <!-- 4. Raw Data Array -->
    <div class="bento-cell bento-raw card-base">
      <div class="cell-header">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          <div>
            <h2 class="cell-title">Raw Data</h2>
            <span class="cell-subtitle">Gamepad API Output</span>
          </div>
        </div>
      </div>
      <div class="cell-content flex-1 flex flex-col justify-center gap-3">
        <div class="grid grid-cols-6 gap-1.5" id="raw-data-matrix">
          <!-- Populated via JS -->
        </div>
        <div class="flex items-center justify-center gap-2 py-1.5 px-3 rounded-xl bg-white/[0.04] border border-white/10 text-center">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0" id="dash-raw-status-dot"></span>
          <span id="raw-data-output" class="text-[10px] font-mono text-stone-300 font-bold uppercase tracking-wider">NO CONTROLLER DETECTED</span>
        </div>
      </div>
    </div>

    <!-- 5. Vibration Test -->
    <div class="bento-cell bento-vibration card-base">
      <div class="cell-header">
        <div class="flex items-center gap-2">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <div>
            <h2 class="cell-title">Vibration Test</h2>
            <span class="cell-subtitle">Dual Motor Setup</span>
          </div>
        </div>
      </div>
      <div class="cell-content flex-1 flex flex-col items-center justify-center gap-3">
        <div class="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
          <svg class="w-4 h-4 text-amber-400 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v.01"/><path d="M8 12v.01"/><path d="M12 12v.01"/><path d="M16 12v.01"/><path d="M20 12v.01"/><path d="m2 8 20-4"/><path d="m2 16 20 4"/></svg>
        </div>
        <div class="grid grid-cols-2 gap-2.5 w-full">
          <button class="vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer" data-vibe="heavy">Heavy <div class="w-3 h-0.5 bg-amber-500 rounded-full mx-auto mt-1"></div></button>
          <button class="vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer" data-vibe="light">Light <div class="w-3 h-0.5 bg-blue-500 rounded-full mx-auto mt-1"></div></button>
          <button class="vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer" data-vibe="burst">Burst <div class="w-3 h-0.5 bg-purple-500 rounded-full mx-auto mt-1"></div></button>
          <button class="vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer" data-vibe="pulse">Pulse <div class="w-3 h-0.5 bg-rose-500 rounded-full mx-auto mt-1"></div></button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const statusDot = document.getElementById('dash-status-dot');
    const statusText = document.getElementById('dash-status-text');
    const modelName = document.getElementById('dash-model-name');
    const rawData = document.getElementById('raw-data-output');
    const rawDot = document.getElementById('dash-raw-status-dot');
    const matrixContainer = document.getElementById('raw-data-matrix');
    
    // Populate 18 matrix tiles
    const matrixEls: HTMLElement[] = [];
    if (matrixContainer) {
      let html = '';
      for (let i = 0; i < 18; i++) {
        html += `<div id="dash-matrix-${i}" class="h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border bg-white/5 text-stone-500 border-white/5 transition-all duration-75">${i}</div>`;
      }
      matrixContainer.innerHTML = html;
      for (let i = 0; i < 18; i++) {
        const el = document.getElementById(`dash-matrix-${i}`);
        if (el) matrixEls.push(el);
      }
    }

    GamepadLoop.subscribe((state) => {
      if (state && state.connected) {
        if (statusDot) statusDot.className = 'status-dot active';
        if (statusText) statusText.textContent = 'Controller Connected';
        if (modelName) modelName.textContent = state.detectedModel;
        if (rawData) rawData.textContent = 'GAMEPAD API ACTIVE';
        if (rawDot) rawDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#10B981]';

        state.buttons.forEach((pressed, idx) => {
          if (matrixEls[idx]) {
            if (pressed) {
              matrixEls[idx].className = 'h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border bg-blue-600 text-white border-blue-400 shadow-[0_0_8px_rgba(37,99,235,0.8)] scale-105 transition-all duration-75';
            } else {
              matrixEls[idx].className = 'h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border bg-white/5 text-stone-500 border-white/5 transition-all duration-75';
            }
          }
        });
      } else {
        if (statusDot) statusDot.className = 'status-dot';
        if (statusText) statusText.textContent = 'Waiting for controller connection...';
        if (modelName) modelName.textContent = 'NO DEVICE';
        if (rawData) rawData.textContent = 'NO CONTROLLER DETECTED';
        if (rawDot) rawDot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';

        for (let i = 0; i < 18; i++) {
          if (matrixEls[i]) matrixEls[i].className = 'h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border bg-white/5 text-stone-500 border-white/5 transition-all duration-75';
        }
      }
    });
  });
</script>

<style>
  /* Base Bento Structure */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 1fr;
    }

    .bento-visualizer {
      grid-column: span 6;
      grid-row: span 2;
    }
    
    .bento-sticks {
      grid-column: span 3;
    }
    
    .bento-triggers {
      grid-column: span 3;
    }
    
    .bento-raw {
      grid-column: span 3;
    }
    
    .bento-vibration {
      grid-column: span 3;
    }
  }

  /* Shared Cell Styles */
  .bento-cell {
    border-radius: 1.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    background: var(--color-surface-1, rgba(15, 15, 20, 0.95));
    border: 1px solid var(--color-border-default, rgba(255,255,255,0.05));
    box-shadow: 0 4px 24px -4px rgba(0,0,0,0.5);
  }

  .cell-header {
    margin-bottom: 1rem;
  }

  .cell-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary, #fff);
    margin: 0;
    line-height: 1.2;
  }

  .cell-subtitle {
    font-size: 0.7rem;
    color: var(--color-text-secondary, rgba(255,255,255,0.55));
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cell-content {
    flex: 1;
    position: relative;
  }

  /* Status Header */
  .status-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: all 0.3s ease;
  }
  .status-dot.active {
    background: #10B981;
    box-shadow: 0 0 10px #10B981;
  }
</style>
