---
/**
 * PS5MasterVisualizer.astro
 * Master Single-Frame 2D PS5 Visualizer & Telemetry Suite.
 * Left Side: 2D Satin DualSense Vector Controller (0-latency real-time movement).
 * Right Side: 2x2 Bento Telemetry Grid (Analog Sticks canvas, Triggers, Raw Data, Vibration Test).
 */
import DualSenseSilhouette from './DualSenseSilhouette.astro';
import PremiumStickCanvas from './PremiumStickCanvas.astro';
import TriggerBars from './TriggerBars.astro';
---

<div class="ps5-master-frame relative w-full rounded-[24px] bg-[#090A0F] border border-white/10 shadow-2xl overflow-hidden select-none">
  <!-- Ambient Backlight Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(37,99,235,0.12)_0%,rgba(0,0,0,0)_80%)] pointer-events-none"></div>

  <!-- Top Header Bar -->
  <div class="relative z-20 w-full flex flex-col sm:flex-row items-center justify-between p-6 border-b border-white/10 bg-black/40 gap-4 font-mono">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_10px_#10B981]" id="master-status-dot"></span>
      <span id="master-status-text" class="text-sm font-bold text-gray-200 uppercase tracking-wider">Awaiting DualSense Input</span>
    </div>
    
    <div class="flex items-center gap-4">
      <div class="bg-white/5 border border-white/10 px-3 py-1.5 rounded-full flex items-center gap-2 text-xs">
        <span class="text-gray-400">POLLING:</span>
        <span id="master-hz" class="text-blue-400 font-bold tabular-nums">-- Hz</span>
      </div>
      <div class="bg-white/5 border border-white/10 px-3 py-1.5 rounded-full flex items-center gap-2 text-xs">
        <span class="text-gray-400">LATENCY:</span>
        <span id="master-latency" class="text-emerald-400 font-bold tabular-nums">-- ms</span>
      </div>
      <div class="hidden md:flex items-center p-1 rounded-full bg-black/50 border border-white/10 text-[10px] font-bold text-gray-400">
        <span class="px-2.5 py-0.5 rounded-full text-white bg-blue-600 shadow-sm">P1 <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block ml-0.5"></span></span>
        <span class="px-2 py-0.5 rounded-full opacity-50">P2</span>
        <span class="px-2 py-0.5 rounded-full opacity-50">P3</span>
        <span class="px-2 py-0.5 rounded-full opacity-50">P4</span>
      </div>
    </div>
  </div>

  <!-- Main Single-Frame 2-Column Grid -->
  <div class="relative z-10 w-full grid grid-cols-1 xl:grid-cols-12 items-stretch">
    
    <!-- LEFT COLUMN: Realtime 2D Vector DualSense Controller -->
    <div class="xl:col-span-6 p-6 sm:p-8 flex flex-col justify-center items-center bg-black/20 border-b xl:border-b-0 xl:border-r border-white/10">
      <div class="w-full text-center mb-2">
        <span class="text-xs font-mono font-bold text-gray-400 uppercase tracking-widest">Real-Time Vector Controller</span>
      </div>
      <div class="w-full flex-1 flex items-center justify-center py-4">
        <DualSenseSilhouette />
      </div>
    </div>

    <!-- RIGHT COLUMN: 2x2 Bento Telemetry Grid -->
    <div class="xl:col-span-6 p-6 sm:p-8 bg-black/40">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full h-full">
        
        <!-- Bento Cell 1: Analog Sticks (Drift & Circularity) -->
        <div class="bento-cell bg-white/[0.03] border border-white/10 rounded-2xl p-4 flex flex-col justify-between shadow-xl">
          <div class="cell-header flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
              <div>
                <h3 class="text-xs font-bold text-white font-mono">Analog Sticks</h3>
                <span class="text-[9px] text-gray-400 font-mono block">Linearity, Drift & Circularity</span>
              </div>
            </div>
            <button id="recenter-sticks-btn" title="Re-center Sticks" class="text-gray-400 hover:text-white transition-colors p-1">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
            </button>
          </div>
          <div class="flex-1 flex items-center justify-center min-h-[160px] w-full">
            <PremiumStickCanvas />
          </div>
        </div>

        <!-- Bento Cell 2: Triggers (Analog Pressure 0-1) -->
        <div class="bento-cell bg-white/[0.03] border border-white/10 rounded-2xl p-4 flex flex-col justify-between shadow-xl">
          <div class="cell-header mb-2">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>
              <div>
                <h3 class="text-xs font-bold text-white font-mono">Triggers</h3>
                <span class="text-[9px] text-gray-400 font-mono block">Analog Pressure (0-1)</span>
              </div>
            </div>
          </div>
          <div class="flex-1 flex items-center justify-center min-h-[160px] w-full">
            <TriggerBars />
          </div>
        </div>

        <!-- Bento Cell 3: Raw Data (Gamepad API Output) -->
        <div class="bento-cell bg-white/[0.03] border border-white/10 rounded-2xl p-4 flex flex-col justify-between shadow-xl">
          <div class="cell-header mb-3">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <div>
                <h3 class="text-xs font-bold text-white font-mono">Raw Data</h3>
                <span class="text-[9px] text-gray-400 font-mono block">Gamepad API Output</span>
              </div>
            </div>
          </div>
          <!-- Button Matrix Grid -->
          <div class="flex-1 flex flex-col justify-center gap-3">
            <div class="grid grid-cols-6 gap-1.5" id="master-btn-matrix">
              <!-- Rendered via JS -->
            </div>
            <div class="text-center">
              <span id="raw-data-subtext" class="text-[10px] font-mono text-gray-400 uppercase tracking-wider">Awaiting Input</span>
            </div>
          </div>
        </div>

        <!-- Bento Cell 4: Vibration Test (Dual Motor) -->
        <div class="bento-cell bg-white/[0.03] border border-white/10 rounded-2xl p-4 flex flex-col justify-between shadow-xl">
          <div class="cell-header mb-2">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <div>
                <h3 class="text-xs font-bold text-amber-400 font-mono">Vibration Test</h3>
                <span class="text-[9px] text-gray-400 font-mono block">Dual Motor Setup</span>
              </div>
            </div>
          </div>
          <div class="flex-1 flex flex-col items-center justify-center gap-3">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v.01"/><path d="M8 12v.01"/><path d="M12 12v.01"/><path d="M16 12v.01"/><path d="M20 12v.01"/><path d="m2 8 20-4"/><path d="m2 16 20 4"/></svg>
            </div>
            <div class="grid grid-cols-2 gap-2 w-full">
              <button class="master-vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-1.5 px-2 rounded bg-white/5 border border-white/10 hover:bg-white/15 text-gray-300 transition-colors" data-vibe="heavy">
                HEAVY <div class="w-3 h-0.5 bg-amber-500 rounded-full mx-auto mt-1"></div>
              </button>
              <button class="master-vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-1.5 px-2 rounded bg-white/5 border border-white/10 hover:bg-white/15 text-gray-300 transition-colors" data-vibe="light">
                LIGHT <div class="w-3 h-0.5 bg-blue-500 rounded-full mx-auto mt-1"></div>
              </button>
              <button class="master-vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-1.5 px-2 rounded bg-white/5 border border-white/10 hover:bg-white/15 text-gray-300 transition-colors" data-vibe="burst">
                BURST <div class="w-3 h-0.5 bg-purple-500 rounded-full mx-auto mt-1"></div>
              </button>
              <button class="master-vibe-btn text-[10px] font-mono font-bold uppercase tracking-wider py-1.5 px-2 rounded bg-white/5 border border-white/10 hover:bg-white/15 text-gray-300 transition-colors" data-vibe="pulse">
                PULSE <div class="w-3 h-0.5 bg-rose-500 rounded-full mx-auto mt-1"></div>
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const statusDot = document.getElementById('master-status-dot');
    const statusText = document.getElementById('master-status-text');
    const hzText = document.getElementById('master-hz');
    const latencyText = document.getElementById('master-latency');
    const btnMatrix = document.getElementById('master-btn-matrix');
    const rawDataSub = document.getElementById('raw-data-subtext');

    // Populate 0-17 button matrix
    const matrixEls: HTMLElement[] = [];
    if (btnMatrix) {
      let html = '';
      for (let i = 0; i < 18; i++) {
        html += `<div id="master-btn-${i}" class="h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-gray-500 border-white/5">${i}</div>`;
      }
      btnMatrix.innerHTML = html;
      for (let i = 0; i < 18; i++) {
        const el = document.getElementById(`master-btn-${i}`);
        if (el) matrixEls.push(el);
      }
    }

    let frameCount = 0;
    let lastHzTime = performance.now();

    GamepadLoop.subscribe((state) => {
      const now = performance.now();
      frameCount++;
      if (now - lastHzTime >= 1000) {
        const hz = Math.round((frameCount * 1000) / (now - lastHzTime));
        frameCount = 0;
        lastHzTime = now;
        if (hzText) hzText.textContent = `${hz} Hz`;
        if (latencyText) latencyText.textContent = `${(1000 / (hz || 60)).toFixed(1)} ms`;
      }

      if (state && state.connected) {
        if (statusText) statusText.textContent = `Connected: ${state.id.substring(0, 20)}...`;
        if (statusDot) statusDot.className = "w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_12px_#10B981]";
        if (rawDataSub) rawDataSub.textContent = "Gamepad API Active";

        // Update button matrix
        state.buttons.forEach((pressed, idx) => {
          if (matrixEls[idx]) {
            if (pressed) {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-blue-600 text-white border-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.8)] scale-105";
            } else {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-gray-500 border-white/5";
            }
          }
        });
      } else {
        if (statusText) statusText.textContent = "Awaiting DualSense Input";
        if (statusDot) statusDot.className = "w-3 h-3 rounded-full bg-amber-400 animate-pulse";
        if (rawDataSub) rawDataSub.textContent = "No Controller Detected";
      }
    });

    // Vibration button handlers
    const vibeBtns = document.querySelectorAll('.master-vibe-btn');
    vibeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLElement).getAttribute('data-vibe');
        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        let activeGp: any = null;
        for (let i = 0; i < gamepads.length; i++) {
          if (gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
        }
        if (activeGp && activeGp.vibrationActuator) {
          let duration = 200, strong = 0, weak = 0;
          if (type === 'heavy') { strong = 1.0; weak = 0.2; duration = 400; }
          if (type === 'light') { strong = 0.1; weak = 0.8; duration = 300; }
          if (type === 'burst') { strong = 1.0; weak = 1.0; duration = 100; }
          if (type === 'pulse') { strong = 0.5; weak = 0.5; duration = 500; }
          
          try {
            activeGp.vibrationActuator.playEffect("dual-rumble", {
              startDelay: 0,
              duration: duration,
              weakMagnitude: weak,
              strongMagnitude: strong
            });
          } catch (err) {
            console.warn("Vibration API failed", err);
          }
        }
      });
    });
  });
</script>
