---
/**
 * TriggerTester.astro — Interactive Trigger Linearity & Analog Range Tester
 * Real-time analog L2/R2 pressure graphs, min/max range detection, and deadzone analysis.
 */
---

<div class="diagnostic-tool-shell group relative" data-model="none" id="trig-tester-root">
  <div class="ambient-glow" style="position: absolute; inset: -4px; border-radius: 24px; background: radial-gradient(ellipse at 50% -20%, rgba(16,185,129,0.15) 0%, rgba(37,99,235,0.1) 50%, transparent 70%); filter: blur(16px); z-index: -1; pointer-events: none;" aria-hidden="true"></div>
  
  <div class="flex flex-col gap-6 relative z-10 bg-[#0E0E10] text-stone-200 rounded-[16px] overflow-hidden border border-white/5 shadow-2xl">
    <!-- TOP TOOLBAR -->
    <div class="w-full bg-[#141417] border-b border-[#27272A] px-5 sm:px-8 py-4 flex flex-wrap items-center justify-between gap-4 font-mono">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        </div>
        <span class="text-white font-bold text-sm font-sans tracking-tight truncate whitespace-nowrap">Analog Trigger Oscilloscope</span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="status-dot w-2 h-2 rounded-full bg-stone-500" id="trig-status-dot"></span>
        <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider" id="trig-status-text">Awaiting Connection</span>
        <span class="text-[10px] font-bold text-emerald-400 px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/20 rounded-full shrink-0 uppercase tracking-wider ml-2" id="trig-model-name">NONE</span>
      </div>
    </div>

    <div class="p-4 sm:p-6 md:p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        {/* L2 Trigger Card */}
        <div class="bg-black/40 border border-white/5 rounded-2xl p-5 flex flex-col gap-5 relative overflow-hidden group/card shadow-inner">
          <div class="absolute inset-0 bg-gradient-to-b from-blue-500/5 to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          
          <div class="flex items-center justify-between z-10">
            <h3 class="text-white font-bold tracking-tight">Left Trigger (L2 / LT)</h3>
            <span class="font-mono text-2xl font-black text-blue-400 tabular-nums" id="l2-pct-val">0.0%</span>
          </div>

          <div class="flex gap-6 z-10">
            <!-- Vertical Bar -->
            <div class="w-12 h-40 bg-black/50 border border-white/10 rounded-xl flex items-end p-1 shadow-inner relative overflow-hidden shrink-0">
              <div class="w-full bg-gradient-to-t from-blue-600 to-blue-400 rounded-lg transition-all duration-75 shadow-[0_0_15px_rgba(59,130,246,0.5)]" id="l2-fill-bar" style="height: 0%"></div>
              
              <!-- Threshold markers -->
              <div class="absolute left-0 right-0 top-[10%] border-t border-white/20 border-dashed"></div>
              <div class="absolute left-0 right-0 top-[50%] border-t border-white/10 border-dashed"></div>
              <div class="absolute left-0 right-0 top-[90%] border-t border-white/20 border-dashed"></div>
            </div>
            
            <!-- Real-time Oscilloscope -->
            <div class="flex-1 bg-black/50 border border-white/10 rounded-xl relative overflow-hidden flex flex-col">
              <span class="absolute top-2 left-3 text-[9px] font-mono font-bold text-stone-500 uppercase tracking-widest z-10">Pressure Waveform</span>
              <canvas id="l2-canvas" class="w-full h-full absolute inset-0"></canvas>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 pt-4 border-t border-white/5 z-10 font-mono">
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Raw Value</span>
              <span class="text-sm font-bold text-white" id="l2-raw-val">0.0000</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Max Peak</span>
              <span class="text-sm font-bold text-blue-400" id="l2-max-val">0.0%</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Linearity</span>
              <span class="text-[10px] font-bold text-blue-400 bg-blue-500/10 border border-blue-500/20 rounded px-2 py-0.5 inline-flex w-max" id="l2-status-badge">Smooth</span>
            </div>
          </div>
        </div>

        {/* R2 Trigger Card */}
        <div class="bg-black/40 border border-white/5 rounded-2xl p-5 flex flex-col gap-5 relative overflow-hidden group/card shadow-inner">
          <div class="absolute inset-0 bg-gradient-to-b from-emerald-500/5 to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
          
          <div class="flex items-center justify-between z-10">
            <h3 class="text-white font-bold tracking-tight">Right Trigger (R2 / RT)</h3>
            <span class="font-mono text-2xl font-black text-emerald-400 tabular-nums" id="r2-pct-val">0.0%</span>
          </div>

          <div class="flex gap-6 z-10">
            <!-- Vertical Bar -->
            <div class="w-12 h-40 bg-black/50 border border-white/10 rounded-xl flex items-end p-1 shadow-inner relative overflow-hidden shrink-0">
              <div class="w-full bg-gradient-to-t from-emerald-600 to-emerald-400 rounded-lg transition-all duration-75 shadow-[0_0_15px_rgba(16,185,129,0.5)]" id="r2-fill-bar" style="height: 0%"></div>
              
              <!-- Threshold markers -->
              <div class="absolute left-0 right-0 top-[10%] border-t border-white/20 border-dashed"></div>
              <div class="absolute left-0 right-0 top-[50%] border-t border-white/10 border-dashed"></div>
              <div class="absolute left-0 right-0 top-[90%] border-t border-white/20 border-dashed"></div>
            </div>
            
            <!-- Real-time Oscilloscope -->
            <div class="flex-1 bg-black/50 border border-white/10 rounded-xl relative overflow-hidden flex flex-col">
              <span class="absolute top-2 left-3 text-[9px] font-mono font-bold text-stone-500 uppercase tracking-widest z-10">Pressure Waveform</span>
              <canvas id="r2-canvas" class="w-full h-full absolute inset-0"></canvas>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-2 pt-4 border-t border-white/5 z-10 font-mono">
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Raw Value</span>
              <span class="text-sm font-bold text-white" id="r2-raw-val">0.0000</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Max Peak</span>
              <span class="text-sm font-bold text-emerald-400" id="r2-max-val">0.0%</span>
            </div>
            <div class="flex flex-col gap-1">
              <span class="text-[9px] text-stone-500 uppercase tracking-widest">Linearity</span>
              <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded px-2 py-0.5 inline-flex w-max" id="r2-status-badge">Smooth</span>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-6 flex justify-end">
        <button type="button" class="px-4 py-2 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg text-xs font-bold text-stone-300 transition-colors uppercase tracking-widest font-mono" id="btn-reset-trig-max">
          Reset Peak Memory
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    let l2MaxPeak = 0;
    let r2MaxPeak = 0;
    
    // Oscilloscope State
    const historySize = 100;
    const l2History = new Array(historySize).fill(0);
    const r2History = new Array(historySize).fill(0);
    
    const l2Canvas = document.getElementById('l2-canvas') as HTMLCanvasElement;
    const r2Canvas = document.getElementById('r2-canvas') as HTMLCanvasElement;
    
    let l2Ctx: CanvasRenderingContext2D | null = null;
    let r2Ctx: CanvasRenderingContext2D | null = null;
    
    function initCanvas(canvas: HTMLCanvasElement | null) {
      if (!canvas) return null;
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      const ctx = canvas.getContext('2d');
      if (ctx) ctx.scale(dpr, dpr);
      return ctx;
    }

    // Initialize after a tiny delay to ensure layouts are computed
    setTimeout(() => {
      l2Ctx = initCanvas(l2Canvas);
      r2Ctx = initCanvas(r2Canvas);
    }, 50);
    
    window.addEventListener('resize', () => {
      l2Ctx = initCanvas(l2Canvas);
      r2Ctx = initCanvas(r2Canvas);
    });

    function drawWaveform(ctx: CanvasRenderingContext2D, canvas: HTMLCanvasElement, history: number[], color: string) {
      if (!ctx || !canvas) return;
      
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;
      const w = rect.width;
      const h = rect.height;
      
      ctx.clearRect(0, 0, w, h);
      
      // Draw grid lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, h * 0.25); ctx.lineTo(w, h * 0.25);
      ctx.moveTo(0, h * 0.5); ctx.lineTo(w, h * 0.5);
      ctx.moveTo(0, h * 0.75); ctx.lineTo(w, h * 0.75);
      ctx.stroke();
      
      // Draw waveform
      ctx.beginPath();
      const step = w / (historySize - 1);
      
      for (let i = 0; i < historySize; i++) {
        const x = i * step;
        const val = history[i];
        // Invert Y so 1.0 is top (0px), 0.0 is bottom (h px)
        // Add tiny padding top/bottom
        const y = h - (val * (h * 0.8) + (h * 0.1));
        
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      
      ctx.strokeStyle = color;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.stroke();
      
      // Fill under waveform
      ctx.lineTo(w, h);
      ctx.lineTo(0, h);
      ctx.closePath();
      
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, color.replace('1)', '0.3)'));
      grad.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = grad;
      ctx.fill();
    }

    function pollTriggers() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const dot = document.getElementById('trig-status-dot');
        const text = document.getElementById('trig-status-text');
        const model = document.getElementById('trig-model-name');

        if (dot) dot.classList.add('bg-emerald-400', 'shadow-[0_0_8px_#34d399]');
        if (text) text.textContent = 'Active';
        if (model) model.textContent = activeGp.id.substring(0, 20);

        const state = parseGamepadState(activeGp);
        const l2Val = state.triggers.l2;
        const r2Val = state.triggers.r2;

        if (l2Val > l2MaxPeak) l2MaxPeak = l2Val;
        if (r2Val > r2MaxPeak) r2MaxPeak = r2Val;

        // Shift history and push new values
        l2History.shift(); l2History.push(l2Val);
        r2History.shift(); r2History.push(r2Val);

        // Draw Canvas
        if (l2Ctx && l2Canvas) drawWaveform(l2Ctx, l2Canvas, l2History, 'rgba(96, 165, 250, 1)'); // Blue
        if (r2Ctx && r2Canvas) drawWaveform(r2Ctx, r2Canvas, r2History, 'rgba(52, 211, 153, 1)'); // Emerald

        // L2 UI
        const l2Pct = (l2Val * 100).toFixed(1);
        const l2PctVal = document.getElementById('l2-pct-val');
        const l2RawVal = document.getElementById('l2-raw-val');
        const l2MaxVal = document.getElementById('l2-max-val');
        const l2FillBar = document.getElementById('l2-fill-bar');

        if (l2PctVal) l2PctVal.textContent = `${l2Pct}%`;
        if (l2RawVal) l2RawVal.textContent = l2Val.toFixed(4);
        if (l2MaxVal) l2MaxVal.textContent = `${(l2MaxPeak * 100).toFixed(1)}%`;
        if (l2FillBar) l2FillBar.style.height = `${l2Val * 100}%`;

        // R2 UI
        const r2Pct = (r2Val * 100).toFixed(1);
        const r2PctVal = document.getElementById('r2-pct-val');
        const r2RawVal = document.getElementById('r2-raw-val');
        const r2MaxVal = document.getElementById('r2-max-val');
        const r2FillBar = document.getElementById('r2-fill-bar');

        if (r2PctVal) r2PctVal.textContent = `${r2Pct}%`;
        if (r2RawVal) r2RawVal.textContent = r2Val.toFixed(4);
        if (r2MaxVal) r2MaxVal.textContent = `${(r2MaxPeak * 100).toFixed(1)}%`;
        if (r2FillBar) r2FillBar.style.height = `${r2Val * 100}%`;
      }

      requestAnimationFrame(pollTriggers);
    }

    pollTriggers();

    document.getElementById('btn-reset-trig-max')?.addEventListener('click', () => {
      l2MaxPeak = 0;
      r2MaxPeak = 0;
    });
  });
</script>
