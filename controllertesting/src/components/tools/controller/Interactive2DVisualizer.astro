---
/**
 * Interactive2DVisualizer.astro — Ultra-Aesthetic 2D Vector PS5 DualSense Visualizer
 *
 * Replaces heavy WebGL 3D canvas with an ultra-responsive, zero-latency vector
 * interface that features authentic PS5 DualSense geometry, vibrant high-luminance neon glow effects,
 * and dual gamepad + touch/click input responsiveness.
 */
import PremiumStickCanvas from './PremiumStickCanvas.astro';
import TriggerBars from './TriggerBars.astro';

export interface Props {
  isRigid?: boolean;
}

const { isRigid = false } = Astro.props;
---
<div class="controller-split-layout" id="hero-layout" data-is-rigid={isRigid ? "true" : "false"}>
  
  <!-- Left Side: 2D Interactive Vector Controller -->
  <div class="controller-2d-wrapper" id="hero-container">
    
    <!-- Ambient Dynamic Backlight Aura -->
    <div class="backlight-aura" id="backlight-aura"></div>

    <!-- Main Vibrate Controls (Floating Sleek Compact Pill) -->
    <div id="main-vibrate-container" class="absolute top-4 right-4 z-50 flex items-center gap-2 backdrop-blur-md p-1.5 pl-3 rounded-full border border-stone-200/20 dark:border-white/10 shadow-xl hidden bg-surface-0/80 dark:bg-surface-1/90 select-none">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 animate-pulse"><path d="M4 12v.01"/><path d="M8 12v.01"/><path d="M12 12v.01"/><path d="M16 12v.01"/><path d="M20 12v.01"/></svg>
      <span class="text-[10px] font-mono font-bold text-stone-400 dark:text-stone-400 uppercase tracking-wider hidden sm:inline">Rumble</span>
      <input type="range" id="main-vibe-slider" min="0" max="100" value="100" class="w-14 accent-blue-500 h-1.5 bg-black/10 dark:bg-white/20 rounded-full appearance-none cursor-pointer" title="Vibration Intensity" />
      <button id="main-vibrate-btn" class="px-2.5 py-1 rounded-full font-mono font-bold text-[10px] tracking-wide transition-all border flex items-center gap-1 text-white bg-blue-600 hover:bg-blue-500 border-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.4)] cursor-pointer">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        TEST
      </button>
    </div>

    <!-- Zero-Latency Button Press HUD (Bottom Center) -->
    <div id="button-press-hud" class="absolute bottom-6 left-1/2 -translate-x-1/2 z-40 flex items-center gap-2.5 backdrop-blur-xl px-5 py-2 rounded-full border border-blue-500/40 shadow-[0_0_30px_rgba(37,99,235,0.4)] opacity-0 transition-all duration-75 scale-95 pointer-events-none bg-surface-0/90 dark:bg-surface-1/95">
      <div class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse shadow-[0_0_12px_rgba(37,99,235,1)]"></div>
      <span id="button-press-text" class="text-stone-900 dark:text-white font-bold tracking-widest uppercase font-mono text-[11px] sm:text-xs">No Input</span>
    </div>

    <!-- Awaiting Connection Overlay (Sleek Floating Top-Left Status Pill) -->
    <div id="awaiting-connection-overlay" class="absolute top-4 left-4 z-40 flex items-center gap-2 pointer-events-none transition-opacity duration-500 opacity-100">
      <div class="bg-surface-0/90 dark:bg-surface-1/90 backdrop-blur-md border border-blue-500/30 rounded-full px-3.5 py-1.5 flex items-center gap-2.5 shadow-lg">
        <div class="relative w-2.5 h-2.5 flex items-center justify-center">
          <span class="absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </div>
        <span class="text-stone-900 dark:text-white font-bold text-xs tracking-wide font-mono">Awaiting Input...</span>
      </div>
    </div>

    <!-- Hardware Mismatch Error Overlay -->
    <div id="mismatch-overlay" class="absolute inset-0 z-50 flex items-center justify-center p-6 bg-surface-0/90 backdrop-blur-md" style="display: none;">
      <div class="relative text-center p-8 rounded-2xl bg-surface-1 border border-red-500/30 shadow-2xl max-w-md w-full flex flex-col items-center">
        <div class="w-16 h-16 shrink-0 bg-red-500/10 rounded-full flex items-center justify-center mb-6 border border-red-500/20 text-red-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Hardware Mismatch</h3>
        <p class="text-secondary text-base mb-8 leading-relaxed" id="mismatch-desc">We expected a PlayStation controller, but detected an alternate device.</p>
        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
          <a href="/test/controller" class="btn-secondary flex-1 justify-center text-sm py-3 !px-4 whitespace-nowrap">View All Testers</a>
          <a href="/test/controller/drift" class="btn-primary flex-1 justify-center text-sm py-3 !px-4 whitespace-nowrap !bg-red-600 hover:!bg-red-500 !text-white border-transparent shadow-[0_4px_12px_rgba(220,38,38,0.3)]">Universal Tester</a>
        </div>
      </div>
    </div>

    <!-- 2D High-Definition SVG Controller Vector -->
    <div class="svg-container flex items-center justify-center w-full h-full p-2 sm:p-6 select-none">
      <svg id="ps5-svg" viewBox="0 0 800 520" class="w-full max-w-[620px] max-h-[440px] select-none transition-transform duration-300 drop-shadow-2xl" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Vivid High-Luminance Neon Glow Filters -->
          <filter id="glow-cross" x="-100%" y="-100%" width="300%" height="300%">
            <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#0099ff" flood-opacity="0.95" />
            <feDropShadow dx="0" dy="0" stdDeviation="14" flood-color="#0066ff" flood-opacity="0.75" />
          </filter>

          <filter id="glow-circle" x="-100%" y="-100%" width="300%" height="300%">
            <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#ff3366" flood-opacity="0.95" />
            <feDropShadow dx="0" dy="0" stdDeviation="14" flood-color="#ff0044" flood-opacity="0.75" />
          </filter>

          <filter id="glow-triangle" x="-100%" y="-100%" width="300%" height="300%">
            <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#00ff88" flood-opacity="0.95" />
            <feDropShadow dx="0" dy="0" stdDeviation="14" flood-color="#00cc66" flood-opacity="0.75" />
          </filter>

          <filter id="glow-square" x="-100%" y="-100%" width="300%" height="300%">
            <feDropShadow dx="0" dy="0" stdDeviation="6" flood-color="#ff2d95" flood-opacity="0.95" />
            <feDropShadow dx="0" dy="0" stdDeviation="14" flood-color="#e60073" flood-opacity="0.75" />
          </filter>

          <linearGradient id="body-white-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.98"/>
            <stop offset="100%" stop-color="#cbd5e1" stop-opacity="0.95"/>
          </linearGradient>

          <linearGradient id="body-dark-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#1e293b" stop-opacity="0.98"/>
            <stop offset="100%" stop-color="#0f172a" stop-opacity="0.98"/>
          </linearGradient>

          <linearGradient id="black-mid-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#18181b"/>
            <stop offset="100%" stop-color="#09090b"/>
          </linearGradient>

          <linearGradient id="stick-cap-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#27272a"/>
            <stop offset="100%" stop-color="#18181b"/>
          </linearGradient>
        </defs>

        <!-- 1. Sleek Top Triggers & Bumpers (Symmetrical Shoulder Tabs) -->
        <g id="group-shoulders">
          <!-- L2 Trigger (Btn 6) -->
          <path id="btn-l2" data-btn="6" d="M 230,55 C 240,25 270,20 295,25 L 285,75 C 260,72 235,68 230,55 Z" class="button-path cursor-pointer fill-stone-700 dark:fill-stone-800 stroke-stone-600 dark:stroke-stone-700 transition-all duration-100" stroke-width="2" />
          <!-- R2 Trigger (Btn 7) -->
          <path id="btn-r2" data-btn="7" d="M 570,55 C 560,25 530,20 505,25 L 515,75 C 540,72 565,68 570,55 Z" class="button-path cursor-pointer fill-stone-700 dark:fill-stone-800 stroke-stone-600 dark:stroke-stone-700 transition-all duration-100" stroke-width="2" />
          
          <!-- L1 Bumper (Btn 4) -->
          <path id="btn-l1" data-btn="4" d="M 220,72 C 225,60 265,55 295,60 L 290,92 C 255,88 225,88 220,72 Z" class="button-path cursor-pointer fill-stone-800 dark:fill-stone-900 stroke-stone-600 transition-all duration-100" stroke-width="2" />
          <!-- R1 Bumper (Btn 5) -->
          <path id="btn-r1" data-btn="5" d="M 580,72 C 575,60 535,55 505,60 L 510,92 C 545,88 575,88 580,72 Z" class="button-path cursor-pointer fill-stone-800 dark:fill-stone-900 stroke-stone-600 transition-all duration-100" stroke-width="2" />
          
          <text x="254" y="78" class="fill-stone-300 font-mono font-bold text-[11px] pointer-events-none select-none">L1</text>
          <text x="536" y="78" class="fill-stone-300 font-mono font-bold text-[11px] pointer-events-none select-none">R1</text>
        </g>

        <!-- 2. Authentic DualSense Main Body Contour (Sleek Ergonomic Proportions) -->
        <g id="dualsense-body">
          <!-- Main White/Dark Ergonomic Outer Contour Shell -->
          <path d="M 280,85 
                   C 350,80 450,80 520,85 
                   C 560,90 605,110 628,150 
                   C 655,205 675,310 685,400 
                   C 690,445 658,472 622,468 
                   C 585,462 550,395 532,335 
                   C 505,320 455,325 400,325 
                   C 345,325 295,320 268,335 
                   C 250,395 215,462 178,468 
                   C 142,472 110,445 115,400 
                   C 125,310 145,205 172,150 
                   C 195,110 240,90 280,85 Z" 
                class="controller-shell stroke-stone-300 dark:stroke-stone-700/60" 
                stroke-width="3" />
          
          <!-- Inner Black Accent Bridge -->
          <path d="M 292,190 
                   C 345,200 455,200 508,190 
                   C 520,240 532,340 532,340 
                   C 505,325 455,330 400,330 
                   C 345,330 295,325 268,340 
                   C 268,340 280,240 292,190 Z" 
                fill="url(#black-mid-grad)" 
                class="stroke-stone-800" 
                stroke-width="2" />
        </g>

        <!-- 3. DualSense Touchpad & Blue Lightbar -->
        <g id="touchpad-group" class="cursor-pointer" data-btn="17">
          <!-- Lightbar LED Border Line -->
          <path id="ps-lightbar" d="M 292,95 L 508,95 L 498,195 L 302,195 Z" class="lightbar-glow fill-transparent stroke-blue-500/40 pointer-events-none" stroke-width="4" />
          
          <!-- Touchpad Surface (Btn 17) -->
          <rect id="btn-touchpad" data-btn="17" x="298" y="100" width="204" height="92" rx="10" class="button-path touchpad-surface stroke-stone-300 dark:stroke-stone-700 fill-stone-100 dark:fill-stone-900 transition-all duration-150 cursor-pointer" stroke-width="1.5" />
          <text x="366" y="152" class="fill-stone-400 dark:fill-stone-500 font-mono font-semibold text-[11px] tracking-widest pointer-events-none select-none">TOUCHPAD</text>
        </g>

        <!-- 4. D-PAD (Directional Buttons) -->
        <g id="group-dpad" transform="translate(200, 205)">
          <circle cx="0" cy="0" r="52" class="fill-stone-200 dark:fill-stone-950 stroke-stone-300 dark:stroke-stone-800 pointer-events-none" stroke-width="1.5" />
          
          <!-- Up (Btn 12) -->
          <path id="btn-dpad-up" data-btn="12" d="M -14,-16 L 14,-16 L 14,-44 C 14,-48 8,-52 0,-52 C -8,-52 -14,-48 -14,-44 Z" class="dpad-btn button-path cursor-pointer" />
          <!-- Down (Btn 13) -->
          <path id="btn-dpad-down" data-btn="13" d="M -14,16 L 14,16 L 14,44 C 14,48 8,52 0,52 C -8,52 -14,48 -14,44 Z" class="dpad-btn button-path cursor-pointer" />
          <!-- Left (Btn 14) -->
          <path id="btn-dpad-left" data-btn="14" d="M -16,-14 L -16,14 L -44,14 C -48,14 -52,8 -52,0 C -52,-8 -48,-14 -44,-14 Z" class="dpad-btn button-path cursor-pointer" />
          <!-- Right (Btn 15) -->
          <path id="btn-dpad-right" data-btn="15" d="M 16,-14 L 16,14 L 44,14 C 48,14 52,8 52,0 C 52,-8 48,-14 44,-14 Z" class="dpad-btn button-path cursor-pointer" />
          
          <!-- Directional Arrow Icons -->
          <path d="M 0,-38 L -6,-26 L 6,-26 Z" class="fill-stone-500 dark:fill-stone-400 pointer-events-none" />
          <path d="M 0,38 L -6,26 L 6,26 Z" class="fill-stone-500 dark:fill-stone-400 pointer-events-none" />
          <path d="M -38,0 L -26,-6 L -26,6 Z" class="fill-stone-500 dark:fill-stone-400 pointer-events-none" />
          <path d="M 38,0 L 26,-6 L 26,6 Z" class="fill-stone-500 dark:fill-stone-400 pointer-events-none" />
        </g>

        <!-- 5. Action Face Buttons (Vibrant PlayStation Glyphs) -->
        <g id="group-action-buttons" transform="translate(600, 205)">
          <!-- Base Bezel -->
          <circle cx="0" cy="0" r="52" class="fill-stone-200 dark:fill-stone-950 stroke-stone-300 dark:stroke-stone-800 pointer-events-none" stroke-width="1.5" />
          
          <!-- Triangle (Top - Btn 3) -->
          <g id="btn-triangle" data-btn="3" class="action-btn cursor-pointer">
            <circle cx="0" cy="-32" r="15" class="button-path fill-stone-100 dark:fill-stone-900 stroke-stone-300 dark:stroke-stone-700" stroke-width="2" />
            <path d="M 0,-40 L -6,-27 L 6,-27 Z" fill="none" stroke="#00ff88" stroke-width="3" stroke-linejoin="round" class="pointer-events-none" />
          </g>

          <!-- Circle (Right - Btn 1) -->
          <g id="btn-circle" data-btn="1" class="action-btn cursor-pointer">
            <circle cx="32" cy="0" r="15" class="button-path fill-stone-100 dark:fill-stone-900 stroke-stone-300 dark:stroke-stone-700" stroke-width="2" />
            <circle cx="32" cy="0" r="7" fill="none" stroke="#ff3366" stroke-width="3" class="pointer-events-none" />
          </g>

          <!-- Cross (Bottom - Btn 0) -->
          <g id="btn-cross" data-btn="0" class="action-btn cursor-pointer">
            <circle cx="0" cy="32" r="15" class="button-path fill-stone-100 dark:fill-stone-900 stroke-stone-300 dark:stroke-stone-700" stroke-width="2" />
            <path d="M -5,27 L 5,37 M 5,27 L -5,37" fill="none" stroke="#0099ff" stroke-width="3" stroke-linecap="round" class="pointer-events-none" />
          </g>

          <!-- Square (Left - Btn 2) -->
          <g id="btn-square" data-btn="2" class="action-btn cursor-pointer">
            <circle cx="-32" cy="0" r="15" class="button-path fill-stone-100 dark:fill-stone-900 stroke-stone-300 dark:stroke-stone-700" stroke-width="2" />
            <rect x="-37" y="-5" width="10" height="10" fill="none" stroke="#ff2d95" stroke-width="3" class="pointer-events-none" />
          </g>
        </g>

        <!-- 6. Left & Right Analog Sticks -->
        <!-- Left Stick Module (L3 - Btn 10) -->
        <g id="group-left-stick" transform="translate(310, 320)">
          <circle cx="0" cy="0" r="44" class="fill-stone-950 stroke-stone-700/80 pointer-events-none" stroke-width="2" />
          <g id="stick-l-cap" data-btn="10" class="button-path cursor-pointer stick-cap-node">
            <circle cx="0" cy="0" r="35" fill="url(#stick-cap-grad)" class="stroke-stone-600" stroke-width="2" />
            <circle cx="0" cy="0" r="27" class="fill-transparent stroke-stone-500/40" stroke-width="1.5" stroke-dasharray="4,4" />
            <circle cx="0" cy="0" r="11" class="fill-stone-800 stroke-stone-600" stroke-width="1" />
            <text x="-8" y="4" class="fill-stone-300 font-mono font-bold text-[10px] pointer-events-none select-none">L3</text>
          </g>
        </g>

        <!-- Right Stick Module (R3 - Btn 11) -->
        <g id="group-right-stick" transform="translate(490, 320)">
          <circle cx="0" cy="0" r="44" class="fill-stone-950 stroke-stone-700/80 pointer-events-none" stroke-width="2" />
          <g id="stick-r-cap" data-btn="11" class="button-path cursor-pointer stick-cap-node">
            <circle cx="0" cy="0" r="35" fill="url(#stick-cap-grad)" class="stroke-stone-600" stroke-width="2" />
            <circle cx="0" cy="0" r="27" class="fill-transparent stroke-stone-500/40" stroke-width="1.5" stroke-dasharray="4,4" />
            <circle cx="0" cy="0" r="11" class="fill-stone-800 stroke-stone-600" stroke-width="1" />
            <text x="-8" y="4" class="fill-stone-300 font-mono font-bold text-[10px] pointer-events-none select-none">R3</text>
          </g>
        </g>

        <!-- 7. Center Function Buttons -->
        <g id="group-meta-buttons">
          <!-- Create / Share (Btn 8) -->
          <g id="btn-create" data-btn="8" class="button-path cursor-pointer">
            <ellipse cx="265" cy="130" rx="6" ry="10" transform="rotate(-20, 265, 130)" class="fill-stone-300 dark:fill-stone-700 stroke-stone-400 dark:stroke-stone-600" stroke-width="1" />
            <line x1="262" y1="126" x2="262" y2="134" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
            <line x1="265" y1="124" x2="265" y2="136" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
            <line x1="268" y1="126" x2="268" y2="134" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
          </g>

          <!-- Options (Btn 9) -->
          <g id="btn-options" data-btn="9" class="button-path cursor-pointer">
            <ellipse cx="535" cy="130" rx="6" ry="10" transform="rotate(20, 535, 130)" class="fill-stone-300 dark:fill-stone-700 stroke-stone-400 dark:stroke-stone-600" stroke-width="1" />
            <line x1="530" y1="127" x2="540" y2="127" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
            <line x1="530" y1="130" x2="540" y2="130" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
            <line x1="530" y1="133" x2="540" y2="133" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" class="pointer-events-none"/>
          </g>

          <!-- PS Home Button (Btn 16) -->
          <g id="btn-ps" data-btn="16" class="button-path cursor-pointer">
            <circle cx="400" cy="270" r="13" class="fill-stone-900 stroke-stone-600" stroke-width="1.5" />
            <path d="M 397,264 C 397,264 403,264 403,269 C 403,274 397,273 397,278 M 394,275 L 406,275" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" class="pointer-events-none" />
          </g>

          <!-- Mute Button (Btn 17/Aux) -->
          <g id="btn-mute" data-btn="17" class="button-path cursor-pointer">
            <rect x="394" y="296" width="12" height="6" rx="2.5" class="fill-stone-800 stroke-stone-600" stroke-width="1" />
            <circle cx="400" cy="299" r="1.2" class="fill-amber-500 pointer-events-none" />
          </g>

          <!-- Speaker Grille Holes -->
          <g class="fill-stone-600/40 pointer-events-none">
            <circle cx="396" cy="236" r="1.2"/>
            <circle cx="400" cy="236" r="1.2"/>
            <circle cx="404" cy="236" r="1.2"/>
            <circle cx="394" cy="241" r="1.2"/>
            <circle cx="398" cy="241" r="1.2"/>
            <circle cx="402" cy="241" r="1.2"/>
            <circle cx="406" cy="241" r="1.2"/>
          </g>
        </g>
      </svg>
    </div>

  </div>

  <!-- Right Side: Telemetry Sidebar & Bento Dashboard -->
  <div class="telemetry-sidebar" id="telemetry-hud">
    <div class="status-indicator mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">Awaiting Gamepad</span>
      </div>
      <div class="flex items-center gap-4">
        <div class="bg-black/20 border border-white/5 rounded px-3 py-1.5 flex items-center gap-2">
          <span class="text-stone-500 font-mono text-[10px] uppercase tracking-widest">Rate</span>
          <span id="telemetry-hz" class="text-stone-900 dark:text-white font-mono text-sm font-bold">-- Hz</span>
        </div>
      </div>
    </div>
    
    <div class="bento-grid" id="telemetry-data" style="display: none;">
      
      <!-- 1. Analog Sticks -->
      <div class="bento-cell flex flex-col min-h-[220px]">
        <div class="cell-header shrink-0 mb-2">
          <div class="flex items-center gap-2">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
            <h3 class="cell-title">Analog Sticks</h3>
          </div>
          <span class="cell-subtitle">DRIFT & CIRCULARITY</span>
        </div>
        <div class="flex-1 relative flex items-center justify-center min-h-0 w-full">
          <PremiumStickCanvas />
        </div>
      </div>

      <!-- 2. Triggers -->
      <div class="bento-cell flex flex-col min-h-[220px]">
        <div class="cell-header shrink-0 mb-2">
          <div class="flex items-center gap-2">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>
            <h3 class="cell-title">Triggers</h3>
          </div>
          <span class="cell-subtitle">ANALOG PRESSURE (0-1)</span>
        </div>
        <div class="flex-1 relative flex items-center justify-center min-h-0 w-full">
          <TriggerBars />
        </div>
      </div>

      <!-- 3. Raw Data & Gyro -->
      <div class="bento-cell flex flex-col min-h-[220px]">
        <div class="cell-header shrink-0 mb-4">
          <div class="flex items-center gap-2">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <h3 class="cell-title">Raw Data</h3>
