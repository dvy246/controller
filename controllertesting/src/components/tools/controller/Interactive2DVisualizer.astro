    background: var(--color-surface-0, rgba(10, 10, 15, 0.7));
    backdrop-filter: blur(24px);
    border-top: 1px solid var(--color-surface-3, rgba(255, 255, 255, 0.05));
  }
  
  @media (min-width: 1280px) {
    .telemetry-sidebar {
      border-top: none;
      border-left: 1px solid var(--color-surface-3, rgba(255, 255, 255, 0.05));
      padding: 2rem;
    }
  }

  /* Bento Grid System */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .bento-cell {
    background: var(--color-surface-1, rgba(18, 18, 24, 0.6));
    border: 1px solid var(--color-surface-3, rgba(255, 255, 255, 0.04));
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    position: relative;
    overflow: hidden;
  }

  .cell-header {
    margin-bottom: 0.5rem;
  }

  .cell-title {
    font-size: 0.95rem;
