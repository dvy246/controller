---
/**
 * Interactive2DVisualizer.astro
 * 1:1 Pixel-Perfect Visual Replica matching competitor (controllertest.io)
 */
import PremiumStickCanvas from './PremiumStickCanvas.astro';
import TriggerBars from './TriggerBars.astro';
import DualJoyConSVG from './DualJoyConSVG.astro';
import SwitchProSVG from './SwitchProSVG.astro';
import PlayStationSVG from './PlayStationSVG.astro';
import XboxSVG from './XboxSVG.astro';

export interface Props {
  isRigid?: boolean;
  mode?: 'default' | 'joycon' | 'switch-pro' | 'playstation' | 'xbox';
}

const { isRigid = false, mode = 'default' } = Astro.props;
---

<div class="doppelrand-shell w-full max-w-7xl mx-auto group" style="isolation: isolate; position: relative;">
  <!-- Ambient glow via inline style to match brandkit -->
  <div style="position: absolute; inset: -4px; border-radius: 24px; background: radial-gradient(ellipse at 50% -20%, rgba(139,92,246,0.15) 0%, rgba(59,130,246,0.1) 50%, transparent 70%); filter: blur(16px); z-index: -1; pointer-events: none;" aria-hidden="true"></div>

  <div class="diagnostic-tool-shell diagnostic-workspace w-full bg-[#0E0E10] select-none text-stone-200 relative z-10 flex flex-col">
      
      <!-- ── 1. DEVICE & TELEMETRY CONTROL STRIP (Top Header Toolbar) ── -->
      <div class="w-full bg-[#141417] border-b border-[#27272A] px-6 sm:px-8 py-4 flex flex-wrap items-center justify-between gap-3 font-mono">
    <!-- Left: Device Name & Live Status -->
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="6" width="20" height="12" rx="4"></rect>
            <path d="M6 12h4m-2-2v4"></path>
            <circle cx="15" cy="11" r="1" fill="currentColor"></circle>
            <circle cx="17.5" cy="13" r="1" fill="currentColor"></circle>
          </svg>
        </div>
        <span class="text-white font-bold text-xs sm:text-sm tracking-tight font-sans whitespace-nowrap">
          {mode === 'joycon' ? 'Nintendo Switch Joy-Con Suite' : mode === 'switch-pro' ? 'Switch Pro Controller Suite' : mode === 'xbox' ? 'Xbox Controller Suite' : 'PlayStation Controller Suite'}
        </span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-stone-600 font-bold hidden sm:inline">•</span>
        <span id="controller-status" class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">
          Press any button to connect
        </span>
      </div>
    </div>

    <!-- Right: Hz, Latency ms & P1-P4 Selector -->
    <div class="flex items-center gap-4 text-xs">
      <div class="flex items-center gap-3 text-stone-400 font-medium">
        <span>POLLING: <strong id="polling-rate-val" class="text-blue-400 font-bold">0 Hz</strong></span>
        <span class="text-stone-700">|</span>
        <span>LATENCY: <strong id="latency-val" class="text-emerald-400 font-bold">0.0 ms</strong></span>
      </div>
      <div class="flex items-center gap-1 bg-[#1A1A1E] p-1 rounded-lg border border-[#2B2B32]">
        <button id="p1-btn" class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-600 text-white shadow-sm transition-all">P1</button>
        <button id="p2-btn" class="px-2 py-0.5 rounded text-[10px] font-bold text-stone-500 hover:text-stone-300 transition-all">P2</button>
        <button id="p3-btn" class="px-2 py-0.5 rounded text-[10px] font-bold text-stone-500 hover:text-stone-300 transition-all">P3</button>
        <button id="p4-btn" class="px-2 py-0.5 rounded text-[10px] font-bold text-stone-500 hover:text-stone-300 transition-all">P4</button>
      </div>
    </div>
  </div>

  <!-- ── 2. MAIN SPLIT VIEWPORT (Controller Stage + Primary Metrics Stack) ── -->
  <div class="w-full grid grid-cols-1 lg:grid-cols-12 items-stretch border-b border-[#27272A]">
    
    <!-- LEFT STAGE: Real-Time Vector Controller Viewport (7 Cols) -->
    <div class="lg:col-span-7 bg-[#121214] p-6 sm:p-8 flex flex-col items-center relative border-b lg:border-b-0 lg:border-r border-[#27272A]">
      
      <!-- Interactive SVG Controller -->
      <div class="w-full flex-1 flex items-center justify-center py-2 relative">
        {mode === 'joycon' ? (
          <DualJoyConSVG />
        ) : mode === 'switch-pro' ? (
          <SwitchProSVG />
        ) : mode === 'xbox' ? (
          <XboxSVG />
        ) : (
          <PlayStationSVG />
        )}
      </div>

      <!-- Integrated Input State Legend -->
      <div class="flex items-center gap-6 font-mono text-xs text-stone-400 px-4 py-1.5 rounded-full bg-black/40 border border-white/10 mt-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block shadow-[0_0_8px_#3B82F6]"></span>
          <span>Button Pressed</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-stone-600 inline-block"></span>
          <span>Rest / Default</span>
        </div>
      </div>
    </div>

    <!-- RIGHT STAGE: Vertical Diagnostic Telemetry Stack (5 Cols) -->
    <div class="lg:col-span-5 bg-[#161618] p-6 flex flex-col gap-6">
      
      <!-- Top Section: Analog Sticks & Drift (Full Width - Title Never Wraps!) -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
            </div>
            <div>
              <span class="text-sm font-bold text-white font-mono leading-none block whitespace-nowrap">Analog Sticks & Drift</span>
              <span class="text-[10px] text-emerald-400 font-mono leading-none block mt-1 font-semibold">Linearity, Offset & Circularity</span>
            </div>
          </div>
          <button id="recenter-btn" title="Re-center Sticks" class="text-stone-400 hover:text-white transition-colors p-1 shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          </button>
        </div>
        
        <div class="w-full pt-1">
          <PremiumStickCanvas />
        </div>
      </div>

      <!-- Bottom Section: Analog Triggers (Full Width - Title Never Wraps!) -->
      <div class="flex flex-col gap-2 pt-4 border-t border-[#27272A]">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>
          </div>
          <div>
            <span class="text-sm font-bold text-white font-mono leading-none block whitespace-nowrap">Analog Triggers (L2 / R2)</span>
            <span class="text-[10px] text-indigo-400 font-mono leading-none block mt-1 font-semibold">Pressure Curve (0.000 – 1.000)</span>
          </div>
        </div>
        
        <div class="w-full pt-1">
          <TriggerBars />
        </div>
      </div>

    </div>
  </div>

  <!-- ── 3. BOTTOM DIAGNOSTIC CONSOLE (Full-Width Raw Telemetry & Vibration Hub) ── -->
  <div class="w-full bg-[#111114] p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Left Console: Gamepad API Telemetry & Button Matrix (6 Cols) -->
    <div class="lg:col-span-6 flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        </div>
        <div>
          <span class="text-sm font-bold text-white font-mono leading-none block">Raw Gamepad API Data</span>
          <span class="text-[10px] text-blue-400 font-mono block mt-1 font-semibold">0-17 Buttons & Active Axes</span>
        </div>
      </div>

      <!-- Button Matrix -->
      <div class="grid grid-cols-6 gap-1.5" id="competitor-matrix">
        <!-- Rendered via JS -->
      </div>

      <!-- Raw Axes 0-3 Telemetry -->
      <div class="pt-1.5 flex flex-col gap-1.5 font-mono">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold text-stone-400 tracking-wider">ANALOG AXES (0 - 3)</span>
          <span class="text-[9px] text-stone-500 font-medium">Bipolar [-1.00 to +1.00]</span>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <!-- Axis 0 (L-Stick X) -->
          <div class="flex items-center gap-2 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
            <span class="text-[10px] font-bold text-emerald-400 w-3">0</span>
            <div class="flex-1 h-2 bg-black/60 rounded-full overflow-hidden relative">
              <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-white/30 -translate-x-1/2 z-10"></div>
              <div id="raw-axis-0-bar" class="h-full bg-emerald-500 transition-all duration-75" style="width: 0%; margin-left: 50%;"></div>
            </div>
            <span id="raw-axis-0-val" class="text-[10px] font-bold text-emerald-400 w-11 text-right tabular-nums">+0.00</span>
          </div>
          <!-- Axis 1 (L-Stick Y) -->
          <div class="flex items-center gap-2 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
            <span class="text-[10px] font-bold text-emerald-400 w-3">1</span>
            <div class="flex-1 h-2 bg-black/60 rounded-full overflow-hidden relative">
              <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-white/30 -translate-x-1/2 z-10"></div>
              <div id="raw-axis-1-bar" class="h-full bg-emerald-500 transition-all duration-75" style="width: 0%; margin-left: 50%;"></div>
            </div>
            <span id="raw-axis-1-val" class="text-[10px] font-bold text-emerald-400 w-11 text-right tabular-nums">+0.00</span>
          </div>
          <!-- Axis 2 (R-Stick X) -->
          <div class="flex items-center gap-2 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
            <span class="text-[10px] font-bold text-blue-400 w-3">2</span>
            <div class="flex-1 h-2 bg-black/60 rounded-full overflow-hidden relative">
              <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-white/30 -translate-x-1/2 z-10"></div>
              <div id="raw-axis-2-bar" class="h-full bg-blue-500 transition-all duration-75" style="width: 0%; margin-left: 50%;"></div>
            </div>
            <span id="raw-axis-2-val" class="text-[10px] font-bold text-blue-400 w-11 text-right tabular-nums">+0.00</span>
          </div>
          <!-- Axis 3 (R-Stick Y) -->
          <div class="flex items-center gap-2 bg-white/5 px-2.5 py-1 rounded-lg border border-white/5">
            <span class="text-[10px] font-bold text-blue-400 w-3">3</span>
            <div class="flex-1 h-2 bg-black/60 rounded-full overflow-hidden relative">
              <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-white/30 -translate-x-1/2 z-10"></div>
              <div id="raw-axis-3-bar" class="h-full bg-blue-500 transition-all duration-75" style="width: 0%; margin-left: 50%;"></div>
            </div>
            <span id="raw-axis-3-val" class="text-[10px] font-bold text-blue-400 w-11 text-right tabular-nums">+0.00</span>
          </div>
        </div>
      </div>
      
      <!-- Diagnostic Helper / Status Line -->
      <div class="flex items-center gap-2 py-2 px-3.5 rounded-xl bg-white/[0.03] border border-white/10 font-mono text-xs w-full overflow-hidden">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0" id="bento-status-dot"></span>
        <span id="bento-status-subtext" class="text-stone-300 font-medium whitespace-normal leading-normal">Connect a controller or press any button to inspect live Gamepad API telemetry.</span>
      </div>
    </div>

    <!-- Right Console: Haptic Vibration Diagnostics (6 Cols) -->
    <div class="lg:col-span-6 flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold text-white font-mono leading-none m-0">Haptic Vibration Test</h3>
            <span class="text-[10px] text-amber-400 font-mono block mt-1 font-semibold">Dual Rumble Actuators</span>
          </div>
        </div>
        <span id="vibe-feedback-tag" class="text-[10px] font-mono text-stone-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded font-semibold">Awaiting Command</span>
      </div>

      <p class="text-xs text-stone-400 font-mono leading-relaxed">
        Tests dual-rumble actuators (Left Heavy & Right Light) via browser Vibration API.
      </p>

      <div class="grid grid-cols-4 gap-2 w-full">
        <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer text-center flex flex-col items-center justify-center gap-1" data-vibe="heavy">
          <span>HEAVY</span>
          <span class="w-4 h-1 bg-amber-500 rounded-full"></span>
        </button>
        <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer text-center flex flex-col items-center justify-center gap-1" data-vibe="light">
          <span>LIGHT</span>
          <span class="w-4 h-1 bg-blue-500 rounded-full"></span>
        </button>
        <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer text-center flex flex-col items-center justify-center gap-1" data-vibe="burst">
          <span>BURST</span>
          <span class="w-4 h-1 bg-purple-500 rounded-full"></span>
        </button>
        <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors cursor-pointer text-center flex flex-col items-center justify-center gap-1" data-vibe="pulse">
          <span>PULSE</span>
          <span class="w-4 h-1 bg-rose-500 rounded-full"></span>
        </button>
      </div>

      <!-- Custom Vibration Intensity Slider -->
      <div class="mt-1 pt-3 border-t border-white/10 flex flex-col gap-2 font-mono">
        <div class="flex items-center justify-between text-xs">
          <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider">Custom Intensity</span>
          <span id="vibe-slider-val" class="text-xs font-bold text-amber-400 tabular-nums">70%</span>
        </div>
        <div class="flex items-center gap-3">
          <input type="range" id="vibe-intensity-slider" min="0" max="100" value="70" class="flex-1 h-1.5 bg-black/60 rounded-lg appearance-none cursor-pointer accent-amber-500 border border-white/10" />
          <button id="vibe-slider-test-btn" class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-mono text-[10px] font-bold uppercase transition-colors shrink-0 cursor-pointer">
            Vibrate
          </button>
        </div>
      </div>
    </div>

    </div>
  </div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const subtext = document.getElementById('connection-subtext');
    const matrixContainer = document.getElementById('competitor-matrix');
    const bentoStatusSubtext = document.getElementById('bento-status-subtext');
    const bentoStatusDot = document.getElementById('bento-status-dot');
    const masterHz = document.getElementById('master-hz');
    const masterLatency = document.getElementById('master-latency');
    const vibeFeedbackTag = document.getElementById('vibe-feedback-tag');
    const stickLCap = document.getElementById('stick-l-cap');
    const stickRCap = document.getElementById('stick-r-cap');
    const l2Fill = document.getElementById('l2-wire-fill');
    const r2Fill = document.getElementById('r2-wire-fill');

    // Populate matrix
    const matrixEls: HTMLElement[] = [];
    if (matrixContainer) {
      let html = '';
      for (let i = 0; i < 18; i++) {
        html += `<div id="comp-btn-${i}" class="h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-stone-500 border-white/5">${i}</div>`;
      }
      matrixContainer.innerHTML = html;
      for (let i = 0; i < 18; i++) {
        const el = document.getElementById(`comp-btn-${i}`);
        if (el) matrixEls.push(el);
      }
    }

    let frameCount = 0;
    let lastHzTime = performance.now();

    GamepadLoop.subscribe((state) => {
      const now = performance.now();
      frameCount++;
      if (now - lastHzTime >= 1000) {
        const hz = Math.round((frameCount * 1000) / (now - lastHzTime));
        frameCount = 0;
        lastHzTime = now;
        if (masterHz) masterHz.textContent = `${hz} Hz`;
        if (masterLatency) masterLatency.textContent = `${(1000 / (hz || 60)).toFixed(1)} ms`;
      }

      if (state && state.connected) {
        const idLower = (state.id || '').toLowerCase();
        const isPS = idLower.includes('dualsense') || idLower.includes('playstation') || idLower.includes('dualshock') || idLower.includes('054c') || idLower.includes('wireless controller');

        if (subtext) {
          subtext.textContent = isPS ? `PS5 DualSense Connected (${state.id.substring(0, 16)}...)` : `Controller Connected (${state.id.substring(0, 16)}...)`;
          subtext.className = "text-emerald-400 font-mono text-xs font-bold";
        }
        
        if (bentoStatusSubtext) {
          bentoStatusSubtext.textContent = isPS ? "PS5 DUALSENSE CONNECTED (GAMEPAD API ACTIVE)" : "CONTROLLER CONNECTED (GAMEPAD API ACTIVE)";
          bentoStatusSubtext.className = "text-stone-300 font-mono text-xs font-semibold truncate";
        }

        if (bentoStatusDot) {
          bentoStatusDot.className = "w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#10B981] shrink-0";
        }

        const touchpadEl = document.getElementById('btn-touchpad');
        if (touchpadEl) {
          touchpadEl.style.stroke = "#3B82F6";
        }

        // Buttons
        state.buttons.forEach((pressed, idx) => {
          const btnEl = document.getElementById(`btn-${idx}`);
          if (btnEl) {
            if (idx === 6 && l2Fill) {
              const val = state.triggers ? state.triggers.l2 : (pressed ? 1 : 0);
              l2Fill.style.opacity = (val * 0.9).toString();
            } else if (idx === 7 && r2Fill) {
              const val = state.triggers ? state.triggers.r2 : (pressed ? 1 : 0);
              r2Fill.style.opacity = (val * 0.9).toString();
            } else if (pressed) {
              btnEl.classList.add('is-pressed');
              btnEl.style.filter = "url(#glow-blue)";
            } else {
              btnEl.classList.remove('is-pressed');
              btnEl.style.filter = "none";
            }
          }

          if (matrixEls[idx]) {
            if (pressed) {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-blue-500 text-white border-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.8)] scale-105";
            } else {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-stone-500 border-white/5";
            }
          }
        });

        // Sticks & Raw Axes 0-3
        const lx = state.leftStick ? state.leftStick.x : 0;
        const ly = state.leftStick ? state.leftStick.y : 0;
        const rx = state.rightStick ? state.rightStick.x : 0;
        const ry = state.rightStick ? state.rightStick.y : 0;

        if (stickLCap) stickLCap.style.transform = `translate(${lx * 18}px, ${ly * 18}px)`;
        if (stickRCap) stickRCap.style.transform = `translate(${rx * 18}px, ${ry * 18}px)`;

        const rawAxes = [lx, ly, rx, ry];
        rawAxes.forEach((val, idx) => {
          const valEl = document.getElementById(`raw-axis-${idx}-val`);
          const barEl = document.getElementById(`raw-axis-${idx}-bar`);
          if (valEl) {
            valEl.textContent = (val >= 0 ? '+' : '') + val.toFixed(2);
          }
          if (barEl) {
            const mag = Math.min(Math.abs(val), 1.0) * 50;
            if (val >= 0) {
              barEl.style.marginLeft = '50%';
              barEl.style.width = `${mag}%`;
            } else {
              barEl.style.marginLeft = `${50 - mag}%`;
              barEl.style.width = `${mag}%`;
            }
          }
        });
      } else {
        if (subtext) {
          subtext.textContent = "Press any button to connect";
          subtext.className = "text-stone-400 font-mono text-xs font-semibold";
        }
        if (bentoStatusSubtext) {
          bentoStatusSubtext.textContent = "Connect a controller or press any button to inspect live Gamepad API telemetry.";
          bentoStatusSubtext.className = "text-stone-400 font-mono text-xs truncate";
        }
        if (bentoStatusDot) {
          bentoStatusDot.className = "w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0";
        }
        const touchpadEl = document.getElementById('btn-touchpad');
        if (touchpadEl) {
          touchpadEl.style.stroke = "#3F3F46";
        }
      }
    });

    // Vibration buttons
    const vibeBtns = document.querySelectorAll('.comp-vibe-btn');
    vibeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLElement).getAttribute('data-vibe');
        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        let activeGp: any = null;
        for (let i = 0; i < gamepads.length; i++) {
          if (gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
        }
        if (activeGp && activeGp.vibrationActuator) {
          let duration = 200, strong = 0, weak = 0;
          if (type === 'heavy') { strong = 1.0; weak = 0.2; duration = 400; }
          if (type === 'light') { strong = 0.1; weak = 0.8; duration = 300; }
          if (type === 'burst') { strong = 1.0; weak = 1.0; duration = 100; }
          if (type === 'pulse') { strong = 0.5; weak = 0.5; duration = 500; }
          
          try {
            activeGp.vibrationActuator.playEffect("dual-rumble", {
              startDelay: 0,
              duration: duration,
              weakMagnitude: weak,
              strongMagnitude: strong
            });
            if (vibeFeedbackTag) {
              vibeFeedbackTag.textContent = `Sent ${type?.toUpperCase()} [${duration}ms]`;
              vibeFeedbackTag.className = "text-[10px] font-mono text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded font-bold";
            }
          } catch (err) {
            console.warn("Vibration API failed", err);
            if (vibeFeedbackTag) {
              vibeFeedbackTag.textContent = "API Error";
              vibeFeedbackTag.className = "text-[10px] font-mono text-red-400 bg-red-500/10 border border-red-500/20 px-2 py-0.5 rounded font-bold";
            }
          }
        } else {
          if (vibeFeedbackTag) {
            vibeFeedbackTag.textContent = "No Rumble Motor Detected";
            vibeFeedbackTag.className = "text-[10px] font-mono text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded font-bold";
          }
        }
      });
    });

    // Custom Vibration Intensity Slider Handlers
    const vibeSlider = document.getElementById('vibe-intensity-slider') as HTMLInputElement | null;
    const vibeSliderVal = document.getElementById('vibe-slider-val');
    const vibeSliderTestBtn = document.getElementById('vibe-slider-test-btn');

    function triggerCustomVibe(intensityPct: number) {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: any = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
      }
      const mag = Math.min(Math.max(intensityPct / 100, 0), 1.0);
      if (activeGp && activeGp.vibrationActuator) {
        try {
          activeGp.vibrationActuator.playEffect("dual-rumble", {
            startDelay: 0,
            duration: 350,
            weakMagnitude: mag,
            strongMagnitude: mag
          });
          if (vibeFeedbackTag) {
            vibeFeedbackTag.textContent = `Custom Rumble [${intensityPct}%]`;
            vibeFeedbackTag.className = "text-[10px] font-mono text-amber-400 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded font-bold";
          }
        } catch (err) {
          console.warn("Vibration API error", err);
        }
      } else {
        if (vibeFeedbackTag) {
          vibeFeedbackTag.textContent = `Set ${intensityPct}% (No Controller Connected)`;
          vibeFeedbackTag.className = "text-[10px] font-mono text-stone-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded font-semibold";
        }
      }
    }

    if (vibeSlider && vibeSliderVal) {
      vibeSlider.addEventListener('input', () => {
        const val = Number(vibeSlider.value);
        vibeSliderVal.textContent = `${val}%`;
        triggerCustomVibe(val);
      });
    }

    if (vibeSliderTestBtn && vibeSlider) {
      vibeSliderTestBtn.addEventListener('click', () => {
        const val = Number(vibeSlider.value);
        triggerCustomVibe(val);
      });
    }
  });
</script>

<style>
  .dpad-btn, .action-btn {
    transition: transform 0.06s ease, fill 0.08s ease, stroke 0.08s ease;
  }
  .is-pressed {
    transform: scale(0.92);
  }
</style>
