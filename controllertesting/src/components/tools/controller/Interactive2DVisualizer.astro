---
/**
 * Interactive2DVisualizer.astro
 * 1:1 Pixel-Perfect Visual Replica matching competitor (controllertest.io)
 */
import PremiumStickCanvas from './PremiumStickCanvas.astro';
import TriggerBars from './TriggerBars.astro';

export interface Props {
  isRigid?: boolean;
}

const { isRigid = false } = Astro.props;
---

<div class="competitor-bento-layout w-full max-w-7xl mx-auto grid grid-cols-1 xl:grid-cols-12 gap-5 select-none text-stone-200">
  
  <!-- LEFT COLUMN: Controller Visualizer Main Card (7 Cols) -->
  <div class="xl:col-span-7 bg-[#161618] border border-[#27272A] rounded-[28px] p-6 flex flex-col justify-between relative shadow-2xl min-h-[500px]">
    
    <!-- Top Header inside Left Card -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="6" y1="12" x2="10" y2="12"></line>
            <line x1="8" y1="10" x2="8" y2="14"></line>
            <circle cx="15" cy="13" r="1" fill="currentColor"></circle>
            <circle cx="17.5" cy="10.5" r="1" fill="currentColor"></circle>
            <path d="M17.32 5H6.68a4 4 0 0 0-3.97 3.58L1.6 16.51A3.5 3.5 0 0 0 5.08 20h.1a3.5 3.5 0 0 0 3.32-2.41L9 16h6l.5 1.59A3.5 3.5 0 0 0 18.82 20h.1a3.5 3.5 0 0 0 3.48-3.49l-1.11-7.93A4 4 0 0 0 17.32 5z"></path>
          </svg>
        </div>
        <div>
          <h2 class="text-white font-bold text-xl tracking-tight">Controller Visualizer</h2>
          <p id="connection-subtext" class="text-stone-400 font-mono text-xs mt-0.5">Press any button to connect</p>
        </div>
      </div>

      <!-- Player Indicator Pills (P1 P2 P3 P4) -->
      <div class="flex items-center gap-3 px-3 py-1.5 rounded-full bg-[#242427] border border-[#3F3F46] font-mono text-xs font-bold text-stone-400">
        <span id="player-p1" class="flex items-center gap-1.5 text-white">
          P1 <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block shadow-[0_0_6px_#10B981]"></span>
        </span>
        <span id="player-p2" class="flex items-center gap-1.5 opacity-40 hover:opacity-100 transition-opacity cursor-pointer">
          P2 <span class="w-1.5 h-1.5 rounded-full bg-stone-600 inline-block"></span>
        </span>
        <span id="player-p3" class="flex items-center gap-1.5 opacity-40 hover:opacity-100 transition-opacity cursor-pointer">
          P3 <span class="w-1.5 h-1.5 rounded-full bg-stone-600 inline-block"></span>
        </span>
        <span id="player-p4" class="flex items-center gap-1.5 opacity-40 hover:opacity-100 transition-opacity cursor-pointer">
          P4 <span class="w-1.5 h-1.5 rounded-full bg-stone-600 inline-block"></span>
        </span>
      </div>
    </div>

    <!-- Center: Interactive 2D Controller Vector Viewport -->
    <div class="w-full flex-1 flex items-center justify-center py-2 relative">
      <svg id="ps5-svg" viewBox="0 0 700 500" class="w-full max-w-[500px] max-h-[360px] select-none transition-transform duration-300 filter drop-shadow-[0_15px_35px_rgba(0,0,0,0.6)]" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="glow-blue" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="0" stdDeviation="8" flood-color="#3b82f6" flood-opacity="0.9" />
          </filter>
        </defs>

        <!-- Triggers & Bumpers -->
        <g id="group-triggers">
          <g id="btn-l2" data-btn="6" class="button-path cursor-pointer">
            <rect x="250" y="20" width="44" height="60" rx="14" class="fill-[#1F1F24] stroke-[#3A3A42] transition-colors" stroke-width="2" />
            <rect id="l2-wire-fill" x="252" y="22" width="40" height="56" rx="12" fill="#3B82F6" class="opacity-0 transition-opacity" />
          </g>
          <g id="btn-r2" data-btn="7" class="button-path cursor-pointer">
            <rect x="406" y="20" width="44" height="60" rx="14" class="fill-[#1F1F24] stroke-[#3A3A42] transition-colors" stroke-width="2" />
            <rect id="r2-wire-fill" x="408" y="22" width="40" height="56" rx="12" fill="#3B82F6" class="opacity-0 transition-opacity" />
          </g>
          <g id="btn-l1" data-btn="4" class="button-path cursor-pointer">
            <rect x="238" y="82" width="68" height="26" rx="10" class="fill-[#26262C] stroke-[#444450] transition-colors" stroke-width="2" />
            <text x="272" y="99" class="fill-stone-300 font-mono font-bold text-[11px]" text-anchor="middle">L1</text>
          </g>
          <g id="btn-r1" data-btn="5" class="button-path cursor-pointer">
            <rect x="394" y="82" width="68" height="26" rx="10" class="fill-[#26262C] stroke-[#444450] transition-colors" stroke-width="2" />
            <text x="428" y="99" class="fill-stone-300 font-mono font-bold text-[11px]" text-anchor="middle">R1</text>
          </g>
        </g>

        <!-- Body Outer Path -->
        <path d="M 230,105 C 310,95 390,95 470,105 C 520,110 570,135 595,185 C 625,250 645,350 655,435 C 660,475 625,495 590,490 C 555,485 520,410 500,345 C 470,335 430,340 350,340 C 270,340 230,335 200,345 C 180,410 145,485 110,490 C 75,495 40,475 45,435 C 55,350 75,250 105,185 C 130,135 180,110 230,105 Z" fill="#18181C" stroke="#3F3F46" stroke-width="2.5" />
        <path d="M 125,230 C 180,260 235,320 235,320 M 575,230 C 520,260 465,320 465,320" fill="none" stroke="#27272A" stroke-width="2" stroke-dasharray="4,4" />

        <!-- Touchpad -->
        <g id="touchpad-group" class="cursor-pointer" data-btn="17">
          <rect id="btn-touchpad" data-btn="17" x="260" y="112" width="180" height="96" rx="12" class="button-path fill-[#222226] stroke-[#3F3F46] transition-all" stroke-width="2" />
          <path d="M 255,108 L 445,108" fill="none" stroke="#3B82F6" stroke-width="3" stroke-linecap="round" class="opacity-70" />
          <text x="350" y="165" class="fill-stone-400 font-mono font-semibold text-[11px] tracking-widest" text-anchor="middle">TOUCHPAD</text>
        </g>

        <!-- D-PAD -->
        <g id="group-dpad" transform="translate(170, 240)">
          <circle cx="0" cy="0" r="52" fill="#222226" stroke="#3F3F46" stroke-width="2" />
          <path id="btn-dpad-up" data-btn="12" d="M -14,-16 L 14,-16 L 14,-44 C 14,-48 8,-52 0,-52 C -8,-52 -14,-48 -14,-44 Z" class="dpad-btn button-path cursor-pointer fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
          <path id="btn-dpad-down" data-btn="13" d="M -14,16 L 14,16 L 14,44 C 14,48 8,52 0,52 C -8,52 -14,48 -14,44 Z" class="dpad-btn button-path cursor-pointer fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
          <path id="btn-dpad-left" data-btn="14" d="M -16,-14 L -16,14 L -44,14 C -48,14 -52,8 -52,0 C -52,-8 -48,-14 -44,-14 Z" class="dpad-btn button-path cursor-pointer fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
          <path id="btn-dpad-right" data-btn="15" d="M 16,-14 L 16,14 L 44,14 C 48,14 52,8 52,0 C 52,-8 48,-14 46,-14 Z" class="dpad-btn button-path cursor-pointer fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
        </g>

        <!-- ACTION BUTTONS -->
        <g id="group-action-buttons" transform="translate(530, 240)">
          <circle cx="0" cy="0" r="52" fill="#222226" stroke="#3F3F46" stroke-width="2" />
          <g id="btn-triangle" data-btn="3" class="action-btn cursor-pointer">
            <circle cx="0" cy="-32" r="16" class="button-path fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
            <polygon points="0,-39 -6,-27 6,-27" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linejoin="round" />
          </g>
          <g id="btn-circle" data-btn="1" class="action-btn cursor-pointer">
            <circle cx="32" cy="0" r="16" class="button-path fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
            <circle cx="32" cy="0" r="7" fill="none" stroke="#EF4444" stroke-width="2.5" />
          </g>
          <g id="btn-cross" data-btn="0" class="action-btn cursor-pointer">
            <circle cx="0" cy="32" r="16" class="button-path fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
            <path d="M -5,27 L 5,37 M 5,27 L -5,37" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-linecap="round" />
          </g>
          <g id="btn-square" data-btn="2" class="action-btn cursor-pointer">
            <circle cx="-32" cy="0" r="16" class="button-path fill-[#2A2A30] stroke-[#4B4B56]" stroke-width="1.5" />
            <rect x="-37" y="-5" width="10" height="10" fill="none" stroke="#EC4899" stroke-width="2.5" />
          </g>
        </g>

        <!-- ANALOG THUMBSTICKS -->
        <g id="group-left-stick" transform="translate(265, 350)">
          <circle cx="0" cy="0" r="42" fill="#222226" stroke="#3F3F46" stroke-width="2" />
          <g id="stick-l-cap" data-btn="10" class="button-path cursor-pointer stick-cap-node">
            <circle cx="0" cy="0" r="33" fill="#2A2A30" stroke="#4B4B56" stroke-width="2" />
            <circle cx="0" cy="0" r="24" fill="none" stroke="#3F3F46" stroke-width="1.5" stroke-dasharray="3,3" />
            <text x="0" y="4" class="fill-stone-400 font-mono font-bold text-[10px]" text-anchor="middle">L3</text>
          </g>
        </g>

        <g id="group-right-stick" transform="translate(435, 350)">
          <circle cx="0" cy="0" r="42" fill="#222226" stroke="#3F3F46" stroke-width="2" />
          <g id="stick-r-cap" data-btn="11" class="button-path cursor-pointer stick-cap-node">
            <circle cx="0" cy="0" r="33" fill="#2A2A30" stroke="#4B4B56" stroke-width="2" />
            <circle cx="0" cy="0" r="24" fill="none" stroke="#3F3F46" stroke-width="1.5" stroke-dasharray="3,3" />
            <text x="0" y="4" class="fill-stone-400 font-mono font-bold text-[10px]" text-anchor="middle">R3</text>
          </g>
        </g>

        <!-- META BUTTONS -->
        <g id="btn-create" data-btn="8" class="button-path cursor-pointer">
          <rect x="226" y="140" width="16" height="24" rx="6" fill="#2A2A30" stroke="#4B4B56" stroke-width="1.5" />
        </g>
        <g id="btn-options" data-btn="9" class="button-path cursor-pointer">
          <rect x="458" y="140" width="16" height="24" rx="6" fill="#2A2A30" stroke="#4B4B56" stroke-width="1.5" />
        </g>
        <g id="btn-ps" data-btn="16" class="button-path cursor-pointer">
          <circle cx="350" cy="275" r="14" fill="#222226" stroke="#3F3F46" stroke-width="1.5" />
          <path d="M 347,269 C 347,269 353,269 353,274 C 353,279 347,278 347,283 M 344,280 L 356,280" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" />
        </g>
      </svg>
    </div>

    <!-- Bottom Legend inside Left Card -->
    <div class="flex items-center justify-center gap-6 font-mono text-xs text-stone-400 pt-3 border-t border-[#27272A]">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 inline-block shadow-[0_0_8px_#3B82F6]"></span>
        <span>Button Pressed</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-stone-600 inline-block"></span>
        <span>Waiting for Input</span>
      </div>
    </div>
  </div>

  <!-- RIGHT COLUMN: 2x2 Bento Grid (4 Separate Floating Cards) (5 Cols) -->
  <div class="xl:col-span-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
    
    <!-- Bento Card 1: Analog Sticks -->
    <div class="bg-[#161618] border border-[#27272A] rounded-[24px] p-4 flex flex-col justify-between shadow-2xl min-h-[235px]">
      <div class="flex items-start justify-between mb-1">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/></svg>
          </div>
          <div class="min-w-0">
            <h3 class="text-xs font-bold text-white font-mono leading-snug tracking-tight">Analog Sticks</h3>
            <span class="text-[9px] text-emerald-400 font-mono leading-none block mt-0.5">Linearity & Drift</span>
          </div>
        </div>
        <button id="recenter-btn" title="Re-center Sticks" class="text-stone-400 hover:text-white transition-colors p-1 shrink-0 mt-0.5">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
        </button>
      </div>
      
      <div class="flex-1 flex items-center justify-center py-1">
        <PremiumStickCanvas />
      </div>
    </div>

    <!-- Bento Card 2: Triggers -->
    <div class="bg-[#161618] border border-[#27272A] rounded-[24px] p-4 flex flex-col justify-between shadow-2xl min-h-[235px]">
      <div class="flex items-center gap-2.5 mb-1">
        <div class="w-7 h-7 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3M1 14h6M9 8h6M17 16h6"/></svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-white font-mono leading-snug tracking-tight">Triggers</h3>
          <span class="text-[9px] text-indigo-400 font-mono leading-none block mt-0.5">Analog Pressure (0-1)</span>
        </div>
      </div>
      
      <div class="flex-1 flex items-center justify-center py-1">
        <TriggerBars />
      </div>
    </div>

    <!-- Bento Card 3: Raw Data -->
    <div class="bg-[#161618] border border-[#27272A] rounded-[24px] p-4 flex flex-col justify-between shadow-2xl min-h-[235px]">
      <div class="flex items-center gap-2.5 mb-1">
        <div class="w-7 h-7 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-white font-mono leading-snug tracking-tight">Raw Data</h3>
          <span class="text-[9px] text-blue-400 font-mono leading-none block mt-0.5">Gamepad API Output</span>
        </div>
      </div>

      <!-- Button Matrix -->
      <div class="flex-1 flex flex-col justify-between mt-2">
        <div class="grid grid-cols-6 gap-1" id="competitor-matrix">
          <!-- Rendered via JS -->
        </div>
        <div class="text-center mt-2">
          <span id="bento-status-subtext" class="text-[9px] font-mono text-stone-500 uppercase tracking-wider font-bold truncate block">NO CONTROLLER DETECTED</span>
        </div>
      </div>
    </div>

    <!-- Bento Card 4: Vibration Test -->
    <div class="bg-[#161618] border border-[#27272A] rounded-[24px] p-4 flex flex-col justify-between shadow-2xl min-h-[235px]">
      <div class="flex items-center gap-2.5 mb-1">
        <div class="w-7 h-7 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <div class="min-w-0">
          <h3 class="text-xs font-bold text-amber-400 font-mono leading-snug tracking-tight">Vibration Test</h3>
          <span class="text-[9px] text-amber-500/70 font-mono leading-none block mt-0.5">Dual Motor Setup</span>
        </div>
      </div>

      <div class="flex-1 flex flex-col items-center justify-center gap-3 py-1">
        <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-stone-400 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M8 6v12M16 6v12M4 9v6M20 9v6"/></svg>
        </div>

        <div class="grid grid-cols-2 gap-2 w-full">
          <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors" data-vibe="heavy">
            HEAVY <div class="w-4 h-1 bg-amber-500 rounded-full mx-auto mt-1"></div>
          </button>
          <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors" data-vibe="light">
            LIGHT <div class="w-4 h-1 bg-blue-500 rounded-full mx-auto mt-1"></div>
          </button>
          <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors" data-vibe="burst">
            BURST <div class="w-4 h-1 bg-purple-500 rounded-full mx-auto mt-1"></div>
          </button>
          <button class="comp-vibe-btn text-[10px] font-mono font-bold uppercase py-2 px-2 rounded-xl bg-white/5 border border-white/10 hover:bg-white/15 text-stone-300 transition-colors" data-vibe="pulse">
            PULSE <div class="w-4 h-1 bg-rose-500 rounded-full mx-auto mt-1"></div>
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { GamepadLoop } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    const subtext = document.getElementById('connection-subtext');
    const matrixContainer = document.getElementById('competitor-matrix');
    const bentoStatusSubtext = document.getElementById('bento-status-subtext');
    const stickLCap = document.getElementById('stick-l-cap');
    const stickRCap = document.getElementById('stick-r-cap');
    const l2Fill = document.getElementById('l2-wire-fill');
    const r2Fill = document.getElementById('r2-wire-fill');

    // Populate matrix
    const matrixEls: HTMLElement[] = [];
    if (matrixContainer) {
      let html = '';
      for (let i = 0; i < 18; i++) {
        html += `<div id="comp-btn-${i}" class="h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-stone-500 border-white/5">${i}</div>`;
      }
      matrixContainer.innerHTML = html;
      for (let i = 0; i < 18; i++) {
        const el = document.getElementById(`comp-btn-${i}`);
        if (el) matrixEls.push(el);
      }
    }

    GamepadLoop.subscribe((state) => {
      if (state && state.connected) {
        const idLower = (state.id || '').toLowerCase();
        const isPS = idLower.includes('dualsense') || idLower.includes('playstation') || idLower.includes('dualshock') || idLower.includes('054c') || idLower.includes('wireless controller');

        if (subtext) {
          subtext.textContent = isPS ? `PS5 DualSense Connected (${state.id.substring(0, 16)}...)` : `Controller Connected (${state.id.substring(0, 16)}...)`;
          subtext.className = "text-emerald-400 font-mono text-xs font-bold mt-0.5";
        }
        
        if (bentoStatusSubtext) {
          bentoStatusSubtext.textContent = isPS ? "PS5 DUALSENSE CONNECTED" : "CONTROLLER CONNECTED";
          bentoStatusSubtext.className = "text-[10px] font-mono text-emerald-400 uppercase tracking-wider font-bold";
        }

        const touchpadEl = document.getElementById('btn-touchpad');
        if (touchpadEl) {
          touchpadEl.style.stroke = "#3B82F6";
        }

        // Buttons
        state.buttons.forEach((pressed, idx) => {
          const btnEl = document.getElementById(`btn-${idx}`);
          if (btnEl) {
            if (idx === 6 && l2Fill) {
              const val = state.triggers ? state.triggers.l2 : (pressed ? 1 : 0);
              l2Fill.style.opacity = (val * 0.9).toString();
            } else if (idx === 7 && r2Fill) {
              const val = state.triggers ? state.triggers.r2 : (pressed ? 1 : 0);
              r2Fill.style.opacity = (val * 0.9).toString();
            } else if (pressed) {
              btnEl.classList.add('is-pressed');
              btnEl.style.filter = "url(#glow-blue)";
            } else {
              btnEl.classList.remove('is-pressed');
              btnEl.style.filter = "none";
            }
          }

          if (matrixEls[idx]) {
            if (pressed) {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-blue-500 text-white border-blue-400 shadow-[0_0_10px_rgba(37,99,235,0.8)] scale-105";
            } else {
              matrixEls[idx].className = "h-6 flex items-center justify-center text-[10px] font-mono font-bold rounded border transition-all duration-75 bg-white/5 text-stone-500 border-white/5";
            }
          }
        });

        // Sticks
        const lx = state.leftStick ? state.leftStick.x : 0;
        const ly = state.leftStick ? state.leftStick.y : 0;
        const rx = state.rightStick ? state.rightStick.x : 0;
        const ry = state.rightStick ? state.rightStick.y : 0;

        if (stickLCap) stickLCap.style.transform = `translate(${lx * 18}px, ${ly * 18}px)`;
        if (stickRCap) stickRCap.style.transform = `translate(${rx * 18}px, ${ry * 18}px)`;
      } else {
        if (subtext) {
          subtext.textContent = "Press any button to connect";
          subtext.className = "text-stone-400 font-mono text-xs mt-0.5";
        }
        if (bentoStatusSubtext) {
          bentoStatusSubtext.textContent = "NO CONTROLLER DETECTED";
          bentoStatusSubtext.className = "text-[10px] font-mono text-stone-500 uppercase tracking-wider font-bold";
        }
        const touchpadEl = document.getElementById('btn-touchpad');
        if (touchpadEl) {
          touchpadEl.style.stroke = "#3F3F46";
        }
      }
    });

    // Vibration buttons
    const vibeBtns = document.querySelectorAll('.comp-vibe-btn');
    vibeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const type = (e.currentTarget as HTMLElement).getAttribute('data-vibe');
        const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
        let activeGp: any = null;
        for (let i = 0; i < gamepads.length; i++) {
          if (gamepads[i]?.connected) { activeGp = gamepads[i]; break; }
        }
        if (activeGp && activeGp.vibrationActuator) {
          let duration = 200, strong = 0, weak = 0;
          if (type === 'heavy') { strong = 1.0; weak = 0.2; duration = 400; }
          if (type === 'light') { strong = 0.1; weak = 0.8; duration = 300; }
          if (type === 'burst') { strong = 1.0; weak = 1.0; duration = 100; }
          if (type === 'pulse') { strong = 0.5; weak = 0.5; duration = 500; }
          
          try {
            activeGp.vibrationActuator.playEffect("dual-rumble", {
              startDelay: 0,
              duration: duration,
              weakMagnitude: weak,
              strongMagnitude: strong
            });
          } catch (err) {
            console.warn("Vibration API failed", err);
          }
        }
      });
    });
  });
</script>

<style>
  .dpad-btn, .action-btn {
    transition: transform 0.06s ease, fill 0.08s ease, stroke 0.08s ease;
  }
  .is-pressed {
    transform: scale(0.92);
  }
</style>
