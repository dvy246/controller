  .dpad-btn, .action-btn .button-path {
    fill: #f1f5f9;
    transition: all 0.08s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.dark) .dpad-btn, :global(.dark) .action-btn .button-path {
    fill: #0f172a;
