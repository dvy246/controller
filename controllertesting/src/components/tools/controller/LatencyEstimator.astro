---
/**
 * LatencyEstimator.astro — Controller Input Latency & Reaction Delay Tool
 * Measures reaction response speed from visual prompt to button trigger actuation.
 */
---

<div class="latency-tester" id="lat-tester-root">
  <div class="tester-status-bar">
    <div class="status-indicator">
      <span class="status-dot" id="lat-status-dot"></span>
      <span class="status-text" id="lat-status-text">Click 'Start Reaction Test' then press any button when box turns GREEN...</span>
    </div>
    <div class="controller-name" id="lat-model-name">No Controller Detected</div>
  </div>

  <div class="lat-hero-box" id="lat-target-box">
    <div class="lat-box-content">
      <span class="lat-box-title" id="lat-box-title">Click Start Below</span>
      <span class="lat-box-sub" id="lat-box-sub">Ready when box turns emerald green</span>
    </div>
  </div>

  <div class="lat-stats-grid">
    <div class="lat-stat-card">
      <span class="lat-label">LAST REACTION TIME</span>
      <span class="lat-val text-gradient" id="lat-last-ms">0 ms</span>
    </div>
    <div class="lat-stat-card">
      <span class="lat-label">BEST (FASTEST)</span>
      <span class="lat-val mono" id="lat-best-ms">0 ms</span>
    </div>
    <div class="lat-stat-card">
      <span class="lat-label">AVERAGE (5 TRIES)</span>
      <span class="lat-val mono" id="lat-avg-ms">0 ms</span>
    </div>
  </div>

  <div class="tester-controls">
    <button type="button" class="btn-primary" id="btn-start-lat">Start Reaction Test</button>
    <button type="button" class="btn-secondary" id="btn-reset-lat">Reset Stats</button>
  </div>
</div>

<script>
  import { parseGamepadState } from '../../../lib/gamepad';

  document.addEventListener('DOMContentLoaded', () => {
    let state: 'idle' | 'waiting' | 'ready' | 'too-early' = 'idle';
    let startTime = 0;
    let timeoutId: number | null = null;
    let trials: number[] = [];

    const box = document.getElementById('lat-target-box');
    const title = document.getElementById('lat-box-title');
    const sub = document.getElementById('lat-box-sub');

    function setBoxState(newState: typeof state) {
      state = newState;
      if (!box || !title || !sub) return;

      if (state === 'idle') {
        box.className = 'lat-hero-box';
        title.textContent = 'Click Start Below';
        sub.textContent = 'Press any button when box turns emerald green';
      } else if (state === 'waiting') {
        box.className = 'lat-hero-box waiting';
        title.textContent = 'Wait for GREEN...';
        sub.textContent = 'Do not press any button yet';
      } else if (state === 'ready') {
        box.className = 'lat-hero-box ready';
        title.textContent = 'PRESS ANY BUTTON NOW!';
        sub.textContent = 'Reaction timer running...';
        startTime = performance.now();
      } else if (state === 'too-early') {
        box.className = 'lat-hero-box too-early';
        title.textContent = 'Too Early!';
        sub.textContent = 'You pressed a button before the box turned green';
      }
    }

    function recordReaction() {
      if (state === 'waiting') {
        if (timeoutId) clearTimeout(timeoutId);
        setBoxState('too-early');
        return;
      }

      if (state === 'ready') {
        const elapsed = Math.round(performance.now() - startTime);
        trials.push(elapsed);

        const lastMs = document.getElementById('lat-last-ms');
        const bestMs = document.getElementById('lat-best-ms');
        const avgMs = document.getElementById('lat-avg-ms');

        if (lastMs) lastMs.textContent = `${elapsed} ms`;
        const best = Math.min(...trials);
        if (bestMs) bestMs.textContent = `${best} ms`;

        const avg = Math.round(trials.reduce((a, b) => a + b, 0) / trials.length);
        if (avgMs) avgMs.textContent = `${avg} ms`;

        if (box && title && sub) {
          box.className = 'lat-hero-box ready';
          title.textContent = `${elapsed} ms!`;
          sub.textContent = 'Great reaction! Click Start to test again.';
        }
        state = 'idle';
      }
    }

    document.getElementById('btn-start-lat')?.addEventListener('click', () => {
      setBoxState('waiting');
      const delay = 1500 + Math.random() * 3000;
      timeoutId = window.setTimeout(() => {
        setBoxState('ready');
      }, delay);
    });

    document.getElementById('btn-reset-lat')?.addEventListener('click', () => {
      trials = [];
      setBoxState('idle');
      const lastMs = document.getElementById('lat-last-ms');
      const bestMs = document.getElementById('lat-best-ms');
      const avgMs = document.getElementById('lat-avg-ms');
      if (lastMs) lastMs.textContent = '0 ms';
      if (bestMs) bestMs.textContent = '0 ms';
      if (avgMs) avgMs.textContent = '0 ms';
    });

    // Gamepad button press detection
    let prevButtons: boolean[] = [];
    function pollReaction() {
      const gamepads = navigator.getGamepads ? navigator.getGamepads() : [];
      let activeGp: Gamepad | null = null;
      for (let i = 0; i < gamepads.length; i++) {
        if (gamepads[i] && gamepads[i]?.connected) {
          activeGp = gamepads[i];
          break;
        }
      }

      if (activeGp) {
        const dot = document.getElementById('lat-status-dot');
        const text = document.getElementById('lat-status-text');
        const model = document.getElementById('lat-model-name');
        if (dot) dot.className = 'status-dot active';
        if (text) text.textContent = 'Controller Active';
        if (model) model.textContent = activeGp.id;

        const gpState = parseGamepadState(activeGp);
        gpState.buttons.forEach((b, idx) => {
          if (b.pressed && !prevButtons[idx]) {
            recordReaction();
          }
          prevButtons[idx] = b.pressed;
        });
      }

      requestAnimationFrame(pollReaction);
    }

    pollReaction();
  });
</script>

<style>
  .latency-tester {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .tester-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-neutral);
  }
  .status-dot.active {
    background: var(--color-pass);
    box-shadow: 0 0 8px var(--color-pass);
  }

  .status-text {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .controller-name {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-accent);
  }

  .lat-hero-box {
    height: 220px;
    background: var(--color-surface-2);
    border: 2px dashed var(--color-border-default);
    border-radius: var(--radius-card);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    transition: background 0.2s, border-color 0.2s;
  }

  .lat-hero-box.waiting {
    background: var(--color-warning-bg);
    border-color: var(--color-warning);
    border-style: solid;
  }

  .lat-hero-box.ready {
    background: var(--color-pass-bg);
    border-color: var(--color-pass);
    border-style: solid;
  }

  .lat-hero-box.too-early {
    background: var(--color-fail-bg);
    border-color: var(--color-fail);
    border-style: solid;
  }

  .lat-box-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lat-box-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .lat-box-sub {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .lat-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .lat-stat-card {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    text-align: center;
  }

  .lat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-tertiary);
    letter-spacing: 0.08em;
  }

  .lat-val {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
  }

  .tester-controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  @media (max-width: 768px) {
    .lat-stats-grid { grid-template-columns: 1fr; }
  }
</style>
