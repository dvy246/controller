---
/**
 * ArcadeRewardsLine.astro — shared rewards/level/streak block for game-over panels.
 * Rendered inside the game-over panel after the final score, before the actions.
 * Element IDs follow `${baseId}-over-*` so games can update them via arcadeRewards.ts.
 */
interface Props {
  /** Unique per-game prefix, e.g. 'sniper', 'blitz', 'maze', 'trig', 'draw'. */
  baseId: string;
  /** XP amount this game awards (must match claimArcadeXp call). */
  xp: number;
}

const { baseId, xp } = Astro.props;
---
<div class="over-rewards">
  <span class="badge badge-pass over-xp" id={`${baseId}-over-xp`}>+{xp} XP earned</span>
  <span class="over-level-line mono" id={`${baseId}-over-level`} hidden>Level 1 · 0 XP</span>
  <div class="over-levelup" id={`${baseId}-over-levelup`} hidden role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    <span id={`${baseId}-over-levelup-text`}>Level up! → Level 2</span>
  </div>
  <div class="over-streak" id={`${baseId}-over-streak`} hidden role="status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
    <span id={`${baseId}-over-streak-text`}>1-day streak</span>
  </div>
</div>

<style>
  .over-rewards {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-block: 0.5rem;
    width: 100%;
  }
  .over-xp { margin: 0; }
  .over-level-line {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }
  .over-levelup,
  .over-streak {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small);
    font-weight: 700;
    padding: 0.35em 0.9em;
    border-radius: var(--radius-pill);
  }
  .over-levelup {
    color: var(--color-accent);
    background: var(--color-info-bg);
    border: 1px solid var(--color-info);
  }
  .over-streak {
    color: var(--color-warning);
    background: var(--color-warning-bg);
    border: 1px solid var(--color-warning);
  }
  .over-levelup[hidden],
  .over-streak[hidden],
  .over-level-line[hidden] {
    display: none;
  }
  .over-animate {
    animation: over-reward-pop 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes over-reward-pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .over-animate {
      animation: none;
      transform: none;
    }
  }
</style>
