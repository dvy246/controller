---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  subtitle?: string;
}

const { 
  faqs, 
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about testing your controller."
} = Astro.props;
---

<div class="premium-faq-section" data-reveal>
  <div class="faq-header">
    <h2 class="faq-title">{title}</h2>
    {subtitle && <p class="faq-subtitle">{subtitle}</p>}
  </div>

  <div class="faq-list" role="list">
    {faqs.map((faq) => (
      <details class="faq-item" role="listitem">
        <summary class="faq-summary">
          <span class="faq-question-text">{faq.question}</span>
          <span class="faq-icon-wrap" aria-hidden="true">
            <svg class="faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </span>
        </summary>
        <div class="faq-body">
          <p class="faq-answer">{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>

<style>
  .premium-faq-section {
    margin-top: 4rem;
    margin-bottom: 4rem;
  }

  .faq-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .faq-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .faq-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    max-width: 56ch;
    line-height: 1.6;
  }

  /* Flex gap — replaces broken space-y-3 Astro SSG fragments */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Core accordion item */
  .faq-item {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    overflow: hidden;
    /* Enumerate explicit properties — no transition: all (Vercel guideline) */
    transition:
      border-color var(--duration-fast) var(--ease-smooth),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .faq-item:hover {
    border-color: rgba(37, 99, 235, 0.45);
    box-shadow: 0 2px 12px rgba(37, 99, 235, 0.08);
  }

  /* Pure CSS [open] selector — no Tailwind group-open: variant needed */
  .faq-item[open] {
    border-color: rgba(37, 99, 235, 0.35);
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.1);
  }

  /* Summary row */
  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  /* Remove browser disclosure triangle */
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-summary::marker { display: none; }

  /* :focus-visible ring — use focus-visible not focus (Vercel guideline) */
  .faq-summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
    border-radius: calc(var(--radius-card) - 2px);
  }
  .faq-summary:focus:not(:focus-visible) {
    outline: none;
  }

  /* Question text */
  .faq-question-text {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--color-text-primary);
    flex: 1;
    min-width: 0;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .faq-item[open] .faq-question-text {
    color: var(--color-accent);
  }

  /* Icon wrap */
  .faq-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-secondary);
    transition:
      background var(--duration-fast) var(--ease-smooth),
      color var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) var(--ease-smooth);
  }

  .faq-item[open] .faq-icon-wrap {
    background: rgba(37, 99, 235, 0.12);
    border-color: rgba(37, 99, 235, 0.3);
    color: var(--color-accent);
  }

  /* + icon rotates to × on open — transform only (compositor-friendly) */
  .faq-icon {
    display: block;
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon-wrap,
    .faq-icon,
    .faq-question-text {
      transition: none;
    }
  }

  /* Answer body */
  .faq-body {
    overflow: hidden;
  }

  .faq-answer {
    margin: 0 1.5rem;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-body);
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
</style>
