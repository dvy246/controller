---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  subtitle?: string;
}

const { 
  faqs, 
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about testing your controller."
} = Astro.props;
---

<div class="premium-faq-section mb-16" data-reveal>
  <div class="mb-10 flex flex-col gap-4 text-left">
    <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">{title}</h2>
    {subtitle && <p class="text-lg text-stone-400 max-w-2xl leading-relaxed">{subtitle}</p>}
  </div>

  <div class="space-y-4 mt-8">
    {faqs.map((faq) => (
      <details class="group bg-[#111116] border border-white/5 rounded-2xl overflow-hidden shadow-md transition-all duration-300 hover:border-blue-500/40 hover:bg-[#15151a] open:bg-[#15151a] open:border-blue-500/30 open:shadow-xl">
        <summary class="flex items-center justify-between p-6 sm:p-8 cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden focus:outline-none focus:ring-2 focus:ring-blue-500/50">
          <span class="text-xl font-extrabold tracking-tight text-stone-200 group-open:text-blue-400 transition-colors pr-6">{faq.question}</span>
          <span class="text-white group-open:text-blue-400 group-open:rotate-45 transition-transform duration-300 shrink-0 bg-white/20 p-2.5 rounded-full border border-white/10 group-hover:bg-blue-500/30 group-hover:text-white shadow-sm flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </summary>
        <div class="px-6 sm:px-8 pb-8 pt-0 text-base sm:text-lg text-stone-400 leading-relaxed">
          <p class="border-t border-white/10 pt-6 mt-2">{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>
