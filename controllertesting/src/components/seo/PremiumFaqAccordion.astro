---
interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  subtitle?: string;
}

const { 
  faqs, 
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about testing your controller."
} = Astro.props;
---

<div class="premium-faq-section my-16" data-reveal>
  <div class="text-center sm:text-left mb-8">
    <h2 class="text-3xl font-extrabold text-primary tracking-tight mb-2">{title}</h2>
    <p class="text-sm text-secondary max-w-2xl">{subtitle}</p>
  </div>

  <div class="flex flex-col gap-4">
    {faqs.map((faq) => (
      <details class="group bg-surface-1 border border-surface-3 rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:border-surface-4 open:bg-surface-2 open:shadow-xl">
        <summary class="flex items-center justify-between p-6 cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden">
          <span class="text-base font-bold text-primary group-open:text-accent transition-colors">{faq.question}</span>
          <span class="text-secondary group-open:text-accent group-open:rotate-45 transition-transform duration-300">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </span>
        </summary>
        <div class="px-6 pb-6 pt-2 text-sm text-secondary leading-relaxed border-t border-surface-3/50 mt-2">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>
