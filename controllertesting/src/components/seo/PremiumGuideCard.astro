---
interface Props {
  title: string;
  description?: string;
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  badge?: string;
}

const { title, description, publishedAt, updatedAt, author, badge = "Repair Guide" } = Astro.props;
---

<div class="premium-guide-card my-16 sm:my-24 doppelrand-shell p-1.5 rounded-3xl w-full max-w-4xl mx-auto shadow-xl" data-reveal>
  <div class="doppelrand-core bg-[var(--color-surface-1)] backdrop-blur-xl border border-[var(--color-border-default)] rounded-[calc(1.5rem-0.375rem)] p-6 sm:p-10 md:p-12 relative overflow-hidden">
    
    <!-- Ambient glow behind the card -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-[var(--color-accent)]/10 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] font-mono text-xs uppercase tracking-widest font-bold mb-6 shadow-sm whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        {badge}
      </div>
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-[var(--color-text-primary)] tracking-tight mb-8 leading-tight">{title}</h2>
      
      {description && (
        <p class="text-[var(--color-text-secondary)] text-base sm:text-lg leading-relaxed -mt-4 mb-6">{description}</p>
      )}

      {(author || publishedAt || updatedAt) && (
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-8 font-mono text-xs uppercase tracking-widest text-[var(--color-text-secondary)]">
          {author && <span class="inline-flex items-center gap-1.5"><span class="text-[var(--color-accent)] font-bold">By</span> {author}</span>}
          {publishedAt && <span class="inline-flex items-center gap-1.5"><span class="text-[var(--color-accent)] font-bold">Published</span> {publishedAt}</span>}
          {updatedAt && <span class="inline-flex items-center gap-1.5"><span class="text-[var(--color-accent)] font-bold">Updated</span> {updatedAt}</span>}
        </div>
      )}
      
      <div class="prose dark:prose-invert max-w-none text-[var(--color-text-primary)] 
        prose-p:text-[var(--color-text-secondary)] prose-p:leading-relaxed prose-p:mb-6 
        prose-strong:text-[var(--color-text-primary)] prose-strong:font-bold
        prose-a:text-[var(--color-accent)] prose-a:font-bold prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-[var(--color-accent-hover)] transition-colors">
        <slot />
      </div>
    </div>
  </div>
</div>
