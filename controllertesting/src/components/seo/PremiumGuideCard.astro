---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="premium-guide-card mt-20 mb-32 doppelrand-shell p-1.5 rounded-[2.5rem] bg-blue-500/10 w-full max-w-4xl mx-auto shadow-2xl" data-reveal>
  <div class="doppelrand-core bg-[#111116]/95 backdrop-blur-xl border border-blue-500/20 rounded-[calc(2.5rem-0.375rem)] p-8 md:p-12 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)] relative overflow-hidden">
    
    <!-- Ambient glow behind the text -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-blue-500/20 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-500/15 border border-blue-500/30 text-blue-400 text-xs uppercase tracking-[0.2em] font-extrabold mb-8 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
        Repair Guide
      </div>

      <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-8 leading-tight">{title}</h2>
      
      <div class="prose prose-invert prose-lg max-w-none text-stone-100 
        prose-p:text-stone-200 prose-p:leading-relaxed prose-p:mb-8 
        prose-strong:text-white prose-strong:font-bold
        prose-a:text-blue-400 prose-a:font-bold prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-blue-300 transition-colors">
        <slot />
      </div>
    </div>
  </div>
</div>
