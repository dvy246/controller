---
/**
 * DiagnosticResultsBento.astro — ControllerTesting.com
 * Premium Asymmetrical 4-Card Bento Grid — rebuilt with deep-dark glass aesthetics,
 * corrected internal padding, badge overflow fix, and consistent vertical rhythm.
 */
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Diagnostics Results",
  subtitle = "Hardware variance and drift severity classification scale."
} = Astro.props;
---

<div class="bento-section w-full max-w-7xl mx-auto mt-16 mb-20" data-reveal>
  <div class="bento-header mb-8 text-center sm:text-left">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">{title}</h2>
    <p class="text-stone-400 text-sm sm:text-base max-w-2xl">{subtitle}</p>
  </div>

  <div class="bento-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch">

    <!-- Card 1: Top Left (2 Columns Wide) — Grade A / Healthy -->
    <div class="bento-card bento-card--wide group">
      <div class="bento-glow bento-glow--emerald"></div>
      <div class="bento-card-body relative z-10 flex flex-col h-full">
        <div class="flex items-start justify-between gap-3 mb-6">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 shadow-[0_0_15px_rgba(16,185,129,0.15)] group-hover:scale-110 transition-transform duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <span class="px-3 py-1 text-[10px] sm:text-xs font-bold font-mono uppercase tracking-wider rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 whitespace-nowrap">Grade A · 0.0% – 2.0%</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-emerald-300 transition-colors">Healthy Centering &amp; Precision</h3>
        <p class="text-sm text-stone-400 leading-relaxed mb-6 flex-1">Normal factory variance. Controller stick operates with precision zero-point accuracy and zero resting drift offset. Hardware is in perfect condition.</p>
        <a href="/deadzone-calculator/fortnite/ps5" class="mt-auto inline-flex items-center justify-between w-full px-4 py-3 bg-white/5 hover:bg-emerald-500/20 border border-white/10 hover:border-emerald-500/30 rounded-xl text-sm font-semibold text-white transition-all">
          <span>Optimize Deadzones</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Card 2: Right Side (Spans 2 Rows) — Buttons & Vibration -->
    <div class="bento-card bento-card--tall group">
      <div class="bento-glow bento-glow--blue"></div>
      <div class="bento-card-body relative z-10 flex flex-col h-full">
        <div class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0 mb-6 shadow-[0_0_15px_rgba(59,130,246,0.15)] group-hover:scale-110 transition-transform duration-500">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 12h4m-2-2v4"/><line x1="15" y1="11" x2="15" y2="11"/><line x1="18" y1="13" x2="18" y2="13"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-blue-300 transition-colors">Buttons &amp; Vibration</h3>
        <p class="text-sm text-stone-400 leading-relaxed mb-6 flex-1">Test all button responses and verify ABXY layout mapping. Dual motor vibration testing with independent left/right motor control. Check your force feedback system health and detect sticky triggers or failing microswitches.</p>
        <div class="flex items-center gap-1.5 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-500 shadow-[0_0_5px_#3b82f6]"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-stone-700"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-stone-700"></span>
        </div>
        <a href="/test/controller/full-diagnostic" class="mt-auto inline-flex items-center justify-between w-full px-4 py-3 bg-white/5 hover:bg-blue-500/20 border border-white/10 hover:border-blue-500/30 rounded-xl text-sm font-semibold text-white transition-all">
          <span>Run Full Diagnostic</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Card 3: Bottom Left (1 Column) — Polling Rate -->
    <div class="bento-card group">
      <div class="bento-glow bento-glow--amber"></div>
      <div class="bento-card-body relative z-10 flex flex-col h-full">
        <div class="flex items-start justify-between gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0 shadow-[0_0_15px_rgba(245,158,11,0.15)] group-hover:scale-110 transition-transform duration-500">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <span class="px-3 py-1 text-[10px] sm:text-xs font-bold font-mono uppercase tracking-wider rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 whitespace-nowrap">Grade B</span>
        </div>
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-amber-300 transition-colors">Polling Rate &amp; Latency</h3>
        <p class="text-sm text-stone-400 leading-relaxed mb-6 flex-1">Measure your controller's actual polling rate. Compare input latency.</p>
        <a href="/overclock-validator/ps5/usb-c" class="mt-auto inline-flex items-center justify-between w-full px-4 py-3 bg-white/5 hover:bg-amber-500/20 border border-white/10 hover:border-amber-500/30 rounded-xl text-sm font-semibold text-white transition-all">
          <span>Hz &amp; Circularity Tools</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Card 4: Bottom Middle (1 Column) — Privacy -->
    <div class="bento-card group">
      <div class="bento-glow bento-glow--purple"></div>
      <div class="bento-card-body relative z-10 flex flex-col h-full">
        <div class="flex items-start justify-between gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 shrink-0 shadow-[0_0_15px_rgba(168,85,247,0.15)] group-hover:scale-110 transition-transform duration-500">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span class="px-3 py-1 text-[10px] sm:text-xs font-bold font-mono uppercase tracking-wider rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 whitespace-nowrap">Local &amp; Secure</span>
        </div>
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-purple-300 transition-colors">100% Client-Side</h3>
        <p class="text-sm text-stone-400 leading-relaxed mb-6 flex-1">Built on the standard Gamepad API. All processing happens locally in your browser.</p>
        <a href="/test/methodology" class="mt-auto inline-flex items-center justify-between w-full px-4 py-3 bg-white/5 hover:bg-purple-500/20 border border-white/10 hover:border-purple-500/30 rounded-xl text-sm font-semibold text-white transition-all">
          <span>Read Methodology</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</div>

<style>
  .bento-card {
    background: linear-gradient(180deg, rgba(20,20,24,0.9) 0%, rgba(14,14,17,0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.02);
    border-radius: 1.5rem;
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.05);
    border-color: rgba(255, 255, 255, 0.15);
  }

  @media (min-width: 1024px) {
    .bento-card--wide {
      grid-column: span 2;
    }
    .bento-card--tall {
      grid-column: 3;
      grid-row: span 2;
    }
  }

  /* Radiant Ambient Under-Glow on hover */
  .bento-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 0;
    pointer-events: none;
  }
  .bento-card:hover .bento-glow {
    opacity: 1;
  }
  .bento-glow--emerald { background: radial-gradient(circle at 50% 0%, rgba(16,185,129,0.1) 0%, transparent 70%); }
  .bento-glow--blue { background: radial-gradient(circle at 50% 0%, rgba(59,130,246,0.1) 0%, transparent 70%); }
  .bento-glow--amber { background: radial-gradient(circle at 50% 0%, rgba(245,158,11,0.1) 0%, transparent 70%); }
  .bento-glow--purple { background: radial-gradient(circle at 50% 0%, rgba(168,85,247,0.1) 0%, transparent 70%); }
</style>
