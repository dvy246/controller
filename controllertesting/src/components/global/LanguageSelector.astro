---
/**
 * LanguageSelector.astro — Accessible Multilingual Language Switcher Dropdown
 * Allows switching between English (en), Spanish (es), German (de), French (fr), Japanese (ja).
 */

import { languages, defaultLang } from '../../i18n/translations';
import { getLangFromUrl, getLocalizedUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const pathname = Astro.url.pathname;

// Only the homepage is currently localized (es/de/fr/ja/index.astro).
// Offering locale links on any other page would 404 — hide them.
const localizedPath =
  currentLang !== defaultLang ? pathname.replace(`/${currentLang}`, '') : pathname;
const isLocalizedPage = localizedPath === '/' || localizedPath === '';
const availableLangs = isLocalizedPage
  ? Object.keys(languages)
  : [currentLang];
---

<div class="lang-selector-wrapper">
  <label for="lang-select" class="sr-only">Select Language</label>
  <select
    id="lang-select"
    class="lang-select"
    aria-label="Language selector"
    onchange="window.location.href = this.value;"
  >
    {availableLangs.map((code) => {
      const url = getLocalizedUrl(Astro.url, code as keyof typeof languages);
      const name = languages[code as keyof typeof languages];
      return (
        <option value={url} selected={code === currentLang}>
          {name}
        </option>
      );
    })}
  </select>
</div>

<style>
  .lang-selector-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .lang-select {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 500;
    padding: 0.35rem 0.625rem;
    cursor: pointer;
    outline: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .lang-select:hover, .lang-select:focus {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }
</style>
