---
/**
 * LanguageSelector.astro — Accessible Multilingual Language Switcher Dropdown
 * Allows switching between English (en), Spanish (es), German (de), French (fr), Japanese (ja).
 */

import { languages, defaultLang } from '../../i18n/translations';
import { getLangFromUrl, getLocalizedUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const availableLangs = Object.keys(languages) as (keyof typeof languages)[];

---

<div class="lang-selector-wrapper">
  <label for="lang-select" class="sr-only">Select Language</label>
  <select
    id="lang-select"
    class="lang-select"
    aria-label="Language selector"
  >
    {availableLangs.map((code) => {
      const name = languages[code as keyof typeof languages];
      return (
        <option value={code} selected={code === currentLang}>
          {name}
        </option>
      );
    })}
  </select>
</div>

<script is:inline>
  (function() {
    function handleLangChange(e) {
      var targetLang = e.target.value;
      var rawPath = window.location.pathname || '/';
      // Normalize path
      var cleanPath = rawPath.replace(/\.html$/, '');
      if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
        cleanPath = cleanPath.slice(0, -1);
      }

      var supported = ['es', 'de', 'fr', 'ja', 'pt', 'ko', 'ru', 'zh-tw', 'it'];
      var basePath = cleanPath;

      for (var i = 0; i < supported.length; i++) {
        var loc = supported[i];
        if (basePath === '/' + loc) {
          basePath = '/';
          break;
        } else if (basePath.startsWith('/' + loc + '/')) {
          basePath = basePath.substring(loc.length + 1);
          break;
        }
      }

      if (!basePath.startsWith('/')) {
        basePath = '/' + basePath;
      }

      var destination = '/';
      if (targetLang === 'en') {
        destination = basePath;
      } else {
        destination = (basePath === '/') ? ('/' + targetLang) : ('/' + targetLang + basePath);
      }

      // Preserve search params and hash if present
      var search = window.location.search || '';
      var hash = window.location.hash || '';
      window.location.assign(destination + search + hash);
    }

    function initLangSelectors() {
      var selects = document.querySelectorAll('.lang-select');
      selects.forEach(function(select) {
        if (select.dataset.i18nBound === 'true') return;
        select.dataset.i18nBound = 'true';
        select.addEventListener('change', handleLangChange);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLangSelectors);
    } else {
      initLangSelectors();
    }
    document.addEventListener('astro:page-load', initLangSelectors);
  })();
</script>

<style>
  .lang-selector-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .lang-select {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 500;
    padding: 0.35rem 0.625rem;
    cursor: pointer;
    outline: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .lang-select:hover, .lang-select:focus {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }
</style>
