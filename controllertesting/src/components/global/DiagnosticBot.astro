---
/**
 * DiagnosticBot.astro
 * Impeccable Diagnostic Routing Assistant.
 * Global-scoped CSS prevents Astro hydration/scoping mismatch on dynamic elements.
 */
---
<div id="ct-bot-container" class="ct-bot-container">
  <!-- Assistant Window -->
  <div id="ct-bot-window" class="ct-bot-window" aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="ct-bot-title">
    
    <!-- Top Header -->
    <div class="ct-bot-header">
      <div class="ct-bot-header-left">
        <div class="ct-bot-live-indicator">
          <span class="live-dot"></span>
          <span class="live-ping"></span>
        </div>
        <div class="ct-bot-header-text">
          <span id="ct-bot-title" class="ct-bot-title">Hardware Diagnostic</span>
          <span class="ct-bot-subtitle">Interactive Guide</span>
        </div>
      </div>
      <button id="ct-bot-close" class="ct-bot-close" aria-label="Close Assistant">
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Active Step Breadcrumb (Visible on sub-steps) -->
    <div id="ct-bot-breadcrumb-bar" class="ct-bot-breadcrumb-bar" style="display: none;">
      <button id="ct-bot-back-btn" class="ct-bot-back-btn" type="button" aria-label="Go back to device selection">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        <span>Back to devices</span>
      </button>
      <span id="ct-bot-crumb-tag" class="ct-bot-crumb-tag">Controller</span>
    </div>

    <!-- Body Area -->
    <div class="ct-bot-body">
      <div class="ct-bot-question-wrap">
        <h3 id="ct-bot-question" class="ct-bot-question" aria-live="polite">
          What hardware are you testing today?
        </h3>
        <p id="ct-bot-hint" class="ct-bot-hint">Select a device category to see recommended diagnostic tools</p>
      </div>

      <!-- Decision Cards Container -->
      <div id="ct-bot-options" class="ct-bot-options" role="menu" aria-live="polite">
        <!-- Dynamically rendered via JS -->
      </div>
    </div>

    <!-- Footer Action Bar -->
    <div class="ct-bot-footer">
      <div class="ct-bot-footer-info">
        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span>Press <kbd>Cmd</kbd>+<kbd>K</kbd> for all 39 tools</span>
      </div>
      <a href="/test/controller/full-diagnostic" class="ct-bot-footer-link">Full Wizard →</a>
    </div>

  </div>

  <!-- Trigger Button -->
  <button id="ct-bot-trigger" class="ct-bot-trigger" aria-label="Open Hardware Diagnostic Assistant" aria-expanded="false" aria-controls="ct-bot-window">
    <div class="ct-bot-trigger-content">
      <div class="trigger-icon-wrap">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="6" width="20" height="12" rx="4"/>
          <path d="M6 12h4M8 10v4"/>
          <circle cx="15" cy="11" r="1"/>
          <circle cx="18" cy="13" r="1"/>
        </svg>
      </div>
      <span class="trigger-label">Hardware Guide</span>
      <span class="trigger-badge">39 Tests</span>
    </div>
  </button>
</div>

<script>
  interface BotOption {
    id?: string;
    label: string;
    desc: string;
    badge?: string;
    iconSvg: string;
    link?: string;
    next?: string;
  }

  interface BotNode {
    title: string;
    hint: string;
    crumb?: string;
    options: BotOption[];
  }

  const ICONS = {
    gamepad: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="4"/><path d="M6 12h4M8 10v4"/><circle cx="15" cy="11" r="1" fill="currentColor"/><circle cx="18" cy="13" r="1" fill="currentColor"/></svg>`,
    mouse: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="7"/><path d="M12 2v6"/></svg>`,
    keyboard: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>`,
    audio: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>`,
    stick: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>`,
    drift: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16 8-8 8M16 16V8H8"/></svg>`,
    wizard: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
    buttons: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="2"/><circle cx="15" cy="15" r="2"/><circle cx="15" cy="9" r="2"/><circle cx="9" cy="15" r="2"/></svg>`,
    hz: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    circularity: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    click: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
    scroll: `<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="6"/><path d="M12 7v4"/></svg>`,
    arrowRight: `<svg aria-hidden="true" class="opt-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>`
  };

  const BOT_DATA: Record<string, BotNode> = {
    start: {
      title: "What hardware are you testing?",
      hint: "Choose your peripheral type to view targeted diagnostics",
      options: [
        {
          id: "controller",
          label: "Controller / Gamepad",
          desc: "PS5 DualSense, Xbox Wireless, Switch Pro, Joy-Con",
          badge: "22 Tests",
          iconSvg: ICONS.gamepad,
          next: "controller"
        },
        {
          id: "mouse",
          label: "Mouse & Pointer",
          desc: "Double-click chatter, 8KHz polling rate, scroll wheel",
          badge: "8 Tests",
          iconSvg: ICONS.mouse,
          next: "mouse"
        },
        {
          id: "keyboard",
          label: "Mechanical Keyboard",
          desc: "Key rollover, switch debounce, ghosting matrix",
          badge: "Direct Tool",
          iconSvg: ICONS.keyboard,
          link: "/keyboard-tester/ansi-100"
        },
        {
          id: "audio",
          label: "Headset & Spatial Audio",
          desc: "3D binaural radar, mic meter, Bluetooth delay",
          badge: "WebAudio",
          iconSvg: ICONS.audio,
          link: "/audio-test/spatial-radar"
        },
        {
          id: "arcade",
          label: "Fight Stick / HOTAS",
          desc: "Capcom SOCD cleaner rules, 128+ button quadrant",
          badge: "Specialized",
          iconSvg: ICONS.stick,
          link: "/test/controller/fight-stick"
        }
      ]
    },
    controller: {
      title: "Select a Controller Diagnostic",
      hint: "Targeted hardware checks using native browser Gamepad API",
      crumb: "Controllers",
      options: [
        {
          label: "Stick Drift Detector",
          desc: "Sub-0.1% drift visualizer & real-time deadzone tuning",
          badge: "Most Popular",
          iconSvg: ICONS.drift,
          link: "/test/controller/drift"
        },
        {
          label: "Full 5-Step Diagnostic",
          desc: "Automated scan of sticks, triggers, buttons & latency",
          badge: "Recommended",
          iconSvg: ICONS.wizard,
          link: "/test/controller/full-diagnostic"
        },
        {
          label: "Controller Health Score™",
          desc: "0–100 condition grade with shareable PDF report",
          badge: "Passport",
          iconSvg: ICONS.circularity,
          link: "/test/controller/health-score"
        },
        {
          label: "Button & Trigger Matrix",
          desc: "Face buttons, D-pad diagonals & analog L2/R2 curves",
          badge: "Precision",
          iconSvg: ICONS.buttons,
          link: "/test/controller/buttons"
        },
        {
          label: "Polling Rate & Latency",
          desc: "Real-time input report frequency in Hz and delay in ms",
          badge: "Esports",
          iconSvg: ICONS.hz,
          link: "/test/controller/polling-rate"
        }
      ]
    },
    mouse: {
      title: "Select a Mouse Diagnostic",
      hint: "Microsecond timing & hardware switch verification",
      crumb: "Mouse Tools",
      options: [
        {
          label: "Double-Click Fault Test",
          desc: "Detect switch chatter and mechanical bounce errors",
          badge: "Critical",
          iconSvg: ICONS.click,
          link: "/test/mouse/double-click"
        },
        {
          label: "Polling Rate Checker (Hz)",
          desc: "High-precision frequency counter up to 8000Hz (8KHz)",
          badge: "8KHz Ready",
          iconSvg: ICONS.hz,
          link: "/test/mouse/polling-rate"
        },
        {
          label: "Scroll Wheel Jumping Test",
          desc: "Verify optical/mechanical encoder step consistency",
          badge: "Encoder",
          iconSvg: ICONS.scroll,
          link: "/test/mouse/scroll"
        },
        {
          label: "CPS & Click Latency Test",
          desc: "Clicks-per-second burst test & response delay timer",
          badge: "Benchmark",
          iconSvg: ICONS.stick,
          link: "/test/mouse/cps"
        }
      ]
    }
  };

  class DiagnosticBotController {
    container: HTMLElement | null;
    window: HTMLElement | null;
    trigger: HTMLElement | null;
    closeBtn: HTMLElement | null;
    backBtn: HTMLElement | null;
    breadcrumbBar: HTMLElement | null;
    crumbTag: HTMLElement | null;
    questionEl: HTMLElement | null;
    hintEl: HTMLElement | null;
    optionsArea: HTMLElement | null;
    currentNode: string = "start";
    isOpen: boolean = false;

    constructor() {
      this.container = document.getElementById("ct-bot-container");
      this.window = document.getElementById("ct-bot-window");
      this.trigger = document.getElementById("ct-bot-trigger");
      this.closeBtn = document.getElementById("ct-bot-close");
      this.backBtn = document.getElementById("ct-bot-back-btn");
      this.breadcrumbBar = document.getElementById("ct-bot-breadcrumb-bar");
      this.crumbTag = document.getElementById("ct-bot-crumb-tag");
      this.questionEl = document.getElementById("ct-bot-question");
      this.hintEl = document.getElementById("ct-bot-hint");
      this.optionsArea = document.getElementById("ct-bot-options");

      this.init();
    }

    init() {
      if (!this.container || !this.window || !this.trigger) return;

      this.trigger.addEventListener("click", () => this.toggle());
      this.closeBtn?.addEventListener("click", () => this.close());
      this.backBtn?.addEventListener("click", () => this.render("start"));

      // Keyboard ESC handling
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && this.isOpen) {
          this.close();
          this.trigger?.focus();
        }
      });

      // Render initial node
      this.render("start");

      // Soft pulse animation after 3s to indicate presence
      setTimeout(() => {
        if (!this.isOpen && !sessionStorage.getItem("ct_bot_seen")) {
          this.trigger?.classList.add("ct-pulse-attention");
        }
      }, 3000);
    }

    toggle() {
      this.isOpen ? this.close() : this.open();
    }

    open() {
      this.isOpen = true;
      this.window?.removeAttribute("aria-hidden");
      this.window?.removeAttribute("inert");
      this.window?.classList.add("is-open");
      this.trigger?.classList.remove("ct-pulse-attention");
      this.trigger?.setAttribute("aria-expanded", "true");
      sessionStorage.setItem("ct_bot_seen", "true");

      setTimeout(() => {
        const firstBtn = this.optionsArea?.querySelector("button, a") as HTMLElement;
        firstBtn?.focus();
      }, 80);
    }

    close() {
      this.isOpen = false;
      this.window?.setAttribute("aria-hidden", "true");
      this.window?.setAttribute("inert", "");
      this.window?.classList.remove("is-open");
      this.trigger?.setAttribute("aria-expanded", "false");
    }

    render(nodeKey: string) {
      const node = BOT_DATA[nodeKey];
      if (!node || !this.questionEl || !this.hintEl || !this.optionsArea) return;

      this.currentNode = nodeKey;

      // Update Breadcrumb
      if (nodeKey === "start") {
        if (this.breadcrumbBar) this.breadcrumbBar.style.display = "none";
      } else {
        if (this.breadcrumbBar) this.breadcrumbBar.style.display = "flex";
        if (this.crumbTag && node.crumb) this.crumbTag.textContent = node.crumb;
      }

      // Update Headings
      this.questionEl.textContent = node.title;
      this.hintEl.textContent = node.hint;

      // Render Options
      this.optionsArea.innerHTML = "";

      node.options.forEach((opt, idx) => {
        const isLink = !!opt.link;
        const el = document.createElement(isLink ? "a" : "button") as HTMLElement;
        el.className = "ct-bot-card";
        el.setAttribute("role", "menuitem");
        el.style.animationDelay = `${idx * 40}ms`;

        if (isLink && opt.link) {
          (el as HTMLAnchorElement).href = opt.link;
        } else {
          (el as HTMLButtonElement).type = "button";
        }

        el.innerHTML = `
          <div class="ct-bot-card-icon">
            ${opt.iconSvg}
          </div>
          <div class="ct-bot-card-main">
            <div class="ct-bot-card-title-row">
              <span class="ct-bot-card-label">${opt.label}</span>
              ${opt.badge ? `<span class="ct-bot-card-badge">${opt.badge}</span>` : ""}
            </div>
            <p class="ct-bot-card-desc">${opt.desc}</p>
          </div>
          <div class="ct-bot-card-arrow" aria-hidden="true">
            ${ICONS.arrowRight}
          </div>
        `;

        if (!isLink && opt.next) {
          el.addEventListener("click", () => {
            this.render(opt.next!);
          });
        }

        this.optionsArea?.appendChild(el);
      });

      // Auto-focus first item on view change if currently open
      if (this.isOpen) {
        const firstBtn = this.optionsArea.querySelector("button, a") as HTMLElement;
        firstBtn?.focus();
      }
    }
  }

  // Initialize safely across Astro view transitions & standard DOM ready
  const initBot = () => new DiagnosticBotController();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBot);
  } else {
    initBot();
  }
  document.addEventListener("astro:page-load", initBot);
</script>

<style is:global>
  /* ==========================================================================
     DIAGNOSTIC BOT CONTAINER & TRIGGER
     ========================================================================== */
  .ct-bot-container {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-family: var(--font-sans, "Geist Sans", system-ui, -apple-system, sans-serif);
    pointer-events: none;
  }

  /* ── Floating Trigger Button ── */
  .ct-bot-trigger {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.875rem 0.5rem 0.625rem;
    background: #0d131f;
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 9999px;
    color: #f8fafc;
    cursor: pointer;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.7), 0 0 20px -5px rgba(37, 99, 235, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.25s ease, opacity 0.2s ease;
    outline: none;
    user-select: none;
  }

  .ct-bot-trigger:hover {
    transform: translateY(-2px) scale(1.02);
    border-color: rgba(59, 130, 246, 0.7);
    box-shadow: 0 14px 35px -5px rgba(0, 0, 0, 0.8), 0 0 25px -4px rgba(37, 99, 235, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .ct-bot-trigger:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
  }

  .ct-bot-trigger[aria-expanded="true"] {
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.95);
  }

  .ct-bot-trigger-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trigger-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.5);
  }

  .trigger-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #f1f5f9;
  }

  .trigger-badge {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.125rem 0.45rem;
    border-radius: 9999px;
    background: rgba(37, 99, 235, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  /* Attention pulse */
  .ct-pulse-attention {
    animation: ctTriggerGlow 2.5s infinite;
  }
  @keyframes ctTriggerGlow {
    0% { box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.7), 0 0 0 0 rgba(37, 99, 235, 0.6); }
    70% { box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.7), 0 0 0 10px rgba(37, 99, 235, 0); }
    100% { box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.7), 0 0 0 0 rgba(37, 99, 235, 0); }
  }

  /* ==========================================================================
     MAIN ASSISTANT WINDOW
     ========================================================================== */
  .ct-bot-window {
    pointer-events: auto;
    position: absolute;
    bottom: 0;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 2rem);
    max-height: calc(100vh - 4rem);
    background: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.9), 0 0 35px -10px rgba(37, 99, 235, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(16px) scale(0.96);
    transform-origin: bottom right;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ct-bot-window.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  /* ── Header ── */
  .ct-bot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 1.25rem 0.875rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, transparent 100%);
  }

  .ct-bot-header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ct-bot-live-indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .live-ping {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid #10b981;
    opacity: 0.6;
    animation: livePing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes livePing {
    0% { transform: scale(0.8); opacity: 0.8; }
    80%, 100% { transform: scale(1.8); opacity: 0; }
  }

  .ct-bot-header-text {
    display: flex;
    flex-direction: column;
  }

  .ct-bot-title {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .ct-bot-subtitle {
    font-family: var(--font-mono, "Geist Mono", monospace);
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
    margin-top: 0.0625rem;
  }

  .ct-bot-close {
    display: flex;
