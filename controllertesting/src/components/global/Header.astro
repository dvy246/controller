---
import { getLangFromUrl } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const l = (path: string) =>
  currentLang === 'en' ? path : path === '/' ? `/${currentLang}` : `/${currentLang}${path}`;

/**
 * Header.astro — ControllerTesting.com
 * Single-line nav, max 72px height, floating with backdrop blur.
 * Flagship SaaS redesign: translucent frosted glass, metallic hairline border,
 * liquid aurora glow layer, magnetic hover states with dots & Geist Mono badges,
 * elevated Cmd+K search trigger, and smooth animated mobile drawer.
 */

import LanguageSelector from './LanguageSelector.astro';
import { GAMES } from '../../data/arcadeInterlinks';
const gameEntries = Object.entries(GAMES);

const gameAccents: Record<string, { bg: string; border: string; color: string }> = {
  'stick-sniper': { bg: 'rgba(239, 68, 68, 0.12)', border: 'rgba(239, 68, 68, 0.3)', color: '#EF4444' },
  'button-blitz': { bg: 'rgba(245, 158, 11, 0.12)', border: 'rgba(245, 158, 11, 0.3)', color: '#F59E0B' },
  'stick-maze': { bg: 'rgba(139, 92, 246, 0.12)', border: 'rgba(139, 92, 246, 0.3)', color: '#8B5CF6' },
  'trigger-racer': { bg: 'rgba(16, 185, 129, 0.12)', border: 'rgba(16, 185, 129, 0.3)', color: '#10B981' },
  'quick-draw': { bg: 'rgba(6, 182, 212, 0.12)', border: 'rgba(6, 182, 212, 0.3)', color: '#06B6D4' },
  'nova-blaster': { bg: 'rgba(249, 115, 22, 0.12)', border: 'rgba(249, 115, 22, 0.3)', color: '#F97316' },
  'beat-drop': { bg: 'rgba(236, 72, 153, 0.12)', border: 'rgba(236, 72, 153, 0.3)', color: '#EC4899' },
  'memory-pulse': { bg: 'rgba(99, 102, 241, 0.12)', border: 'rgba(99, 102, 241, 0.3)', color: '#6366F1' },
  'asteroid-dash': { bg: 'rgba(59, 130, 246, 0.12)', border: 'rgba(59, 130, 246, 0.3)', color: '#3B82F6' },
  'combo-rush': { bg: 'rgba(168, 85, 247, 0.12)', border: 'rgba(168, 85, 247, 0.3)', color: '#A855F7' },
  'neon-striker': { bg: 'rgba(217, 70, 239, 0.12)', border: 'rgba(217, 70, 239, 0.3)', color: '#D946EF' },
  'kart-drift': { bg: 'rgba(20, 184, 166, 0.12)', border: 'rgba(20, 184, 166, 0.3)', color: '#14B8A6' },
  'signal-salvage': { bg: 'rgba(34, 197, 94, 0.12)', border: 'rgba(34, 197, 94, 0.3)', color: '#22C55E' },
};
---

<header class="site-header" role="banner">
  {/* ── Scroll progress hairline (CSS scroll-driven, compositor-only) ── */}
  <div class="scroll-progress" aria-hidden="true"></div>

  {/* ── Liquid purple aurora layer (decorative, non-interactive) ── */}
  <div class="header-aurora" aria-hidden="true">
    <span class="aurora-blob blob-1"></span>
    <span class="aurora-blob blob-2"></span>
    <span class="aurora-blob blob-3"></span>
    <span class="aurora-blob blob-4"></span>
    <span class="aurora-line"></span>
  </div>



  <nav class="site-nav" aria-label="Main navigation">
    <div class="nav-inner">

      {/* ── Logo ── */}
      <a href={l('/')} class="nav-logo" aria-label="ControllerTesting.com home">
        <div class="logo-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <defs>
              <linearGradient id="g-nav-logo" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#2563EB"/>
                <stop offset="100%" stop-color="#7C3AED"/>
              </linearGradient>
            </defs>
            <rect width="28" height="28" rx="7" fill="url(#g-nav-logo)"/>
            <path d="M8 14c0-3.314 2.686-6 6-6s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="#FFFFFF" stroke-width="1.5" fill="none"/>
            <circle cx="14" cy="14" r="2" fill="#10B981"/>
            <path d="M14 8v2M14 18v2M8 14h2M18 14h2" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="logo-glow" aria-hidden="true"></span>
        </div>
        <span class="nav-logo-text">
          Controller<span class="logo-accent">Testing</span>
        </span>
      </a>

      {/* ── Primary Nav Links & Dropdowns ── */}
      <ul class="nav-links" role="list">
        <!-- Diagnostics Dropdown -->
        <li class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            <span class="nav-dot" aria-hidden="true"></span>
            Tools
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="dropdown-menu" role="menu" aria-label="Diagnostics">
            <div class="dropdown-grid">
              <div class="dropdown-column">
                <span class="dropdown-category">Diagnostic Tools</span>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller')}>
                  <div class="dropdown-item-icon" style="background: rgba(59, 130, 246, 0.12); border-color: rgba(59, 130, 246, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="nav-ctrl" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3B82F6"/><stop offset="100%" stop-color="#60A5FA"/></linearGradient></defs><rect x="2" y="6" width="20" height="12" rx="4" fill="url(#nav-ctrl)" fill-opacity="0.25" stroke="#3B82F6" stroke-width="2"/><path d="M6 12h4M8 10v4" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/><circle cx="15" cy="11" r="1.5" fill="#EF4444"/><circle cx="18" cy="13" r="1.5" fill="#10B981"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Controller Tests
                      <span class="nav-badge badge-core">Core</span>
                    </div>
                    <span class="dropdown-item-desc">Stick drift, circularity &amp; input latency</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/drift')}>
                  <div class="dropdown-item-icon" style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#10B981" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="#10B981" fill-opacity="0.3" stroke="#34D399" stroke-width="1.5"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#34D399" stroke-width="2" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Stick Drift Test
                      <span class="nav-badge badge-speed">Hot</span>
                    </div>
                    <span class="dropdown-item-desc">High-precision 0.1% drift detection</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/mouse')}>
                  <div class="dropdown-item-icon" style="background: rgba(6, 182, 212, 0.12); border-color: rgba(6, 182, 212, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="nav-ms" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#06B6D4"/><stop offset="100%" stop-color="#10B981"/></linearGradient></defs><rect x="6" y="3" width="12" height="18" rx="6" fill="url(#nav-ms)" fill-opacity="0.25" stroke="#06B6D4" stroke-width="2"/><line x1="12" y1="7" x2="12" y2="11" stroke="#10B981" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Mouse Suite
                      <span class="nav-badge badge-precision">8KHz</span>
                    </div>
                    <span class="dropdown-item-desc">CPS, polling rate, DPI &amp; double-click</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/keyboard')}>
                  <div class="dropdown-item-icon" style="background: rgba(139, 92, 246, 0.12); border-color: rgba(139, 92, 246, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="nav-kb" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#8B5CF6"/><stop offset="100%" stop-color="#EC4899"/></linearGradient></defs><rect x="2" y="4" width="20" height="16" rx="3" fill="url(#nav-kb)" fill-opacity="0.25" stroke="#8B5CF6" stroke-width="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M8 16h8" stroke="#EC4899" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Keyboard &amp; MIDI
                      <span class="nav-badge badge-midi">WebMIDI</span>
                    </div>
                    <span class="dropdown-item-desc">NKRO matrix &amp; MIDI velocity</span>
                  </div>
                </a>
              </div>
              
              <div class="dropdown-column">
                <span class="dropdown-category">Wizards &amp; Telemetry</span>
                <a role="menuitem" class="dropdown-item dropdown-item-featured" href={l('/test/controller/full-diagnostic')}>
                  <div class="dropdown-item-icon" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.35);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><defs><linearGradient id="nav-diag" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#F59E0B"/><stop offset="100%" stop-color="#EF4444"/></linearGradient></defs><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="url(#nav-diag)" fill-opacity="0.3" stroke="#F59E0B" stroke-width="2" stroke-linejoin="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Full Diagnostic Wizard
                      <span class="nav-badge badge-pro">PRO</span>
                    </div>
                    <span class="dropdown-item-desc">5-step hardware checkup &amp; score</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/quick-health')}>
                  <div class="dropdown-item-icon" style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M22 12h-4l-3 9L9 3l-3 9H2" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Quick Health Check
                      <span class="nav-badge badge-speed">60s</span>
                    </div>
                    <span class="dropdown-item-desc">Instant hardware status grade</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/passport')}>
                  <div class="dropdown-item-icon" style="background: rgba(99, 102, 241, 0.12); border-color: rgba(99, 102, 241, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="#6366F1" fill-opacity="0.2" stroke="#6366F1" stroke-width="2"/><polyline points="14 2 14 8 20 8" stroke="#818CF8" stroke-width="2"/><path d="M16 13H8M16 17H8M10 9H8" stroke="#A5B4FC" stroke-width="2" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Controller Passport
                      <span class="nav-badge badge-live">Live</span>
                    </div>
                    <span class="dropdown-item-desc">Verifiable hardware evidence report</span>
                  </div>
                </a>
              </div>
              <div class="dropdown-column">
                <span class="dropdown-category">Advanced Diagnostics</span>
                <a role="menuitem" class="dropdown-item" href={l('/calibrate/dualsense/hall-effect')}>
                  <div class="dropdown-item-icon" style="background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 11V3" stroke="#38BDF8" stroke-width="2" stroke-linecap="round"/><circle cx="4" cy="12" r="2.5" fill="#38BDF8"/><circle cx="12" cy="10" r="2.5" fill="#818CF8"/><circle cx="20" cy="14" r="2.5" fill="#C084FC"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      WebHID Calibrator
                      <span class="nav-badge badge-pass">New</span>
                    </div>
                    <span class="dropdown-item-desc">Hardware zero-point reset</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/deadzone-calculator/apex-legends/ps5')}>
                  <div class="dropdown-item-icon" style="background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#EF4444" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="#F59E0B" fill-opacity="0.3" stroke="#F59E0B" stroke-width="1.5"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="#EF4444" stroke-width="1.5"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Deadzone Sandbox</div>
                    <span class="dropdown-item-desc">Game-engine specific tuning</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/overclock-validator/ps5/usb-c')}>
                  <div class="dropdown-item-icon" style="background: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#FACC15" stroke-width="2"/><polyline points="12 6 12 12 16 14" stroke="#00F2FE" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Overclock Validator</div>
                    <span class="dropdown-item-desc">Observed Hz &amp; input latency</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/haptics/unreal/explosion')}>
                  <div class="dropdown-item-icon" style="background: rgba(236, 72, 153, 0.12); border-color: rgba(236, 72, 153, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M2 12h2M6 8v8M10 4v16M14 6v12M18 9v6M22 12h-2" stroke="#EC4899" stroke-width="2.5" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Haptic Composer</div>
                    <span class="dropdown-item-desc">WebAudio rumble generation</span>
                  </div>
                </a>
              </div>
              <div class="dropdown-column">
                <span class="dropdown-category">Niche Testers</span>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/nintendo-switch')}>
                  <div class="dropdown-item-icon" style="background: rgba(230, 0, 18, 0.15); border-color: rgba(230, 0, 18, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="12" rx="4" fill="#E60012" fill-opacity="0.2" stroke="#E60012" stroke-width="2"/><circle cx="8" cy="12" r="2" fill="#E60012"/><circle cx="16" cy="12" r="2" fill="#00C3E3"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Nintendo Switch</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/ps5')}>
                  <div class="dropdown-item-icon" style="background: rgba(37, 99, 235, 0.15); border-color: rgba(37, 99, 235, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="12" rx="4" fill="#2563EB" fill-opacity="0.2" stroke="#2563EB" stroke-width="2"/><path d="M6 12h4M8 10v4" stroke="#60A5FA" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="12" r="1.5" fill="#3B82F6"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">PS5 DualSense</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/xbox')}>
                  <div class="dropdown-item-icon" style="background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="12" rx="4" fill="#10B981" fill-opacity="0.2" stroke="#10B981" stroke-width="2"/><circle cx="8" cy="12" r="2" fill="#10B981"/><circle cx="16" cy="12" r="2" fill="#34D399"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Xbox Controller</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/joycon')}>
                  <div class="dropdown-item-icon" style="background: rgba(244, 63, 94, 0.15); border-color: rgba(244, 63, 94, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="6" y="2" width="12" height="20" rx="6" fill="#F43F5E" fill-opacity="0.2" stroke="#F43F5E" stroke-width="2"/><circle cx="12" cy="8" r="2" fill="#F43F5E"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Joy-Con</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/switch-pro')}>
                  <div class="dropdown-item-icon" style="background: rgba(124, 58, 237, 0.15); border-color: rgba(124, 58, 237, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="6" width="20" height="12" rx="4" fill="#7C3AED" fill-opacity="0.2" stroke="#7C3AED" stroke-width="2"/><path d="M6 12h4M8 10v4" stroke="#A855F7" stroke-width="2" stroke-linecap="round"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Switch Pro</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/joystick-tester')}>
                  <div class="dropdown-item-icon" style="background: rgba(249, 115, 22, 0.15); border-color: rgba(249, 115, 22, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 2v14" stroke="#F97316" stroke-width="3" stroke-linecap="round"/><circle cx="12" cy="20" r="3" fill="#F59E0B"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Joystick Tester</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href={l('/test/controller/gamepad-mapping')}>
                  <div class="dropdown-item-icon" style="background: rgba(139, 92, 246, 0.15); border-color: rgba(139, 92, 246, 0.3);" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><polygon points="12 2 2 7 12 12 22 7 12 2" fill="#8B5CF6" fill-opacity="0.3" stroke="#8B5CF6" stroke-width="2"/><polyline points="2 17 12 22 22 17" stroke="#EC4899" stroke-width="2"/><polyline points="2 12 12 17 22 12" stroke="#06B6D4" stroke-width="2"/></svg>
                  </div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Gamepad Mapping</div>
                  </div>
                </a>
              </div>
            </div>
            <div class="dropdown-footer">
              <a role="menuitem" class="dropdown-footer-link" href={l('/tools')}>
                <span>View All 39 Diagnostic Tools</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </li>




        <!-- Play Dropdown -->
        <li class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            <span class="nav-dot" aria-hidden="true"></span>
            Play
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="dropdown-menu" role="menu" aria-label="Arcade Games">
            <div class="dropdown-grid dropdown-grid-games">
              {
                [
                  [
                    { label: 'Aim & Control', games: ['stick-sniper', 'stick-maze', 'trigger-racer', 'nova-blaster'] },
                    { label: 'Combo & Arcade', games: ['combo-rush', 'kart-drift'] },
                  ],
                  [
                    { label: 'Reflex & Timing', games: ['button-blitz', 'quick-draw', 'beat-drop', 'memory-pulse', 'asteroid-dash'] },
                    { label: 'Party & Multiplayer', games: ['neon-striker', 'signal-salvage'] },
                  ],
                ].map((groups) => (
                  <div class="dropdown-column">
                    {
                      groups.map((group) => (
                        <>
                          <span class="dropdown-category">{group.label}</span>
                          {
                            group.games.map((slug) => {
                              const game = GAMES[slug];
                              const acc = gameAccents[slug] || gameAccents['stick-sniper'];
                              return (
                                <a role="menuitem" class="dropdown-item" href={l(game.href)}>
                                  <div class="dropdown-item-icon" style={`background: ${acc.bg}; border-color: ${acc.border};`} aria-hidden="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={acc.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                      <path d="M6 11h4M8 9v4" />
