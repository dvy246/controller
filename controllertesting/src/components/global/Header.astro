---
/**
 * Header.astro — ControllerTesting.com
 * Single-line nav, max 72px height, floating with backdrop blur.
 * Flagship SaaS redesign: translucent frosted glass, metallic hairline border,
 * liquid aurora glow layer, magnetic hover states with dots & Geist Mono badges,
 * elevated Cmd+K search trigger, and smooth animated mobile drawer.
 */

import LanguageSelector from './LanguageSelector.astro';
---

<header class="site-header" role="banner">
  {/* ── Scroll progress hairline (CSS scroll-driven, compositor-only) ── */}
  <div class="scroll-progress" aria-hidden="true"></div>

  {/* ── Liquid purple aurora layer (decorative, non-interactive) ── */}
  <div class="header-aurora" aria-hidden="true">
    <span class="aurora-blob blob-1"></span>
    <span class="aurora-blob blob-2"></span>
    <span class="aurora-blob blob-3"></span>
    <span class="aurora-blob blob-4"></span>
    <span class="aurora-line"></span>
  </div>

  <nav class="site-nav" aria-label="Main navigation">
    <div class="nav-inner">

      {/* ── Logo ── */}
      <a href="/" class="nav-logo" aria-label="ControllerTesting.com home">
        <div class="logo-icon-wrapper">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect width="28" height="28" rx="7" fill="var(--color-accent)"/>
            <path d="M8 14c0-3.314 2.686-6 6-6s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="var(--color-text-inverse)" stroke-width="1.5" fill="none"/>
            <circle cx="14" cy="14" r="2" fill="var(--color-pass)"/>
            <path d="M14 8v2M14 18v2M8 14h2M18 14h2" stroke="var(--color-text-inverse)" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="logo-glow" aria-hidden="true"></span>
        </div>
        <span class="nav-logo-text">
          Controller<span class="logo-accent">Testing</span>
        </span>
      </a>

      {/* ── Primary Nav Links & Dropdowns ── */}
      <ul class="nav-links" role="list">
        <!-- Diagnostics Dropdown -->
        <li class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            <span class="nav-dot" aria-hidden="true"></span>
            Diagnostics
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="dropdown-menu" role="menu" aria-label="Diagnostics">
            <div class="dropdown-grid">
              <div class="dropdown-column">
                <span class="dropdown-category">Diagnostic Tools</span>
                <a role="menuitem" class="dropdown-item" href="/test/controller">
                  <div class="dropdown-item-icon">🎮</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Controller Tests
                      <span class="nav-badge badge-core">Core</span>
                    </div>
                    <span class="dropdown-item-desc">Stick drift, circularity & input latency</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/mouse">
                  <div class="dropdown-item-icon">🖱️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Mouse Suite
                      <span class="nav-badge badge-precision">8KHz</span>
                    </div>
                    <span class="dropdown-item-desc">CPS, polling rate, DPI & double-click</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/keyboard">
                  <div class="dropdown-item-icon">⌨️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Keyboard &amp; MIDI
                      <span class="nav-badge badge-midi">WebMIDI</span>
                    </div>
                    <span class="dropdown-item-desc">NKRO matrix &amp; MIDI velocity</span>
                  </div>
                </a>
              </div>
              
              <div class="dropdown-column">
                <span class="dropdown-category">Wizards &amp; Telemetry</span>
                <a role="menuitem" class="dropdown-item dropdown-item-featured" href="/test/controller/full-diagnostic">
                  <div class="dropdown-item-icon">⚡</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Full Diagnostic Wizard
                      <span class="nav-badge badge-pro">PRO</span>
                    </div>
                    <span class="dropdown-item-desc">5-step hardware checkup &amp; score</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/quick-health">
                  <div class="dropdown-item-icon">🩺</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Quick Health Check
                      <span class="nav-badge badge-speed">60s</span>
                    </div>
                    <span class="dropdown-item-desc">Instant hardware status grade</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/passport">
                  <div class="dropdown-item-icon">📜</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      Controller Passport
                      <span class="nav-badge badge-live">Live</span>
                    </div>
                    <span class="dropdown-item-desc">Verifiable hardware evidence report</span>
                  </div>
                </a>
              </div>
              <div class="dropdown-column">
                <span class="dropdown-category">Advanced Diagnostics</span>
                <a role="menuitem" class="dropdown-item" href="/calibrate/dualsense/hall-effect">
                  <div class="dropdown-item-icon">🎛️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">
                      WebHID Calibrator
                      <span class="nav-badge badge-pass">New</span>
                    </div>
                    <span class="dropdown-item-desc">Hardware zero-point reset</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/deadzone-calculator/apex-legends/ps5">
                  <div class="dropdown-item-icon">🎯</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Deadzone Sandbox</div>
                    <span class="dropdown-item-desc">Game-engine specific tuning</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/overclock-validator/ps5/usb-c">
                  <div class="dropdown-item-icon">⏱️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Overclock Validator</div>
                    <span class="dropdown-item-desc">True Hz & input latency</span>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/haptics/unreal/explosion">
                  <div class="dropdown-item-icon">📳</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Haptic Composer</div>
                    <span class="dropdown-item-desc">WebAudio rumble generation</span>
                  </div>
                </a>
              </div>
              <div class="dropdown-column">
                <span class="dropdown-category">Niche Testers</span>
                <a role="menuitem" class="dropdown-item" href="/test/controller/nintendo-switch">
                  <div class="dropdown-item-icon">🎮</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Nintendo Switch</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/ps5">
                  <div class="dropdown-item-icon">🎮</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">PS5 DualSense</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/xbox">
                  <div class="dropdown-item-icon">🎮</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Xbox Controller</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/joycon">
                  <div class="dropdown-item-icon">🕹️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Joy-Con</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/switch-pro">
                  <div class="dropdown-item-icon">🎮</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Switch Pro</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/joystick-tester">
                  <div class="dropdown-item-icon">🕹️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Joystick Tester</div>
                  </div>
                </a>
                <a role="menuitem" class="dropdown-item" href="/test/controller/gamepad-mapping">
                  <div class="dropdown-item-icon">🎛️</div>
                  <div class="dropdown-item-content">
                    <div class="dropdown-item-title">Gamepad Mapping</div>
                  </div>
                </a>
              </div>
            </div>
            <div class="dropdown-footer">
              <a role="menuitem" class="dropdown-footer-link" href="/tools">
                <span>View All 32 Diagnostic Tools</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        </li>

        <!-- Play Direct Link -->
        <li class="nav-link-wrap">
          <a href="/games" class="nav-link">
            <span class="nav-dot" aria-hidden="true"></span>
            Play
            <span class="nav-badge badge-games">Arcade</span>
          </a>
        </li>

        <!-- Resources Dropdown -->
        <li class="nav-dropdown">
          <button type="button" class="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false">
            <span class="nav-dot" aria-hidden="true"></span>
            Resources
            <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="dropdown-menu dropdown-menu-single" role="menu" aria-label="Resources">
            <a role="menuitem" class="dropdown-item" href="/fix-or-replace">
              <div class="dropdown-item-icon">🛠️</div>
              <div class="dropdown-item-content">
                <div class="dropdown-item-title">Fix &amp; Repair</div>
                <span class="dropdown-item-desc">Repair cost vs replacement decision calculator</span>
              </div>
            </a>
            <a role="menuitem" class="dropdown-item" href="/warranty">
              <div class="dropdown-item-icon">🛡️</div>
              <div class="dropdown-item-content">
                <div class="dropdown-item-title">Warranty Assistant</div>
                <span class="dropdown-item-desc">RMA eligibility checker &amp; claim evidence</span>
              </div>
            </a>
            <a role="menuitem" class="dropdown-item" href="/embeds">
              <div class="dropdown-item-icon">📦</div>
              <div class="dropdown-item-content">
                <div class="dropdown-item-title">
                  Widgets &amp; Embeds
                  <span class="nav-badge badge-widgets">15 Widgets</span>
                </div>
                <span class="dropdown-item-desc">Embed diagnostic widgets on your site</span>
              </div>
            </a>
            <a role="menuitem" class="dropdown-item" href="/compatibility">
              <div class="dropdown-item-icon">📊</div>
              <div class="dropdown-item-content">
                <div class="dropdown-item-title">Compatibility Matrix</div>
                <span class="dropdown-item-desc">Browser API support across OS &amp; controllers</span>
              </div>
            </a>
            <div class="dropdown-sep" role="separator"></div>
            <a role="menuitem" class="dropdown-item" href="/learn">
              <div class="dropdown-item-icon">📚</div>
              <div class="dropdown-item-content">
                <div class="dropdown-item-title">Learn Guides</div>
                <span class="dropdown-item-desc">Deep-dive technical repair &amp; tuning articles</span>
              </div>
            </a>
          </div>
        </li>
      </ul>

      {/* ── Right actions ── */}
      <div class="nav-actions">
        {/* Cmd+K Search trigger button */}
        <button
          type="button"
          class="nav-search-btn"
          aria-label="Search diagnostic tools (Cmd+K)"
          onclick="if(window.openGlobalSearch) window.openGlobalSearch()"
        >
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="search-btn-text">Search diagnostic tools...</span>
          <kbd class="search-btn-kbd" title="Press ⌘K or Ctrl+K to search">⌘K</kbd>
        </button>

        {/* Language selector */}
        <LanguageSelector />

        {/* Theme toggle slider */}
        <button
          id="theme-toggle"
          class="theme-switch"
          type="button"
          role="switch"
          aria-checked="true"
          aria-label="Toggle dark and light theme"
        >
          <span class="theme-track" aria-hidden="true">
            <svg class="track-icon track-sun" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <circle cx="12" cy="12" r="5"/>
              <path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <svg class="track-icon track-moon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <span class="theme-knob"></span>
          </span>
        </button>

        {/* Primary CTA */}
        <a href="/test/controller/full-diagnostic" class="btn-primary nav-cta">
          Run Diagnostic
        </a>

        {/* Mobile menu button */}
        <button
          class="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-toggle"
          type="button"
        >
          <span class="hamburger-box" aria-hidden="true">
            <span class="hamburger-line line-top"></span>
            <span class="hamburger-line line-mid"></span>
            <span class="hamburger-line line-bot"></span>
          </span>
        </button>
      </div>
    </div>
  </nav>

  {/* ── Mobile menu ── */}
  <div id="mobile-menu" class="mobile-menu" aria-hidden="true" hidden>
    <div class="mobile-menu-inner">
      <div class="mobile-search-wrapper">
        <button
          type="button"
          class="mobile-search-btn"
          onclick="if(window.openGlobalSearch) window.openGlobalSearch()"
        >
          <div class="mobile-search-content">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span>Search diagnostic tools...</span>
          </div>
          <kbd class="search-btn-kbd">⌘K</kbd>
        </button>
      </div>

      <div class="mobile-nav-grid">
        <div class="mobile-nav-section">
          <p class="mobile-nav-heading">Diagnostics</p>
          <ul role="list" class="mobile-nav-links">
            <li><a href="/test/controller" class="mobile-nav-link"><span>🎮 Controller Tests</span><span class="nav-badge badge-core">Core</span></a></li>
            <li><a href="/test/mouse" class="mobile-nav-link"><span>🖱️ Mouse Suite</span><span class="nav-badge badge-precision">8KHz</span></a></li>
            <li><a href="/test/keyboard" class="mobile-nav-link"><span>⌨️ Keyboard &amp; MIDI</span><span class="nav-badge badge-midi">WebMIDI</span></a></li>
            <li><a href="/test/controller/quick-health" class="mobile-nav-link mobile-nav-link-em"><span>🩺 Quick Health Check</span><span class="nav-badge badge-speed">60s</span></a></li>
            <li><a href="/test/controller/full-diagnostic" class="mobile-nav-link mobile-nav-link-em"><span>⚡ Full Diagnostic Wizard</span><span class="nav-badge badge-pro">PRO</span></a></li>
            <li><a href="/test/controller/passport" class="mobile-nav-link"><span>📜 Controller Passport</span></a></li>
            <li><a href="/calibrate/dualsense/hall-effect" class="mobile-nav-link"><span>🎛️ WebHID Calibrator</span></a></li>
            <li><a href="/deadzone-calculator/apex-legends/ps5" class="mobile-nav-link"><span>🎯 Deadzone Sandbox</span></a></li>
            <li><a href="/tools" class="mobile-nav-link"><span>🧰 All 32 Diagnostic Tools</span></a></li>
          </ul>
        </div>

        <div class="mobile-nav-section">
          <p class="mobile-nav-heading">Arcade Games</p>
          <ul role="list" class="mobile-nav-links">
            <li><a href="/games" class="mobile-nav-link"><span>🎯 Arcade Games</span><span class="nav-badge badge-games">5 Games</span></a></li>
          </ul>
        </div>

        <div class="mobile-nav-section">
          <p class="mobile-nav-heading">Resources</p>
          <ul role="list" class="mobile-nav-links">
            <li><a href="/fix-or-replace" class="mobile-nav-link"><span>🛠️ Fix &amp; Repair</span></a></li>
            <li><a href="/warranty" class="mobile-nav-link"><span>🛡️ Warranty Check</span></a></li>
            <li><a href="/embeds" class="mobile-nav-link"><span>📦 Widgets &amp; Embeds</span><span class="nav-badge badge-widgets">15 Widgets</span></a></li>
            <li><a href="/compatibility" class="mobile-nav-link"><span>📊 Compatibility Matrix</span></a></li>
            <li><a href="/learn" class="mobile-nav-link"><span>📚 Technical Learn Guides</span></a></li>
          </ul>
        </div>
      </div>

      <div class="mobile-cta-wrapper">
        <a href="/test/controller/full-diagnostic" class="btn-primary mobile-cta">
          Run Full Hardware Diagnostic
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    var btn = document.getElementById('mobile-menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        if (expanded) {
          menu.classList.remove('open');
          setTimeout(function() {
            menu.hidden = true;
            menu.setAttribute('aria-hidden', 'true');
          }, 220);
        } else {
          menu.hidden = false;
          menu.setAttribute('aria-hidden', 'false');
          void menu.offsetWidth;
          menu.classList.add('open');
        }
      });
      document.addEventListener('click', function(e) {
        if (!btn.contains(e.target) && !menu.contains(e.target)) {
          btn.setAttribute('aria-expanded', 'false');
          menu.classList.remove('open');
          setTimeout(function() {
            menu.hidden = true;
            menu.setAttribute('aria-hidden', 'true');
          }, 220);
        }
      });
    }

    /* Keep theme switch ARIA state in sync */
    var toggle = document.getElementById('theme-toggle');
    if (toggle) {
      var theme = document.documentElement.getAttribute('data-theme') || 'dark';
      toggle.setAttribute('aria-checked', String(theme === 'dark'));
    }
  })();
</script>

<style>
  /* ── Header shell ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(6, 6, 11, 0.75);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--color-border-subtle);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.35);
    transition: background 300ms var(--ease-smooth), border-color 300ms var(--ease-smooth);
  }

  :global([data-theme="light"]) .site-header {
    background: rgba(250, 251, 253, 0.82);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  /* ── Scroll progress hairline ── */
  .scroll-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 51;
    pointer-events: none;
    background: linear-gradient(90deg,
      rgba(139, 92, 246, 0.9),
      rgba(37, 99, 235, 0.9) 50%,
      rgba(139, 92, 246, 0.9));
    transform-origin: left center;
    will-change: transform;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation: scroll-progress-grow linear both;
      animation-timeline: scroll(root);
      animation-duration: 1ms;
    }
  }

  @keyframes scroll-progress-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress { animation: none; }
  }

  /* ── Liquid purple aurora layer ── */
  .header-aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(52px);
    will-change: transform;
    opacity: 0.34;
    mix-blend-mode: screen;
  }

  :global([data-theme="light"]) .aurora-blob {
    opacity: 0.16;
    mix-blend-mode: normal;
  }

  .blob-1 {
    width: 440px;
    height: 280px;
    left: -140px;
    top: -160px;
    background: radial-gradient(circle at 30% 30%, rgba(139, 92, 246, 0.95), rgba(139, 92, 246, 0) 70%);
    animation: aurora-drift-1 26s ease-in-out infinite alternate;
    animation-delay: 0.8s;
  }

  .blob-2 {
    width: 380px;
    height: 240px;
    right: -120px;
    top: -150px;
    background: radial-gradient(circle at 60% 40%, rgba(168, 85, 247, 0.9), rgba(168, 85, 247, 0) 70%);
    animation: aurora-drift-2 32s ease-in-out infinite alternate;
    animation-delay: 1s;
  }

  .blob-3 {
    width: 320px;
    height: 220px;
    left: 34%;
    top: -170px;
    background: radial-gradient(circle at 50% 50%, rgba(79, 70, 229, 0.85), rgba(79, 70, 229, 0) 70%);
    animation: aurora-drift-3 38s ease-in-out infinite alternate;
    animation-delay: 1.2s;
  }

  .blob-4 {
    width: 220px;
    height: 160px;
    left: 58%;
    top: -120px;
    background: radial-gradient(circle at 50% 50%, rgba(37, 99, 235, 0.8), rgba(37, 99, 235, 0) 70%);
    animation: aurora-drift-4 20s ease-in-out infinite alternate;
    animation-delay: 1.4s;
    opacity: 0.24;
  }

  @keyframes aurora-drift-1 {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    50%  { transform: translate3d(70px, 26px, 0) scale(1.18); }
    100% { transform: translate3d(-50px, 14px, 0) scale(0.94); }
  }

  @keyframes aurora-drift-2 {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    50%  { transform: translate3d(-80px, 20px, 0) scale(1.12); }
    100% { transform: translate3d(40px, -18px, 0) scale(1.22); }
  }

  @keyframes aurora-drift-3 {
