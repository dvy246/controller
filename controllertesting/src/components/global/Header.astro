    background: rgba(250, 251, 253, 0.82);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  /* ── Scroll progress hairline ── */
  .scroll-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 51;
    pointer-events: none;
    background: linear-gradient(90deg,
      rgba(139, 92, 246, 0.9),
      rgba(37, 99, 235, 0.9) 50%,
      rgba(139, 92, 246, 0.9));
    transform-origin: left center;
    will-change: transform;
  }

  @supports (animation-timeline: scroll()) {
    .scroll-progress {
      animation: scroll-progress-grow linear both;
      animation-timeline: scroll(root);
      animation-duration: 1ms;
    }
  }

  @keyframes scroll-progress-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress { animation: none; }
  }

  /* ── Liquid purple aurora layer ── */
  .header-aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(52px);
    will-change: transform;
    opacity: 0.34;
    mix-blend-mode: screen;
  }

  :global([data-theme="light"]) .aurora-blob {
    opacity: 0.16;
    mix-blend-mode: normal;
  }

  .blob-1 {
    width: 440px;
    height: 280px;
    left: -120px;
    top: -160px;
    background: radial-gradient(circle at 30% 30%, rgba(37, 99, 235, 0.95), rgba(37, 99, 235, 0) 70%);
    animation: aurora-drift-1 26s ease-in-out infinite alternate;
    animation-delay: 0.8s;
  }

  .blob-2 {
    width: 480px;
    height: 240px;
    right: -120px;
    top: -150px;
    background: radial-gradient(circle at 60% 40%, rgba(59, 130, 246, 0.9), rgba(59, 130, 246, 0) 70%);
    animation: aurora-drift-2 32s ease-in-out infinite alternate;
    animation-delay: 1s;
  }

  .blob-3 {
    width: 380px;
    height: 220px;
    left: 34%;
    top: -170px;
    background: radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.85), rgba(14, 165, 233, 0) 70%);
    animation: aurora-drift-3 38s ease-in-out infinite alternate;
    animation-delay: 1.2s;
  }

  .blob-4 {
    width: 320px;
    height: 160px;
    left: 58%;
    top: -120px;
    background: radial-gradient(circle at 50% 50%, rgba(29, 78, 216, 0.8), rgba(29, 78, 216, 0) 70%);
    animation: aurora-drift-4 20s ease-in-out infinite alternate;
    animation-delay: 1.4s;
    opacity: 0.24;
  }

  @keyframes aurora-drift-1 {
    0%   { transform: translate3d(0, 0, 0) scale(1); }
    50%  { transform: translate3d(70px, 26px, 0) scale(1.18); }
