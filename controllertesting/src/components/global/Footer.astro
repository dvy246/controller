---
/**
 * Footer.astro — ControllerTesting.com
 * Trust signals, SEO links, disclaimer, affiliate disclosure.
 */
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">

    {/* ── Top: Brand + Trust ── */}
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="ControllerTesting.com">
          <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <rect width="28" height="28" rx="6" fill="var(--color-accent)"/>
            <path d="M8 14c0-3.314 2.686-6 6-6s6 2.686 6 6-2.686 6-6 6-6-2.686-6-6z" stroke="var(--color-text-inverse)" stroke-width="1.5" fill="none"/>
            <circle cx="14" cy="14" r="2" fill="var(--color-pass)"/>
          </svg>
          <span>ControllerTesting.com</span>
        </a>
        <p class="footer-tagline">
          The only platform that owns the entire controller lifecycle from diagnosis to optimization.
          Free, instant, private — all processing in your browser.
        </p>
        <div class="trust-badges">
          <span class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Private
          </span>
          <span class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            Instant
          </span>
          <span class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            Free Forever
          </span>
        </div>
      </div>

      {/* ── Nav columns ── */}
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <h3 class="footer-col-title">Controller Tests <span class="footer-col-icon">▼</span></h3>
          <ul role="list">
            <li><a href="/test/controller/drift">Stick Drift Test</a></li>
            <li><a href="/test/controller/full-diagnostic">Full Diagnostic</a></li>
            <li><a href="/test/controller/buttons">Button Tester</a></li>
            <li><a href="/test/controller/triggers">Trigger Test</a></li>
            <li><a href="/test/controller/health-score">Health Score</a></li>
            <li><a href="/test/controller/vibration">Vibration Test</a></li>
            <li><a href="/test/controller">All 21 Tools</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3 class="footer-col-title">More Tests <span class="footer-col-icon">▼</span></h3>
          <ul role="list">
            <li><a href="/test/mouse">Mouse Tests</a></li>
            <li><a href="/test/keyboard">Keyboard Tests</a></li>
            <li><a href="/test/midi">MIDI &amp; Drum Pads</a></li>
            <li><a href="/audio-test/surround-sound">Spatial Audio Test</a></li>
            <li><a href="/hz-test/144hz">Hz &amp; Ghosting Test</a></li>
            <li><a href="/games">Game Arcade</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3 class="footer-col-title">Fix &amp; Optimize <span class="footer-col-icon">▼</span></h3>
          <ul role="list">
            <li><a href="/warranty">Warranty Assistant</a></li>
            <li><a href="/fix-or-replace">Fix vs Replace Calc</a></li>
            <li><a href="/fix/stick-drift/ps5-dualsense">Fix PS5 Drift</a></li>
            <li><a href="/test/controller/timeline">Drift Timeline Tracker</a></li>
            <li><a href="/test/controller/competitive-readiness">Competitive Readiness</a></li>
            <li><a href="/test/controller/ps-calibration">PS4/PS5 Calibration</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3 class="footer-col-title">Compare &amp; Data <span class="footer-col-icon">▼</span></h3>
          <ul role="list">
            <li><a href="/compare/dualsense-vs-xbox-series">DualSense vs Xbox Series</a></li>
            <li><a href="/compare/dualsense-edge-vs-xbox-elite-2">Edge vs Elite Series 2</a></li>
            <li><a href="/controller/ps5-dualsense">PS5 DualSense Profile</a></li>
            <li><a href="/controller/xbox-wireless">Xbox Wireless Profile</a></li>
            <li><a href="/reliability/ps5-dualsense">DualSense Reliability</a></li>
            <li><a href="/reliability/xbox-series-x">Xbox Series X Reliability</a></li>
            <li><a href="/press">Press Kit</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3 class="footer-col-title">Learn &amp; Connect <span class="footer-col-icon">▼</span></h3>
          <ul role="list">
            <li><a href="/shop">Repair Shop Suite</a></li>
            <li><a href="/verify">Verify Certificate</a></li>
            <li><a href="/passport">Controller Passport</a></li>
            <li><a href="/learn">Controller Guides</a></li>
            <li><a href="/connect">Connect &amp; Pair</a></li>
            <li><a href="/learn/hall-effect-vs-potentiometer-guide">Hall Effect vs Potentiometer</a></li>
            <li><a href="/test/methodology">How Tests Work</a></li>
            <li><a href="/reliability/report">Monthly Reliability Report</a></li>
          </ul>
        </div>
      </nav>
    </div>

    {/* ── Bottom: Legal ── */}
    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {new Date().getFullYear()} ControllerTesting.com. All rights reserved.
        Results are informational only. Controller testing accuracy depends on browser Gamepad API implementation.
        Repair guides: always consult a professional for complex repairs. We are not responsible for any damage.
      </p>
      <p class="footer-affiliate">
        <strong>Affiliate disclosure:</strong> Some links on this site are affiliate links. We may earn a commission if you purchase through them, at no extra cost to you. All recommendations are based on our independent testing and analysis.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border-subtle);
    background: var(--color-surface-1);
    margin-top: var(--spacing-section);
  }

  .footer-inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: 3rem 1.5rem 2rem;
  }

  /* ── Top ── */
  .footer-top {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* ── Brand ── */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .footer-tagline {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 280px;
  }

  .trust-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-micro);
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 0.25em 0.625em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Nav ── */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .footer-col-title {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.875rem;
    font-family: var(--font-mono);
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col a {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
    line-height: 1.4;
  }

  .footer-col a:hover {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  /* ── Bottom ── */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-legal,
  .footer-affiliate {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    line-height: 1.6;
  }

  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-nav { grid-template-columns: repeat(2, 1fr); }
  }

  .footer-col-icon {
    display: none;
    font-size: 0.6rem;
    transition: transform var(--duration-fast);
  }

  @media (max-width: 640px) {
    .footer-nav { 
      grid-template-columns: 1fr; 
      gap: 0; 
    }
    .footer-inner { padding-inline: 1rem; }
    
    .footer-col {
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .footer-col:last-child {
      border-bottom: none;
    }
    
    .footer-col-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem 0;
      margin-bottom: 0;
      cursor: pointer;
    }
    
    .footer-col-icon {
      display: block;
    }
    
    .footer-col ul {
      display: none;
      padding-bottom: 1.25rem;
    }
    
    .footer-col.is-open ul {
      display: flex;
    }
    
    .footer-col.is-open .footer-col-icon {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  document.querySelectorAll('.footer-col-title').forEach(title => {
    title.addEventListener('click', () => {
      const col = title.parentElement;
      if (window.innerWidth <= 640 && col) {
        col.classList.toggle('is-open');
      }
    });
  });
</script>
