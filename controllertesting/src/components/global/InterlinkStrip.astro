---
/**
 * InterlinkStrip.astro — bidirectional test ↔ game cross-links.
 * Renders a compact strip of related arcade games (on diagnostic tool pages)
 * or related diagnostic tools (on game pages). Uses the shared
 * arcadeInterlinks registry so every page stays in sync.
 *
 * Props:
 *   - links: GameRef[] | ToolRef[]  (pre-resolved refs)
 *   - title: string                 (section heading)
 *   - subtitle: string              (optional helper line)
 *   - type: 'games' | 'tools'       (controls card styling)
 */

interface GameRef {
  name: string;
  href: string;
  desc: string;
  xp?: number;
}

interface ToolRef {
  name: string;
  href: string;
  desc: string;
}

interface Props {
  links: Array<GameRef | ToolRef>;
  title: string;
  subtitle?: string;
  type: 'games' | 'tools';
}

const { links, title, subtitle = '', type } = Astro.props;
if (!links.length) return;
---

<section class={`interlink-strip interlink-strip--${type}`} data-reveal aria-label={title}>
  <div class="interlink-head">
    <div class="interlink-head-text">
      <span class="badge-tag">{type === 'games' ? 'Play & Practice' : 'Test Your Setup'}</span>
      <h2 class="interlink-title">{title}</h2>
      {subtitle && <p class="interlink-subtitle">{subtitle}</p>}
    </div>
    {type === 'games' && (
      <a class="interlink-hub" href="/games">
        <span>Browse all games</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    )}
    {type === 'tools' && (
      <a class="interlink-hub" href="/test/controller">
        <span>All diagnostic tools</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    )}
  </div>

  <div class="interlink-grid">
    {links.map((l) => (
      <a href={l.href} class={`interlink-card card-base card-hover interlink-card--${type}`}>
        <div class="interlink-card-top">
          <span class={`interlink-icon interlink-icon--${type}`} aria-hidden="true">
            {type === 'games' ? (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><rect x="2" y="6" width="20" height="12" rx="6"/></svg>
            ) : (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2-1 3.7-2.4 4.8A7 7 0 0 1 5 9a7 7 0 0 1 7-7z"/><circle cx="9" cy="7" r="1.5"/><path d="M12 22c3-1 5-3.4 5-6"/></svg>
            )}
          </span>
          {'xp' in l && l.xp ? <span class="interlink-xp mono">+{l.xp} XP</span> : null}
        </div>
        <h3 class="interlink-card-name">{l.name}</h3>
        <p class="interlink-card-desc">{l.desc}</p>
        <span class="interlink-card-cta">
          <span>{type === 'games' ? 'Play' : 'Open tester'}</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .interlink-strip {
    margin-block: var(--space-16, 4rem);
  }

  .interlink-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .interlink-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .interlink-head .badge-tag {
    align-self: flex-start;
  }

  .interlink-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin: 0;
  }

  .interlink-subtitle {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0;
  }

  .interlink-hub {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.375rem;
  }
  .interlink-hub:hover { text-decoration: underline; text-underline-offset: 3px; }

  .interlink-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
    width: 100%;
  }

  .interlink-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    text-decoration: none;
    cursor: pointer;
    padding: 1.5rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-card);
    transition: background var(--duration-fast), border-color var(--duration-fast), transform var(--duration-fast);
  }

  .interlink-card:hover {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .interlink-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .interlink-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .interlink-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-subtle);
  }

  .interlink-icon--games {
    color: var(--color-accent);
    background: var(--color-info-bg);
  }

  .interlink-icon--tools {
    color: var(--color-pass);
    background: var(--color-pass-bg);
  }

  .interlink-xp {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-pass);
    background: var(--color-pass-bg);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-pass);
  }

  .interlink-card-name {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .interlink-card-desc {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex-grow: 1;
    margin: 0;
  }

  .interlink-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 0.25rem;
  }
</style>
