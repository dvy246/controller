---
/**
 * SemanticGlossary.astro
 * Flagship Knowledge & Hardware Reference Component with 4-Card Bento Grid,
 * custom SVG iconography, subtle ambient glows, and multi-language support.
 */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<section class="semantic-glossary-section w-full max-w-7xl mx-auto my-16 px-4 sm:px-6 lg:px-8" data-reveal>
  {/* Header with Eyebrow Badge */}
  <div class="glossary-header mb-8 text-center sm:text-left">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-mono font-bold uppercase tracking-wider mb-3">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      {t("glossary.eyebrow")}
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-2">
      {t("glossary.title")}
    </h2>
    <p class="text-stone-400 text-sm sm:text-base max-w-2xl">
      {t("glossary.subtitle")}
    </p>
  </div>
  
  {/* 4-Card Bento Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-stretch">
    
    {/* Card 1: Stick Drift & Deadzones */}
    <article class="glossary-card group relative bg-gradient-to-br from-white/[0.06] to-white/[0.01] backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-7 shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_12px_36px_-12px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-emerald-500/30 hover:shadow-[0_16px_40px_-10px_rgba(16,185,129,0.15)] hover:-translate-y-0.5 flex flex-col justify-between">
      <div class="glossary-card-glow glossary-card-glow--emerald" aria-hidden="true"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 shadow-[0_0_15px_rgba(16,185,129,0.2)] group-hover:scale-110 transition-transform duration-300">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"></circle>
              <circle cx="12" cy="12" r="4" fill="currentColor" fill-opacity="0.25"></circle>
              <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
            </svg>
          </div>
          <span class="px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Potentiometers
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors">
          {t("glossary.driftTitle")}
        </h3>
        <p class="text-sm text-stone-300 leading-relaxed">
          {t("glossary.driftDesc")}
        </p>
      </div>
    </article>

    {/* Card 2: Polling Rate (Hz) & Input Latency */}
    <article class="glossary-card group relative bg-gradient-to-br from-white/[0.06] to-white/[0.01] backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-7 shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_12px_36px_-12px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-amber-500/30 hover:shadow-[0_16px_40px_-10px_rgba(245,158,11,0.15)] hover:-translate-y-0.5 flex flex-col justify-between">
      <div class="glossary-card-glow glossary-card-glow--amber" aria-hidden="true"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0 shadow-[0_0_15px_rgba(245,158,11,0.2)] group-hover:scale-110 transition-transform duration-300">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <span class="px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20">
            1000Hz / 1ms
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-amber-300 transition-colors">
          {t("glossary.pollingTitle")}
        </h3>
        <p class="text-sm text-stone-300 leading-relaxed">
          {t("glossary.pollingDesc")}
        </p>
      </div>
    </article>

    {/* Card 3: Hall Effect Sensors */}
    <article class="glossary-card group relative bg-gradient-to-br from-white/[0.06] to-white/[0.01] backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-7 shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_12px_36px_-12px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-purple-500/30 hover:shadow-[0_16px_40px_-10px_rgba(168,85,247,0.15)] hover:-translate-y-0.5 flex flex-col justify-between">
      <div class="glossary-card-glow glossary-card-glow--purple" aria-hidden="true"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 shrink-0 shadow-[0_0_15px_rgba(168,85,247,0.2)] group-hover:scale-110 transition-transform duration-300">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
          </div>
          <span class="px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider rounded-md bg-purple-500/10 text-purple-400 border border-purple-500/20">
            Magnetic Sensor
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-purple-300 transition-colors">
          {t("glossary.hallTitle")}
        </h3>
        <p class="text-sm text-stone-300 leading-relaxed">
          {t("glossary.hallDesc")}
        </p>
      </div>
    </article>

    {/* Card 4: Circularity Error */}
    <article class="glossary-card group relative bg-gradient-to-br from-white/[0.06] to-white/[0.01] backdrop-blur-md border border-white/10 rounded-2xl p-6 sm:p-7 shadow-[inset_0_1px_0_rgba(255,255,255,0.1),0_12px_36px_-12px_rgba(0,0,0,0.5)] transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_16px_40px_-10px_rgba(59,130,246,0.15)] hover:-translate-y-0.5 flex flex-col justify-between">
      <div class="glossary-card-glow glossary-card-glow--blue" aria-hidden="true"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between gap-3 mb-5">
          <div class="w-11 h-11 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 shrink-0 shadow-[0_0_15px_rgba(59,130,246,0.2)] group-hover:scale-110 transition-transform duration-300">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" stroke-dasharray="4 2"></circle>
              <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
              <path d="M12 3v18M3 12h18" stroke-opacity="0.4"></path>
            </svg>
          </div>
          <span class="px-2.5 py-1 text-[11px] font-mono font-bold uppercase tracking-wider rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20">
            360° Geometry
          </span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-blue-300 transition-colors">
          {t("glossary.circularityTitle")}
        </h3>
        <p class="text-sm text-stone-300 leading-relaxed">
          {t("glossary.circularityDesc")}
        </p>
      </div>
    </article>

  </div>
</section>

<style>
  .glossary-card-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: 1rem;
    opacity: 0.12;
    transition: opacity 0.3s ease;
  }

  .glossary-card:hover .glossary-card-glow {
    opacity: 0.28;
  }

  .glossary-card-glow--emerald {
    background: radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.8) 0%, transparent 60%);
  }

  .glossary-card-glow--amber {
    background: radial-gradient(circle at 15% 15%, rgba(245, 158, 11, 0.8) 0%, transparent 60%);
  }

  .glossary-card-glow--purple {
    background: radial-gradient(circle at 15% 15%, rgba(168, 85, 247, 0.8) 0%, transparent 60%);
  }

  .glossary-card-glow--blue {
    background: radial-gradient(circle at 15% 15%, rgba(59, 130, 246, 0.8) 0%, transparent 60%);
  }
</style>
