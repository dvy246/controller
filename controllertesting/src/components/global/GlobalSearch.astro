---

<div id="search-modal-backdrop" class="search-modal-backdrop" aria-hidden="true" hidden>
  <div class="search-modal-container" role="dialog" aria-modal="true" aria-label="Site Search">
    <div class="search-modal-header">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="global-search-input"
        class="search-input"
        placeholder="Type to search tools, games, guides... (Esc to close)"
        autocomplete="off"
        spellcheck="false"
      />
      <span class="search-kbd">ESC</span>
    </div>

    <div class="search-modal-results" id="search-results-container">
      <div class="search-empty-state" id="search-initial-state">
        <span>Popular Quick Searches:</span>
        <div class="search-quick-tags">
          <button type="button" class="quick-tag" data-query="drift">Stick Drift</button>
          <button type="button" class="quick-tag" data-query="polling">Polling Rate</button>
          <button type="button" class="quick-tag" data-query="calibration">PS Calibration</button>
          <button type="button" class="quick-tag" data-query="mouse">Mouse Hz</button>
          <button type="button" class="quick-tag" data-query="wheel">Steering Wheel</button>
        </div>
      </div>
      <div id="search-dynamic-list" class="search-dynamic-list"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchItems }}>
  (function () {
    var backdrop = document.getElementById('search-modal-backdrop');
    var input = document.getElementById('global-search-input');
    var listContainer = document.getElementById('search-dynamic-list');
    var initialState = document.getElementById('search-initial-state');
    var selectedIndex = -1;

    function openSearch() {
      if (!backdrop || !input) return;
      backdrop.hidden = false;
      backdrop.setAttribute('aria-hidden', 'false');
      input.value = '';
      renderResults('');
      setTimeout(function () { input.focus(); }, 50);
    }

    function closeSearch() {
      if (!backdrop) return;
      backdrop.hidden = true;
      backdrop.setAttribute('aria-hidden', 'true');
    }

    function renderResults(query) {
      if (!listContainer || !initialState) return;
      var q = query.trim().toLowerCase();
      selectedIndex = -1;

      if (!q) {
        initialState.style.display = 'block';
        listContainer.innerHTML = '';
        return;
      }

      initialState.style.display = 'none';

      var filtered = searchItems.filter(function (item) {
        return (
          item.title.toLowerCase().indexOf(q) !== -1 ||
          item.category.toLowerCase().indexOf(q) !== -1 ||
          item.desc.toLowerCase().indexOf(q) !== -1
        );
      });

      if (filtered.length === 0) {
        listContainer.innerHTML = '<div class="search-no-results">No diagnostic tools found for "' + query + '"</div>';
        return;
      }

      var html = '';
      var currentCat = '';
      filtered.forEach(function (item, idx) {
        if (item.category !== currentCat) {
          currentCat = item.category;
          html += '<div class="search-category-header">' + currentCat + '</div>';
        }
        html +=
          '<a href="' + item.url + '" class="search-result-item" data-index="' + idx + '">' +
            '<div class="res-left">' +
              '<span class="res-title">' + item.title + '</span>' +
              '<span class="res-desc">' + item.desc + '</span>' +
            '</div>' +
            '<svg class="res-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>' +
          '</a>';
      });

      listContainer.innerHTML = html;
    }

    // Keyboard Shortcuts
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (backdrop && backdrop.hidden) {
          openSearch();
        } else {
          closeSearch();
        }
      } else if (e.key === 'Escape' && backdrop && !backdrop.hidden) {
        closeSearch();
      }
    });

    if (input) {
      input.addEventListener('input', function (e) {
        renderResults(e.target.value);
      });

      input.addEventListener('keydown', function (e) {
        var items = listContainer ? listContainer.querySelectorAll('.search-result-item') : [];
        if (items.length === 0) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
          updateSelection(items);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, 0);
          updateSelection(items);
        } else if (e.key === 'Enter' && selectedIndex >= 0) {
          e.preventDefault();
          var href = items[selectedIndex].getAttribute('href');
          if (href) window.location.href = href;
        }
      });
    }

    function updateSelection(items) {
      items.forEach(function (el, i) {
        if (i === selectedIndex) {
          el.classList.add('selected');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('selected');
        }
      });
    }

    // Backdrop click close
    if (backdrop) {
      backdrop.addEventListener('click', function (e) {
        if (e.target === backdrop) closeSearch();
      });
    }

    // Export window openSearch helper for header search button trigger
    window.openGlobalSearch = openSearch;

    // Quick Tags click
    document.addEventListener('click', function (e) {
      if (e.target && e.target.classList.contains('quick-tag')) {
        var q = e.target.getAttribute('data-query');
        if (input && q) {
          input.value = q;
          renderResults(q);
        }
      }
    });
  })();
</script>

<style>
  .search-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background: rgba(6, 6, 11, 0.8);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
    padding-inline: 1rem;
  }
  .search-modal-container {
    width: 100%;
    max-width: 640px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-card);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
  }
  .search-modal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-surface-1);
  }
  .search-icon { color: var(--color-text-tertiary); flex-shrink: 0; }
  .search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
  }
  .search-kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-tertiary);
    background: var(--color-surface-3);
    border: 1px solid var(--color-border-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }
  .search-modal-results {
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .search-empty-state {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .search-quick-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .quick-tag {
    background: var(--color-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.75rem;
    font-size: var(--text-small);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .quick-tag:hover {
    background: var(--color-surface-3);
    border-color: var(--color-accent);
  }
  .search-category-header {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem 0.25rem;
  }
  .search-result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.15s;
  }
  .search-result-item:hover, .search-result-item.selected {
    background: var(--color-surface-3);
  }
  .res-left { display: flex; flex-direction: column; gap: 0.2rem; }
  .res-title { font-size: 0.9375rem; font-weight: 700; color: var(--color-text-primary); }
  .res-desc { font-size: var(--text-small); color: var(--color-text-secondary); }
  .res-arrow { color: var(--color-text-tertiary); flex-shrink: 0; }
  .search-no-results {
    padding: 2rem 1rem;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
</style>
