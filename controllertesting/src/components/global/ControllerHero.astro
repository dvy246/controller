---
/**
 * ControllerHero.astro — 3D Three.js Realistic Controller Hero
 * 
 * Premium floating 3D controller implementation for the right column of the hero.
 */
---
<div class="controller-3d-wrapper relative w-full h-full min-h-[440px] lg:min-h-[500px] flex items-center justify-center" id="hero-container">
  
  <!-- Subtle Glow Aura behind 3D canvas -->
  <div class="absolute inset-0 bg-gradient-to-tr from-blue-600/15 via-indigo-500/10 to-transparent blur-3xl rounded-full pointer-events-none"></div>

  <!-- Loading State Spinner -->
  <div class="loading-spinner active" id="loading-spinner">
    <div class="spinner-ring"></div>
    <span class="loading-text">LOADING 3D PS5 DUALSENSE...</span>
  </div>

  <!-- 3D WebGL Canvas -->
  <canvas id="webgl-canvas" class="webgl-canvas"></canvas>
  
  <!-- Telemetry HUD Badge -->
  <div class="telemetry-hud" id="telemetry-hud">
    <div class="status-indicator">
      <span class="status-dot" id="status-dot"></span>
      <span id="status-text">Awaiting Gamepad</span>
    </div>
    <div class="telemetry-data" id="telemetry-data" style="display: none;">
      <div>L-STICK: <span id="ls-val">0.00, 0.00</span></div>
      <div>R-STICK: <span id="rs-val">0.00, 0.00</span></div>
    </div>
  </div>
</div>

<style>
  .controller-3d-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loading-spinner {
    position: absolute;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease;
    opacity: 0;
    pointer-events: none;
  }

  .loading-spinner.active {
    opacity: 1;
  }

  .spinner-ring {
    width: 32px;
    height: 32px;
    border: 2px solid rgba(255,255,255,0.05);
    border-top-color: var(--color-primary, #3b82f6);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 12px;
  }

  .loading-text {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .webgl-canvas {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    z-index: 2;
    outline: none;
    opacity: 1;
  }

  .telemetry-hud {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 1;
  }
  
  .webgl-canvas.loaded ~ .telemetry-hud {
    opacity: 1;
  }

  .status-indicator {
    background: rgba(9, 9, 11, 0.72);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.92);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: all 0.3s ease;
  }
  .status-dot.connected { 
    background: #10b981; 
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6); 
  }

  .telemetry-data {
    font-family: var(--font-mono, monospace);
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.6);
    display: flex;
    gap: 16px;
    background: rgba(9, 9, 11, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    padding: 6px 14px;
    border-radius: 20px;
  }
  .telemetry-data span { color: rgba(255,255,255,0.92); }
</style>

<script>
  // Tiny loader: the full Three.js engine (~631KB) lives in controllerHero3D.ts
  // and is fetched ONLY when the hero enters the viewport AND the browser is
  // idle — so the homepage never ships the 3D bundle on its critical path.
  const heroReady = () => {
    const heroEl = document.getElementById('hero-container');
    if (!heroEl || heroEl.dataset.threeInitialized === 'true') return;

    // Phase 1 (zero main-thread cost): warm the asset cache the moment the
    // hero is visible. Preloads are pure fetches — no JS execution — so they
    // can race ahead of the engine import without touching rendering budget.
    const preload = (href: string, as: string, type?: string) => {
      if (document.querySelector(`link[href="${href}"]`)) return;
      const link = document.createElement('link');
      link.rel = 'preload';
      link.href = href;
      link.as = as;
      if (type) link.type = type;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    };
    preload('/models/controller.glb', 'fetch', 'model/gltf-binary');
    preload('/libs/basis/basis_transcoder.js', 'fetch');
    preload('/libs/basis/basis_transcoder.wasm', 'fetch', 'application/wasm');

    // Phase 2: start the engine import at the first idle slot, but never wait
    // on idle past window load + 150ms — the old timeout:2500 gate alone could
    // hold the spinner for 2.5s before any byte downloaded. Whichever fires
    // first wins; the `started` flag makes the race idempotent.
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      import('./controllerHero3D.ts').then((m) => m.startHero3D()).catch((err) => {
        console.warn('3D hero failed to load:', err);
      });
    };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(start, { timeout: 1500 });
    } else {
      start();
    }
    window.addEventListener('load', () => setTimeout(start, 150), { once: true });
  };

  if ('IntersectionObserver' in window) {
    const heroEl = document.getElementById('hero-container');
    if (heroEl) {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          heroReady();
        }
      }, { rootMargin: '300px 0px 300px 0px' });
      io.observe(heroEl);
    } else {
      heroReady();
    }
  } else {
    heroReady();
  }
</script>
