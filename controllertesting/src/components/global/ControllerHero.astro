---
/**
 * ControllerHero.astro — image-led homepage hero
 *
 * The supplied controller photograph is the hero's proof point. The stage
 * uses transform/opacity-only motion so the page stays static, cheap, and
 * predictable while still feeling like a precision instrument.
 */
---

<div class="controller-hero" id="controller-hero">
  <div class="hero-field" aria-hidden="true">
    <span class="field-orbit field-orbit-wide"></span>
    <span class="field-orbit field-orbit-tight"></span>
    <span class="field-axis field-axis-horizontal"></span>
    <span class="field-axis field-axis-vertical"></span>
  </div>

  <div
    class="controller-stage"
    id="controller-stage"
    tabindex="0"
    aria-label="Interactive controller preview. Move your pointer over the controller."
  >
    <div class="stage-marker stage-marker-top" aria-hidden="true">
      <span class="marker-dot"></span>
      <span>LIVE SENSOR MAP / MOVE TO INSPECT</span>
    </div>

    <div class="controller-art">
      <div class="controller-float">
        <div class="controller-image-wrap">
          <div class="controller-image-backlight" aria-hidden="true"></div>
          <img
            class="controller-image"
            src="/images/controller-hero.jpg"
            width="736"
            height="1308"
            alt="White PlayStation DualSense controller lit against a dark background"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="controller-sheen" aria-hidden="true"></span>
        </div>
      </div>
    </div>

    <div class="stage-marker stage-marker-bottom" aria-hidden="true">
      <span>DUALSENSE / USB + BT</span>
      <span class="marker-line"></span>
      <span>READY</span>
    </div>
  </div>

  <div class="controller-readout" aria-label="Controller test preview">
    <div class="readout-header">
      <span class="readout-kicker">Input monitor</span>
      <span class="readout-live"><span class="readout-dot"></span>Ready</span>
    </div>
    <div class="readout-grid">
      <div>
        <span class="readout-label">Drift</span>
        <strong>0.08%</strong>
      </div>
      <div>
        <span class="readout-label">Polling</span>
        <strong>1000 Hz</strong>
      </div>
      <div>
        <span class="readout-label">Health</span>
        <strong class="readout-pass">PASS</strong>
      </div>
    </div>
  </div>
</div>

<style>
  .controller-hero {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --pointer-x: 0px;
    --pointer-y: 0px;
    --pointer-active: 0;
    position: relative;
    width: 100%;
    max-width: 560px;
    min-height: 620px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    isolation: isolate;
  }

  .hero-field,
  .controller-stage,
  .controller-readout {
    position: absolute;
  }

  .hero-field {
    inset: 6% 0 8%;
    z-index: -1;
    overflow: hidden;
    border-radius: 48% 52% 44% 56% / 50% 44% 56% 50%;
    background:
      radial-gradient(circle at 50% 48%, rgba(37, 99, 235, 0.17), transparent 33%),
      radial-gradient(circle at 64% 26%, rgba(255, 255, 255, 0.06), transparent 28%);
    animation: field-breathe 12s var(--ease-smooth) infinite alternate;
  }

  .hero-field::before,
  .hero-field::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* A quiet instrument grid gives the photograph a shared spatial plane. */
  .hero-field::before {
    opacity: 0.34;
    background-image:
      linear-gradient(rgba(126, 158, 224, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(126, 158, 224, 0.11) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at center, black 15%, transparent 76%);
    transform: perspective(600px) rotateX(58deg) translateY(18%);
    transform-origin: center bottom;
  }

  /* This is the interactive shade: it tracks the same pointer coordinates as the controller. */
  .hero-field::after {
    inset: 0 -10%;
    opacity: calc(0.42 + (var(--pointer-active) * 0.16));
    background:
      radial-gradient(circle 150px at calc(50% + var(--pointer-x)) calc(46% + var(--pointer-y)), rgba(127, 170, 255, 0.22), transparent 72%),
      linear-gradient(120deg, transparent 22%, rgba(255, 255, 255, 0.07) 49%, transparent 66%);
    animation: field-scan 15s var(--ease-smooth) infinite alternate;
    transition: opacity 500ms var(--ease-smooth);
    will-change: transform, opacity;
  }

  .field-orbit,
  .field-axis {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .field-orbit {
    left: 50%;
    top: 48%;
    border: 1px solid rgba(111, 157, 255, 0.16);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-18deg);
    animation: orbit-drift 16s var(--ease-smooth) infinite alternate;
  }

  .field-orbit-wide {
    width: 92%;
    height: 42%;
  }

  .field-orbit-tight {
    width: 70%;
    height: 30%;
    border-color: rgba(255, 255, 255, 0.1);
    transform: translate(-50%, -50%) rotate(22deg);
    animation-duration: 13s;
    animation-direction: alternate-reverse;
  }

  .field-axis {
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.16), transparent);
    opacity: 0.45;
  }

  .field-axis-horizontal {
    left: 5%;
    right: 5%;
    top: 50%;
    height: 1px;
  }

  .field-axis-vertical {
    top: 5%;
    bottom: 5%;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12), transparent);
  }

  .controller-stage {
    position: relative;
    width: 100%;
    height: 540px;
    display: grid;
    place-items: center;
    perspective: 1100px;
    transform: translate3d(0, 0, 0) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    transition: transform 700ms var(--ease-spring);
    will-change: transform;
    touch-action: pan-y;
    outline: none;
  }

  .controller-stage:focus-visible {
    border-radius: 24px;
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  .controller-art {
    position: relative;
    width: min(82%, 370px);
    aspect-ratio: 736 / 1308;
    transform: translateZ(16px);
  }

  .controller-float {
    position: relative;
    width: 100%;
    height: 100%;
    animation: controller-float 9s var(--ease-smooth) infinite alternate;
    will-change: transform;
  }

  .controller-image-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
    border-radius: 26px;
    transform: translate3d(var(--image-x, 0px), var(--image-y, 0px), 0);
    transition: transform 650ms var(--ease-spring);
    will-change: transform;
  }

  .controller-image-backlight {
    position: absolute;
    inset: 16% 10% 16%;
    background: radial-gradient(ellipse, rgba(37, 99, 235, 0.28), transparent 68%);
    opacity: 0.42;
    transform: translate3d(0, 0, -1px) scale(1.05);
    z-index: -1;
  }

  .controller-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transform: none;
    filter: drop-shadow(0 28px 30px rgba(0, 0, 0, 0.32));
  }

  .controller-image-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 56%, rgba(4, 6, 12, 0.12));
    pointer-events: none;
  }

  .controller-sheen {
    position: absolute;
    top: -18%;
    bottom: -18%;
    left: -50%;
    width: 18%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.16), transparent);
    opacity: 0;
    transform: skewX(-18deg) translateX(-120%);
    animation: image-sweep 8s var(--ease-smooth) 1.4s infinite;
    pointer-events: none;
  }

  .stage-marker {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(218, 226, 244, 0.64);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stage-marker-top {
    top: 9%;
    left: 3%;
  }

  .stage-marker-bottom {
    right: 4%;
    bottom: 9%;
    color: rgba(218, 226, 244, 0.5);
  }

  .marker-dot,
  .readout-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-pass);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1), 0 0 12px rgba(16, 185, 129, 0.75);
  }

  .marker-line {
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .controller-readout {
    position: relative;
    z-index: 3;
    width: min(92%, 300px);
    margin: 0 4% 0 auto;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 14px;
    background: rgba(10, 12, 22, 0.86);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.26), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    transform: translateZ(0);
  }

  .readout-header,
  .readout-live {
    display: flex;
    align-items: center;
  }

  .readout-header {
    justify-content: space-between;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .readout-kicker,
  .readout-label,
  .readout-live {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .readout-kicker { color: rgba(255, 255, 255, 0.54); }

  .readout-live {
    gap: 0.4rem;
    color: var(--color-pass);
  }

  .readout-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    padding-top: 0.8rem;
  }

  .readout-grid > div {
    display: grid;
    gap: 0.25rem;
  }

  .readout-label { color: rgba(255, 255, 255, 0.42); }

  .readout-grid strong {
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .readout-grid .readout-pass { color: var(--color-pass); }

  @keyframes controller-float {
    from { transform: translate3d(0, -4px, 0) rotate(-0.4deg); }
    to { transform: translate3d(0, 5px, 0) rotate(0.4deg); }
  }

  @keyframes image-sweep {
    0%, 38% { opacity: 0; transform: skewX(-18deg) translateX(-120%); }
    48% { opacity: 0.9; }
    66%, 100% { opacity: 0; transform: skewX(-18deg) translateX(570%); }
  }

  @keyframes field-breathe {
    from { opacity: 0.7; transform: scale(0.96) rotate(-1deg); }
    to { opacity: 1; transform: scale(1.04) rotate(1deg); }
  }

  @keyframes orbit-drift {
    from { transform: translate(-50%, -50%) rotate(-18deg) scale(0.96); opacity: 0.62; }
    to { transform: translate(-50%, -50%) rotate(-8deg) scale(1.04); opacity: 1; }
  }

  @keyframes field-scan {
    from { transform: translate3d(-3%, 0, 0); }
    to { transform: translate3d(3%, 0, 0); }
  }

  @media (max-width: 1024px) {
    .controller-hero { max-width: 480px; min-height: 560px; }
    .controller-stage { height: 480px; }
    .controller-art { width: min(82%, 330px); }
    .stage-marker-top { top: 4%; }
    .stage-marker-bottom { bottom: 4%; }
  }

  @media (max-width: 640px) {
    .controller-hero { min-height: 490px; }
    .controller-stage { height: 410px; }
    .controller-art { width: min(78%, 280px); }
    .controller-image-wrap { border-radius: 22px; }
    .stage-marker { font-size: 0.5rem; letter-spacing: 0.1em; }
    .stage-marker-top { left: 0; }
    .stage-marker-bottom { right: 0; }
    .controller-readout { width: min(96%, 270px); margin-right: 2%; }
    .readout-grid { gap: 0.5rem; }
    .readout-grid strong { font-size: 0.6875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-field,
    .field-orbit,
    .controller-float,
    .controller-sheen {
      animation: none;
    }

    .controller-stage {
      transition: none;
      transform: none;
    }

    .hero-field::after { animation: none; will-change: auto; }
  }

  :global([data-theme="light"]) .hero-field {
    background:
      radial-gradient(circle at 50% 48%, rgba(37, 99, 235, 0.1), transparent 33%),
      radial-gradient(circle at 64% 26%, rgba(37, 99, 235, 0.05), transparent 28%);
  }

  :global([data-theme="light"]) .controller-image-wrap {
    border-color: rgba(0, 0, 0, 0.14);
    box-shadow: 0 28px 72px rgba(20, 30, 60, 0.18), 0 8px 24px rgba(20, 30, 60, 0.12);
  }

  :global([data-theme="light"]) .controller-readout {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(0, 0, 0, 0.12);
    box-shadow: 0 18px 36px rgba(20, 30, 60, 0.14);
  }

  :global([data-theme="light"]) .readout-header { border-bottom-color: rgba(0, 0, 0, 0.1); }
  :global([data-theme="light"]) .readout-kicker { color: rgba(15, 23, 42, 0.58); }
  :global([data-theme="light"]) .readout-label { color: rgba(15, 23, 42, 0.52); }
  :global([data-theme="light"]) .readout-grid strong { color: rgba(15, 23, 42, 0.9); }
  :global([data-theme="light"]) .stage-marker { color: rgba(15, 23, 42, 0.58); }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('controller-hero');
    const stage = document.getElementById('controller-stage');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!root || !stage || reducedMotion.matches) return;

    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;

    const applyTilt = (x, y) => {
      root.style.setProperty('--tilt-x', `${(y * -4).toFixed(2)}deg`);
      root.style.setProperty('--tilt-y', `${(x * 5).toFixed(2)}deg`);
      root.style.setProperty('--image-x', `${(x * 10).toFixed(1)}px`);
      root.style.setProperty('--image-y', `${(y * 8).toFixed(1)}px`);
      root.style.setProperty('--pointer-x', `${(x * 90).toFixed(1)}px`);
      root.style.setProperty('--pointer-y', `${(y * 70).toFixed(1)}px`);
    };

    const resetTilt = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      root.style.setProperty('--tilt-x', '0deg');
      root.style.setProperty('--tilt-y', '0deg');
      root.style.setProperty('--image-x', '0px');
      root.style.setProperty('--image-y', '0px');
      root.style.setProperty('--pointer-x', '0px');
      root.style.setProperty('--pointer-y', '0px');
      root.style.setProperty('--pointer-active', '0');
    };

    stage.addEventListener('pointerenter', () => {
      root.style.setProperty('--pointer-active', '1');
    }, { passive: true });

    stage.addEventListener('pointermove', (event) => {
      const bounds = stage.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left) / bounds.width - 0.5;
      pointerY = (event.clientY - bounds.top) / bounds.height - 0.5;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        applyTilt(pointerX, pointerY);
      });
    }, { passive: true });

    stage.addEventListener('keydown', (event) => {
      const step = 0.08;
      if (event.key === 'ArrowLeft') pointerX = Math.max(-0.5, pointerX - step);
      else if (event.key === 'ArrowRight') pointerX = Math.min(0.5, pointerX + step);
      else if (event.key === 'ArrowUp') pointerY = Math.max(-0.5, pointerY - step);
      else if (event.key === 'ArrowDown') pointerY = Math.min(0.5, pointerY + step);
      else if (event.key === 'Escape') { resetTilt(); return; }
      else return;
      event.preventDefault();
      root.style.setProperty('--pointer-active', '1');
      applyTilt(pointerX, pointerY);
    });

    stage.addEventListener('pointerleave', resetTilt, { passive: true });
    stage.addEventListener('blur', resetTilt);
  })();
</script>
